{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llmwiki/schemas/page-meta.schema.json",
  "title": "page-meta",
  "description": "Sidecar per MediaWiki-pagina (sync) voor conflictdetectie bij push. Niet gebruikt bij curation/knowledge-base, waar de pagina zelf het archief is.",
  "type": "object",
  "required": ["titel", "namespace", "sha1"],
  "properties": {
    "titel": { "type": "string" },
    "pageid": { "type": "integer" },
    "revid": { "type": "integer" },
    "tijdstempel": { "type": "string" },
    "namespace": { "type": "integer" },
    "contentmodel": { "type": "string" },
    "categorieen": { "type": "array", "items": { "type": "string" } },
    "sha1": { "type": "string" }
  },
  "additionalProperties": false
}
