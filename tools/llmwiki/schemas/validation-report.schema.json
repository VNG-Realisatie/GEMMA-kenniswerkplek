{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llmwiki/schemas/validation-report.schema.json",
  "title": "validation-report",
  "description": "Uitvoer van de VALIDATE-fase: resultaat per controle.",
  "type": "object",
  "required": ["run", "controles"],
  "properties": {
    "run": { "type": "string" },
    "controles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["naam", "resultaat", "ernst"],
        "properties": {
          "naam": { "type": "string" },
          "doel": { "type": "string", "description": "Betrokken pagina of bestand" },
          "resultaat": { "type": "string", "enum": ["ok", "fout"] },
          "ernst": { "type": "string", "enum": ["info", "waarschuwing", "fout"] },
          "melding": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
