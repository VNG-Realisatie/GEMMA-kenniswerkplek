          <property key="BIV score BBN" value="121"/>
          <property key="Beschikbaarheid" value="1"/>
          <property key="Beschikbaarheid (belangrijkste reden)" value="1 : irritatie en ongemak bij burgers geventileerd in de media."/>
          <property key="Toelichting" value="De component kan ondersteunen door, aan de hand van vastgelegde gegevens over werkzoekenden, vacatures en werkgevers, potentiele matches te bepalen. Afhankelijk van de context kan dit leiden tot het automatisch versturen van meldingen aan betrokkenen of tot het verwerken van de resultaten door een medewerker die de resultaten als input voor vervolgacties gebruikt. Matching kan als doel hebben het invullen van bestaande vacatures, om leerwerkplekken in te vullen of eenvoudigweg om werkzoekenden en werkgevers met elkaar in contact te brengen."/>
          <property key="GEMMA status" value="In gebruik"/>
          <property key="GEMMA type" value="Referentiecomponent"/>
          <property key="Integriteit" value="2"/>
          <property key="Integriteit (belangrijkste reden)" value="2 : verlies van publiek respect; klachten van burgers."/>
