        <property key="GEMMA type" value="Standaard"/>
        <property key="GEMMA status" value="In gebruik"/>
      </element>
      <element xsi:type="archimate:ApplicationService" name="Aantoonbaar maken authenticiteit van informatie" id="id-044bcf8f5224467db7076be50fb7674a">
