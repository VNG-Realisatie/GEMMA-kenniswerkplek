        <element xsi:type="archimate:ApplicationInterface" name="Klanten API" id="id-8c66a7d4-80a4-413f-87e0-42964d232d9d">
          <documentation>De Klanten API standaardiseert het creëren, bijwerken, lezen en verwijderen van klantgegevens.</documentation>
          <property key="Object ID" value="8c66a7d4-80a4-413f-87e0-42964d232d9d"/>
        </element>
