      <element xsi:type="archimate:Grouping" name="Bestuur applicatieservices voor ketenpartners" id="id-b8d5ba90c0084b1d8ffa50b8c3aa430f">
        <documentation>Applicatieservices die ketenpartners ondersteunen bij bestuurlijke processen, zoals samenwerking op beleidsniveau.</documentation>
        <property key="GEMMA subtype" value="Domein en doelgroep"/>
        <property key="GEMMA type" value="Groep"/>
        <property key="Object ID" value="c5215c83-05fb-43e1-b11a-43c833b75dd3"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Bestuur applicatieservices voor inwoners en ondernemers" id="id-c9a2107a8e3e461faa1b63bd8a8c992e">
        <documentation>Applicatieservices gericht op het ondersteunen van inwoners en ondernemers bij bestuurlijke zaken, zoals participatie of inspraak.</documentation>
        <property key="GEMMA subtype" value="Domein en doelgroep"/>
        <property key="GEMMA type" value="Groep"/>
        <property key="Object ID" value="f3cc5bf1-b6ba-437f-9a0f-ab2afa9d0e03"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Generieke applicatieservices voor gemeente" id="id-ce09c5bb06734deeab2318bf6dba5f0d">
        <documentation>Een groep met applicatieservices voor de gemeente zelf. Deze groep bestaat uit generieke applicatieservices die in veel gemeentelijke processen/domeinen/bedrijfsfuncties inzetbaar is.</documentation>
        <property key="GEMMA subtype" value="Domein en doelgroep"/>
        <property key="GEMMA type" value="Groep"/>
        <property key="Object ID" value="9322f1e5-a25c-11e5-11ba-005056a85f9c"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Ondersteuning applicatieservices voor ketenpartners" id="id-ea703e8119f640588d55af475679aa90">
        <documentation>Applicatieservices die ketenpartners helpen bij operationele en administratieve ondersteuning in samenwerking met gemeenten.</documentation>
        <property key="GEMMA subtype" value="Domein en doelgroep"/>
        <property key="GEMMA type" value="Groep"/>
        <property key="Object ID" value="8f17379b-c315-4caf-8a34-18caf1e39b3d"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Publieksdiensten applicatieservices voor inwoners en ondernemers" id="id-f966c207747e4c0692926e9bdb223f87">
        <documentation>Applicatieservices gericht op het leveren van gemeentelijke diensten aan inwoners en ondernemers, zoals aanvragen of meldingen.</documentation>
        <property key="GEMMA subtype" value="Domein en doelgroep"/>
        <property key="GEMMA type" value="Groep"/>
        <property key="Object ID" value="50d0e329-db92-419a-b26a-943ef0fd9a77"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Fysieke leefomgeving applicatieservices voor gemeente" id="id-fe17de65e0634ba0b05d28c6a899425b">
        <documentation>Applicatieservices gericht op gemeentelijke taken binnen ruimtelijke ordening, infrastructuur en milieu.</documentation>
        <property key="GEMMA subtype" value="Domein en doelgroep"/>
        <property key="GEMMA type" value="Groep"/>
        <property key="Object ID" value="9a505387-cf35-11e5-11ba-005056a85f9c"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Generieke applicatieservices voor inwoners en ondernemers" id="id-ffb0b0e066e949a6881a64a4c5a1db64">
        <documentation>Algemene applicatieservices die inwoners en ondernemers ondersteunen bij interactie met gemeentelijke diensten.</documentation>
        <property key="Toelichting" value="Bijvoorbeeld het aanvragen van producten of diensten, het inzage krijgen in voor hen relevante gegevens, etc. De verwachting is dat deze groep applicatieservices zowel in omvang als in rijkheid gaat groeien om steeds meer 'self-service' door klanten mogelijk te maken."/>
        <property key="GEMMA subtype" value="Domein en doelgroep"/>
        <property key="GEMMA type" value="Groep"/>
        <property key="Object ID" value="9322f1e8-a25c-11e5-11ba-005056a85f9c"/>
      </element>
    </folder>
