            </child>
            <child xsi:type="archimate:Note" id="id-8efe8ca87829451c9b2a60ffecad4c8a" textAlignment="1" fillColor="#ffffff" borderType="1">
              <bounds x="30" y="3330" width="5371" height="132"/>
            </child>
            <child xsi:type="archimate:Note" id="id-7bf3d58b40a84f1f904bd0dc463742b4" font="1|Segoe UI|43.8|1|WINDOWS|1|-73|0|0|0|700|0|0|0|0|3|2|1|34|Segoe UI" fontColor="#2760a4" lineColor="#000000" textAlignment="1" fillColor="#ffffff" alpha="0">
              <bounds x="52" y="3363" width="313" height="107"/>
