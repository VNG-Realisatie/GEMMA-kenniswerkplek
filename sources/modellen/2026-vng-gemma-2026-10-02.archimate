      <element xsi:type="archimate:BusinessObject" name="zaak" id="id-dfabd361-70bc-11e4-67ab-0050568a6153">
        <documentation>een samenhangende hoeveelheid werk met gedefinieerde aanleiding en een gedefinieerd eindresultaat waarvan kwaliteit en doorlooptijd bewaakt moeten worden</documentation>
        <property key="Object ID" value="dfabd361-70bc-11e4-67ab-0050568a6153"/>
      </element>
