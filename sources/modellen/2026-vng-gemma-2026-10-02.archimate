          <property key="Object ID" value="5f1eb6ee-78aa-11e5-1099-005056a83192"/>
        </element>
        <element xsi:type="archimate:ApplicationService" name="Analyseren processen" id="id-bae978ac9f9243a191c4748122f55b88">
