        <property key="Object ID" value="091fc70e-9144-4ef3-b168-30a5ab1bc850"/>
        <property key="GEMMA status" value="In ontwikkeling"/>
        <property key="GEMMA type" value="Technologiecomponent"/>
      </element>
    </folder>
    <folder name="Applicatieontwikkelservices" id="id-80aafd3c47bd463cb67de7cd973ca06e">
      <element xsi:type="archimate:TechnologyService" name="Testservices" id="id-c4ecf04d75d34a68aefd54bc71ca7883">
        <property key="Object ID" value="9d8aca41-e872-44f6-9c55-7ae994178457"/>
      </element>
      <element xsi:type="archimate:TechnologyService" name="Release- en buildcoördinatie" id="id-c625e7cb136e4883aadfd4cf8a71a200">
        <documentation>Technologieservice die het aansturen en coördineren van geautomatiseerde bouw- en uitrolprocessen verzorgt, om software sneller, betrouwbaarder en herhaalbaar te leveren.</documentation>
        <property key="Object ID" value="679f5555-bb45-4e0b-ae7f-0cec713d7c65"/>
      </element>
      <element xsi:type="archimate:TechnologyService" name="Ontwikkel- en testservices" id="id-c9a1039f251f43dcbf7fc91c14c39110">
        <property key="Object ID" value="6807661b-9ebc-4bb0-bfe4-3b86e8f604c7"/>
      </element>
      <element xsi:type="archimate:TechnologyService" name="Ontwikkelservices" id="id-d534d2e7c7dc4accae654290ade4fe8d">
        <property key="Object ID" value="c91f06c7-d4cf-45a6-b089-ee136de6021c"/>
      </element>
    </folder>
    <folder name="Applicatieontwikkeltools (DevOps)" id="id-a0a2785d58e7459590db33a718aa8ddb">
      <element xsi:type="archimate:SystemSoftware" name="Code editor" id="id-4f6ed80a7eac4964ba197ad7c5b60147">
        <documentation>Tool voor het schrijven, testen en debuggen van code</documentation>
        <property key="Toelichting" value="Code schrijven, debuggen, bouwen , met tools zoals VS Code, IntelliJ"/>
        <property key="Object ID" value="08510585-cb62-4b08-b9e5-290a94d274cd"/>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="Deploymentcomponent" id="id-7d3b952257324e78ab80b4f9106b1cac">
        <documentation>Tool voor het geautomatiseerd uitrollen van software naar diverse omgevingen</documentation>
        <property key="Toelichting" value="Richt zich op het beheren en uitvoeren van de deployment en configuratie in productie of testomgevingen., met tools zoals Kubernetes, Helm, ArgoCD, Ansible"/>
        <property key="Object ID" value="b7ea29ae-3d8b-469a-a22e-75dc6903393f"/>
        <property key="GEMMA type" value="Technologiecomponent"/>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="Testtool" id="id-8b6722812306419ab48836c584c3be0f">
        <documentation>Tool voor automatische validatie van softwaregedrag</documentation>
        <property key="Toelichting" value="Unit-, integratie- of API-tests uitvoeren , met tools zoals JUnit, Cypress, Postman"/>
        <property key="Object ID" value="a95a78e7-a2f7-4abf-bbbd-405a76ccead3"/>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="Containerisatietool" id="id-90c911737e504ca39df1c591b34452e4">
        <documentation>Tool die software-artifacten verpakt in containerimages voor consistente uitvoering in diverse omgevingen</documentation>
        <property key="Toelichting" value="Maakt herbruikbare, geïsoleerde omgevingen voor applicaties, los van de onderliggende infrastructuur. Voorbeelden: Docker, Podman, Buildah"/>
        <property key="Object ID" value="5ff4b735-f487-4253-a0b5-314add8eb751"/>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="Versiebeheertool" id="id-9ac269ef6274484aa6da7796bd3602fe">
        <documentation>Tool om versies van code op te slaan, te delen en samen te voegen</documentation>
        <property key="Toelichting" value="Versiebeheer, branching, collaboration , met tools zoals Git, GitHub, GitLab"/>
        <property key="Object ID" value="6feb955c-fe29-429b-b92a-511b206747e1"/>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="CI/CD-tool" id="id-c2dbc65ecf8e47c2bfc1f271390f2c6f">
        <documentation>Tool die het bouwen, testen (CI) en uitrollen (CD) van code naar omgevingen automatiseert en coördineert.</documentation>
        <property key="Toelichting" value="De Continuous Integration/Continuous Delivery-tool coördineert en automatiseert het proces door andere tools aan te sturen voor bouwen, containerisatie en uitrol, maar voert deze stappen niet zelf uit. Voorbeelden zijn GitHub Actions, GitLab CI/CD en Jenkins."/>
        <property key="Object ID" value="5248911b-1a36-4c6f-b777-a653c34c36b0"/>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="Buildtool" id="id-c2f2e6ae77834d30893d85ddf077797b">
        <documentation>Tool die broncode compileert en software-artefacten maakt. </documentation>
        <property key="Toelichting" value="Zorgt voor het vertalen van code naar uitvoerbare bestanden en beheert dependencies. Voorbeelden: Maven, Gradle, Ant, MSBuild"/>
        <property key="Object ID" value="33654601-70be-4c04-b2e5-4e174664c5b2"/>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="Code scanner" id="id-ed4c761d3ce64c3bb44b09b46805701f">
        <documentation>Tool voor het analyseren van broncode op kwaliteit, kwetsbaarheden en onderhoudbaarheid</documentation>
        <property key="Toelichting" value="Code automatisch scannen en rapporteren , met tools zoals SonarQube, Semgrep (Statische analyse, SAST - Static Application Security Testing)"/>
        <property key="Object ID" value="ee9ade9c-8d12-450b-94ea-58f5661972fa"/>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="Pentest component" id="id-edf225d6d87b4ce69acdf5236cc79755">
        <documentation>Technologiecomponent die tijdens uitvoering automatisch kwetsbaarheden detecteert, vergelijkbaar met een doorlopende penetratietest</documentation>
        <property key="Toelichting" value="De geautomatiseerde beveiligingstesten wordt veelal Dynamic Application Security Testing (DAST) genoemd en richten zich op specifieke kwetsbaarheden, zoals XSS, SQL-injectie en misconfiguraties. Pentesten richten zich op het gehele systeem en het menselijk gedrag en zijn daarmee breder en minder voorspelbaar."/>
        <property key="Object ID" value="c94ca961-078e-4353-ba0d-3d53c44ed3a5"/>
        <property key="GEMMA type" value="Technologiecomponent"/>
        <property key="GEMMA status" value="In ontwikkeling"/>
      </element>
    </folder>
