        <documentation>Applicatieservices die de gemeente ondersteunt in de uitvoering van publieke diensten voor inwoners en ondernemers.</documentation>
        <property key="GEMMA subtype" value="Domein en doelgroep"/>
        <property key="GEMMA type" value="Groep"/>
        <property key="Object ID" value="4adc69d1-d707-11e5-11ba-005056a85f9c"/>
