        <element xsi:type="archimate:BusinessProcess" name="Deelproces Vaststellen voorontwerp" id="id-87005276-f90b-4fb5-87d1-c12052eef95f">
          <property key="Object ID" value="87005276-f90b-4fb5-87d1-c12052eef95f"/>
