          <property key="Object ID" value="857ffb0d-da88-11e1-7023-0050568a1905"/>
        </element>
        <element xsi:type="archimate:ApplicationService" name="Registreren en delen technische logging" id="id-741e092097b24ab6b0fcb1abda0eea30">
          <documentation>Bijhouden en ontsluiten systeemgebeurtenissen ten behoeve van informatiebeveiliging, foutoplossing en het optimaliseren van systemen</documentation>
          <property key="Object ID" value="55a0f5b8-9c0a-44c6-b950-9e87cf82d3fd"/>
        </element>
