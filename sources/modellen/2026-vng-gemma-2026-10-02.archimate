            <child xsi:type="archimate:Note" id="id-569d67d3a8784623810f60b7809f886b" font="1|Segoe UI|43.8|1|WINDOWS|1|-73|0|0|0|700|0|0|0|0|3|2|1|34|Segoe UI" fontColor="#2760a4" lineColor="#000000" textAlignment="1" fillColor="#ffffff" alpha="0">
              <bounds x="52" y="3363" width="313" height="107"/>
