        <documentation>Applicatieservices die ketenpartners ondersteunen in samenwerking op het gebied van handhaving en veiligheid.</documentation>
        <property key="GEMMA subtype" value="Domein en doelgroep"/>
        <property key="GEMMA type" value="Groep"/>
        <property key="Object ID" value="593847b8-d70f-11e5-11ba-005056a85f9c"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Fysieke leefomgeving applicatieservices voor ketenpartners" id="id-55a5c4f4c0004aa08a963978f6d4a32e">
        <documentation>Applicatieservices die gericht zijn op het ondersteunen van ketenpartners in ruimtelijke ordening, milieu en infrastructuur.</documentation>
        <property key="GEMMA subtype" value="Domein en doelgroep"/>
        <property key="GEMMA type" value="Groep"/>
        <property key="Object ID" value="451fcc87-4710-4215-a60a-f82516fa0f95"/>
      </element>
