          <property key="Vertrouwelijkheid (belangrijkste reden)" value="1 : interne negatieve publiciteit (imagoschade)."/>
        </element>
        <element xsi:type="archimate:ApplicationComponent" name="Bedrijven- en instellingen-registratiecomponent" id="id-cd0ddeb9-42dc-4385-9a78-0cca5e835e5e">
          <documentation>Component voor het registreren van KvK-inschrijvingen vestigingen, activiteiten en werkgelegenheid conform LISA</documentation>
          <property key="GEMMA status" value="In gebruik"/>
