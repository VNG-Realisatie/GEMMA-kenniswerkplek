          <documentation>De Selectielijst API stelt de gegevens die horen bij de Selectielijst gemeenten en intergemeentelijke organen beschikbaar.</documentation>
          <property key="Object ID" value="4d5bab71-9abe-46ed-9bbe-539923131ea3"/>
        </element>
        <element xsi:type="archimate:ApplicationInterface" name="Documenten API" id="id-76f359d9-0fe9-45a5-99a9-d6bacf22155e">
          <documentation>De Documenten API standaardiseert het creëren, bijwerken, lezen en verwijderen van informatieobjecten en bijbehorende metagegevens.</documentation>
          <property key="Object ID" value="76f359d9-0fe9-45a5-99a9-d6bacf22155e"/>
