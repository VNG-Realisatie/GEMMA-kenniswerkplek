        <documentation>Technologiecomponent voor het registreren van technologie gerelateerde gebeurtenissen. Bijvoorbeeld: de ELK-stack (Elasticsearch, Logstash, Kibana).</documentation>
        <property key="Object ID" value="5f53925a-fca1-4d00-a731-ae9fab96df33"/>
        <property key="GEMMA status" value="In ontwikkeling"/>
        <property key="GEMMA type" value="Technologiecomponent"/>
      </element>
