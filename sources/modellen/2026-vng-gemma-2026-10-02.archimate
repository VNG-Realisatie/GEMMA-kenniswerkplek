      <folder name="Basiscomponenten" id="47f47df0-f4dd-48c9-adfb-18578375d944">
        <element xsi:type="archimate:FlowRelationship" name="aanmelden als afnemer" id="id-11897264-3d7c-4a46-a38a-b56e39857c14" source="id-7a855337-fcbb-11e5-11ba-005056a85f9c" target="id-5060f0fc-6198-4936-99d3-1c5a35aae8de">
