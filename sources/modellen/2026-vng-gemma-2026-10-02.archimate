            <child xsi:type="archimate:Note" id="id-0b08aa71f2184119920c9c1800e66cf5" font="1|Segoe UI|36.0|1|WINDOWS|1|-60|0|0|0|700|0|0|0|0|3|2|1|34|Segoe UI" textAlignment="1">
              <bounds x="61" y="3073" width="2588" height="222"/>
