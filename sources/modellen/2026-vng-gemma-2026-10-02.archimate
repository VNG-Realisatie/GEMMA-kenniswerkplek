          </element>
          <element xsi:type="archimate:BusinessObject" name="Begrotingregel" id="id-036d7ad3033544f5ab0952dedf376c0a">
            <documentation>Een item op de begroting</documentation>
            <property key="GGM-guid" value="{87964E36-9FEE-4b8f-A053-C4EDAF000646}"/>
            <property key="GGM-uml-type" value="Class"/>
            <property key="GGM-datum-tijd-export" value="10122024-112046"/>
            <property key="Let op" value="&quot;ggm-&quot; properties worden beheerd in het GGM informatiemodel"/>
            <property key="Object ID" value="ecb0f96e-e66d-48fb-ade1-416366d1b18e"/>
            <property key="GEMMA URL" value="https://gemmaonline.nl/index.php/GEMMA/id-ecb0f96e-e66d-48fb-ade1-416366d1b18e"/>
            <property key="Toelichting" value="Een begrotingsregel betreft #. een combinatie van hoofdstuk met optioneel doelstelling met optioneel product of #. een kostenplaats met 1 of meer hoofdrekeningen"/>
          </element>
          <element xsi:type="archimate:BusinessObject" name="Traject" id="id-03972958be3a4c7e86bb0f4983da203e">
            <documentation>Samenstel van achtereenvolgens uit te voeren en onderling samenhangende deelhandelingen of van opeenvolgende stadia in een proces, voorgesteld als een route die via opeenvolgende bestemmingen naar de eindbestemming voert.</documentation>
