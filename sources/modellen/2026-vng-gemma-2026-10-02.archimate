            <property key="Object ID" value="698092e0-5d15-4172-b7bb-328d863179f5"/>
          </element>
          <element xsi:type="archimate:Constraint" name="3PAS API-standaard" id="id-a330539b99434bef83eb0f7391c85051">
            <documentation>Een standaard voor het publiceren van kennisgevingen op het DRP platform.</documentation>
            <property key="GEMMA status" value="In gebruik"/>
            <property key="GEMMA type" value="Standaard"/>
            <property key="Beheerder" value="KOOP"/>
