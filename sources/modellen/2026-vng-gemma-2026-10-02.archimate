        <property key="GEMMA type" value="Technologiecomponent"/>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="Intrusion Detection component" id="id-611de6bdd64246ee89e860abedd52f2b">
        <documentation>Technologiecomponent voor het detecteren en rapporteren van verdachte activiteiten en mogelijke inbreuken op een netwerk of systeem.</documentation>
