            <property key="Object ID" value="9454406b-1cbd-4f4c-8337-863863518f19"/>
            <property key="GEMMA sortering" value="g"/>
            <property key="GEMMA type" value="Taakveld Iv3"/>
          </element>
        </folder>
        <element xsi:type="archimate:Grouping" name="Beleidsdomeinen ingedeeld in Iv3" id="id-612efdd59a45413b8117474df5090260">
          <documentation>Hiërarchie van de beleidsdomeinen gebruikt door het gemeentelijke gegevensmodel (GGM)</documentation>
          <property key="Object ID" value="03309378-2fc8-4bd3-be48-7b2534275a2e"/>
