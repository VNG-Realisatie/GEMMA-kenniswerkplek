          <property key="Object ID" value="5f1eb6eb-78aa-11e5-1099-005056a83192"/>
        </element>
        <element xsi:type="archimate:ApplicationService" name="Beheren van managementinformatie" id="id-abbf79d71fb8464aba1f66dbf4d14ea6">
          <documentation>Applicatieservice voor het creëren en tonen van managementinformatie. Hieronder valt functionaliteit voor het integreren van gegevens en het maken en tonen van standaard en custom rapportages of trendanalyses.</documentation>
          <property key="Object ID" value="8280288e-da88-11e1-7023-0050568a1905"/>
