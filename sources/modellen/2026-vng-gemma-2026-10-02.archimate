        <property key="Object ID" value="91dae465-b0e3-4b45-b78f-6e7177179e56"/>
      </element>
      <element xsi:type="archimate:ApplicationService" name="Openbaar toegankelijk publiceren van informatie" id="id-312ccae49c0f4213815a4dc3e40a04ea">
        <documentation>Applicatieservice voor het presenteren van informatie en bijbehorende metadata in een publiek toegankelijke omgeving.</documentation>
        <property key="Object ID" value="5e2b0c88-42cd-4223-9787-b360c63c65bc"/>
      </element>
      <element xsi:type="archimate:ApplicationService" name="Oninterpreteerbaar maken van niet-openbare informatie ('weglakken')" id="id-e7b18ea674654db3b1423e312cc65777">
        <documentation>Applicatieservice voor het oninterpreteerbaar maken (ook wel 'lakken' genoemd) van informatie die niet (actief) openbaar mag worden gemaakt.</documentation>
