        <element xsi:type="archimate:Constraint" name="PDF/A-2 (ISO 19005-2)" id="id-c204c5a1-8db0-11e3-67ab-0050568a6153">
          <documentation>PDF/A-2 slaat de brug tussen PDF/A-1 en PDF 1.7 waarbij PDF/A-2 een betere geschiktheid heeft voor langdurig archiveren van documenten waar  'elementen' inzitten die niet door PDF/A-1 worden ondersteund en waarbij PDF 1.7 kan worden gebruikt voor 'elementen' die niet door PDF/A-2 ondersteund worden.</documentation>
          <property key="GEMMA type" value="Standaardversie"/>
          <property key="Versieaanduiding" value="2 (ISO 19005-2)"/>
          <property key="Status" value="In gebruik"/>
          <property key="Object ID" value="c204c5a1-8db0-11e3-67ab-0050568a6153"/>
