        <element xsi:type="archimate:ApplicationComponent" name="Documentcreatiecomponent" id="id-d6a2d1a8-23be-4808-b5ac-69e00de528c9">
          <documentation>Component voor het aanmaken van documenten waarbij vaste teksten/templates worden gecombineerd met gegevens.</documentation>
          <property key="Toelichting" value="De component maakt het mogelijk om met behulp van voorgedefinieerde templates, tekstblokken en verwijzingen naar bronsystemen documenten op maat aan te maken. Aanmaak kan volledig automatisch plaatsvinden of er wordt aan een gebruiker gevraagd om eerst een aantal situatieafhankelijke keuzes te maken. Afhankelijk van de configuratie kan opslag van het document al dan niet automatisch plaats vinden."/>
          <property key="GEMMA status" value="In gebruik"/>
          <property key="GEMMA type" value="Referentiecomponent"/>
          <property key="Object ID" value="d6a2d1a8-23be-4808-b5ac-69e00de528c9"/>
          <property key="BBN" value="BBN 2"/>
          <property key="BIV score BBN" value="222"/>
          <property key="Beschikbaarheid" value="2"/>
          <property key="Beschikbaarheid (belangrijkste reden)" value="2 : verlies van publiek respect; klachten van burgers."/>
          <property key="Integriteit" value="2"/>
