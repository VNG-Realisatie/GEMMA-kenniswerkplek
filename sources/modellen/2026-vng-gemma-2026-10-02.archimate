          <property key="Vertrouwelijkheid" value="2"/>
          <property key="Vertrouwelijkheid (belangrijkste reden)" value="2 : politieke schade aan een bestuurder: bestuurder moet zich verantwoorden n.a.v. verantwoordings vragen."/>
        </element>
        <element xsi:type="archimate:ApplicationComponent" name="Samenwerkingscomponent" id="id-d845fe29-3810-4e50-970a-b48330d19f7b">
          <documentation>Component voor het op afstand, onafhankelijk van elkaar, gecoördineerd samen werken aan een gemeenschappelijk doel.</documentation>
          <property key="Toelichting" value="De component maakt het mogelijk dat meerdere personen of organisaties gezamenlijk kunnen werken aan een doel en daarbij maximaal onafhankelijk van elkaar zijn. Het component moet zoveel mogelijk tijd-, plaats- en apparaatonafhankelijk door deelnemers kunnen worden gebruikt. De Engelse term voor deze vorm van samenwerking is: 'collaboration. Een voorbeeld van een samenwerkingsysteem is een extranet dat geschikt is voor samenwerking tussen medewerkers en personen buiten de organisatie. Andere voorbeelden van samenwerkingssystemen zijn publiek aangeboden voorzieningen zoals Office365 of groepsfaciliteiten binnen platforms als Yammer of Facebook."/>
          <property key="GEMMA status" value="In gebruik"/>
          <property key="GEMMA type" value="Referentiecomponent"/>
          <property key="Object ID" value="d845fe29-3810-4e50-970a-b48330d19f7b"/>
          <property key="BBN" value="BBN 1"/>
