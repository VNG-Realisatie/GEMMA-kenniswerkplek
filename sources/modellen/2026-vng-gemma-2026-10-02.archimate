        </element>
        <element xsi:type="archimate:ApplicationComponent" name="E-formulieren publicatie-en-beheercomponent" id="id-5c9f683b-4454-4e3e-b93c-da50dfd6934a">
          <documentation>Component voor het ontwikkelen, publiceren, laten invullen, indienen en bevestigen van elektronische formulieren.</documentation>
          <property key="Toelichting" value="De component biedt mogelijkheden om verschillende soorten formulieren te ontwikkelen met behulp van standaard bouwblokken en functionaliteiten (bijv. voor controles). Het component biedt ondersteuning voor het slim aanroepen van ontwikkelde formulieren (bijv. t.b.v. voorinvulling van al bekende gegevens), het tijdens invulling gebruik maken van functionaliteit die door andere systemen wordt geleverd (bijv. online betaling) en het tijdens invulling realtime opvragen van gegevens die elders zijn opgeslagen (bijv. via webservices)."/>
          <property key="GEMMA status" value="In gebruik"/>
          <property key="GEMMA type" value="Referentiecomponent"/>
          <property key="Object ID" value="5c9f683b-4454-4e3e-b93c-da50dfd6934a"/>
          <property key="BBN" value="BBN 2"/>
          <property key="BIV score BBN" value="222"/>
          <property key="Beschikbaarheid" value="2"/>
          <property key="Beschikbaarheid (belangrijkste reden)" value="2 : schade te herstellen door ambtelijke opschaling."/>
          <property key="Integriteit" value="2"/>
          <property key="Integriteit (belangrijkste reden)" value="2 : belangrijk verlies van management control."/>
          <property key="Vertrouwelijkheid" value="2"/>
          <property key="Vertrouwelijkheid (belangrijkste reden)" value="2 : verlies van publiek respect; klachten van burgers; significant verlies van motivatie van medewerkers."/>
        </element>
