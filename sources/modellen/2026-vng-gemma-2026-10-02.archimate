          <property key="Object ID" value="eb5cb7da-c5b6-11e5-11ba-005056a85f9c"/>
        </element>
        <element xsi:type="archimate:ApplicationService" name="Beschikbaarstellen van informatieobjecten" id="id-bba6ff59502a48c49ca0f98f4ce3b43c">
