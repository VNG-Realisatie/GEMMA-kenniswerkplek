        <property key="Object ID" value="1c56b47c-f2b8-48ef-a3e1-fce1b36e99c2"/>
        <property key="GEMMA status" value="In ontwikkeling"/>
        <property key="GEMMA type" value="Technologiecomponent"/>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="WORM component" id="id-a1eac7e2a297487fb83b8f29b4c58779">
        <documentation>Technologiecomponent voor het één keer opslaan en meerdere keren lezen van gegevens zonder ze te wijzigen. Bijvoorbeeld voor archivering en compliance.</documentation>
        <property key="Object ID" value="42c83ec9-6868-4ea9-9393-d3425fa762b5"/>
        <property key="GEMMA status" value="In ontwikkeling"/>
        <property key="GEMMA type" value="Technologiecomponent"/>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="ETL-component" id="id-be474175369e4322b82614e51fe8f788">
        <documentation>Technologiecomponent voor het extraheren, transformeren naar een gewenst formaat en laden in een doelopslagplaats gegevens uit verschillende bronnen. Bijvoorbeeld voor data warehousing.</documentation>
        <property key="Object ID" value="e22bec0e-3eb0-4211-b3f5-4940a524d394"/>
        <property key="GEMMA status" value="In ontwikkeling"/>
        <property key="GEMMA type" value="Technologiecomponent"/>
      </element>
