        <property key="GEMMA status" value="In ontwikkeling"/>
        <property key="GEMMA type" value="Technologiecomponent"/>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="Load balancer" id="id-71c75af8fd50418ab74061b066085567">
