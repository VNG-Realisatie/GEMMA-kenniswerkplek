      </element>
      <element xsi:type="archimate:BusinessActor" name="Beheerder generieke voorzieningen" id="id-b62b5860-c7c0-427f-b49e-e8d83d84fa4c">
        <property key="Object ID" value="b62b5860-c7c0-427f-b49e-e8d83d84fa4c"/>
      </element>
      <element xsi:type="archimate:BusinessActor" name="Regisseur gegevensmanagement" id="id-c445ae76-f5e4-4fb0-8a6f-200abb747e41">
        <property key="Object ID" value="c445ae76-f5e4-4fb0-8a6f-200abb747e41"/>
      </element>
      <element xsi:type="archimate:BusinessActor" name="Gegevensarchitect" id="id-d17bfd8a-2c42-4c63-9b29-7c8100a6f013">
        <property key="Object ID" value="d17bfd8a-2c42-4c63-9b29-7c8100a6f013"/>
      </element>
      <element xsi:type="archimate:BusinessActor" name="Afnemer" id="id-dcf821fe-e6c2-46da-b874-50c39d66ebd4">
        <property key="Object ID" value="dcf821fe-e6c2-46da-b874-50c39d66ebd4"/>
      </element>
      <element xsi:type="archimate:BusinessActor" name="Gebruiker" id="id-e5c1664937a549b9a7b7b5f81614abc4">
        <documentation>Iedere persoon, organisatie of functionele eenheid die gebruik maakt van een informatiesysteem.</documentation>
        <property key="Object ID" value="50adfbc8-1027-4df7-88d6-187cba7e6a68"/>
      </element>
      <element xsi:type="archimate:BusinessActor" name="Auditor / Kwaliteitscontrole" id="id-ff0ed2c5-423f-4139-8b49-b4e1460890b5">
        <property key="Object ID" value="ff0ed2c5-423f-4139-8b49-b4e1460890b5"/>
      </element>
    </folder>
    <folder name="Producten" id="cbd170c0-84f7-4cbe-acfa-f8c3bfe27cfa">
      <element xsi:type="archimate:Product" name="IaaS - Infrastructure as a Service" id="id-05b651be5d24491a8da42992d9d9a908">
        <documentation>Dienst waarbij de aanbieder de infrastructuur (zoals servers, opslag en netwerken) beheert en beveiligt. De gemeente is zelf verantwoordelijk voor het besturingssysteem, applicaties en data.</documentation>
        <property key="Object ID" value="7ead0d8e-8b57-4f39-9c2b-a0591f192011"/>
        <property key="Toelichting" value="Kies IaaS als je maximale controle wilt over de technische inrichting, bijvoorbeeld bij maatwerkapplicaties of specifieke beveiligingseisen."/>
        <property key="GEMMA type" value="Cloud-dienstverleningsmodel"/>
      </element>
      <element xsi:type="archimate:Product" name="Generieke voorzieningen" id="id-1fca4e30-1880-11e4-67ab-0050568a6153">
        <documentation>Ingerichte informatiesystemen ten behoeve van het gegevensmanagement. Denk hierbij aan gegevensmagazijnen, distributiesystemen, servicecatalogi, etcetera.</documentation>
        <property key="Object ID" value="1fca4e30-1880-11e4-67ab-0050568a6153"/>
      </element>
      <element xsi:type="archimate:Product" name="SaaS - Software as a Service" id="id-381cf8110a1a4196adc16b6e94a612a1">
        <documentation>Dienst waarbij de aanbieder de volledige stack, inclusief applicatie, beheert en beveiligt. De gemeente gebruikt de software en is verantwoordelijk voor juist gebruik en databeheer.</documentation>
        <property key="Object ID" value="923290ab-8e22-46a5-bca3-7b8f496f4121"/>
        <property key="Toelichting" value="Kies SaaS als je snel en efficiënt gebruik wilt maken van standaardoplossingen met minimale beheerlast en automatische updates."/>
        <property key="GEMMA type" value="Cloud-dienstverleningsmodel"/>
      </element>
      <element xsi:type="archimate:Product" name="PaaS - Platform as a Service" id="id-ab473d4bfcf943b3b7c350313452c0da">
        <documentation>Dienst waarbij de aanbieder zowel infrastructuur als platform (zoals OS, databases en middleware) beheert en beveiligt. De gemeente ontwikkelt, beheert en beveiligt haar eigen applicaties en data.</documentation>
        <property key="Object ID" value="8622a681-25f0-4480-959a-892837f0259a"/>
        <property key="Toelichting" value="Kies PaaS als je applicaties wilt ontwikkelen of draaien zonder je bezig te houden met onderliggende techniek, maar wél regie wilt houden over de functionaliteit."/>
        <property key="GEMMA type" value="Cloud-dienstverleningsmodel"/>
      </element>
      <element xsi:type="archimate:Product" name="Gegevenscatalogus" id="id-bbed56c8-17c4-11e4-67ab-0050568a6153">
        <documentation>Deze catalogus beschrijft of omvat: • gegevenswoordenboek: de gegevensdefinities • objecten/entiteitsmodellen: de onderlinge relatie tussen gegevens • relatie met landelijke gegevensverzamelingen en –definities   In het woordenboek wordt vastgelegd  • De betekenis van een gegeven • De classificatie van een gegeven • Eigenaar van het gegeven • Het formaat van het gegeven • Levenscyclus van het gegeven (ontstaan, mutatie, beëindiging, verwijdering) • Relatie tot andere gegevens</documentation>
        <property key="Object ID" value="bbed56c8-17c4-11e4-67ab-0050568a6153"/>
      </element>
      <element xsi:type="archimate:Product" name="On premises - Self managed" id="id-bf8539b5fa3948718445e3a441bcc9a2">
        <documentation>De gemeente is zelf verantwoordelijk voor het beheer van de dienst: van infrastructuur tot en met de software</documentation>
        <property key="Toelichting" value="Dit model komt vaak voor bij on-premises levering, maar kan ook gelden bij private cloud."/>
        <property key="Object ID" value="cd244bb7-596f-493c-9859-e57b54b73af2"/>
        <property key="GEMMA type" value="Cloud-dienstverleningsmodel"/>
      </element>
    </folder>
    <folder name="Bedrijfsfuncties" id="cd6a614c-7771-41f7-b7fe-571ea9e79956">
      <folder name="(Hoofd)bedrijfsfuncties" id="1d8e3d07-8ea2-4ce8-b1c3-fd05baf781d2">
        <element xsi:type="archimate:BusinessFunction" name="Afstemming" id="id-03c32c37-e435-47be-8b71-d143452ea4f9">
          <documentation>Het inhoudelijke en procesmatig afstemmen met een partij met wie wordt samengewerkt of waarvan diensten worden betrokken, zodat beiden over de juiste informatie beschikken.</documentation>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="03c32c37-e435-47be-8b71-d143452ea4f9"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Sturing" id="id-058b95b0-ecb4-4cef-970c-754b1f0113a4">
          <documentation>Het richting geven aan de organisatie door het bepalen van de gewenste verandering en de kaders waarbinnen deze verandering moet plaatsvinden, het vormen van samenwerkingsverbanden om hier in vulling aan te geven en het verantwoorden of doelstellingen ook behaald zijn.</documentation>
          <property key="GEMMA type" value="Bedrijfsfunctie laag"/>
          <property key="Object ID" value="058b95b0-ecb4-4cef-970c-754b1f0113a4"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Bewaking" id="id-09c4ff42-0fdd-4c03-b5cb-04d27b04e573">
          <documentation>Het vanuit allerlei perspectieven controleren of aan de gewenste doelstellingen en randvoorwaarden wordt voldaan en het zonodig nemen van de juiste corrigerende maatregelen</documentation>
          <property key="GEMMA type" value="Bedrijfsfunctie laag"/>
          <property key="Object ID" value="09c4ff42-0fdd-4c03-b5cb-04d27b04e573"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Ontvangst" id="id-0ae840a8-d403-4090-9d02-4ec36a02f88c">
          <documentation>Het ontvangen van signalen, gegevens of een verzoek of een melding die aanleiding geeft om een proces te starten of die anderszins bijdraagt aan de uitvoering van het proces.</documentation>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="0ae840a8-d403-4090-9d02-4ec36a02f88c"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Klant- en keteninteractie" id="id-1022e062-af16-4ca9-8ee8-434ebd880977">
          <documentation>Het aangaan van de interactie met de klant en ketenpartners, het ervoor zorgen dat zij over de juiste gegevens en informatie beschikken en het ontvangen van meldingen, verzoeken en gegevens.</documentation>
          <property key="GEMMA type" value="Bedrijfsfunctie laag"/>
          <property key="Object ID" value="1022e062-af16-4ca9-8ee8-434ebd880977"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Producten- en dienstenrealisatie veiligheidsdomein" id="id-11ceda47-d0a4-49cb-88d7-eaf623172f3f">
          <documentation>Het uitvoeren van activiteiten om producten en diensten te leveren binnen het Veiligheidsdomein.</documentation>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="11ceda47-d0a4-49cb-88d7-eaf623172f3f"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Openbare orde en veiligheidontwikkeling" id="id-133873ca-ac3a-42b7-8378-ea8dfe76ad65">
          <documentation>Het ontwikkelen en invoeren van beleid dat betrekking heeft op openbare orde en veiligheidsaspecten.</documentation>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="133873ca-ac3a-42b7-8378-ea8dfe76ad65"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Financieel management" id="id-1b024c55-a823-4f47-bed6-b913065d910d">
          <documentation>Het zorgdragen voor alle inkomende en uitgaande financiële stromen.</documentation>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="1b024c55-a823-4f47-bed6-b913065d910d"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Sociale ontwikkeling" id="id-20cf9297-82a6-4574-9c92-9fe6b1c160bb">
          <documentation>Het ontwikkelen en implementeren van beleid dat betrekking heeft op sociale aspecten.</documentation>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="20cf9297-82a6-4574-9c92-9fe6b1c160bb"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Regievoering" id="id-277135f4-2303-4476-a16f-27936488f87c">
          <documentation>Het coördineren van de kwaliteit en levering van uitbestede diensten door aanbieders.</documentation>
          <property key="GEMMA type" value="Bedrijfsfunctie laag"/>
          <property key="Object ID" value="277135f4-2303-4476-a16f-27936488f87c"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Samenwerkingsvorming" id="id-2a0745ce-06c7-40ee-8f20-5a242666db11">
          <documentation>Het vormen van een samenwerkingsverband met andere organisaties en het maken van de daarbij behorende afspraken.</documentation>
          <property key="Toelichting" value="Bijv. het oprichten, wijzigen of opheffen van gemeenschappelijke regelingen waarmee een bepaalde vorm van samenwerking tussen overheidsorganen wordt bewerkstelligd."/>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="2a0745ce-06c7-40ee-8f20-5a242666db11"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Samenwerking en participatie" id="id-2b1a0ded-34e5-469e-835d-8e2896ba745e">
          <documentation>Het actief benutten van ideeën en denkkracht van partners bij het plannen, ontwikkelen, uitvoeren en/of evalueren van gemeentelijk beleid</documentation>
          <property key="Toelichting" value="Bijv. digitale cocreatie bij het vormen van nieuw beleid of het ondersteunen van burgerinitiatieven via een digitaal samenwerkingsplatform waar zowel gemeente als inwoners en/of ondernemers aan deel kunnen nemen."/>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="2b1a0ded-34e5-469e-835d-8e2896ba745e"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Producten- en dienstenrealisatie publieksdiensten" id="id-2b40d5bc-cd28-4b62-b0b1-a68f16b7aa64">
          <documentation>Het uitvoeren van activiteiten om producten en diensten te leveren binnen het domein Publieksdiensten.</documentation>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="2b40d5bc-cd28-4b62-b0b1-a68f16b7aa64"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Informatiseringsmanagement" id="id-2bd849c5-1f1b-4df4-aa2d-9b483a026711">
          <documentation>Het ervoor zorgen dat informatiebehoeften bekend zijn en zijn vertaald naar gewenste functionaliteiten van de informatievoorziening.</documentation>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="2bd849c5-1f1b-4df4-aa2d-9b483a026711"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Uitvoering" id="id-31dbd6e5-fae0-46b8-9ccf-d26a8fa91bc1">
          <documentation>Het leveren van producten en diensten waar een klant om heeft gevraagd of die anderzijds tot de verantwoordelijkheid van de gemeente behoren.</documentation>
          <property key="Toelichting" value="Samenwerkingstaken op basis van specifieke samenwerkingsvormen in de integrale veiligheid die afgestemd zijn in samenwerkingsovereenkomsten of convenanten."/>
          <property key="GEMMA type" value="Bedrijfsfunctie laag"/>
          <property key="Object ID" value="31dbd6e5-fae0-46b8-9ccf-d26a8fa91bc1"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Organisatiekeuze" id="id-399c8bb4-b744-44b5-8bad-50e646199efe">
          <documentation>Het kiezen van een aanbieder voor een bepaalde in te kopen dienst of in het geval van een samenwerking het bepalen van de keuze van een organisatie om mee te gaan samenwerken als gevolg van de strategie van Samenwerkingsvorming</documentation>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="399c8bb4-b744-44b5-8bad-50e646199efe"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Klantenservice" id="id-3a00e208-a8bb-48f6-aabd-c9f402bc8df8">
          <documentation>Het verlenen van service aan dienstenafnemers</documentation>
          <property key="Toelichting" value="Bijv. het geven van ondersteuning via telefoon of chat aan burgers om hen te helpen bij het vinden van informatie of het aanvragen van bepaalde producten"/>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="3a00e208-a8bb-48f6-aabd-c9f402bc8df8"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Kaderbewaking" id="id-3aa70633-78cc-4e4f-9a19-defd91f4cdce">
          <documentation>Het bewaken of processen binnen de zelf opgestelde beperkingen worden uitgevoerd.</documentation>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="3aa70633-78cc-4e4f-9a19-defd91f4cdce"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Toezicht en handhaving fysieke leefomgeving" id="id-3d875d2f-8411-4bad-9427-2b6f7d19b014">
          <documentation>Het uitvoeren van toezicht en handhavingstaken in het ruimtelijke domein.</documentation>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="3d875d2f-8411-4bad-9427-2b6f7d19b014"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Inkoop- en contractmanagement" id="id-4230dc51-fbc7-4e12-830d-0b64b3dac5d5">
          <documentation>Het verwerven van middelen en het bewaken van de afspraken hierover met de leverancier.</documentation>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="4230dc51-fbc7-4e12-830d-0b64b3dac5d5"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Opdrachtbewaking" id="id-4a999fff-7bd3-4e1a-880c-4c8222756ff8">
          <documentation>Het bewaken of de door een aanbieder geleverde dienst conform afspraken is.</documentation>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="4a999fff-7bd3-4e1a-880c-4c8222756ff8"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Informering" id="id-524bf2df-191c-48a5-9a60-ab9526a38fb6">
          <documentation>Het geven van algemene of persoonlijke informatie of advies.</documentation>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="524bf2df-191c-48a5-9a60-ab9526a38fb6"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Administratieve ondersteuning" id="id-590b70e6-93f4-41e8-8b02-e42bf9a17127">
          <documentation>Het bieden van ondersteuning bij administratieve taken.</documentation>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="590b70e6-93f4-41e8-8b02-e42bf9a17127"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Verandermanagement" id="id-5bcd12b5-c61b-4112-ac98-18e043a55f6d">
          <documentation>Het bepalen en managen van grotere veranderingen zodat maximaal wordt bijgedragen aan de doelstellingen.</documentation>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="5bcd12b5-c61b-4112-ac98-18e043a55f6d"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Economische ontwikkeling" id="id-61f0d9c9-fa27-4756-b83a-8ffb10eb2f1b">
          <documentation>Het ontwikkelen en implementeren van beleid dat betrekking heeft op economische aspecten.</documentation>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="61f0d9c9-fa27-4756-b83a-8ffb10eb2f1b"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Veiligheidsdata-analyse" id="id-6685751f-9d53-441a-91b7-9de881eb9047">
          <documentation>Het verzamelen, transformeren, combineren, analyseren en visualiseren van veiligheid gerelateerde data.</documentation>
          <property key="Toelichting" value="Data is afkomstig uit meerdere interne en externe, digitale en niet-digitale bronnen. De nadruk ligt op het vergaren van kennis uit grote hoeveelheden gegevens en om specifieke, selectieve informatie. Doel is met name om inzicht te krijgen in waar aandacht nodig is (met bijvoorbeeld campagnes) of om het genereren van signalen. Bij het combineren van gegevensbronnen kunnen data science/bigdata-technieken worden toegepast voor het genereren van informatie."/>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="6685751f-9d53-441a-91b7-9de881eb9047"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Automatiseringsmanagement" id="id-6775c70a-3ad4-46d5-9a07-d9206c5c12b5">
          <documentation>Het ervoor zorgen dat IT-systemen beschikbaar zijn voor de ondersteuning van de informatievoorziening.</documentation>
          <property key="Toelichting" value="Functioneel beheer Het in stand houden en aansturen van de informatievoorziening. Applicatiebeheer Het aanpassen van toepassingsprogrammatuur en gegevensverzamelingen. Gegevensbeheer Het ervoor zorgen dat er kwalitatief hoogwaardige gegevens beschikbaar zijn. Identiteitenbeheer Het beheren en beschikbaar stellen van gegevens van gebruikers en hun autorisaties. Informatiebeveiliging Het borgen van de continuïteit van de informatie en de informatievoorziening en het beperken van de eventuele gevolgen van beveiligingsincidenten tot een acceptabel, vooraf bepaald niveau. IT-infrastructuurbeheer Het in stand houden en beheren van IT-infrastructuur. IT-infrastructuurontwikkeling Het ontwikkelen en aanpassen van IT-infrastructuur. Applicatie-ontwikkeling Het ontwikkelen toepassingsprogrammatuur en gegevensverzamelingen."/>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="6775c70a-3ad4-46d5-9a07-d9206c5c12b5"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Signaalverwerking" id="id-6b35af78-734b-11e5-1099-005056a83192">
          <documentation>Het verwerken van signalen ten aanzien van het betreffende onderwerp</documentation>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="6b35af78-734b-11e5-1099-005056a83192"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Risicomanagement" id="id-6e6bede1-7dd5-491b-a686-2a79f450ecd8">
          <documentation>Het bepalen en bewaken van de risico's waaraan de organisatie wordt blootgesteld.</documentation>
          <property key="Toelichting" value="Dit geldt in het bijzonder ook voor het beheren van veiligheidsrisico's in het veiligheidsdomein."/>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="6e6bede1-7dd5-491b-a686-2a79f450ecd8"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Gegevensmanagement" id="id-6f9c9d87-b7cf-4ddb-b8d6-dd94699df24a">
          <documentation>Het geheel van activiteiten om in de gemeente op het juiste moment over de juiste gegevens van de juiste kwaliteit te beschikken.</documentation>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="6f9c9d87-b7cf-4ddb-b8d6-dd94699df24a"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Casusregievoering sociaal domein" id="id-6ffc6611-e0aa-43a2-85e4-4301cd1bda2f">
          <documentation>Het voeren van Regie op het verbeteren van bijvoorbeeld Burgers en Huishoudens, Jeugd en Kinderen, Ondernemingen/Arbeidsmarkt, Gebied/Wijk, Veiligheid, Omgeving, etc. en het daarvoor nemen van verbeterinitiatieven, door het inzetten en monitoren van interne en externe producten en diensten om een bepaald verbeterdoel te bereiken
Voorstel: Regievoering op casussen die geen voorspelbaar verloop kennen.</documentation>
          <property key="Toelichting" value="Voor processen die een vooraf bekende set van stappen/statussen doorlopen is zaakgericht werken geschikt. Voor meer dynamische, onvoorspelbare, processen is Adaptive Case Management geschikt."/>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="6ffc6611-e0aa-43a2-85e4-4301cd1bda2f"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Opdrachtverstrekking" id="id-6fff6a95-b764-4646-8504-255355e3786f">
          <documentation>Het verstrekken van een opdracht aan een aanbieder voor het leveren van een dienst.</documentation>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="6fff6a95-b764-4646-8504-255355e3786f"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Toezicht en handhaving veiligheidsdomein" id="id-73b339b1-aa26-4282-8556-a497956efd7d">
          <documentation>Het uitvoeren van toezicht en handhaving om te zorgen dat vastgestelde regelgeving wordt nageleefd.</documentation>
          <property key="Toelichting" value="Toezicht en handhaving kan bijv. worden uitgevoerd door BOA's en met behulp van camera's of data-analyse. Te onderscheiden zijn bijv.: * oplegging maatregel * intake signaal normafwijkend gedrag * vaststelling afwijkingscategorie * vaststelling verwijtbaarheid * bepaling recidive * vaststelling maatregel * afhandeling maatregel * effectuering maatregel * oplegging boete."/>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="73b339b1-aa26-4282-8556-a497956efd7d"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Besturing" id="id-73ea4c93-80ec-4454-8c21-f9d2a8945829">
          <documentation>Het inrichten en uitvoeren van de besluitvormingsprocessen en -structuren en het nemen van strategische besluiten.</documentation>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="73ea4c93-80ec-4454-8c21-f9d2a8945829"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Organisatieontwikkeling" id="id-74cb8773-e2db-4235-947e-d7be760a2911">
          <documentation>Het operationaliseren en implementeren van veranderingen in de organisatie.</documentation>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="74cb8773-e2db-4235-947e-d7be760a2911"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Juridische ondersteuning" id="id-79014004-56c3-4d04-8971-9609cb68d5a4">
          <documentation>Het bieden van advies en ondersteuning op het gebied van wet- en regelgeving.</documentation>
          <property key="Toelichting" value="Binnen het domein veiligheid is een belangrijk aspect van de juridische ondersteuning het bepalen wanneer, welke informatie voor welk doel gebruikt mag worden."/>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="79014004-56c3-4d04-8971-9609cb68d5a4"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Verantwoording" id="id-7987f0d4-21f1-4f01-96e5-80d1bb340fcb">
          <documentation>Het rapporteren naar belanghebbenden binnen en buiten de organisatie over de mate waarin wordt voldaan aan verplichtingen en afspraken.</documentation>
          <property key="Toelichting" value="Bijv. in de vorm van jaarlijks op te leveren begrotings- en verantwoordingsstukken conform de Gemeentewet."/>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="7987f0d4-21f1-4f01-96e5-80d1bb340fcb"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Ontwikkeling" id="id-7a3406dc-e226-4696-b547-6376dc48a495">
          <documentation>Verdere invulling geven aan de gewenste verandering. Ontwikkeling heeft betrekking op de inhoudelijke beleidsterreinen van de gemeente. Het behelst het opstellen van de gewenste portfolio van producten en diensten alsook het verder uitwerken van deze producten en diensten voor de verschillende beleidsterreinen van de gemeente. Ook het doorvoeren van de gewenste (organisatie)veranderingen maakt deze uit van deze functie.</documentation>
          <property key="GEMMA type" value="Bedrijfsfunctie laag"/>
          <property key="Object ID" value="7a3406dc-e226-4696-b547-6376dc48a495"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Dienstverlening servicemanagement" id="id-7cae587a-97ba-45b3-b747-ffaef8cb9359">
          <documentation>Het analyseren van de kwantiteit en kwaliteit van dienstverlening ten opzichte van gedefinieerde serviceniveaus en het op basis daarvan ondernemen van actie</documentation>
          <property key="Toelichting" value="Bijv. het vergelijken van gemeten wachttijdcijfers met gedane toegezeggingen in een klantenhandvest en het eventueel treffen van maatregelen bij tekortkomingen"/>
          <property key="Object ID" value="7cae587a-97ba-45b3-b747-ffaef8cb9359"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Ontwikkeling dienstverlening" id="id-7ec194db-fd7a-4e7a-8c80-48467263e5dc">
          <documentation>Het bepalen welke producten en diensten worden geleverd, onder welke voorwaarden dit gebeurt en het doorvoeren hiervan.</documentation>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="7ec194db-fd7a-4e7a-8c80-48467263e5dc"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Fysieke leefomgeving ontwikkeling" id="id-85c56921-70bb-11e4-67ab-0050568a6153">
          <documentation>Het ontwikkelen en implementeren van het beleid op het gebied van de fysieke leefomgeving binnen een gemeente.</documentation>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="85c56921-70bb-11e4-67ab-0050568a6153"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Projectmanagement" id="id-865ba8f5-f53e-41d9-9b75-1f1d57c0b4ea">
          <documentation>Het plannen, beheren en rapporteren van en over projecten.</documentation>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="865ba8f5-f53e-41d9-9b75-1f1d57c0b4ea"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Huisvesting" id="id-877dc781-70bb-11e4-67ab-0050568a6153">
          <documentation>Het verlenen van vastgoedgerelateerde diensten, parkeerdiensten en nutsdiensten (gas, water en licht), de planning daarvan en het onderhoud daarop.</documentation>
          <property key="Toelichting" value="Bijv. via het onderhouden van gebouwen en daarmee verbonden installaties (elektrische en werktuigbouwkundige), het zorgdragen voor de aanwezigheid van gebouwgebonden zaken als water, gas, en elektra en het verzorgen van (interne) verhuizingen. Naast gebouwen zelf behoren hiertoe ook ruimten en stallingen en parkeerplaatsen."/>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="877dc781-70bb-11e4-67ab-0050568a6153"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Casusregievoering veiligheidsdomein" id="id-8edb061b-0372-4a7e-aa54-802ef98fdd54">
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="8edb061b-0372-4a7e-aa54-802ef98fdd54"/>
          <property key="Toelichting" value="Voor processen die een vooraf bekende set van stappen/statussen doorlopen is zaakgericht werken geschikt. Voor meer dynamische, onvoorspelbare, processen is Adaptive Case Management geschikt."/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Performance management" id="id-92d69d15-3694-40d7-8649-d270cb678bf5">
          <documentation>Het bewaken of processen worden uitgevoerd in lijn met de opgestelde doelstellingen (inhoud en proces).</documentation>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="92d69d15-3694-40d7-8649-d270cb678bf5"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Communicatiemanagement" id="id-97a44ed9-572e-44b1-8c16-71ef808839b5">
          <documentation>Het ervoor zorgdragen dat de organisatie zich op de juiste wijze uit naar interne en externe partijen.</documentation>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="97a44ed9-572e-44b1-8c16-71ef808839b5"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Toezicht en handhaving Publieksdiensten" id="id-99058cf3-eda2-4df1-904a-4ab059db3da8">
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="99058cf3-eda2-4df1-904a-4ab059db3da8"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Producten- en dienstenrealisatie fysieke leefomgeving" id="id-9a066e58-f6b8-4761-8159-2f53b2ccf8c7">
          <documentation>Het uitvoeren van activiteiten om producten en diensten te leveren binnen de fysieke leefomgeving.</documentation>
          <property key="Toelichting" value="Bijv. bodembeheer, afvalinzameling, begraafplaatsexploitatie."/>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="9a066e58-f6b8-4761-8159-2f53b2ccf8c7"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Dienstverleningskaders bewaking" id="id-9a45fa00-5301-4520-9249-cd602f5713e3">
          <property key="Object ID" value="9a45fa00-5301-4520-9249-cd602f5713e3"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Exploitatie fysieke leefomgeving" id="id-a4504f6c-e588-45d3-bf6e-8d86515d7696">
          <documentation>Het conform privaatrechtelijke grondslag exploiteren van de gemeentelijke voorzieningen zoals een zwembad, museum, parkeergarage of sportaccommodatie.</documentation>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="a4504f6c-e588-45d3-bf6e-8d86515d7696"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Toezicht en handhaving sociaal domein" id="id-a72dcd9f-a7b7-475d-8a57-00b9bc26a544">
          <documentation>Het uitvoeren van toezicht en handhaving om te zorgen dat vastgestelde regelgeving wordt nageleefd.</documentation>
          <property key="Toelichting" value="Toezicht en handhaving kan bijv. worden uitgevoerd door BOA's en met behulp van camera's of data-analyse. Te onderscheiden zijn bijv.: * oplegging maatregel * intake signaal normafwijkend gedrag * vaststelling afwijkingscategorie * vaststelling verwijtbaarheid * bepaling recidive * vaststelling maatregel * afhandeling maatregel * effectuering maatregel * oplegging boete."/>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="a72dcd9f-a7b7-475d-8a57-00b9bc26a544"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Personeelsmanagement" id="id-a8e19e73-b3ea-4ada-8cc9-71375570ab7f">
          <documentation>Het ervoor zorgdragen dat er competente medewerkers beschikbaar zijn voor de uitvoering van bedrijfsprocessen.</documentation>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="a8e19e73-b3ea-4ada-8cc9-71375570ab7f"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Uitvoering Sociaal Domein" id="id-aa1864da-592b-40a7-b816-e7e76dc4c446">
          <documentation>Het leveren van gemeentelijke producten en diensten die tot het sociaal domein worden gerekend.</documentation>
          <property key="GEMMA type" value="Bedrijfsfunctie domein"/>
          <property key="Object ID" value="aa1864da-592b-40a7-b816-e7e76dc4c446"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Informatie- en archiefbeheer" id="id-aa83e0ca-8ee0-4517-9dbd-2d52bc80abbd">
          <documentation>Het ervoor zorgdragen dat gegevens beschikbaar blijven zodat het handelen van gemeenten publiek verantwoord kan worden.</documentation>
          <property key="Toelichting" value="Bijv. door van belang zijnde informatieobjecten te archiveren en voor daartoe geautoriseerde geautoriseerde medewerkers of externe ter beschikking te stellen. Informatieobjecten kunnen bijv. in- of uitgaande documenten zijn, opgestelde beleidsnotities, genomen besluiten of vergaderverslagen."/>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="aa83e0ca-8ee0-4517-9dbd-2d52bc80abbd"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Ondersteuning" id="id-b276b675-727f-4ce1-bdb2-060ba77abdad">
          <documentation>Het ervoor zorgen dat de juiste mensen en middelen beschikbaar zijn zodat de overige functies uitgevoerd kunnen worden.</documentation>
          <property key="Toelichting" value="Opmerking: de term &quot;bedrijfsvoering&quot; wordt binnen de overheid gebruikt als aanduiding van: * alleen de ondersteunende taken * het gehele takenpakket met zowel primaire als ondersteunende taken. Om misverstanden te voorkomen is voor de domeinbenaming &quot;ondersteuning&quot; (en niet &quot;bedrijfsvoering&quot;) gekozen zodat duidelijk is dat het hierbij uitsluitend over ondersteunende bedrijfsfuncties gaat."/>
          <property key="GEMMA type" value="Bedrijfsfunctie laag"/>
          <property key="Object ID" value="b276b675-727f-4ce1-bdb2-060ba77abdad"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Compliance management" id="id-b9940c7b-b8ff-4ff3-bb17-f0215ffaf189">
          <documentation>Het bewaken of processen worden uitgevoerd in lijn met wet- en regelgeving.</documentation>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="b9940c7b-b8ff-4ff3-bb17-f0215ffaf189"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Vordering sociaal domein" id="id-bd07efbd-a507-4a41-ac3c-16d9372647cf">
          <documentation>Het eisen van teruggave van een (deel van een) bedrag dat ten onrechte is uitgekeerd.</documentation>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="bd07efbd-a507-4a41-ac3c-16d9372647cf"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Beheren fysieke leefomgeving" id="id-bd0d751e-88f7-40c2-a7ce-fe6be1a57348">
          <documentation>Het in stand houden van de gemeentelijke openbare ruimte door vervanging of reparatie.</documentation>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="bd0d751e-88f7-40c2-a7ce-fe6be1a57348"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Producten- en dienstenrealisatie sociaal domein" id="id-bf097fc0-dd3e-403a-945d-efe1994f35d4">
          <documentation>Het uitvoeren van activiteiten om producten en diensten te leveren binnen het Sociaal Domein.</documentation>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="bf097fc0-dd3e-403a-945d-efe1994f35d4"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Beheren openbare orde en veiligheid" id="id-cc78dac1-b643-46f2-9792-fc874c472753">
          <documentation>Het uitvoeren van werkzaamheden om in geval van verstoringen van de openbare orde adequaat op te kunnen treden.</documentation>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="cc78dac1-b643-46f2-9792-fc874c472753"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Invordering publieksdiensten" id="id-da0f339c-bdef-4471-9b3b-fd9a0c662f61">
          <documentation>Het innen van belasting of achteraf vorderen van te weinig betaalde belasting.</documentation>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="da0f339c-bdef-4471-9b3b-fd9a0c662f61"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Veiligheidsmanagement" id="id-dac034e1-b473-45e2-91dd-0c1e2743f631">
          <documentation>Het bewaken dat de organisatie voldoet aan alle aspecten van veiligheid en beveiliging.</documentation>
          <property key="Toelichting" value="Hieronder valt de bewaking/beveiliging van het gebouw en terrein, en tevens het onderhoud, registratie van sloten, de uitgifte van sleutels en het bijhouden hiervan in een sleutelplan. Maar ook de veiligheid van de medewerkers dmv onder andere een Bedrijfshulpverlening organisatie en een calamiteiten- evacuatieplan."/>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="dac034e1-b473-45e2-91dd-0c1e2743f631"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Samenwerkingsbewaking" id="id-dc2b00a2-5552-4796-a9ac-a438af3eb7e3">
          <documentation>Het bewaken of een samenwerkingsverband verloopt conform verwachtingen en afspraken.</documentation>
          <property key="Toelichting" value="Dit geldt specifiek ook voor de samenwerking bij rampenbestrijding waarbij oefeningen en incidenten geëvalueerd en bijgesteld kunnen worden (zie o.a. de bedrijfsfunctie plan- en organisatievorming rampen (koud))."/>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="dc2b00a2-5552-4796-a9ac-a438af3eb7e3"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Uitvoering openbare orde en veiligheid" id="id-de168a10-7030-4026-bd95-298e6a6cb3e2">
          <documentation>Het leveren van gemeentelijke producten en diensten die tot het domein openbare orde en veiligheid worden gerekend.</documentation>
          <property key="GEMMA type" value="Bedrijfsfunctie domein"/>
          <property key="Object ID" value="de168a10-7030-4026-bd95-298e6a6cb3e2"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Strategie" id="id-ee339dfd-51b9-4c27-8a52-c19e39c90cc1">
          <documentation>Het bepalen welke veranderingen zouden moeten worden doorgevoerd en de doelstellingen die daaraan ten grondslag liggen.</documentation>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="ee339dfd-51b9-4c27-8a52-c19e39c90cc1"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Realiseren fysieke leefomgeving" id="id-ef3913d6-4b86-4d4d-8062-36d46e4e4498">
          <documentation>Het beheren van projecten in het ruimtelijke domein gericht op het aanbrengen van wijzigingen in de omgeving.</documentation>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="ef3913d6-4b86-4d4d-8062-36d46e4e4498"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Uitvoering fysieke leefomgeving" id="id-f10ff76e-e4de-4f30-bb1f-81c7cfffb46a">
          <documentation>Het leveren van gemeentelijke producten en diensten die tot het ruimtelijk domein worden gerekend.</documentation>
          <property key="GEMMA type" value="Bedrijfsfunctie domein"/>
          <property key="Object ID" value="f10ff76e-e4de-4f30-bb1f-81c7cfffb46a"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Uitvoering Publieksdiensten" id="id-f54b116c-22f4-4f01-bf6d-997debf536c3">
          <documentation>Het leveren van gemeentelijke producten en diensten die tot het domein publieksdiensten worden gerekend.</documentation>
          <property key="Toelichting" value="Bijv. klachtenafhandeling, subsidiering, burgelijke stand diensten en belastingoplegging."/>
          <property key="GEMMA type" value="Bedrijfsfunctie domein"/>
          <property key="Object ID" value="f54b116c-22f4-4f01-bf6d-997debf536c3"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Verstrekking" id="id-fb0f88df-3b16-4b80-8151-c3da291d02e9">
          <documentation>Het leveren van een product of dienst</documentation>
          <property key="Toelichting" value="Bijv. het verstrekken van een paspoort of het verlenen van een vergunning"/>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="fb0f88df-3b16-4b80-8151-c3da291d02e9"/>
        </element>
      </folder>
      <folder name="Sub(sub)bedrijfsfuncties" id="ea07cf61-9f11-47d7-86bd-698cca04272e">
        <element xsi:type="archimate:BusinessFunction" name="Open data publicatie" id="id-00dff8d3-a50b-4e1a-90e8-241b013f868a">
          <documentation>Het publiceren van gestructureerde en door softwareprogramma's te verwerken gegevens</documentation>
          <property key="Toelichting" value="Bijv. via het beschikbaarstellen van openbare gegevens in de vorm van datasets of API's"/>
          <property key="Object ID" value="00dff8d3-a50b-4e1a-90e8-241b013f868a"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Handhaving" id="id-020f2f8c-d549-4a95-a2a9-56c1b0a43be8">
          <documentation>Het opleggen van een maatregel in het kader van toezicht en handhaving.</documentation>
          <property key="Object ID" value="020f2f8c-d549-4a95-a2a9-56c1b0a43be8"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Projectportfoliobeheer" id="id-03531e90-b79e-4fee-a9de-280697773b2a">
          <documentation>Het managen van een veelheid aan projecten, meestal gemeentebreed, om strategische organisatiedoelen te realiseren.</documentation>
          <property key="Toelichting" value="In tegenstelling tot programmamanagment kan het hier ook niet-gerelateerde projecten betreffen. Doel is om vanuit organisatieperspectief optimale keuzes te maken door de juiste projecten te selecteren, prioriteren en uit te voeren."/>
          <property key="Object ID" value="03531e90-b79e-4fee-a9de-280697773b2a"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Data-analyse, verwerking en visualisatie integrale veiligheid" id="id-03fcfc6d-9616-47ac-9bec-99e172e3d1fd">
          <documentation>Het maken van analyses en het presenteren van de resultaten om overzicht en signalen te verkrijgen op het gebied van de integrale veiligheid.</documentation>
          <property key="Toelichting" value="Dit is een verplichte taak van de gemeente in tegenstelling tot taken op het vlak van georganiseerde criminaliteit."/>
          <property key="Object ID" value="03fcfc6d-9616-47ac-9bec-99e172e3d1fd"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Subsidies publicatie" id="id-05d62660-0888-4ad5-8e3d-32d3f0f764b4">
          <documentation>Het publiceren van verleende subsidies</documentation>
          <property key="Toelichting" value="Bijv. in de vorm van een subsidieregister waarin alle door de gemeente verleende subsidies staan"/>
          <property key="Object ID" value="05d62660-0888-4ad5-8e3d-32d3f0f764b4"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Rampenoefening en opleiding" id="id-05d63eab-10c2-46d2-ae38-08e430f40c17">
          <documentation>Het opleiden, trainen en oefenen van personeel om in geval van rampen adequaat te kunnen handelen.</documentation>
          <property key="Toelichting" value="Hiervoor worden bijv. rampscenarios gemaakt op basis van aanwezige rampenplannen en overeengekomen organisatie bij rampen (zie bedrijfsfunctie 'plan- en organisatievorming rampen (koud)'. Dit gebeurt veelal in samenwerking met betrokken partijen zoals veiligheidsregio's, politie, bedrijven, etc."/>
          <property key="Object ID" value="05d63eab-10c2-46d2-ae38-08e430f40c17"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Bevolkingsadministratie bijhouding" id="id-05ebfe88-2d7a-4093-bb4c-d9371baeb43c">
          <documentation>Het uitvoeren van taken om de Basisregistratie Personen actueel en betrouwbaar te houden</documentation>
          <property key="Toelichting" value="Bijv. het actualiseren van gegevens naar aanleiding van verleende diensten of het onderzoeken van persoons- en/of adres gegevens (bijv. n.a..v terugmeldingen)"/>
          <property key="Object ID" value="05ebfe88-2d7a-4093-bb4c-d9371baeb43c"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Projectbeheer" id="id-07f086d1-e6ca-4142-96d3-4baafa463916">
          <documentation>Het voorbereiden, plannen, uitvoeren en afronden van individuele projecten.</documentation>
          <property key="Object ID" value="07f086d1-e6ca-4142-96d3-4baafa463916"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Uitbetaling" id="id-097409a6-e881-4a0f-a9be-f90e9cb008d7">
          <documentation>Het uitbetalen aan burger en/of bedrijf</documentation>
          <property key="Object ID" value="097409a6-e881-4a0f-a9be-f90e9cb008d7"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Applicatiebeheer" id="id-0a5674fa-2a89-4dce-8599-850146a16d2a">
          <documentation>Het uitvoeren van beheertaken m.b.t. bedrijfsapplicaties en de bijbehorende gegevensverzamelingen.</documentation>
          <property key="Toelichting" value="Bijv. het instellen van bepaalde applicatiefunctionaliteiten en het mede zorg dragen voor correcte updates van de applicatie."/>
          <property key="Object ID" value="0a5674fa-2a89-4dce-8599-850146a16d2a"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Veiligheidsinformatie visualisatie" id="id-0d4793a0-900f-43b0-b408-d0f1b1cadfc4">
          <documentation>Het visualiseren van de resultaten data analyses in de vorm van dashboards, stoplichten, grafieken etc.</documentation>
          <property key="Object ID" value="0d4793a0-900f-43b0-b408-d0f1b1cadfc4"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Verstrekking voorzieningen" id="id-11667caa-f425-4564-b574-1f3c6380c0d3">
          <documentation>Het verstrekken van voorzieningen conform afspraak met de gemeente</documentation>
          <property key="Object ID" value="11667caa-f425-4564-b574-1f3c6380c0d3"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Kabels- en leidingenbeheer" id="id-117db024-9c8d-4ab1-b5ef-cf85b6b2b59c">
          <documentation>Gegevens over kabels en leidingen in de ondergrond beheren in het kader van de WIBON. Het aanleveren van netinformatie volgens het informatiemodel Kabels en Leidingen (IMKL).</documentation>
          <property key="Object ID" value="117db024-9c8d-4ab1-b5ef-cf85b6b2b59c"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Governance inrichting" id="id-11a4c070-7b4f-4ecf-a47b-6574a916319f">
          <documentation>Het inrichten en bewaken van besluitvormingsprocessen en structuren</documentation>
          <property key="Toelichting" value="De governancestructuur bepaalt hoe invloed en zeggenschap zijn verdeeld en besturing en toezicht daarop plaatsvindt. Hierbij spelen raad, college en het ambtelijk apparaat een rol."/>
          <property key="Object ID" value="11a4c070-7b4f-4ecf-a47b-6574a916319f"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Belastinginvordering" id="id-11c7e20b-a0c1-46ef-80a6-1d578c784077">
          <documentation>Het innen van belastingschulden.</documentation>
          <property key="Toelichting" value="In de zogeheten heffingsfase komt de belastingschuld van een belastingplichtige tot stand. In de invorderingsfase wordt die schuld vervolgens van de belastingschuldige geïnd. Na betaling vervalt de belastingschuld. Bij niet-betaling kan de belastingschuld ook tenietgaan in de volgende situaties: * bij verjaring * bij kwijtschelding * bij verrekening. Indien geen verhaalsmogelijkheden aanwezig zijn en binnen afzienbare tijd niet te verwachten zijn, wordt de aanslag oninbaar geleden. Dit betekent echter niet dat de belastingschuld teniet gaat. Als nadat de belastingschuld oninbaar is geleden verhaalsmogelijkheden bekend worden, kan daarop gewoon verhaal worden gehaald. Teruggaven blijven verrekend worden met oninbaar geleden aanslagen, zolang deze nog niet verjaard zijn."/>
          <property key="Object ID" value="11c7e20b-a0c1-46ef-80a6-1d578c784077"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Interne efficiency verbetering" id="id-11d12bb4-d6f9-4459-ad00-abea550fd6de">
          <documentation>Het ontwikkelen en implementeren van beleid om met de intern beschikbare middelen een optimale output te realiseren.</documentation>
          <property key="Object ID" value="11d12bb4-d6f9-4459-ad00-abea550fd6de"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Applicatie-ontwikkeling" id="id-11d5d01b-b29e-4c94-b139-a8787b08d227">
          <documentation>Het ontwikkelen toepassingsprogrammatuur en daarbij benodigde gegevensverzamelingen.</documentation>
          <property key="Toelichting" value="Hierbij kan het gaan om zelfstandige nieuwe applicaties of om het aanpassen of uitbreiden van bestaande applicaties."/>
          <property key="Object ID" value="11d5d01b-b29e-4c94-b139-a8787b08d227"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Lokale regelgeving publicatie" id="id-12462bc1-7ee1-4501-aa0c-acfca71b09b6">
          <documentation>Het informeren over algemeen verbindende voorschriften (vaak verordening genoemd)</documentation>
          <property key="Toelichting" value="Bijv. informatie over de regels rondom bepaalde typen vergunningen of (niet verplicht) bijv. beleidsregels en interne gemeentelijke regelingen."/>
          <property key="Object ID" value="12462bc1-7ee1-4501-aa0c-acfca71b09b6"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Belasting subject- en objectregistratie" id="id-159f234f-0d4d-41af-8583-808e3fc352da">
          <documentation>Het uitvoeren van taken om belastingen- en heffingengerelateerde gegevens actueel en betrouwbaar te houden.</documentation>
          <property key="Toelichting" value="Bijv. het aanmelden en registreren van personen als belastingplichtige."/>
          <property key="Object ID" value="159f234f-0d4d-41af-8583-808e3fc352da"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Horeca vergunningverlening" id="id-173177ab-9277-4146-ad60-24159bb6b974">
          <documentation>Het verlenen van vergunningen voor evenementen.</documentation>
          <property key="Toelichting" value="Omdat hierbij risicos op basis van de locatie, openingstijden, risicoprofiel eigenaar, etc. een rol spelen zijn dit type vergunningen binnen het domein Openbare orde en Veiligheid ondergebracht. Vergunningenbeheer waarbij dit minder of niet het geval is zijn aanwezig binnen de domeinen 'Publieksdiensten' en 'Ruimte'."/>
          <property key="Object ID" value="173177ab-9277-4146-ad60-24159bb6b974"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Klantfeedback verzameling" id="id-18203f60-ba1d-4517-92cc-beeea7032438">
          <documentation>Het verzamelen van feedback van klanten over de kwaliteit van plaatsgevonden dienstverlening</documentation>
          <property key="Toelichting" value="Bijv. door afnemers laten geven van suggesties om dienstverlening te verbeteren"/>
          <property key="Object ID" value="18203f60-ba1d-4517-92cc-beeea7032438"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Subsidieverlening ruimtelijk" id="id-1895941d-7887-4114-af39-3e0eac834e71">
          <documentation>Het subsidiëren van diverse soorten activiteiten met een ruimtelijke component.</documentation>
          <property key="Object ID" value="1895941d-7887-4114-af39-3e0eac834e71"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Output-opmaak" id="id-18dcd496-b6fa-46cc-8aa6-a23c4fcd61b9">
          <documentation>Het formatteren van producten volgens geldende afspraken en/of standaarden; bij digitale dienstverlening zijn 'producten' meestal berichten en/of documenten.</documentation>
          <property key="Toelichting" value="Bijv. het opmaken van documenten in de gemeentelijke huisstijl of het volgens geldende berichtstandaarden transformeren van data naar een elektronisch bericht"/>
          <property key="Object ID" value="18dcd496-b6fa-46cc-8aa6-a23c4fcd61b9"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Kanaal personalisatie" id="id-18eddfba-c49e-4db9-aab1-30efbcb209e7">
          <documentation>Het conform persoonlijke voorkeuren gebruiken van kanalen voor communicatie met een dienstenafnemer</documentation>
          <property key="Toelichting" value="Bijv. door berichten volgens voorkeur te verzenden als sms, email, naar de Berichtenbox of via het MijnGemeente portaal."/>
          <property key="Object ID" value="18eddfba-c49e-4db9-aab1-30efbcb209e7"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Programmabeheer" id="id-1ad99e29-cd78-40d4-9620-55053ccccbc9">
          <documentation>Het managen van een groep gerelateerde projecten.</documentation>
          <property key="Toelichting" value="Waar bij projectbeheer het doel is om een individueel project succesvol af te ronden heeft programmabeheer als doel om optimale eindresultaten te behalen voor het programma waar de projecten onderdeel van zijn."/>
          <property key="Object ID" value="1ad99e29-cd78-40d4-9620-55053ccccbc9"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Vastgoedbeheer" id="id-1af6f4aa-d797-44f5-bfb0-e77229141dfa">
          <documentation>Het verwerven, inrichten, beheren en afstoten van gebouwen.</documentation>
          <property key="Object ID" value="1af6f4aa-d797-44f5-bfb0-e77229141dfa"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Kennismanagement" id="id-1b3a246e-5aec-465a-ad14-68cee1e2c114">
          <documentation>Het beheren, delen en gebruiken van binnen de gemeente aanwezige kennis om deze optimaal te benutten.</documentation>
          <property key="Toelichting" value="Bijv. via het ter beschikking stellen van middelen aan medewerkers om kennis te verzamelen, vast te leggen en te delen. Naast specifieke software hiervoor wordt hierbij steeds meer gebruik gemaakt van &quot;web 2.0 technologie&quot; waarbij medewerkers laagdrempelig kennis kunnen vastleggen, met elkaar delen en reageren op elkaars bijdragen."/>
          <property key="Object ID" value="1b3a246e-5aec-465a-ad14-68cee1e2c114"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Ziekte- en verlofadministratie" id="id-1df27b35-fe09-448a-9a8f-39ffa4f56461">
          <documentation>Het administreren van ziekte en verlof van medewerkers.</documentation>
          <property key="Object ID" value="1df27b35-fe09-448a-9a8f-39ffa4f56461"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Output-verzending" id="id-1eeb4102-dc87-4731-9753-42dad177433a">
          <documentation>Het verzenden van output</documentation>
          <property key="Toelichting" value="Bijv. het verzenden van een papieren brief of een elektronisch bericht via e-mail of in de Berichtenbox @opm: was oorspronkelijk 'documentverzending'; &quot;document&quot; wordt vaak gebruikt als synoniem voor &quot;tekstdocument&quot; terwijl het gaat om output in brede zin"/>
          <property key="Object ID" value="1eeb4102-dc87-4731-9753-42dad177433a"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Balie beheer" id="id-23f462d2-f915-41b6-9708-fbf1f50e1dba">
          <documentation>Het managen van mensen en middelen om dienstverlening via balies te bieden</documentation>
          <property key="Toelichting" value="Bijv. het inrichten van nummersystemen voor het op volgorde bedienen van klanten"/>
          <property key="Object ID" value="23f462d2-f915-41b6-9708-fbf1f50e1dba"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Indiening c.q. wijziging aanvraag" id="id-24c15ba5-f3ca-4daa-b95d-1353241f6dee">
          <documentation>Het indienen respectievelijk wijzigen van een aanvraag.</documentation>
          <property key="Object ID" value="24c15ba5-f3ca-4daa-b95d-1353241f6dee"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Informatiedeling georganiseerde criminaliteit" id="id-265f91aa-04c6-4ecf-9585-71fe1b3897b5">
          <documentation>Het delen van informatie met partners. Hiervoor is een specifieke taak belegd (bijvoorbeeld bij een informatiemanager) ondersteund door juridische ondersteuning. Op bestuurlijk niveau worden er afspraken gemaakt wat er met wie gedeeld mag worden. Dit speelt o.a. bij de bestrijding van georganiseerde criminaliteit en het plannen, oefenen en bestrijden van rampen.</documentation>
          <property key="Object ID" value="265f91aa-04c6-4ecf-9585-71fe1b3897b5"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Klachten afhandeling" id="id-26c556a4-479a-482c-b5f5-357577e87094">
          <documentation>Het behandelen van ingediende klachten</documentation>
          <property key="Toelichting" value="Bijv. klachten over de behandeling door een gemeentelijke werknemer"/>
          <property key="Object ID" value="26c556a4-479a-482c-b5f5-357577e87094"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Vergunningenbeheer evenementen" id="id-27112fc9-9263-4c21-95e5-554e41da8e40">
          <documentation>Het beheren en verlenen van vergunningen voor evenementen.</documentation>
          <property key="Toelichting" value="Omdat hierbij risicos op basis van de locatie, openingstijden, risicoprofiel eigenaar, etc. een rol spelen zijn dit type vergunningen binnen het domein Openbare orde en Veiligheid ondergebracht. Andere domeinen waar andere typen vergunningen worden beheerd zijn de domeinen 'Publieksdiensten' en 'Ruimte'."/>
          <property key="Object ID" value="27112fc9-9263-4c21-95e5-554e41da8e40"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Burgerinitiatieven facilitering" id="id-27250af5-c8bc-4167-a743-9b1c6d6edef6">
          <documentation>Het faciliteren van bekendheid en eventuele deelname aan burgerinitiatieven</documentation>
          <property key="Toelichting" value="Bijv. via het publiceren van bestaande burgerinitiatieven en het bieden van de gelegeneid tot feedback of deelname"/>
          <property key="Object ID" value="27250af5-c8bc-4167-a743-9b1c6d6edef6"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Salaris- en declaratieverwerking" id="id-2d2da56f-e363-4ca5-a969-2860f78aaaef">
          <documentation>Het berekenen en uitkeren van het salaris en verwerken van declaraties van medewerkers.</documentation>
          <property key="Object ID" value="2d2da56f-e363-4ca5-a969-2860f78aaaef"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Begroting en verantwoording" id="id-2da09d66-c2f2-44be-9d47-084c3dbd3142">
          <documentation>Het jaarlijks afleggen van verantwoording conform de Gemeentewet.</documentation>
          <property key="Toelichting" value="Verantwoording kan bijv. worden afgelegd via tussentijdse rapportages of via conform de Gemeentewet op te stellen begroting, meerjarenraming, jaarrekening en jaarverslag."/>
          <property key="Object ID" value="2da09d66-c2f2-44be-9d47-084c3dbd3142"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Besluitvorming lokale integrale veiligheid" id="id-2e2d731d-4655-4384-ad27-485d34f95fea">
          <documentation>Het besluiten over de manier waarop veiligheid binnen de lokale omgeving integraal kan worden bevorderd.</documentation>
          <property key="Toelichting" value="Er is een relatie met de besluitvorming voor de regionale integrale veiligheid. Deze vindt plaats in het samenwerkingsverband met de partners in de regionale veiligheid binnen de bedrijfsfunctie besluitvorming regionale integrale veiligheid. Daaruit voortvloeiende operationele planvorming valt onder de bedrijfsfuncties in openbare orde en veiligheidontwikkeling."/>
          <property key="Object ID" value="2e2d731d-4655-4384-ad27-485d34f95fea"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Duurzaam bewaren en beheren van informatieobjecten" id="id-2ecaafc1-116b-4b79-ab16-e95280d4cca8">
          <documentation>Het opslaan van informatieobjecten en het beheren van wat zich in de opslag bevindt zodanig dat deze duurzaam toegankelijk blijft.</documentation>
          <property key="Toelichting" value="Om duurzame toegankelijkheid te borgen horen hier dus preserveringsmaatregelen bij om dreigend verlies van toegankelijkheid te voorkomen. Naast de voor deze hoofdfunctie relevante OAIS-functie Preservation planning, zijn in deze hoofdfunctie ook de OAIS-functies Archival Storage, Data Management en een deel van Administration gebundeld."/>
          <property key="Object ID" value="2ecaafc1-116b-4b79-ab16-e95280d4cca8"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Afrekening" id="id-2f045ed6-9deb-4ba6-9407-a9ab79e2bae6">
          <documentation>Het afrekenen van afgenomen producten of diensten, bijbehorende leges of andere verschuldigde bedragen</documentation>
          <property key="Toelichting" value="Bijv. het online betalen voor een aangevraagd paspoort"/>
          <property key="Object ID" value="2f045ed6-9deb-4ba6-9407-a9ab79e2bae6"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Intern afvalbeheer" id="id-2fe9032b-9238-4628-a592-ad8dbb21ad1d">
          <documentation>Het ophalen en afvoeren van afval.</documentation>
          <property key="Object ID" value="2fe9032b-9238-4628-a592-ad8dbb21ad1d"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Algemeen beheer duurzame opslag informatieobjecten" id="id-30332e6d-7cbc-4835-880b-6b104a9d1d34">
          <documentation>Het beheren van de gebruikte systeemomgeving zodanig dat verantwoorde duurzame opslag is geborgd.</documentation>
          <property key="Toelichting" value="Nodig zijn o.a. het documenteren en beheren van: * inrichtingsinformatie * toegangsbeheer * digitale koppelingen en het monitoren van: * ontwikkelingen rondom bestandsformaten * gebruikersbehoeften * functioneren van de voorziening."/>
          <property key="Object ID" value="30332e6d-7cbc-4835-880b-6b104a9d1d34"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Exploiteren van begraafplaatsen" id="id-30deba14-c60a-49b2-b6d2-740a6d2539f5">
          <documentation>Het exploiteren van begraafplaatsen, inclusief ondersteunende diensten die bij het uitvoeren van een begrafenis verzorgd worden.</documentation>
          <property key="Toelichting" value="Bijv. het uitgeven van grafrechten en verlenen van vergunningen voor plaatsen van grafstenen. BIj het verzorgen van diensten bij begrafenissen valt te denken aan: het graven van een graf, voorlopen, diverse diensten in de Aula e.d."/>
          <property key="Object ID" value="30deba14-c60a-49b2-b6d2-740a6d2539f5"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Besluitvormings verantwoording" id="id-33aee737-2990-4504-969c-360616e5c135">
          <documentation>Het bieden van inzicht in plaatsgevonden processen en het democratisch tot stand komen van genomen besluiten.</documentation>
          <property key="Toelichting" value="Bijv. door vergaderingen uit te zenden en inzicht te geven in stemgedrag van fracties en raadsleden."/>
          <property key="Object ID" value="33aee737-2990-4504-969c-360616e5c135"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Officiële documenten verstrekking" id="id-3668255a-275b-4c9a-9b61-f4a475600ed0">
          <documentation>Het op aanvraag verstrekken van persoonlijke documenten zoals paspoort of rijbewijs</documentation>
          <property key="Toelichting" value="Bijv. rijbewijzen, identiteitsbewijzen en reisdocumenten"/>
          <property key="Object ID" value="3668255a-275b-4c9a-9b61-f4a475600ed0"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Budgetbeheer" id="id-3850d422-6dce-11e5-1099-005056a83192">
          <documentation>Preventie en nazorg na schuldbemiddeling</documentation>
          <property key="Object ID" value="3850d422-6dce-11e5-1099-005056a83192"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Schuldhulpverlening" id="id-3850d427-6dce-11e5-1099-005056a83192">
          <documentation>Schuldhulpverlening minnelijke regeling Schuldhulpverlening WSNP</documentation>
          <property key="Object ID" value="3850d427-6dce-11e5-1099-005056a83192"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Lokale bekendmakingen publicatie" id="id-3921d4fb-1a96-4933-92ee-105a231bd21d">
          <documentation>Het informeren over lokale bekendmakingen</documentation>
          <property key="Toelichting" value="Bijv. lokale bekendmakingen zoals beschikkingen waarbij er sprake is van mogelijk belang van derden maar ook bijv. gewijzigde openingstijden die voor burgers interessant kunnen zijn"/>
          <property key="Object ID" value="3921d4fb-1a96-4933-92ee-105a231bd21d"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Vertrouwelijke informering" id="id-3a0222d6-512e-40d7-99b0-6e2f96f210ba">
          <documentation>Het informeren over vertrouwelijke zaken waarbij bekend moet zijn wie de afnemer is en of hij/zij recht heeft op de informatie</documentation>
          <property key="Toelichting" value="Bijv. het tonen van de eigen gegevens zoals bekend in de BRP of het tonen van de status van eigen zaken die bij de gemeente in behandeling zijn"/>
          <property key="Object ID" value="3a0222d6-512e-40d7-99b0-6e2f96f210ba"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Onderscheidingen beheer" id="id-3a6aaf3c-029e-43ad-9802-2f797de0b5b4">
          <documentation>Het voordragen en toekennen van onderscheidingen</documentation>
          <property key="Toelichting" value="Bijv. het verlenen van koninklijke onderscheidingen of kinderlintjes"/>
          <property key="Object ID" value="3a6aaf3c-029e-43ad-9802-2f797de0b5b4"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Vraag-antwoord dialoog ondersteuning" id="id-3abbee9d-c9f0-49d6-b638-d55a097b423f">
          <property key="Object ID" value="3abbee9d-c9f0-49d6-b638-d55a097b423f"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Zelfredzaamheidstimulering" id="id-3bde9bd1-5dd5-11e5-1099-005056a83192">
          <documentation>Het ondersteunen van de zelfredzaamheidsontwikkeling van burgers</documentation>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="3bde9bd1-5dd5-11e5-1099-005056a83192"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Bestelling" id="id-3c0ab1b3-5beb-4699-a25f-66445d2963c4">
          <documentation>Het bestellen van een bepaald type goederen of diensten bij een leverancier.</documentation>
          <property key="Object ID" value="3c0ab1b3-5beb-4699-a25f-66445d2963c4"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Besluitvorming regionale integrale veiligheid" id="id-3c60c88a-2856-422c-90b9-dd66870385d7">
          <documentation>Bestuurlijke besluitvorming voor de bevordering van de regionale veiligheid in samenwerkingsverband met regionale partners.</documentation>
          <property key="Toelichting" value="Dit vindt plaats conform de afspraken die gemaakt zijn binnen de bedrijfsfunctie samenwerkingsafspraken partners integrale veiligheid. Besluitvorming vindt plaats tussen de partners op bestuurlijk niveau. De besluitvorming voor de lokale integrale veiligheid vindt plaats binnen de gemeente in de bedrijfsfunctie Besluitvorming lokale integrale veiligheid. De operationele planvorming valt onder de bedrijfsfuncties in openbare orde en veiligheidontwikkeling."/>
          <property key="Object ID" value="3c60c88a-2856-422c-90b9-dd66870385d7"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="BAG Beheer" id="id-3c6baa05c6904cfbba03880e2e4c5cd6">
          <documentation>Beheren van gegevens ten behoeve van adressen en gebouwen.</documentation>
          <property key="Object ID" value="8a571cb5-5e22-4fce-b691-0d6b8ce60739"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Data-analyse, verwerking en visualisatie criminaliteit" id="id-3c7d1735-2ea4-4636-bc48-efaa0fb05bf3">
          <documentation>Het maken van analyses en het presenteren van de resultaten om overzicht en signalen te verkrijgen op het gebied van de bestrijding van georganiseerde criminaliteit.</documentation>
          <property key="Toelichting" value="Dit is een geen taak van de gemeente in tegenstelling tot taken op het vlak van integrale veiligheid."/>
          <property key="Object ID" value="3c7d1735-2ea4-4636-bc48-efaa0fb05bf3"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Exploiteren van accommodaties" id="id-3d9e85b8-7b5f-41e4-b1ce-08e06ce9e580">
          <documentation>Het conform privaatrechtelijke grondslag exploiteren van gemeentelijke accommodaties. Accommodaties zijn gebouwen of terreinen die ingezet worden voor maatschappelijk nut (wijkgebouw, zwembad, evenemententerrein).</documentation>
          <property key="Toelichting" value="Bijv. een zwembad, museum, sportaccommodatie, wijkgebouw of evenemententerrein."/>
          <property key="Object ID" value="3d9e85b8-7b5f-41e4-b1ce-08e06ce9e580"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Contractbeheer" id="id-3eef0007-c73a-45ed-879d-ac6be8d7e114">
          <documentation>Het tot stand brengen en bewaken van contracten met leveranciers.</documentation>
          <property key="Toelichting" value="Bijv. om te zorgen dat tijdig actie wordt ondernomen om contract op te zeggen voordat er automatisch verlening plaatsvindt."/>
          <property key="Object ID" value="3eef0007-c73a-45ed-879d-ac6be8d7e114"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Economische acquisitie en accountmanagement" id="id-41207f99-f392-4518-b3e7-780ccb8df3b0">
          <documentation>Het acquireren en optimaliseren van de relatie bij en met ondernemers</documentation>
          <property key="Toelichting" value="Bijv. het doen van koude of warme acquisitie richting bedrijven"/>
          <property key="Object ID" value="41207f99-f392-4518-b3e7-780ccb8df3b0"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Medewerkerbeoordeling" id="id-41fdbd58-6c76-4979-8cfd-457bcc64e964">
          <documentation>Het beoordelen van de prestaties van medewerkers en het nemen van passende maatregelen.</documentation>
          <property key="Toelichting" value="Maatregelen kunnen bijv. zijn belonen, promoveren, ontslaan of demoveren."/>
          <property key="Object ID" value="41fdbd58-6c76-4979-8cfd-457bcc64e964"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Identiteitvaststelling" id="id-4222a2f5-7cf1-4887-9272-ced628765ccf">
          <documentation>Vaststellen van de identiteit van de persoon. Op basis van DIGID, geldig paspoort of Id bewijs. Resultaat een geïdentificeerd persoon.
NIEUW: Vaststellen van de identiteit van de dienstenaanvrager</documentation>
          <property key="Toelichting" value="Afhankelijk van de verzender wordt de identiteit via een andere methode vastgesteld. Bij een inwoner bijv. via DigiD, bij een ondernemer via eHerkenning en bij een device bijv. via een certificaatcontrole."/>
          <property key="Object ID" value="4222a2f5-7cf1-4887-9272-ced628765ccf"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Openbare informering" id="id-4240888f-8b62-45b3-9dcc-aca35a71e2a6">
          <documentation>Het voor iedereen toegankelijk openbaar informeren</documentation>
          <property key="Toelichting" value="Bijv. het publiceren van informatie op gemeentelijke website of via social media"/>
          <property key="Object ID" value="4240888f-8b62-45b3-9dcc-aca35a71e2a6"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Aanmaken c.q. wijzigen klantafspraak" id="id-42464b2b-6318-443b-9f4b-bbd863cc5601">
          <documentation>Maken van een afspraak tussen klant en professional op een locatie met een bepaald doel.</documentation>
          <property key="Object ID" value="42464b2b-6318-443b-9f4b-bbd863cc5601"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Grootboekbeheer" id="id-4266ce67-6f7b-44d3-a461-1530ee2cdb12">
          <documentation>Het beheren van de balans van de organisatie.</documentation>
          <property key="Object ID" value="4266ce67-6f7b-44d3-a461-1530ee2cdb12"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Dienstverlening serviceniveau meting" id="id-42b3855a-1053-47ec-9229-d13bb1c536ec">
          <documentation>Het meten en analyseren van de kwantiteit en kwaliteit van diensten ten opzichte van gedefinieerde service-levels</documentation>
          <property key="Toelichting" value="Bijv. het meten van wachttijden of het tellen van het aantal dienstverlening gerelateerde klachten"/>
          <property key="Object ID" value="42b3855a-1053-47ec-9229-d13bb1c536ec"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Informatieobjecten publicatie" id="id-42d32f1f-d1fe-4fb0-acff-2ff8f6bf132b">
          <documentation>Het actief aan het publiek beschikbaarstellen van informatieobjecten</documentation>
          <property key="Toelichting" value="Bijv. door via zelf in te geven zoekcriteria objecten te kunnen opvragen en evt. te downloaden"/>
          <property key="Object ID" value="42d32f1f-d1fe-4fb0-acff-2ff8f6bf132b"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Identiteitenbeheer" id="id-4344e524-e01f-4f17-aacb-ac3999f5ded8">
          <documentation>Het beheren en beschikbaar stellen van gegevens van gebruikers van IT-voorzieningen en hun autorisaties.</documentation>
          <property key="Toelichting" value="Autorisaties kunnen via verschillende mechanismen worden toegekend. Bijv. op basis van afdeling, functie, rol, etc."/>
          <property key="Object ID" value="4344e524-e01f-4f17-aacb-ac3999f5ded8"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Signalen detectie en ontvangst" id="id-452ef605-2ef2-4742-a647-09e42a0df2ff">
          <documentation>Het actief detecteren en ontvangen van signalen</documentation>
          <property key="Toelichting" value="Signalen kunnen afkomstig zijn van mensen of dingen in allerlei formaten"/>
          <property key="Object ID" value="452ef605-2ef2-4742-a647-09e42a0df2ff"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Casus Evaluatie" id="id-46decd56-db61-4fd7-aa7e-d474182d9dc5">
          <documentation>Evaluatie van resultaten, tussentijds en bij beëindiging.</documentation>
          <property key="Toelichting" value="Afhankelijk van de bevindingen kan bijstelling van (deel)plan(nen) plaatsvinden."/>
          <property key="Object ID" value="46decd56-db61-4fd7-aa7e-d474182d9dc5"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Medewerkerontwikkeling" id="id-47c86282-4fce-4b77-96c5-3cc61271d724">
          <documentation>Het actief stimuleren en begeleiden van kennis- en vaardighedenontwikkeling van medewerkers.</documentation>
          <property key="Object ID" value="47c86282-4fce-4b77-96c5-3cc61271d724"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Kwijtschelding" id="id-482e7775-7521-45a8-b195-2ee9ca0dbdd8">
          <documentation>Het vrijwillig prijsgeven van een vordering op iemand.</documentation>
          <property key="Toelichting" value="Vaak is de reden van kwijtschelding dat dat het met deze (rechts)persoon financieel zo slecht gaat, dat het bijna zeker is dat deze toch niet zal betalen. Er kan bijv. kwijtschelding van gemeentelijke belastingen plaats vinden voor ingezetenen onder een bepaalde inkomens- en vermogensgrens (vaak de bijstandsnorm)."/>
          <property key="Object ID" value="482e7775-7521-45a8-b195-2ee9ca0dbdd8"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Leveranciersbeheer" id="id-4ab8bcd5-c298-4a6c-ab56-b14c7b4a80d8">
          <documentation>Het verwerven, beheren en monitoren van leveranciers.</documentation>
          <property key="Object ID" value="4ab8bcd5-c298-4a6c-ab56-b14c7b4a80d8"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Nederlanderschap diensten" id="id-4c27c433-eded-46a9-bef1-002b82759ca9">
          <documentation>Het behandelen van aanvragen van de Nederlandse nationaliteit of het verkrijgen van bewijs daarvan</documentation>
          <property key="Toelichting" value="Bijv. het beoordelen of iemand in aanmerking komt voor naturalisatieprocedure of optieprocedure en het in gang zetten daarvan"/>
          <property key="Object ID" value="4c27c433-eded-46a9-bef1-002b82759ca9"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Ontsluiten van informatieobjecten" id="id-4e552d04-b19c-4f89-a822-13a5563329be">
          <documentation>Het ontsluiten van in opslag zijnde informatieobjecten in de vorm van reproducties voor verschillende vormen van gebruik.</documentation>
          <property key="Toelichting" value="Opgeslagen objecten moeten vindbaar, beschikbaar en toegankelijk zijn voor gebruik. Gebruik kan weergave of reproductie van informatieobjecten betreffen, door ambtenaren of burgers. Ontsluiten is ook nodig voor beheerdoelen zoals het overdragen van objecten voor opslag in een andere voorziening. Gezien vanuit gebruikers zal de functie voor het ontsluiten van informatieobjecten vaak door verschillende applicatiecomponenten worden ingevuld. Zoekvraag en opvraagvraag zullen vaak via een ander systeem worden gedaan dat vervolgens communiceert met de component die zorgt voor ontsluiting van informatieobjecten waarbij rekening wordt gehouden met geldende authenticatie- en autorisatieeisen."/>
          <property key="Object ID" value="4e552d04-b19c-4f89-a822-13a5563329be"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Naheffing en navordering" id="id-4f8fe4ad-a076-4302-90e7-c7d81f424fc1">
          <documentation>Het achteraf vorderen van te weinig betaalde belasting.</documentation>
          <property key="Toelichting" value="Navorderen gebeurt alleen bij aanslagbelastingen, dit kan in beginsel alleen indien sprake is van kwade trouw. Naheffen is alleen mogelijk bij alleen bij afdrachts- en voldoeningsbelastingen. Het mag slechts plaatsvinden onder bepaalde stringente voorwaarden. In het algemeen is een boven water komen van een nieuw feit vereist, waarvan de belastingplichtige wist of behoorde te weten dat dit tot een hogere belasting leidt. Dit is meestal het geval bij frauduleuze handelingen."/>
          <property key="Object ID" value="4f8fe4ad-a076-4302-90e7-c7d81f424fc1"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Strategische planning" id="id-50254e73-38ed-4801-8417-7fc5407612dc">
          <documentation>Het ontwikkelen van een strategische visie en het vertalen ervan naar meerjarendoelstellingen, uitgangspunten en een strategisch plan voor de gemeente.</documentation>
          <property key="Toelichting" value="De gemeenteraad bepaalt het gemeentelijk beleid op hoofdlijnen, het gemeentebestuur bepaalt de strategie hoe landelijke wetten en besluiten van de gemeenteraad het beste kunnen worden uitgevoerd."/>
          <property key="Object ID" value="50254e73-38ed-4801-8417-7fc5407612dc"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Medewerkeradministratie" id="id-51a9e46b-44da-46ea-8bf5-ded9a19e6717">
          <documentation>Het administreren van gegevens van medewerkers.</documentation>
          <property key="Toelichting" value="Bijv. naam-, functie- en salarisgegevens."/>
          <property key="Object ID" value="51a9e46b-44da-46ea-8bf5-ded9a19e6717"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Tijdregistratie" id="id-55d4bd65-900c-4790-acd2-5cd3da36e8e6">
          <documentation>Het registreren van de hoeveelheid en het doel waar tijd van medewerkers aan is besteed.</documentation>
          <property key="Toelichting" value="Doel kan bijv. zijn om de fysieke aanwezigheid van medewerkers of de inzet op verschillende projecten te meten."/>
          <property key="Object ID" value="55d4bd65-900c-4790-acd2-5cd3da36e8e6"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Onderhouden van sociale netwerken" id="id-5622f991-bcfa-413e-8df4-8213dcd54241">
          <documentation>Het onderhouden van relaties in bestaande sociale netwerken van personen en organisaties met als doel het bevorderen van openbare orde en veiligheid. Dit omvat onder andere het voeren van preventieve, persoonlijke gesprekken en het onderhouden van relaties met lokale, sociale organisaties.</documentation>
          <property key="Object ID" value="5622f991-bcfa-413e-8df4-8213dcd54241"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Preventief beheer" id="id-598af611ab754fc4942541d611e5317c">
          <documentation>Planmatig beheer van de fysieke objecten</documentation>
          <property key="Object ID" value="ef9f1e0a-d8f6-4e30-8c3d-fe1de0c3a947"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Kennis beschikbaarstelling" id="id-599d85e3-2d69-4723-a8d3-f498b36c30d1">
          <documentation>Het delen van informatie en kennis met dienstafnemers voor het vergroten van zelfredzaamheid</documentation>
          <property key="Toelichting" value="Bijv. via Frequently Asked Questions of een Kennisbank voorziening"/>
          <property key="Object ID" value="599d85e3-2d69-4723-a8d3-f498b36c30d1"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Plan- en organisatievorming rampen (koud)" id="id-59cbdc1c-deda-423c-8e9c-fc91259d7c8e">
          <documentation>Het maken, toetsen en actualiseren van plannen en de organisatie voor het handelen in het geval van rampen.</documentation>
          <property key="Toelichting" value="Veel van deze taken worden in samenwerkingsverband met de veiligheidsregio's uitgevoerd, denk aan met maken van (regionale) crisisplannen, calamiteitenplannen, aanvalsplannen, etc. Ervaringen uit oefeningen (bedrijfsfunctie oefening en opleiding rampen) en uit evaluaties (bedrijfsfunctie samenwerkingsbewaking) worden gebruikt om de plannen aan te scherpen. Opmerking: de term koud komt uit het domein van de veiligheidsregios en betreft het voorbereiden op rampen in tegenstelling tot het daadwerkelijk bestrijden van rampen die met de term warm wordt aangeduid."/>
          <property key="Object ID" value="59cbdc1c-deda-423c-8e9c-fc91259d7c8e"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Juridische advisering" id="id-5a04d7bd-438c-4d7d-a6fa-c33bb3307f30">
          <documentation>Het geven van juridisch advies.</documentation>
          <property key="Object ID" value="5a04d7bd-438c-4d7d-a6fa-c33bb3307f30"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Samenwerkingsvorming Omgevingsagenda" id="id-5a5c8a9055cd4eaba9b08ce610520d88">
          <documentation>De Omgevingsagenda is de basis voor de samenwerking tussen Rijk en regio bij opgaven in de fysieke leefomgeving. Het doel van de Omgevingsagenda is om als overheden samen gebiedsgericht (dus met het gebied als uitgangspunt) uitwerking te geven aan de gedeelde ambities en opgaven.</documentation>
          <property key="Object ID" value="86651a78-471d-49eb-b55a-0357cda61b5c"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Gegevensanalyse" id="id-5a9d0c615bfc4a6694303792b133c391">
          <documentation>Het verzamelen, transformeren, combineren, analyseren en visualiseren van gerelateerde data.</documentation>
          <property key="Object ID" value="5c61dfc2-ed6c-4d48-a81c-815a8ca47e14"/>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Toelichting" value="Data is afkomstig uit meerdere interne en externe, digitale en niet-digitale bronnen. De nadruk ligt op het vergaren van kennis uit grote hoeveelheden gegevens en om specifieke, selectieve informatie. Doel is met name om inzicht te krijgen in waar aandacht nodig is (met bijvoorbeeld campagnes) of om het genereren van signalen. Bij het combineren van gegevensbronnen kunnen data science/bigdata-technieken worden toegepast voor het genereren van informatie."/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Preventiecampagnes" id="id-5b473459-254e-4891-b43c-39b448267f52">
          <documentation>Het voeren van campagnes gericht op burgers en organisaties met als doel het bevorderen van de veiligheid (bijvoorbeeld inbraakpreventie campagnes en het ondersteunen lokale burgerinitiatieven).</documentation>
          <property key="Object ID" value="5b473459-254e-4891-b43c-39b448267f52"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Winkels, markt- en straathandel beheer" id="id-5c098c43-1d67-4848-bc56-fe53311e569f">
          <documentation>Het beheren van winkels, markten en verkoopactiviteiten op straat</documentation>
          <property key="Toelichting" value="Bijv. het registreren en verlenen van vergunningen"/>
          <property key="Object ID" value="5c098c43-1d67-4848-bc56-fe53311e569f"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Afronden procedures WRO-plannen" id="id-5c59d1e0-02a9-430a-87d8-2f61deabf72c">
          <documentation>Beheren van WRO-plannen in de ruimtelijke omgeving (waaronder bestemmingsplannen).</documentation>
          <property key="Toelichting" value="Hieronder valt het beheren van alle vormen van plannen die in de ruimtelijke ordening ontwikkeld worden. Naast bestemmingsplannen valt hierbij te denken aan structuurvisies, welstandsnota's of stedebouwkundige visies."/>
          <property key="Object ID" value="5c59d1e0-02a9-430a-87d8-2f61deabf72c"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="BRO Beheer" id="id-5db8b459c11c43ff89b962ddff05b036">
          <documentation>Beheren van gegevens ten behoeve van bodem en ondergrond.</documentation>
          <property key="Object ID" value="507af102-5a30-4fae-895a-08be68b24d80"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Ontwikkeling realisatiebeleid fysieke leefomgeving" id="id-5e62786ef1f4433dac9f176bc0e67cbf">
          <documentation>Het uitwerken van ruimtelijke kaders vastgelegd in realisatiebeleid fysieke leefomgeving voor het ambtsgebied van de gemeente.</documentation>
          <property key="Object ID" value="1f0902fb-536c-44ee-b6b1-7713fef759fc"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Gemeentelijke eigendommenbeheer" id="id-613a3b32-a305-4207-a6e2-b209d551d3c8">
          <documentation>Het beheren van gemeentelijke eigendommen waaronder vastgoed en percelen.</documentation>
          <property key="Toelichting" value="Bijv. het ondersteunen van aan- en verkoop en het opleggen van leges, huur en pacht."/>
          <property key="Object ID" value="613a3b32-a305-4207-a6e2-b209d551d3c8"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Kredietverstrekking" id="id-6690f193-6dc8-11e5-1099-005056a83192">
          <documentation>Het verstrekken van kredieten.</documentation>
          <property key="Object ID" value="6690f193-6dc8-11e5-1099-005056a83192"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Persoonsgegevens gebruik informering" id="id-675778d4-5ad6-4ece-a5b0-c3d9be18e48c">
          <documentation>Het informeren over waar en met welk doel persoonlijke gegevens zijn geregistreerd en wanneer en waarvoor deze zijn gebruikt binnen de gemeente</documentation>
          <property key="Toelichting" value="Bijv. via een overzicht van alle registraties waar de persoon bekend is en het tonen van logging-gegevens over gebruik daarvan"/>
          <property key="Object ID" value="675778d4-5ad6-4ece-a5b0-c3d9be18e48c"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Verloren en gevonden voorwerpen beheer" id="id-67ae19e3-1096-4117-ac17-b3dbbb886ede">
          <documentation>Het beheren van gevonden en verloren voorwerpen</documentation>
          <property key="Toelichting" value="Bijv. door de rechtmatige eigenaar een verloren voorwerp te verstrekken"/>
          <property key="Object ID" value="67ae19e3-1096-4117-ac17-b3dbbb886ede"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Casus Monitoring" id="id-69866809-8abe-44fc-9655-c30a9312107a">
          <documentation>Monitoring van deelplannen uitvoering op voortgang en resultaten.</documentation>
          <property key="Toelichting" value="Monitoring moet inzicht geven in de voortgang en effecten in relatie tot gestelde doelen."/>
          <property key="Object ID" value="69866809-8abe-44fc-9655-c30a9312107a"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Documentcreatie" id="id-6a9cc332-7ab4-4e9d-93f0-fb052c97fd85">
          <documentation>Beschrijving: Het creëren van documenten
NIEUW: Het creëren van producten</documentation>
          <property key="Toelichting" value="Bijv. het geautomatiseerd aanmaken van aanslagen"/>
          <property key="Object ID" value="6a9cc332-7ab4-4e9d-93f0-fb052c97fd85"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Gepersonaliseerde informering" id="id-6aa54059-9d14-4539-988a-c6be06a22fa3">
          <documentation>Het informeren conform de doorgegeven voorkeuren van informatieafnemers</documentation>
          <property key="Object ID" value="6aa54059-9d14-4539-988a-c6be06a22fa3"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Bezwaar- en beroepafhandeling" id="id-6b35af73-734b-11e5-1099-005056a83192">
          <documentation>De behandeling van bezwaren en beroepen van burgers en/of bedrijven</documentation>
          <property key="Object ID" value="6b35af73-734b-11e5-1099-005056a83192"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Besluitvorming levensonderhoud" id="id-6b35af7f-734b-11e5-1099-005056a83192">
          <documentation>* Vaststelling Voorliggende Voorziening, Het bepalen of er sprake is van een voorliggende voorziening welke de aanvrager te gelde moet maken. De voorliggende voorziening is van invloed op het recht of de hoogte en mogelijk de duur van de uitkering Levensonderhoud. 
* Vaststelling Relatie, Het bepalen van de voor de duur en hoogte van het recht op of verhaalbaarheid van een uitkering levensonderhoud relevante relaties die een persoon heeft. 
* Vaststelling Vermogen, Het bepalen van de som van bezittingen en schulden. 
* Vaststelling Bijstandsvorm, Het bepalen van de vorm (geldlening, krediethypotheek, voorschot, gift) waarin de bijstand wordt verleend. Er wordt altijd een tegenprestatie verlangd voor de Levensonderhoud uitkering, deze hoeft echter niet  van financiële aard te zijn. 
* Validering Adres, Het vergelijken van de door een persoon opgegeven adresgegevens  versus het GBA(V). Geldt ook voor woonadreshistorie. 
* Vaststelling Uitsluitingsgronden, Het bepalen of de wettelijke uitsluitingsgronden op de aanvrager van de levensonderhoud-uitkering van toepassing zijn. Uitsluitingsgronden als genoemd in Artikel 13 
* Vaststelling Woonsituatie en leefsituatie, Het bepalen of er sprake is van zelfstandige bewoning, een huurvorm of een eigendomsvorm om vast te stellen of er sprake is van kostendelers. Als er sprake is van eigendom, dan start het onderzoek naar vestiging van een krediethypotheek. De opgegeven adresgegevens inclusief inwonenden worden afgezet tegen de gegevens uit het GBA(-V)  en een tabel met adressen van woon-zorgcomplexen, bejaardentehuizen e.d.  
* Vaststelling Risicoprofiel, Het vergelijken van de aanvraag gegevens met bepaalde risicometrieken en -profielen om het risico op fraude of onjuiste dienstverlening te bepalen. 
* Bepaling Individuele Verplichtingen/Ontheffingen, Het onderzoeken en bepalen van individuele verplichtingen of ontheffingen van de algemeen geldende verplichtingen voor het verkrijgen en behouden van een uitkering voor levensonderhoud.  
* Beslissing Levensonderhoud, Het nemen van een besluit over het recht, de hoogte en duur inzake een aanvraag of wijziging van een bijstandsuitkering, inclusief motivering en berekening. 
* Vaststelling Verblijfstitel, Het vaststellen van de verblijfstitel van de voor het bepalen van het recht op uitkering relevante persoon op basis van de gegevens op de aanvraag, de verblijfstitel (GBA) en indien nodig verblijfsdocumenten. 
* Vaststelling Inkomen, Het onderzoeken en bepalen van individuele verplichtingen of ontheffingen van de algemeen geldende verplichtingen voor het verkrijgen en behouden van een uitkering voor levensonderhoud.  
* Vaststelling Norm, Het bepalen van de geldende norm (recht en hoogte) van de uitkering levensonderhoud afgaande op de vastgestelde situatie van de aanvrager 
* Vaststelling aanvangsdatum uitkeringsrecht, Het op basis van de aanvraag gegevens en bronnenonderzoek (GBA, SUWI,...) bepalen van de ingangsdatum van het recht op een uitkering levensonderhoud.  Deze kan in de toekomst liggen, maar ligt in principe niet voor de datum waarop de aanvraag is gedaan. Indien van dit laatste wordt afgeweken, wordt dit gemotiveerd. 
* Beschikking Levensonderhoud, Het samenstellen van de gegevens die nodig zijn voor het aanmaken van een document met een voor beroep vatbare beslissing over de aanvraag/wijziging levensonderhoud.</documentation>
          <property key="Object ID" value="6b35af7f-734b-11e5-1099-005056a83192"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Exploiteren vastgoed en terreinen" id="id-6fde08f1-e286-4343-a27f-814456f292ef">
          <documentation>Het verhuren van gemeentelijk vastgoed en terreinen.</documentation>
          <property key="Toelichting" value="Bijv. woningen of volkstuinen. Hier valt niet het vastgoed onder dat als &quot;accomodatie&quot; wordt gezien (zoals zwembaden, sporthallen etc.)."/>
          <property key="Object ID" value="6fde08f1-e286-4343-a27f-814456f292ef"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Ontwikkeling exploitatiebeleid fysieke leefomgeving" id="id-7278676a49784bb0a505e842dab25368">
          <documentation>Het uitwerken van ruimtelijke kaders vastgelegd in exploitatiebeleid fysieke leefomgeving voor het ambtsgebied van de gemeente.</documentation>
          <property key="Object ID" value="3ed95b03-5302-4fea-8509-500c8baf7e12"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Informatieextractie en opslag" id="id-72a7113c-31d2-4678-842b-00592230fb6b">
          <documentation>Het extraheren van de inhoudelijke gegevens die via een bepaald kanaal zijn verkregen om die kanaalonafhankelijk te kunnen gaan verwerken</documentation>
          <property key="Toelichting" value="Bijv. door ongestructureerde gegevens die via een email zijn ontvangen via een eFormulier om te zetten in een standaard berichtformaat of door ontvangen gestructureerde gegevens te transformeren naar het formaat dat geautomatiseerd kan worden verwerkt"/>
          <property key="Object ID" value="72a7113c-31d2-4678-842b-00592230fb6b"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Klanttevredenheids meting" id="id-789a1f64-e727-4444-af4b-d7c01d44bb97">
          <documentation>Het meten van de mate van tevredenheid bij klanten</documentation>
          <property key="Toelichting" value="Bijv. door burgers laten scoren van de door hen ervaren dienstverleningskwaliteit"/>
          <property key="Object ID" value="789a1f64-e727-4444-af4b-d7c01d44bb97"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Verkiezingen gerelateerde diensten" id="id-78bbc144-8a22-43a4-8233-c4cfaf7b73c2">
          <documentation>Het lokaal organiseren van verkiezingen</documentation>
          <property key="Toelichting" value="Bijv. het inrichten van stemlokalen en verstrekken van stempassen"/>
          <property key="Object ID" value="78bbc144-8a22-43a4-8233-c4cfaf7b73c2"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Verkeerbeheer" id="id-78c7f400aba04feca562818c4b411625">
          <property key="Object ID" value="a95d62a7-3bdb-42e7-9d99-ab7b2cf76d32"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Toestemmingverlening activiteit fysieke leefomgeving" id="id-7a1e5935-026e-41ef-be95-d02f2a2a3937">
          <documentation>Het verlenen van het uitvoeren van activiteiten die betrekking hebben op de volgende toestemming: aanvraag vergunning, melding, informatie, informatie ongewoon voorval, aanvraag maatwerkvoorschrift, melding gelijkwaardige maatregel, aanvraag toestemming gelijkwaardige maatregel of het verlenen van het recht op opstal waarbij een burger het recht krijgt om een eigen gebouw (opstal) op gemeentelijk eigendom te plaatsen.</documentation>
          <property key="Toelichting" value="Het gaat hier zowel om gebruik als veranderingen in de omgeving. Andere domeinen waar andere typen vergunningen worden beheerd zijn de domeinen 'Veiligheid' en 'Publieksdiensten'."/>
          <property key="Object ID" value="7a1e5935-026e-41ef-be95-d02f2a2a3937"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Inkomensondersteuning" id="id-7be8a2ed-2eda-11e5-1099-005056a83192">
          <documentation>(Gemeentelijke) inkomensondersteunende regelingen die tot taakgebied van gemeente behoren en bijzondere bijstand.</documentation>
          <property key="Object ID" value="7be8a2ed-2eda-11e5-1099-005056a83192"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Arbeidsmarktbemiddeling" id="id-7be8a2f1-2eda-11e5-1099-005056a83192">
          <documentation>* Matchen WZ naar Vacature
* Dealmaking,
* Drempel verlagend aanbod vanuit de gemeente aan werkgever. 
* Stimulering om werkzoekende in dienst te nemen. 
* Jobhunting 
* Monitoring voortgang individuele sollicitatie 
* Matching op relevante ondernemingsprofielen</documentation>
          <property key="Object ID" value="7be8a2f1-2eda-11e5-1099-005056a83192"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Uitvoering instrumenten" id="id-7be8a2f5-2eda-11e5-1099-005056a83192">
          <documentation>Bestaat uit:
* Registratie aanmelding werkinstrument GSD 
* Behandeling uitvoering werkinstrument GSD
* Bepaling loonwaarde op vacature 
* Besluitvorming uitvoering werkinstrument GSD
* Oplevering uitvoering werkinstrument GSD</documentation>
          <property key="Object ID" value="7be8a2f5-2eda-11e5-1099-005056a83192"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Beheer sociale werkvoorziening" id="id-7be8a2f9-2eda-11e5-1099-005056a83192">
          <documentation>De sociale werkvoorziening is een overheidsvoorziening in Nederland op grond van de Wet sociale werkvoorziening en biedt mensen met een arbeidshandicap een passende werkplek in een zo regulier mogelijke, aan de arbeidshandicap aangepaste, werkomgeving.</documentation>
          <property key="Object ID" value="7be8a2f9-2eda-11e5-1099-005056a83192"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Zelfredzaamheidontwikkeling" id="id-7be8a2fd-2eda-11e5-1099-005056a83192">
          <documentation>Het ondersteunen van zelfredzaamheidsontwikkeling bij inwoners, waarbij zelfredzaamheid gezien wordt als: &quot;Het lichamelijke, verstandelijke, geestelijke en financiële vermogen om zelf voorzieningen te treffen die deelname aan het normale maatschappelijke verkeer mogelijk maakt.&quot; (WMO)</documentation>
          <property key="Object ID" value="7be8a2fd-2eda-11e5-1099-005056a83192"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Voorzieningenverstrekking" id="id-7be8a305-2eda-11e5-1099-005056a83192">
          <documentation>o.a. bijzondere bijstand, subsidies, kredieten, stadspas en andere minimaregelingen</documentation>
          <property key="Object ID" value="7be8a305-2eda-11e5-1099-005056a83192"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Sportstimulering" id="id-7daf0a95-4ab7-4261-b769-5d408ab3aa72">
          <documentation>Het subsidiëren van initiatieven die sportbeoefening stimuleren</documentation>
          <property key="Toelichting" value="Bijv. toekennen van subsidie voor sportverenigingondersteuning of toekennen van een bijdrage Sportfonds schoolgaande kinderen"/>
          <property key="Object ID" value="7daf0a95-4ab7-4261-b769-5d408ab3aa72"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Zaken en casussen informering" id="id-84fe4295-e229-439c-a70d-46c0df913db5">
          <documentation>Het geven van informatie over bij de overheid lopende zaken en casussen waarbij de persoon betrokken is</documentation>
          <property key="Toelichting" value="Bijv. lopende of afgehandelde aanvragen of klachten bij de gemeente"/>
          <property key="Object ID" value="84fe4295-e229-439c-a70d-46c0df913db5"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Waardering en heffing" id="id-8719d591-70bb-11e4-67ab-0050568a6153">
          <documentation>Het vaststellen en opleggen van de aanslag voor gemeentelijke belastingen.</documentation>
          <property key="Toelichting" value="Bij de gemeentelijke belastingen zijn drie typen belastingen te onderscheiden: * algemene belastingen (bijv. onroerendezaakbelastingen, de hondenbelastingen en de forensen- en toeristenbelasting) * bestemmingsbelastingen (bijv. rioolheffing en afvalstoffenheffing) * retributies (rechten en leges) (bijv. verstrekking paspoort, vergunning, markt- en standplaatsgelden)."/>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="8719d591-70bb-11e4-67ab-0050568a6153"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Ontwikkeling beheerbeleid fysieke leefomgeving" id="id-875b32f2d477491eb93acafa91ada38a">
          <documentation>Het uitwerken van ruimtelijke kaders vastgelegd in beheerbeleid fysieke leefomgeving voor het ambtsgebied van de gemeente.</documentation>
          <property key="Object ID" value="f30cecc4-4681-4fcf-befb-b6783f43a21d"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Algemene online samenwerking facilitering" id="id-88869fea-a927-448f-a572-00be229bbd02">
          <documentation>Het faciliteren van online samenwerking tussen gemeente en (keten)partners voor diverse doelen</documentation>
          <property key="Toelichting" value="Bijv. via het beschikbaarstellen van online samenwerkingscomponenten zoals discussiefora waar betrokkenen gebruik van kunnen maken"/>
          <property key="Object ID" value="88869fea-a927-448f-a572-00be229bbd02"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Cateringbeheer" id="id-8982339b-4bcd-4156-81aa-7fde20ab9eda">
          <documentation>Het verzorgen van catering.</documentation>
          <property key="Toelichting" value="Bijv. in de vorm van bedrijfsrestaurants of door eten en drinken bij vergaderingen te verzorgen."/>
          <property key="Object ID" value="8982339b-4bcd-4156-81aa-7fde20ab9eda"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Elektronische publieke diensten ontwikkeling" id="id-8b1f2e57-5cd0-4faf-81f5-461bc5ab52db">
          <documentation>Het ontwikkelen van beleid om effectief en efficiënt elektronische diensten te kunnen verlenen.</documentation>
          <property key="Toelichting" value="Doel is om het elektronische kanaal (met name het internet) optimaal te kunnen benutten. Burgers moeten alle (aan)vragen aan de overheid digitaal kunnen versturen en alle berichten van de overheid digitaal ontvangen. Het digitale kanaal wordt daarbij voorkeurskanaal vanuit de overheid gepresenteerd. Via een multichannel strategie wordt de relatie tussen de verschillende kanalen voor dienstverlening bewaakt (bijv. persoonlijke kanaal (bijv. het loket), het schriftelijke kanaal (bijv. brieven) en het telefonische kanaal (bijv. het Klantcontactcentrum). Conform het uitgangspunt digitaal waar het kan, persoonlijk waar het moet blijven andere kanalen beschikbaar voor mensen die het digitale kanaal niet kunnen of willen gebruiken. Doelen van het (door)ontwikkelen en toepassen van elektronische diensten kunnen bijv. zijn: * meer efficiency (= tijd en kosten) * hogere klanttevredenheid * verhoogde effectiviteit van beleid * betere kwaliteit van dienstverlening * meer transparantie."/>
          <property key="Object ID" value="8b1f2e57-5cd0-4faf-81f5-461bc5ab52db"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Samenwerkingsafspraken partners integrale veiligheid" id="id-8b548075-8cca-4236-b7ab-138c77891663">
          <documentation>Het maken van afspraken over samenwerking met partners in de integrale veiligheid.</documentation>
          <property key="Toelichting" value="Hierbij kan de gemeente de regievoerder of alleen participant zijn."/>
          <property key="Object ID" value="8b548075-8cca-4236-b7ab-138c77891663"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Verstrekking rechten en plichten" id="id-8c848610-bf5e-4bb4-a795-02c8bfacdf2c">
          <documentation>Het informeren van de dienstaanvrager over de bij de dienst behorende rechten en plichten.</documentation>
          <property key="Toelichting" value="Bijv.: een werkzoekende die de plicht heeft om te solliciteren en het recht heeft op een uitkering."/>
          <property key="Object ID" value="8c848610-bf5e-4bb4-a795-02c8bfacdf2c"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Persoonlijke nieuwsvoorziening" id="id-9093fddd-9ac0-4fa4-8886-ee5034b9e902">
          <documentation>Het voortdurend, gericht individueel toezenden van nieuws aan een dienstafnemer op basis van het opgegeven interesseprofiel</documentation>
          <property key="Toelichting" value="Bijv. in de vorm van nieuwsbrieven of rss-feeds"/>
          <property key="Object ID" value="9093fddd-9ac0-4fa4-8886-ee5034b9e902"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Invordering uitkering" id="id-920b527e-5d3a-11e5-1099-005056a83192">
          <documentation>Het invorderen van teveel uitbetaalde uitkeringssommen.</documentation>
          <property key="Toelichting" value="Een te veel uitbetaalde uitkeringssom kan bijv. het gevolg zijn van uitkeringsfraude. Effectueren van de terugvordering vindt plaats via het: * bepalen of een ontstane vordering ook daadwerkelijk teruggevorderd wordt (bijv. niet overgaan tot terugvordering als het bedrag te laag is) * berekenen van draagkracht * maken van aflossingsafspraken * innen van het gevorderde bedrag"/>
          <property key="Object ID" value="920b527e-5d3a-11e5-1099-005056a83192"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Waardering onroerende zaken" id="id-96cfe9ad-e758-4c16-a88a-4d9092b673fa">
          <documentation>Het waarderen van onroerende zaken voor het heffen van belasting.</documentation>
          <property key="Toelichting" value="De WOZ regelt de waardering van alle onroerende zaken in Nederland ten behoeve van belastingheffing. De WOZ-waarde is een grondslag voor verschillende soorten belastingheffing. De gemeente bepaalt een WOZ-waarde voor een onroerende zaak (WOZ-object) en levert deze waarde aan voor de Basisregistratie WOZ die deel uitmaakt van het Nederlandse stelsel van basisregistraties."/>
          <property key="Object ID" value="96cfe9ad-e758-4c16-a88a-4d9092b673fa"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Vraag en aanbod matching" id="id-98d30239-887f-4750-ace5-34c5e974a2e1">
          <documentation>Het publiceren en matchen van lokaal aanwezige vraag en aanbod</documentation>
          <property key="Toelichting" value="Bijv. voor gevraagde en aangeboden persoonlijke ondersteuning of bedrijfsruimten"/>
          <property key="Object ID" value="98d30239-887f-4750-ace5-34c5e974a2e1"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Casus Toekenning" id="id-99997c77-6c9e-4247-a4ba-e34a346ffcbf">
          <documentation>Toekenning van deelplannen en taken aan betrokkenen op basis van het opgestelde plan.</documentation>
          <property key="Toelichting" value="Betrokkenen kunnen bijv. zijn: gemeente, ketenpartner, klant of klant-relatie."/>
          <property key="Object ID" value="99997c77-6c9e-4247-a4ba-e34a346ffcbf"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Attendering" id="id-9a2cbc39-8527-4eb9-9309-324ee963c7de">
          <documentation>Het voortdurend, gericht individueel attenderen van een dienstafnemer op nieuw beschikbaar gekomen informatie aan de hand van het opgegeven interesseprofiel</documentation>
          <property key="Toelichting" value="Bijv. het attenderen van een burger op het naderend verlopen geldigheid van een paspoort of rijbewijs"/>
          <property key="Object ID" value="9a2cbc39-8527-4eb9-9309-324ee963c7de"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Curatief beheer" id="id-9a455c5185c74c75bf596ec0729d5134">
          <documentation>Beheer van de fysieke objecten naar aanleiding van ontvangen signalen</documentation>
          <property key="Object ID" value="3b02266e-e63a-435e-919a-131b9d05559d"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Imago-ontwikkeling" id="id-9ba5513b-2052-4da4-af9d-cd5f4b6cf7e2">
          <documentation>Het opstellen en beheren van een imago en het uitdragen daarvan.</documentation>
          <property key="Toelichting" value="Bijv. via het ontwikkelen van een huisstijl, bijbehorende sjablonen en het toepassen daarvan bij publicaties."/>
          <property key="Object ID" value="9ba5513b-2052-4da4-af9d-cd5f4b6cf7e2"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Exploiteren van havens" id="id-9cd788b8-7a5c-4c11-b11b-7ff8321707b1">
          <documentation>Het uitvoeren van activiteiten voor het exploiteren van gemeentelijke haven(s)</documentation>
          <property key="Toelichting" value="Bijv. het verlenen van aanlegvergunningen"/>
          <property key="Object ID" value="9cd788b8-7a5c-4c11-b11b-7ff8321707b1"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Schoonmaak" id="id-9ed8fca1-ffcb-44f5-952c-6c778bb03fa6">
          <documentation>Het schoonmaken van gebouwen, ruimtes en meubilair.</documentation>
          <property key="Object ID" value="9ed8fca1-ffcb-44f5-952c-6c778bb03fa6"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Output archivering" id="id-9fa10230-1891-46d9-af14-ae11f339c17b">
          <documentation>Het archiveren van geleverde producten en/of bijbehorende metagegevens</documentation>
          <property key="Toelichting" value="Bijv. het archiveren van een elektronisch document dat naar een klant is verzonden (bijv. via email of berichtenbox, of (na inscannen) van papieren brief."/>
          <property key="Object ID" value="9fa10230-1891-46d9-af14-ae11f339c17b"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Zoekondersteuning" id="id-a06fb77a-f62e-4e5b-a65f-83cbef28d654">
          <documentation>Het beantwoorden van zoekvragen van klanten door het opleveren van (verwijzingen naar) relevante informatie</documentation>
          <property key="Toelichting" value="Bijv. door klanten zoekwoorden in te laten geven binnen een eigen zoekmachine of door te zorgen voor goede ondersteuning bij zoeken via algemene zoekmachines zoals Google"/>
          <property key="Object ID" value="a06fb77a-f62e-4e5b-a65f-83cbef28d654"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Ideeën verwerking" id="id-a0f1eeaa-5ad3-45cd-8804-9d58a78df9de">
          <documentation>Het behandelen van ingediende ideeën</documentation>
          <property key="Toelichting" value="Bijv. ideeen over verbetering van gemeentelijke dienstverlening"/>
          <property key="Object ID" value="a0f1eeaa-5ad3-45cd-8804-9d58a78df9de"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Exploiteren van parkeerplaatsen" id="id-a3ec498f-cc6b-4eee-b000-16620e3ba437">
          <documentation>Het exploiteren van parkeerplaatsen, parkeergarages en tijdelijke voorzieningen voor parkeren.</documentation>
          <property key="Toelichting" value="Bijv. via betaling bij plaatsing bij parkeerautomaten of in parkeergarages"/>
          <property key="Object ID" value="a3ec498f-cc6b-4eee-b000-16620e3ba437"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Beperkingenbesluiten beheer" id="id-a4c44a46-6774-4f23-8472-9e491625665a">
          <documentation>Het verwerken van beperkingsbesluiten op percelen in het kader van de WKPB. Het vaststellen van de beperking gebeurt in andere functies, dit is alleen het vastleggen in de overkoepelende registratie.</documentation>
          <property key="Object ID" value="a4c44a46-6774-4f23-8472-9e491625665a"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Betalingbeheer" id="id-a6637d4b-24d1-4257-bb2e-aca6d4051930">
          <documentation>Het uitbetalen van verplichtingen aan crediteuren.</documentation>
          <property key="Object ID" value="a6637d4b-24d1-4257-bb2e-aca6d4051930"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Kantoorwerkzaamheden-ondersteuning" id="id-a6aaab4e-8d22-4a91-8263-c3ed48e38271">
          <documentation>Het ondersteunen van kantoorwerkzaamheden via het beschikbaarstellen van, vaak elektronische, middelen.</documentation>
          <property key="Toelichting" value="Bijv. door voor kantwoorwerkers elektronische voorzieningen beschikbaar te stellen voor beheer van agenda's of het kunnen maken van teksten of spreadsheets."/>
          <property key="Object ID" value="a6aaab4e-8d22-4a91-8263-c3ed48e38271"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Vormacceptatie" id="id-a7b38f25-8e28-4e04-94ca-864a950a1d24">
          <documentation>Het bepalen of een verzoek of melding voldoet aan de formele indieningsvereisten.</documentation>
          <property key="Toelichting" value="Bijv. het toetsen of alle verplichte bijlagen aanwezig zijn om een aanvraag te kunnen behandelen"/>
          <property key="Object ID" value="a7b38f25-8e28-4e04-94ca-864a950a1d24"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Bedrijfsgegevens beheer" id="id-a9eea8b7-9299-11e5-1099-005056a83192">
          <property key="Object ID" value="a9eea8b7-9299-11e5-1099-005056a83192"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Externe communicatie" id="id-aa1c42d7-5552-4681-9f5a-61ae17aafc1c">
          <documentation>Het verstrekken en ter beschikking stellen van informatie naar partijen buiten de eigen organisatie.</documentation>
          <property key="Toelichting" value="Bijv. via het maken van nieuwsberichten voor de pers of inwoners die via diverse kanalen worden gepubliceerd."/>
          <property key="Object ID" value="aa1c42d7-5552-4681-9f5a-61ae17aafc1c"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Toezicht" id="id-aac7ff27-3c79-4234-bf48-1cc00e450553">
          <documentation>Het uitvoeren van toezicht.</documentation>
          <property key="Object ID" value="aac7ff27-3c79-4234-bf48-1cc00e450553"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Leerlingenadministratie" id="id-ab46e401-9e45-11e5-11ba-005056a85f9c">
          <property key="Object ID" value="ab46e401-9e45-11e5-11ba-005056a85f9c"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Leerlingenvervoer" id="id-ab46e404-9e45-11e5-11ba-005056a85f9c">
          <property key="Object ID" value="ab46e404-9e45-11e5-11ba-005056a85f9c"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Media beheer" id="id-acf49c9e-4d1b-45bb-b312-f503c1588bc2">
          <documentation>Het volgen van en waar nodig reageren op mediaberichten waarbij de gemeente een rol speelt</documentation>
          <property key="Toelichting" value="Bijv. het op sociale media signaleren van onduidelijkheden of klachten over gemeentelijke dienstverlening en het adequaat reageren daarop"/>
          <property key="Object ID" value="acf49c9e-4d1b-45bb-b312-f503c1588bc2"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Afhandeling klantcontactmoment" id="id-acf4c752-d015-41d4-a7b7-d12cf10a6f06">
          <documentation>Een contactmoment met een burger of werkgever vastleggen. Datum, reden contact. Resultaat contact, vervolg acties, en vervolgafspraken.</documentation>
          <property key="Object ID" value="acf4c752-d015-41d4-a7b7-d12cf10a6f06"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Geluidbeheer" id="id-afec0908-3ab0-44cb-9c5b-f0e3ffe57699">
          <documentation>Beheren van meetgegevens over geluid in de fysieke leefomgeving.</documentation>
          <property key="Object ID" value="afec0908-3ab0-44cb-9c5b-f0e3ffe57699"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Producten en diensten publicatie" id="id-b1351052-301e-44be-b128-771272c1f9e9">
          <documentation>Het publiceren van informatie over de producten en diensten die de gemeente levert, inclusief de geldende voorwaarden en manier van aanvragen</documentation>
          <property key="Toelichting" value="Bijv. door deze via een digitale producten- en dienstencatalogus te publiceren op de gemeentelijke website"/>
          <property key="Object ID" value="b1351052-301e-44be-b128-771272c1f9e9"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Goederenafhandeling" id="id-b224a080-85a3-4008-9967-195147adbaa8">
          <documentation>Het afhandelen en routeren van inkomende en uitgaande goederenstromen en het beheren van goederen.</documentation>
          <property key="Object ID" value="b224a080-85a3-4008-9967-195147adbaa8"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Debiteurenbeheer" id="id-b2584870-08e4-4f9f-9b1b-62340cb29fcf">
          <documentation>Het ervoor zorg dragen dat debiteuren openstaande vorderingen betalen.</documentation>
          <property key="Object ID" value="b2584870-08e4-4f9f-9b1b-62340cb29fcf"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Systeembeheer" id="id-b3b4cc7f-ec2d-4cf0-8389-cc4ce7cbce34">
          <documentation>Het uitvoeren van beheertaken m.b.t. IT-infrastructuur, systeemprogrammatuur en applicaties.</documentation>
          <property key="Toelichting" value="Biijv. het installeren van hardware, systeemprogrammatuur en applicaties en het verzorgen van back-up's en restores."/>
          <property key="Object ID" value="b3b4cc7f-ec2d-4cf0-8389-cc4ce7cbce34"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Organisatiemanagement" id="id-b41387b8-5f41-4c0f-96b9-ff597340f63a">
          <documentation>Het bepalen van de structuur van de organisatie en de te onderkennen functies, taken en verantwoordelijkheden.</documentation>
          <property key="Object ID" value="b41387b8-5f41-4c0f-96b9-ff597340f63a"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Vermogensbeheer" id="id-b45948c0-4bcc-491c-bea8-de13f81d826c">
          <documentation>Het beheren van het vermogen van de organisatie en de rendering ervan door investeringen aan te gaan.</documentation>
          <property key="Object ID" value="b45948c0-4bcc-491c-bea8-de13f81d826c"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Inkomensbeslaglegging derden" id="id-b492b590-5d3d-11e5-1099-005056a83192">
          <documentation>* Registeren informatieverzoek beslaglegger 
* Informatieverstrekking aan beslaglegger
* Registreren beslaglegging derden 
* Berekenen beslagvrije voet 
* Bepaling effectuering beslaglegging</documentation>
          <property key="Object ID" value="b492b590-5d3d-11e5-1099-005056a83192"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Verhaal" id="id-b492b5b2-5d3d-11e5-1099-005056a83192">
          <documentation>Het verhalen van kosten voor het levensonderhoud op derden.</documentation>
          <property key="Toelichting" value="Verhaal vindt plaats wanneer de gemeente een uitkering heeft verstrekt voor een bepaalde periode waarvan achteraf is vastgesteld dat een derde dit inkomen had moeten verstrekken (bijv. partner of garantsteller, of UWV). De gemeente verhaalt dit bedrag op de derde. Effectueren van verhaal vindt plaats via het: * onderzoeken van verhaalbaarheid * beschikking verhaal * beslissen beslaglegging"/>
          <property key="Object ID" value="b492b5b2-5d3d-11e5-1099-005056a83192"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Dataverwerving integrale veiligheid" id="id-b5631ccc-93f3-4b34-8d0e-7502c5115d84">
          <documentation>Het verwerven van digitale en niet digitale informatie uit interne en externe bronnen ten behoeve van de integrale veiligheid.</documentation>
          <property key="Toelichting" value="Dit is een verplichte taak van de gemeente in tegenstelling tot taken op het vlak van georganiseerde criminaliteit."/>
          <property key="Object ID" value="b5631ccc-93f3-4b34-8d0e-7502c5115d84"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Waarmerking" id="id-b65effcb-cd9c-4c08-95a2-f6185781c5c0">
          <documentation>Het toevoegen van een waarmerk aan een document of bericht om de echtheid te bekrachtigen</documentation>
          <property key="Toelichting" value="Bijv. het toevoegen van een digitale handtekening aan documenten in PDF/A formaat"/>
          <property key="Object ID" value="b65effcb-cd9c-4c08-95a2-f6185781c5c0"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Kaderstelling integrale veiligheid vergunningverlening" id="id-b6c08c0a-0003-40cf-aff7-038dbf4eba07">
          <documentation>Het bepalen van kaders waarbinnen vergunningen afgegeven mogen worden vanuit het perspectief openbare orde en veiligheid.</documentation>
          <property key="Toelichting" value="Deze functie is integraal ondersteunend aan alle gemeentelijke domeinen en geldt voor alle vergunningen."/>
          <property key="Object ID" value="b6c08c0a-0003-40cf-aff7-038dbf4eba07"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Klantgeleiding" id="id-b7309972-770d-41e8-b756-b40975fdceb9">
          <documentation>Het ondersteunen van een dienstenafnemer bij het vinden van de juiste dienst</documentation>
          <property key="Toelichting" value="Bijv. via het bieden van telefonische ondersteuning of intelligente e-diensten die afnemers stapsgewijs richting juiste dienst leiden"/>
          <property key="Object ID" value="b7309972-770d-41e8-b756-b40975fdceb9"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Vergunningenbeheer Publieksdiensten" id="id-b7e4786e-cff2-40a8-ac4b-6c48a0abfbe0">
          <documentation>Het beheren en verlenen van vergunningen voor diverse soorten lokale activiteiten.</documentation>
          <property key="Toelichting" value="Bijv. vergunningen voor loterijen, rommelmarkten, collectes, luchtbalonnen, textielinzameling. Andere domeinen waar andere typen vergunningen worden beheerd zijn de domeinen 'Veiligheid' en 'Ruimte'."/>
          <property key="Object ID" value="b7e4786e-cff2-40a8-ac4b-6c48a0abfbe0"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Interne communicatie" id="id-b893ce72-1e3a-4f14-bc69-8dbcf46c8d95">
          <documentation>Het verstrekken en ter beschikking stellen van informatie voor medewerkers.</documentation>
          <property key="Toelichting" value="Bijv. via het maken en publiceren van nieuwsberichten op het gemeentelijke intranet."/>
          <property key="Object ID" value="b893ce72-1e3a-4f14-bc69-8dbcf46c8d95"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Informatieverzoek verwerking" id="id-b8fb62a0-3c6e-4d3f-a9cc-38e8ab62e795">
          <documentation>Het verwerken van een informatieverzoek dat niet direct is af te handelen</documentation>
          <property key="Toelichting" value="Bijv. de aanvraag van een ja/nee reclamesticker die naar de aanvrager moet worden opgestuurd"/>
          <property key="Object ID" value="b8fb62a0-3c6e-4d3f-a9cc-38e8ab62e795"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Flankerende voorzieningen en advisering" id="id-b9b7e12b-0d23-4a32-b00b-73fef33b26cf">
          <documentation>Adviseren aan aanvrager van aanvullende mogelijk dienstverlening van derde partijen. Advies vastleggen in administratie. Kan bij contactmoment of specifiek.</documentation>
          <property key="Object ID" value="b9b7e12b-0d23-4a32-b00b-73fef33b26cf"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Middeleninzet planning" id="id-bb413a82-833c-4f86-987c-93fcc6517d67">
          <documentation>Het plannen en beheren van de inzet van mensen en middelen.</documentation>
          <property key="Toelichting" value="Bijv. het inroosteren van medewerkers voor bepaalde werkzaamheden of het inkopen van benodigde middelen die nodig zijn voor het kunnen uitvoeren van bedrijfsprocessen."/>
          <property key="Object ID" value="bb413a82-833c-4f86-987c-93fcc6517d67"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="In bewaring nemen van informatieobjecten" id="id-bb90af2f-dba8-436f-b82b-050c0f429ab2">
          <documentation>Het ontvangen van informatieobjecten, controleren, aanvullen waar nodig en uitvoeren van alle benodigde voorbereidende handelingen om een object te genereren voor duurzame opslag.</documentation>
          <property key="Toelichting" value="Bij objecten worden waar nodig een of meer aanvullende manifestaties c.q. representaties van die objecten plus metagegevens bewaard. Aggregaties bundelen bij elkaar horende objecten zoals: * meerdere versies van 'één' informatieobject; * meerdere manifestaties/representaties van een informatieobject (met manifestaties, ook wel representaties genoemd, worden meerdere fysieke vormen van inhoudelijk hetzelfde informatieobject bedoeld, zoals een PDF-bestand naast een Word-bestand van hetzelfde tekstdocument); * dossiers zoals zaakdossiers."/>
          <property key="Object ID" value="bb90af2f-dba8-436f-b82b-050c0f429ab2"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Autorisatievaststelling" id="id-be46c7a7-6e38-435d-ac02-db40a8c0fe7a">
          <documentation>Het vaststellen van de rechten van een geauthenticeerde dienstenafnemer</documentation>
          <property key="Toelichting" value="Bijv. het vaststellen of een geauthenticeerdre afnemer rechten heeft tot inzage in bepaalde gegevens of het uitvoeren van een bepaald type transactie"/>
          <property key="Object ID" value="be46c7a7-6e38-435d-ac02-db40a8c0fe7a"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Schade gerelateerde diensten" id="id-bf2c71a0-aa5e-48f9-86ac-862dd09b2218">
          <documentation>Het verlenen van diensten in situaties waarin schade is geleden en de gemeente hierbij betrokken is</documentation>
          <property key="Toelichting" value="Bijv. het toekennen van een schadevergoeding wanneer een burger schade heeft door een gemeentelijke activiteit of door nalatigheid van de gemeente"/>
          <property key="Object ID" value="bf2c71a0-aa5e-48f9-86ac-862dd09b2218"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Functioneel beheer" id="id-bfb5e768-4ea5-492a-990b-f23faacb8eff">
          <documentation>Het uitvoeren van beheertaken zodat applicaties bedrijfsprocessen optimaal ondersteunen.</documentation>
          <property key="Toelichting" value="Bijv. door bestaande gebruikerswensen te verzamelen en te vertalen in nieuw te realiseren applicatiefunctionaliteit."/>
          <property key="Object ID" value="bfb5e768-4ea5-492a-990b-f23faacb8eff"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Archeologische objectenbeheer" id="id-bfcd3053-b303-499c-87a1-c5a67583b274">
          <documentation>Het registreren van archeologische onderzoeken en het vastleggen van archeologische objecten.</documentation>
          <property key="Toelichting" value="Bijv. het adviseren bij vergunningaanvragen voor opgraving en registreren van (oudheidkundige) vondsten"/>
          <property key="Object ID" value="bfcd3053-b303-499c-87a1-c5a67583b274"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Beheren fysieke objecten" id="id-c02372c9-e979-4966-95f6-50d1fa249198">
          <documentation>Het uitvoeren van werkzaamheden om te voldoen aan de beleidsdoelen voor het beheer van objecten in de fysieke leefomgeving die eigendom zijn van de gemeente of waarvoor contractuele verplichtingen zijn aangegaan. Denk hierbij aan de volgende voorbeelden:
* Groenbeheer
* Gebouwenbeheer
* Waterbeheer
* Rioolbeheer
* Wegenbeheer
* Bodembeheer
* Begraafplaatsenbeheer</documentation>
          <property key="Toelichting" value="Hieronder vallen diverse vormen van beheer."/>
          <property key="Object ID" value="c02372c9-e979-4966-95f6-50d1fa249198"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Beleid cocreatie (nieuw)" id="id-c05b81d8-be63-4b56-adc5-4d1a721995c0">
          <documentation>Het vragen van input en gezamenlijk formuleren van nieuw beleid</documentation>
          <property key="Toelichting" value="Bijv. via het on- en offline samen met burgers en/of bedrijven formuleren van beleid op een bepaald gebied"/>
          <property key="Object ID" value="c05b81d8-be63-4b56-adc5-4d1a721995c0"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Erfpachtuitgifte" id="id-c11dba32-1e80-4fd8-b900-edd83cc27b0c">
          <documentation>Het uitgeven van het recht om een aan de gemeente toebehorend stuk grond te gebruiken.</documentation>
          <property key="Toelichting" value="De erfpachter heeft tijdens de duur van de erfpacht dezelfde rechten als de eigenaar, maar mag niets doen dat de waarde zou verminderen."/>
          <property key="Object ID" value="c11dba32-1e80-4fd8-b900-edd83cc27b0c"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Casus Beoordeling" id="id-c1ab9a4e-a413-4588-a7d4-0807e3c2c346">
          <documentation>Vorming van een beeld van de situatie van de klant(en) inclusief behoeften en mogelijkheden.</documentation>
          <property key="Toelichting" value="Binnen het sociale domein kan dit bijv. via een &quot;keukentafelgesprek&quot; worden gedaan."/>
          <property key="Object ID" value="c1ab9a4e-a413-4588-a7d4-0807e3c2c346"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Overheid, kenniscentra en bedrijfsleven samenwerkingsontwikkeling" id="id-c1f17e4b-c484-49ac-b78a-6848b9312e78">
          <property key="Toelichting" value="De samenwerking tussen de driehoek overheid, onderwijs/onderzoek en bedrijfsleven wordt vaak aangeduid als de gouden driehoek. Steeds meer uitdagingen vereisen samenwerking van actieve en betrokken ondernemers, gezamenlijke financiering en gebruik van aanwezige kennis en onderzoeksresultaten."/>
          <property key="Object ID" value="c1f17e4b-c484-49ac-b78a-6848b9312e78"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Signalen routering" id="id-c205f62c-441f-4b4b-8a6b-4e8b2e9cce91">
          <documentation>Het doorgeven van (evt. bewerkte) signalen naar gegevensverzamelingen en bedrijfsapplicaties</documentation>
          <property key="Toelichting" value="Bijv. het doorgeven van geclusterde signalen afkomstig van sensoren naar een bedrijfssysteem waarin grofmazige analyse plaatsvindt"/>
          <property key="Object ID" value="c205f62c-441f-4b4b-8a6b-4e8b2e9cce91"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Subsidieverlening Publieksdiensten" id="id-c227565e-0152-4a71-9623-d8e98a8bef0e">
          <documentation>Het subsidiëren van diverse soorten binnengemeentelijke activiteiten.</documentation>
          <property key="Toelichting" value="Voorbeelden van verschillende typen subsidies: Cultureel: toekennen van subsidies aan culturele instellingen, toneelgezelschappen of lokale radio. Duurzaamheid: toekennen van subsidie bij het isoleren van woningen of plaatsen van zonnepanelen Emancipatie: toekennen van subsidie aan sociaal cultureel werk dat gericht is op minderheden Participatie: het organiseren van wijkactiviteiten zoals een straatspeeldag of het doen van vrijwilligerswerk Bedrijfssubsidies: het toekennen van startend ondernemerschapsubsidie"/>
          <property key="Object ID" value="c227565e-0152-4a71-9623-d8e98a8bef0e"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Beveiliging- en privacymanagement" id="id-c3504e2e-d852-41f2-9aa5-169b37cfd136">
          <documentation>Het stimuleren van en toezien op voldoende veiligheidsbewustzijn bij medewerkers.</documentation>
          <property key="Toelichting" value="Bijv. door het helder omschrijven van functies en verantwoordelijkheden, het aanbieden van scholing om aan de eisen te kunnen voldoen of het regelmatig publiceren van veiligheidsgerelateerde berichten op het intranet."/>
          <property key="Object ID" value="c3504e2e-d852-41f2-9aa5-169b37cfd136"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Ontwikkeling toezicht- en handhavingsbeleid fysieke leefomgeving" id="id-c3bebbe10d7449b8a581ba5fa5eb6828">
          <documentation>Het uitwerken van ruimtelijke kaders vastgelegd in toezicht- en handhavingsbeleid fysieke leefomgeving voor het ambtsgebied van de gemeente.</documentation>
          <property key="Object ID" value="43a348a1-f0e7-4ac7-8eb4-e935ac556193"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Jeugdzorg" id="id-c50551d6-dfab-11e5-11ba-005056a85f9c">
          <documentation>voorzieningen die er zijn voor de jeugd die problemen heeft en specifieke zorg nodig heeft. Die zorg kan op een breed spectrum betrekking hebben, van op jeugdigen toegesneden psychische hulp tot schuldhulpverlening.</documentation>
          <property key="Object ID" value="c50551d6-dfab-11e5-11ba-005056a85f9c"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Formatieplanning" id="id-c5386283-a205-4dcc-8fc2-86eacf506f92">
          <documentation>Het vaststellen welke budgetten en formatieplaatsen beschikbaar zijn voor organisatorische eenheden.</documentation>
          <property key="Object ID" value="c5386283-a205-4dcc-8fc2-86eacf506f92"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Ruimtelijke uitvoering" id="id-c61924f0-e340-4b6c-b400-8f3971637a83">
          <documentation>Het plannen, beheren en rapporteren van en over projecten die de ruimtelijke omgeving wijzigen.</documentation>
          <property key="Toelichting" value="Projectmatige oplossingen die (al dan niet) toegespitst zijn op het ruimtelijke domein (en die bij toespitsing bijv. de VISI als standaard ondersteunen)."/>
          <property key="Object ID" value="c61924f0-e340-4b6c-b400-8f3971637a83"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Ruimtelijke ontwerpen" id="id-c63b4da2-71fc-4314-8c48-e6eec64993c2">
          <documentation>Het ontwikkelen van ontwerpen die leiden tot het projectmatig uitvoeren van wijzigingen in de ruimtelijke omgeving.</documentation>
          <property key="Toelichting" value="Hieronder valt o.a. het maken en beheren van bestektekeningen."/>
          <property key="Object ID" value="c63b4da2-71fc-4314-8c48-e6eec64993c2"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Burgerlijke stand diensten" id="id-c689b2cc-4672-4474-a82f-44273c60d384">
          <documentation>Het bijhouden van de burgerlijke staat van personen n.a.v. geboorte, overlijden, huwelijk en verhuizing</documentation>
          <property key="Toelichting" value="Bijv. het opmaken van akten bij geboorte, huwelijk, echtscheiding en overlijden."/>
          <property key="Object ID" value="c689b2cc-4672-4474-a82f-44273c60d384"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Facturering" id="id-c84a9b95-cb21-486f-8d07-2ae0833dd43f">
          <documentation>Het kenbaar maken van openstaande vorderingen aan debiteuren.</documentation>
          <property key="Object ID" value="c84a9b95-cb21-486f-8d07-2ae0833dd43f"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Contactbeheer" id="id-ca7deb46-63fb-45e8-abbf-c2d50d52f7a1">
          <documentation>Het onderhouden van de relatie met klanten en ketenpartners.</documentation>
          <property key="GEMMA type" value="Bedrijfsfunctie"/>
          <property key="Object ID" value="ca7deb46-63fb-45e8-abbf-c2d50d52f7a1"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Exploiteren van afvalopslag en -verwerking" id="id-cc1c4709-f354-4747-8bac-3bc54f88e409">
          <documentation>Exploiteren van de opslag en verwerking van afval.</documentation>
          <property key="Object ID" value="cc1c4709-f354-4747-8bac-3bc54f88e409"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Gemeenschappelijke voorzieningen ontwikkeling" id="id-ce00d8fb-2977-4a14-ade3-67b96f826714">
          <documentation>Het ontwikkelen van dienstverlening die (meer) gebruik maakt van (open) standaarden en gemeenschappelijke voorzieningen in plaats eigen voorzieningen.</documentation>
          <property key="Toelichting" value="Gemeenten zoeken meer samenwerking met publieke en private partijen om diensten effectief en efficient te kunnen leveren. Voorzieningen die bedoeld zijn voor gebruik door meer gemeenten spelen daarbij een steeds grotere rol. Het ontwikkelen en toepassen daarvan vraagt om een nieuwe visie op het leveren van diensten en de inzet van middelen daarbij. Voobeelden van gemeenschappelijke voorzieningen zijn: * MijnOverheid als informatieportaal * Landelijke webdiensten"/>
          <property key="Object ID" value="ce00d8fb-2977-4a14-ade3-67b96f826714"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Architectuur management" id="id-d018644d-f913-4b12-b75c-fb6474e88250">
          <documentation>Het ontwikkelen, beheren en toepassen van architectuur voor het in lijn met bedrijfsdoelen sturen van veranderingen.</documentation>
          <property key="Toelichting" value="Bijv. via het in kaart brengen van huidige en gewenste situatie, het vaststellen van architectuurprincipes en van kaders voor nieuwe ontwikkelingen en het begeleiden daarvan."/>
          <property key="Object ID" value="d018644d-f913-4b12-b75c-fb6474e88250"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Call center beheer" id="id-d0990d48-7310-44f6-a6a7-f527255123d8">
          <documentation>Het managen van mensen en middelen om diensten via een call center te bieden</documentation>
          <property key="Toelichting" value="Bijv. het instellen van voice-reponse systemen en het managen van medewerkers die telefonische klantondersteuning bieden"/>
          <property key="Object ID" value="d0990d48-7310-44f6-a6a7-f527255123d8"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Bedrijfsadvies en ondersteuning" id="id-d0f34bb5-bb4f-42b3-8f02-f29fa9dcd1c8">
          <documentation>Het adviseren en ondersteunen van ondernemers</documentation>
          <property key="Toelichting" value="Bijv. het geven van informatie over vestigings- of subsidiemogelijkheden"/>
          <property key="Object ID" value="d0f34bb5-bb4f-42b3-8f02-f29fa9dcd1c8"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Casus Coordinatie" id="id-d2ceaddc-c934-4e9d-8e21-2c5c85912f6c">
          <property key="Object ID" value="d2ceaddc-c934-4e9d-8e21-2c5c85912f6c"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Marketing en promotie" id="id-d75f3684-085c-4235-960c-af7a4bcca104">
          <documentation>Het promoten van stad en gemeentelijke producten en diensten</documentation>
          <property key="Toelichting" value="Bijv. via het doen van campagnes via social media of het beschikbaarstellen van een app met toeristische informatie"/>
          <property key="Object ID" value="d75f3684-085c-4235-960c-af7a4bcca104"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Externe veiligheidbeheer" id="id-d8490752b1aa4da18ada6c391656297d">
          <documentation>Beheren van gegevens over externe veiligheid.</documentation>
          <property key="Object ID" value="f6485dd3-29d0-472e-9650-63263fe0349b"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Kaderstelling" id="id-d856787c-aa33-4bb4-90da-f9a33ea3ec0a">
          <documentation>Het bepalen van    visie en kaders waarbinnen het college van burgemeester en wethouders de gemeente moet besturen.</documentation>
          <property key="Toelichting" value="Het college functioneert binnen de algemene beleidskaders zoals die door de raad zijn vastgesteld en formuleert op haar beurt gemeentelijk beleid dat zij moet uitvoeren."/>
          <property key="Object ID" value="d856787c-aa33-4bb4-90da-f9a33ea3ec0a"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Klachtenafhandeling" id="id-dfe72a31-853b-43c5-8ea7-41de13116fed">
          <documentation>Het afhandelen van klachten van personen over het functioneren van de gemeente of haar medewerkers.</documentation>
          <property key="Object ID" value="dfe72a31-853b-43c5-8ea7-41de13116fed"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Belastingoplegging" id="id-e2102da9-cadd-402d-aed0-1b1f13d4b4ad">
          <documentation>Het opleggen van gemeentelijke belastingen, precario en retributies.</documentation>
          <property key="Toelichting" value="Bijv. onroerendezaak-, riool- en afvalstoffenheffing"/>
          <property key="Object ID" value="e2102da9-cadd-402d-aed0-1b1f13d4b4ad"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Gebouwen- en ruimtenbeveiliging" id="id-e2780d2b-1e8e-43c0-bc8c-600796cb7202">
          <documentation>Het ervoor zorgdragen dat alleen geautoriseerde personen toegang hebben tot ruimten.</documentation>
          <property key="Object ID" value="e2780d2b-1e8e-43c0-bc8c-600796cb7202"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Persoonlijke gegevens informering" id="id-e2ddcbf9-d77c-4cb8-ac45-a4b92047f860">
          <documentation>Het informeren over persoonlijke gegevens zoals die bekend zijn bij de overheid</documentation>
          <property key="Toelichting" value="Bijv. BRP-gegevens of lokaal bij de gemeente in registraties vastgelegde persoonlijke gegevens"/>
          <property key="Object ID" value="e2ddcbf9-d77c-4cb8-ac45-a4b92047f860"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Rampenbestrijding (warm)" id="id-e2f49a6b-1050-4a19-944f-16c1cf5216db">
          <documentation>Het daadwerkelijk acteren bij crises en rampen conform opgestelde crises- en rampscenario's.</documentation>
          <property key="Toelichting" value="Hierbij wordt gebruik gemaakt van opgestelde plannen (bedrijfsfunctie plan- en organisatievorming rampen (koud)) en samenwerkingsovereenkomsten met de betrokken partijen (bedrijfsfunctie samenwerkingsafspraken partners integrale veiligheid). Hierbij treden speciale bevoegdheden in werking en komt een directe informatiestroom op gang op basis van gemaakte afspraken."/>
          <property key="Object ID" value="e2f49a6b-1050-4a19-944f-16c1cf5216db"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Dataverwerving georganiseerde criminaliteit" id="id-e3a61cac-9e81-417b-b073-2ef774cd6248">
          <documentation>Het verwerven van digitale en niet digitale informatie uit interne en externe bronnen ten behoeve van de bestrijding van georganiseerde criminaliteit.</documentation>
          <property key="Toelichting" value="Dit is een geen taak van de gemeente in tegenstelling tot taken op het vlak van integrale veiligheid."/>
          <property key="Object ID" value="e3a61cac-9e81-417b-b073-2ef774cd6248"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Maken van bestekken fysieke leefomgeving" id="id-e685cef5-6c75-4b5f-ac52-b48587db8bf6">
          <documentation>Het maken van bestekken inclusief de van toepassing zijnde administratieve, juridische en technische bepalingen, materialen en uitvoeringsvoorwaarden.</documentation>
          <property key="Toelichting" value="Aan bestekken zijn tekeningen gekoppeld, de zogenaamde bestektekeningen die samen met de technische omschrijving de basis vormen van het contract tussen opdrachtgever en aannemer (opdrachtnemer). Een bestek kan een volledige beschrijving, een functionele beschrijving of een prestatiebeschrijving van een werk zijn. In eerste instantie kan een bestek een basis vormen voor prijsvorming."/>
          <property key="Object ID" value="e685cef5-6c75-4b5f-ac52-b48587db8bf6"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Activabeheer" id="id-e6c81951-4f98-44f2-9d11-3690ca76deb3">
          <documentation>Het financieel administreren van de bezittingen van de organisatie.</documentation>
          <property key="Object ID" value="e6c81951-4f98-44f2-9d11-3690ca76deb3"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Strategievorming fysieke leefomgeving" id="id-e6e8e4b20a524d11b5c87bd859b1462e">
          <documentation>De ruimtelijke strategie over de ontwikkeling van de fysieke leefomgeving, de te bereiken kwalitatieve doelen en hoe deze doelen behaald worden, worden vastgelegd in de Omgevingsvisie. 

De Omgevingsvisie is een integrale langetermijnvisie voor de hele fysieke leefomgeving en haar grondgebied.  De fysieke leefomgeving is breder dan alleen de ruimtelijke aspecten. De wet noemt verplichte aspecten die integraal terug moeten komen in de omgevingsvisie. Daarin zit bijvoorbeeld het gebruik van natuurlijke hulpbronnen, activiteiten waardoor emissies, hinder of risico’s worden veroorzaakt en het nalaten van activiteiten. Ook ontwikkelingen op het gebied van cultureel erfgoed, energie-infrastructuur, landbouw, landschap, milieu, natuur en water worden volgens de memorie van toelichting bij de wet meegewogen en beschreven. Een omgevingsvisie bestrijkt daarmee de hele breedte van de fysieke leefomgeving zoals bedoeld in de Omgevingswet. De omgevingsvisie is dus niet een optelsom van beleidsvisies voor de diverse domeinen, maar een samenhangende visie op strategisch niveau.

De uitwerking van de Omgevingsvisie vindt zijn weerslag in het Omgevingsplan en notities bij de bedrijfsfunctie ontwikkeling.</documentation>
          <property key="Object ID" value="8e0a2cb6-843f-44c4-8a40-1b52c1ead4e2"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Dienstenontwikkeling vanuit gebruikersperspectief" id="id-e7817ef5-f41a-4f04-b5fb-ab11c11e27bb">
          <documentation>Het ontwikkelen van dienstverlening waarbij het afnemersperspectief en mogelijkheden leidend zijn.</documentation>
          <property key="Toelichting" value="Gemeentelijke diensten zijn nog (te) vaak ingericht vanuit optimalisering van interne bedrijfsvoering. Doel is om dienstverlening meer 'van buiten naar binnen' te ontwikkelen. Voorbeelden waarbij dienstverlening vanuit afnemersperspectief wordt ingericht zijn het: * transparant en aanspreekbaar werken en afspraken nakomen * integraal werken om het gemak voor afnemers te verhogen * begrijpelijk communiceren richting afnemers * dereguleren waar dit mogelijk is * toepassen van de webrichtlijnen voor de toegankelijkheid van websites * gebruik maken van afnemers ervaringen en feedback (bijv. via klantreizen) * bieden van laagdrempelige (elektronische) inzage- en correctiemogelijkheden * het goed ondersteunen van mobiele devices bij elektronische dienstverlening."/>
          <property key="Object ID" value="e7817ef5-f41a-4f04-b5fb-ab11c11e27bb"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Afvalinzameling" id="id-e79d6415-e641-4eb9-a73e-f5325e5a418c">
          <documentation>Organiseren van de afvalinzameling voor burgers, bedrijven en instellingen en van openbare afvalbakken.</documentation>
          <property key="Toelichting" value="Bijv. het plannen van ophaalroutes, gebruik van resources dan wel het management voeren op uitbesteede diensten die dit realiseren voor het inzamelen van afval."/>
          <property key="Object ID" value="e79d6415-e641-4eb9-a73e-f5325e5a418c"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Casus Planvorming" id="id-e98bdaca-4c0e-4e43-b528-008f5073b71e">
          <documentation>Creatie en tussentijdse bijstelling van een plan van aanpak.</documentation>
          <property key="Toelichting" value="Betrokken kunnen bijv. zijn: regisseur, ketenpartners, klanten of klant-relaties."/>
          <property key="Object ID" value="e98bdaca-4c0e-4e43-b528-008f5073b71e"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="BGT Beheer" id="id-ea4a05cd26c94e39bc719ac224cb153e">
          <documentation>Beheren van gegevens ten behoeve van grootschalige topografie (referentieschaal 1:1000).</documentation>
          <property key="Object ID" value="1d9ecd9c-4158-4655-a4c6-60893a483efc"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Voorwaardentoetsing" id="id-eace2517-91c5-43f9-82d4-89f9ff834ce3">
          <documentation>Het toetsen of aan alle voorwaarden is voldaan om een aanvraag te kunnen afhandelen</documentation>
          <property key="Object ID" value="eace2517-91c5-43f9-82d4-89f9ff834ce3"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Bedrijfshulpverlening" id="id-eb33cfd6-6824-49cf-8f77-411de2aea760">
          <documentation>Het verlenen hulp bij gebeurtenissen die de veiligheid en/of gezondheid van werknemers en andere aanwezigen bedreigen.</documentation>
          <property key="Toelichting" value="Bijv. hulp bij brand of ongevallen."/>
          <property key="Object ID" value="eb33cfd6-6824-49cf-8f77-411de2aea760"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Klantondersteuning" id="id-ebcca492-fe5f-4daa-a14a-94a2b2f05da2">
          <documentation>Het inhoudelijk ondersteunen van klanten bij het afnemen van door de gemeente aangeboden diensten</documentation>
          <property key="Toelichting" value="Bijv. door klanten uit te leggen wat bedoeld wordt met bepaalde informatie of hen te ondersteunen bij het uitvoeren van een transactie"/>
          <property key="Object ID" value="ebcca492-fe5f-4daa-a14a-94a2b2f05da2"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Uit- en inbesteding" id="id-ece72ddf-5f8e-4e3a-b984-93d9c235ad6f">
          <documentation>Het vormen van een samenwerkingsverband met externe partijen om één of meer bedrijfsactiviteiten extern of gezamenlijk te laten uitvoeren.</documentation>
          <property key="Toelichting" value="Als gevolg van een strategische keuze kunnen één of meer bedrijfsactiviteiten worden: * uitbesteed aan een dienstverlenende onderneming (outsourcing) * inbesteed door voor een andere organisatie diensten te gaan verlenen (insourcing) * gedaan via samenwerking, waarbij bedrijfsactiviteiten samen met een dienstverlenende onderneming worden uitgevoerd (co-sourcing)."/>
          <property key="Object ID" value="ece72ddf-5f8e-4e3a-b984-93d9c235ad6f"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Compliancebeheer" id="id-ecf00a1b-f38f-447a-b5c3-2129086cac48">
          <documentation>Het controleren of het functioneren van de organisatie in lijn is met wet- en regelgeving.</documentation>
          <property key="Object ID" value="ecf00a1b-f38f-447a-b5c3-2129086cac48"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Algemene content publicatie" id="id-ee81eff8-8f68-498c-95d9-70ae37cd1396">
          <documentation>Het publiceren van allerlei soorten (niet nader gespecificeerde) content die gemeentelijke relevantie heeft</documentation>
          <property key="Toelichting" value="Bijv. gemeentelijk nieuws, serviceafspraken, gemeentelijke organisatieopbouw, etc."/>
          <property key="Object ID" value="ee81eff8-8f68-498c-95d9-70ae37cd1396"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Lokale en regionale economische ontwikkeling" id="id-ef36b0c2-3e15-4014-bace-8720e15ea5f8">
          <documentation>Ontwikkeling van een aantrekkelijk ondernemersklimaat gericht op het versterken en bevorderen van de lokale en regionale economie.</documentation>
          <property key="Toelichting" value="Bijv. via het * verbeteren van het vestigingsklimaat voor bedrijven * verbeteren van de dienstverlening aan bedrijven * bevorderen en behouden van ondernemerschap * verbinden van bedrijven en onderwijspartijen * verminderen van onnodige regeldruk * ontwikkelen van regionaal arbeidsmarkt beleid * faciliteren innovatieve initiatieven * ondersteunen van ZZP'ers en startende ondernemers"/>
          <property key="Object ID" value="ef36b0c2-3e15-4014-bace-8720e15ea5f8"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Aanbesteding" id="id-f023811a-174a-46b5-bee8-c1aca37b7dc7">
          <documentation>Het conform wetgeving aanbesteden van opdrachten voor 'werken', 'diensten' of 'leveringen' waarbij bedrijven een offerte kunnen indienen.</documentation>
          <property key="Toelichting" value="Aabestedingsopdrachten kunnen zich richten op: * 'werken', bijvoorbeeld het bouwen van een fysiek bouwkundig of civieltechnisch object zoals gebouw of tunnel; * 'diensten', bijvoorbeeld het uitvoeren van een verhuizing, het verlenen van juridisch advies of het uitvoeren van een ingenieursopdracht; * 'leveringen', bijvoorbeeld het leveren van (een partij) goederen, bijvoorbeeld koffieautomaten of auto's."/>
          <property key="Object ID" value="f023811a-174a-46b5-bee8-c1aca37b7dc7"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Zelfredzaamheidbepaling" id="id-f0b9f592-cd0a-4687-b84f-6187617aa841">
          <documentation>Het bepalen in welke mate een klant zelfredzaam is.</documentation>
          <property key="Toelichting" value="Bijv. het bepalen van de mate zelfredzaamheid van een klant via een instrument zoals de Zelfredzaamheid-matrix."/>
          <property key="Object ID" value="f0b9f592-cd0a-4687-b84f-6187617aa841"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Actieve openbaarmaking van informatie" id="id-f157a282d0d14d19bbc7a9483b619bfb">
          <documentation>Actief openbaarmaken van gemeentelijke informatie die niet (primair) voor het doel van openbaarmaking is gecreëerd.</documentation>
          <property key="Grondslag" value="Wet open overheid, Wet elektronische publicaties, Bekendmakingswet, Gemeentewet (?)"/>
          <property key="Object ID" value="8da87d99-de7d-42a4-8b17-c98ff96cda42"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Werving en selectie" id="id-f15b5b8d-bf4e-48f5-ab32-bf7677c70705">
          <documentation>Het werven en selecteren van nieuwe medewerkers.</documentation>
          <property key="Object ID" value="f15b5b8d-bf4e-48f5-ab32-bf7677c70705"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Signalen bewerking" id="id-f2087bf8-66a0-442d-a59b-41e70323145c">
          <documentation>Ruwe signalen (voor)bewerken om ze geschikt te maken voor verdere verwerking</documentation>
          <property key="Toelichting" value="Bijv. grote hoeveelheden signalen van autonome devices die worden geclustered voordat ze bruikbaar zijn voor analyse of uitvoering"/>
          <property key="Object ID" value="f2087bf8-66a0-442d-a59b-41e70323145c"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Erfgoed- en monumentenbeheer" id="id-f228c9bd-3de0-436b-98a3-d0165932c7a8">
          <documentation>Beheren van erfgoed en monumenten (o.a. in de vorm van het vaststellen van beleid en het bepalen van beschermenswaardige objecten).</documentation>
          <property key="Toelichting" value="Vastleggen van de redengevende omschrijvingen waarom objecten beschermd zijn en deze gegevens beschikbaar stellen in o.a. vergunningsprocessen."/>
          <property key="Object ID" value="f228c9bd-3de0-436b-98a3-d0165932c7a8"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Luchtbeheer" id="id-f316f1a81492439a93a1789731b680ec">
          <documentation>Beheren van meetgegevens over lucht in de fysieke leefomgeving.</documentation>
          <property key="Object ID" value="a5794d94-d019-464b-be88-1ecd6547727c"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="City marketing en toeristische promotie" id="id-f36fd494-e711-4ff3-a3fe-17b6c565bafb">
          <documentation>Het strategisch promoten van een stad voor bedrijven en bezoekers</documentation>
          <property key="Toelichting" value="Bijv. het promoten van de stad via slogans, reclamemateriaal en social media content gericht op verbetering van het imago (&quot;branding&quot;). Vaak met als doel om bedrijven of burgers te wijzen op de kansen die de stad biedt op bepaalde terreinen. Waar het gaat om toerisme kan dit bijv. via toeristische stadsgidsen, social media, apps of radiospots."/>
          <property key="Object ID" value="f36fd494-e711-4ff3-a3fe-17b6c565bafb"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Recreatie en toerisme ontwikkeling" id="id-f37d5b0a-345f-4423-a01d-90d806fc48a1">
          <documentation>Het ontwikkelen van aantrekkelijke vrijetijdsvoorzieningen voor inwoners en toeristen.</documentation>
          <property key="Toelichting" value="Bijv via investeren in: * cultuuraanbod * evenementen * winkelen * overnachtingsmogelijkheden * fiets- en wandelroutes"/>
          <property key="Object ID" value="f37d5b0a-345f-4423-a01d-90d806fc48a1"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Plan en realisatie publicatie" id="id-f6279c62-ec09-4050-a344-e1afb3d95817">
          <documentation>Het publiceren van gemeentelijke plannen en realisatiecijfers</documentation>
          <property key="Toelichting" value="Bijv. door aan te geven wat de gemeente levert, met welke kwaliteit en tegen welke kosten"/>
          <property key="Object ID" value="f6279c62-ec09-4050-a344-e1afb3d95817"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Aanpak specifieke probleemgebieden openbare orde en veiligheid" id="id-f74423fe-a107-436e-915b-431efd0ea5e0">
          <documentation>Het ontwikkelen van aanpakken voor verschillende veiligheid-gerelateerde probleemgebieden.</documentation>
          <property key="Toelichting" value="passend bij de afspraken en kaders van de bestuurlijke besluiten en samenwerkingsafspraken over lokale en regionale veiligheid (zie de bedrijfsfuncties 'besluitvorming lokale integrale veiligheid' en 'besluitvorming regionale integrale veiligheid'). Denk hierbij aan maatregelen in het kader van: * winkeldiefstal * terrorisme * verkeersveiligheid * illegale opslag * transport en opslag gevaarlijke stoffen * crisis- en calamiteiten * smart/bel/headshops * brandveiligheid * parkeeroverlast * inbraakpreventie, overvallen, straatroof * outlaw motorgangs * alcohol en drugs * seksueel geweld/ mensensmokkel * wijkveiligheid/ overlast * voetbalgeweld * ondermijning * vrijplaatsen * huiselijk geweld."/>
          <property key="Object ID" value="f74423fe-a107-436e-915b-431efd0ea5e0"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Ontwikkeling algemeen verbindende voorschriften fysieke leefomgeving" id="id-f8a2b585aaba46769072d1a6a39d8d2f">
          <documentation>Het uitwerken van ruimtelijke kaders vastgelegd in algemeen verbindende voorschriften voor het ambtsgebied van de gemeente.</documentation>
          <property key="Object ID" value="ee7b6732-3d32-4bde-8606-876ed790b917"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Crediteurenbeheer" id="id-fd61133c-4e55-4bef-8121-30066ce3cdf7">
          <documentation>Het verwerken van inkomende facturen.</documentation>
          <property key="Object ID" value="fd61133c-4e55-4bef-8121-30066ce3cdf7"/>
        </element>
        <element xsi:type="archimate:BusinessFunction" name="Begrotingbeheer" id="id-fe2b23a7-6efc-47e3-af7b-a4cff0d8b8f2">
          <documentation>Het vaststellen van de beschikbare financiële middelen en de daaruit voortvloeiende budgetten.</documentation>
          <property key="Object ID" value="fe2b23a7-6efc-47e3-af7b-a4cff0d8b8f2"/>
        </element>
      </folder>
    </folder>
    <folder name="Bedrijfssamenwerkingen" id="ea4e9991-3685-4b9f-b96d-80c0a072300b">
      <element xsi:type="archimate:BusinessCollaboration" name="Bestandsoverdracht" id="id-7bd49996-02dc-11e6-11ba-005056a85f9c">
        <property key="Object ID" value="7bd49996-02dc-11e6-11ba-005056a85f9c"/>
      </element>
      <element xsi:type="archimate:BusinessCollaboration" name="Afspraken maken over gegevensleveringen" id="id-92cda2e1-17bf-11e4-67ab-0050568a6153">
        <documentation>Bronhouder, afnemer, domeinarchitect, gegevensmakelaar en functionaris voor de gegevensbescherming maken afspraken over gegevensleveringen. Deze afspraken leiden tot één of meer GLO's. Deze GLO's zijn input voor de gegevensarchitect.   Onderdeel van de afspraken over gegevensleveringen zijn de afspraken over gegevensuitwisselingen. Deze afspraken worden vastgelegd in privacy convenanten en beschrijven de afspraken die tussen partijen gemaakt worden ten aanzien van gegevensuitwisseling en doel of de noodzaak van de gegevensuitwisseling. Als het gaat om een samenwerking tussen partijen, zoals in een sociaal wijkteam, dan kan de gemeente bijvoorbeeld de werkwijze vastleggen in een privacyconvenant. Het is dringend aan te bevelen dat de gemeente dergelijke privacyconvenanten opstelt. Een convenant kan er zijn voor een sociaal wijkteam, maar ook voor een doelgroepgerichte aanpak – zoals overlastgevende jongeren, zorgmijders of voor het Veiligheidshuis. Een privacyconvenant maakt voor alle betrokkenen – inclusief de burgers – duidelijk hoe partijen omgaan met persoonsgegevens en hoe de privacybescherming is geborgd. Convenanten kunnen nooit een wet opzij zetten. Een convenant kan nooit méér bevoegdheden scheppen dan een wet aan de gemeente toekent. Om vast te stellen of een convenant privacy-proof is en past binnen de wettelijke kaders, kan een onafhankelijk partij een PIA (Privacy Impact Assessment) laten uitvoeren. Op landelijk niveau is bij nieuwe wetgeving een PIA's verplicht. De Tweede Kamer vraagt er altijd om. Op gemeentelijk niveau is er geen verplichting, maar het is wel verstandig om een PIA te laten doen.</documentation>
        <property key="Object ID" value="92cda2e1-17bf-11e4-67ab-0050568a6153"/>
      </element>
      <element xsi:type="archimate:BusinessCollaboration" name="Ontwerpen gegevenscatalogus" id="id-bbeae5c0-17c4-11e4-67ab-0050568a6153">
        <documentation>De gegevensarchitect stelt samen met de gegevensmakelaar en de functionaris voor de gegevensbescherming het ontwerp op voor de gegevenscatalogus. Dit ontwerp is input voor de implementatie van de gegevenscatalogus binnen generieke voorzieningen.</documentation>
        <property key="Object ID" value="bbeae5c0-17c4-11e4-67ab-0050568a6153"/>
      </element>
      <element xsi:type="archimate:BusinessCollaboration" name="Ontwerpen en implementeren van generieke voorzieningen" id="id-bbeae5c7-17c4-11e4-67ab-0050568a6153">
        <documentation>De implementatie hiervan wordt uitgevoerd door de beheerder generieke voorzieningen en de gegevensarchitect. Het resultaat zijn ingerichte generieke voorzieningen zoals een gegevensmagazijn, datawarehouse en servicebus met adapters. De generieke voorzieningen worden gebruikt door de beheerder generieke voorzieningen en de distributeur.</documentation>
        <property key="Object ID" value="bbeae5c7-17c4-11e4-67ab-0050568a6153"/>
      </element>
      <element xsi:type="archimate:BusinessCollaboration" name="Gegevensverwerking" id="id-e148d49d-17ba-11e4-67ab-0050568a6153">
        <property key="Object ID" value="e148d49d-17ba-11e4-67ab-0050568a6153"/>
      </element>
    </folder>
    <folder name="DevOps" id="id-16d14914ffef4315ab9605ee4e7e4186">
      <element xsi:type="archimate:BusinessCollaboration" name="DevOps team" id="id-d52695320e57451bb733eb967fbb3094">
        <documentation>De groep professionals die gezamenlijk verantwoordelijk is voor het plannen, bouwen, testen, uitrollen en beheren van software</documentation>
        <property key="Object ID" value="f3ce3e59-674a-419f-bba2-3edfa41367ca"/>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="Build" id="id-54300648fc2b44fc8485c5ae8c9963f5">
        <documentation>Samenvoegen van onderdelen tot een werkende versie van het product.</documentation>
        <property key="Object ID" value="2bb4002a-49b5-41d0-811c-0c80e08befc3"/>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="Test" id="id-56937b1222af4e0ba8b098466850fc14">
        <documentation>Controleren of het product goed werkt en voldoet aan de eisen.</documentation>
        <property key="Object ID" value="106a2680-eb22-45eb-bdb2-f65b7a045d92"/>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="Operations" id="id-5eea7ca7c60a4b5ab679cc8d6f33f808">
        <documentation>Het beheren en onderhouden van IT-infrastructuur, applicaties en services, met focus op stabiliteit, schaalbaarheid en betrouwbaarheid.</documentation>
        <property key="Object ID" value="a14b2346-93a6-4a93-a684-535abaaba6ba"/>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="Plan" id="id-995f8f906c684da8b4a455ec0471de06">
        <documentation>Vaststellen wat gebouwd moet worden, waarom, en hoe het werk wordt verdeeld.</documentation>
        <property key="Object ID" value="5fb5beef-bc54-4e84-aba8-4bab419b2d08"/>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="Deploy" id="id-a3028168c55343c2bd80a9cb49e1d574">
        <documentation>Uitrollen van de oplossing naar de beoogde gebruikersomgeving.</documentation>
        <property key="Object ID" value="451897bd-31de-4cf3-91c0-9c41598ae1a8"/>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="Operate &amp; Monitor" id="id-d8cdbb1ea85c44c785cb1a31bd14390c">
        <documentation>Bewaken van prestaties, stabiliteit en beschikbaarheid in productie.</documentation>
        <property key="Object ID" value="ddaf6a00-7467-449c-b7e7-747a114cedbb"/>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="Release" id="id-dfc4c488c3b54f809f8c0fbe142558d2">
        <documentation>Gereedmaken en beschikbaar stellen van de oplossing voor uitrol.</documentation>
        <property key="Object ID" value="25b2004d-6777-4abe-9d06-cc360ce9d262"/>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="Development" id="id-e4cc9173ad0d4f839e7cbaabd28c2361">
        <documentation>Het proces van ontwerpen, coderen, testen en implementeren van software, gericht op snelle en iteratieve levering van functionaliteit.&#xD;
</documentation>
        <property key="Object ID" value="57ea10a4-55d9-40ed-8e61-4037f875960e"/>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="Secure &amp; Feedback" id="id-e689e5d636c54fe9ba8341191cce9705">
        <documentation>Verzamelen van signalen uit gebruik, incidenten en beveiligingsgebeurtenissen om continu te verbeteren.</documentation>
        <property key="Object ID" value="bfde8946-3c41-4bd0-9966-7c1f894d8585"/>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="Develop" id="id-f21c9b60ac0d4a378dfb75ceb158276f">
        <documentation>Uitwerken van oplossingen door het bouwen van functionaliteit.</documentation>
        <property key="Object ID" value="697c463e-d6d5-4f48-9614-3762c3f9324a"/>
      </element>
      <element xsi:type="archimate:BusinessRole" name="Ontwikkelaar" id="id-1151856f13b44abd8cfef360c3fc282f">
        <documentation>Bouwt, test en onderhoudt de software.</documentation>
        <property key="Object ID" value="bb933e90-a9ad-446e-8898-6d00c4f07c28"/>
      </element>
      <element xsi:type="archimate:BusinessRole" name="Beheerder (Ops)" id="id-23dae85c71404d188811e9c566d99d6c">
        <documentation>Beheert infrastructuur en zorgt voor stabiele uitvoering.</documentation>
        <property key="Object ID" value="7f4af3a2-8bed-4792-9f65-a31bc1b25d17"/>
      </element>
      <element xsi:type="archimate:BusinessRole" name="Support / Monitoring" id="id-3b1a9c122f0944039e153a0308a09aa5">
        <documentation>Signaleert problemen en koppelt gebruikservaring terug.</documentation>
        <property key="Object ID" value="475fe4f4-3749-489e-90d9-e931b6f1f52b"/>
      </element>
      <element xsi:type="archimate:BusinessRole" name="DevOps Engineer" id="id-d249a39c22a44ec1b16781498e79815e">
        <documentation>Automatiseert processen en verbindt ontwikkeling en beheer.</documentation>
        <property key="Object ID" value="fc9686ea-4a62-49a8-9e30-ddbfb316978b"/>
      </element>
      <element xsi:type="archimate:BusinessRole" name="Tester / QA" id="id-d725d3bf8a754009877aeb01694a511c">
        <documentation>Test of de software werkt zoals bedoeld.</documentation>
        <property key="Object ID" value="e8715766-e1ab-44c4-9866-82978b11bd23"/>
      </element>
      <element xsi:type="archimate:BusinessRole" name="Product Owner" id="id-d935e3f4a34046f6a2990a5c98d74ac2">
        <documentation>Bepaalt wat gebouwd wordt en stelt prioriteiten.</documentation>
        <property key="Object ID" value="3f18f130-803a-44f7-aeee-d5b3e9e0b053"/>
      </element>
    </folder>
