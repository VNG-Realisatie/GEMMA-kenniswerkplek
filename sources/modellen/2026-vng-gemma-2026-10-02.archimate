          <child xsi:type="archimate:Note" id="id-43fa50902adb45f69ef5c733dcdb5c5d" textAlignment="1">
            <bounds x="40" y="30" width="371" height="71"/>
            <content>In deze view wordt gedefinieerd wat de procesondersteunende componenten zijn en wat de gedeelde functionaliteit en standaarden zijn</content>
          </child>
          <child xsi:type="archimate:Note" id="id-dff7d16f8081452492d46d6fae3c40c7" textAlignment="1">
            <bounds x="860" y="590" width="281" height="91"/>
            <content>Een Meldingen openbare ruimtecomponent is een specifiek procesafhandelcomponent. Hiervoor geldt dat de standaard ZGW API aanbevolen is</content>
          </child>
          <child xsi:type="archimate:Note" id="id-5f5d3af4c524411f92da7a4e01fbb1a8" textAlignment="1">
            <bounds x="760" y="220" width="251" height="61"/>
            <content>Voor de Generiek Zaakafhandelcomponent geldt dat de standaard ZGW API verplicht is</content>
          </child>
          <child xsi:type="archimate:Note" id="id-cce2e1cbcbf14714b2cdd9e7f6524e6c" textAlignment="1">
            <bounds x="130" y="220" width="291" height="61"/>
            <content>Voor alle procesondersteunende componenten geldt dat de applicatiefunctie beheren zaken wordt ondersteund</content>
          </child>
          <child xsi:type="archimate:DiagramObject" id="id-2ec7bb7c863a4bbe977b2833aaa8bdc5" font="1|.AppleSystemUIFont|10.0|0|COCOA|1|.SFNS-Regular" lineColor="#000000" fillColor="#daeef3" archimateElement="id-0777c4b6-e7c5-4d42-9fe8-9b98e6bca8a6" type="1">
            <bounds x="710" y="760" width="229" height="60"/>
            <sourceConnection xsi:type="archimate:Connection" id="id-06cbc0d9a91d4f059e3739f9e2b2e12d" source="id-2ec7bb7c863a4bbe977b2833aaa8bdc5" target="id-ef3493735ac84ef9bbe99f10ca9d4115" archimateRelationship="id-1eab52f8-0f12-4c3d-ab20-9148932ba9e3"/>
          </child>
