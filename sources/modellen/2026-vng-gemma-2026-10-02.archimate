        <property key="GEMMA type" value="Technologiecomponent"/>
        <property key="Object ID" value="2f34f557-31b8-438a-b164-26fef574b6da"/>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="Event broker" id="id-79c0134f56b349ebb90654d36e5c968d">
        <documentation>Component voor ontvangen van notificaties van bronsystemen en het routeren daarvan naar geabonneerde afnemers.</documentation>
        <property key="GEMMA status" value="In ontwikkeling"/>
        <property key="GEMMA type" value="Technologiecomponent"/>
        <property key="Toelichting" value="Dit wordt ook Publish-Subscribe genoemd, waarbij berichten door een uitgever (publisher) worden verzonden naar meerdere ontvangers (subscribers) die zich hebben geabonneerd op een bepaald onderwerp of kanaal."/>
        <property key="Object ID" value="0cc5a8f6-aca8-482f-97fb-204618e942d2"/>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="FTP-component" id="id-878bde58366f464587068696388a548b">
