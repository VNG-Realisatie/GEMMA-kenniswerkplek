            <child xsi:type="archimate:Note" id="id-2df0cdf01190433499c9122a1f07e17f" font="1|Arial|12.0|0|WINDOWS|1|-20|0|0|0|400|0|0|0|0|3|2|1|34|Arial" textAlignment="1" fillColor="#eaf2fb" borderType="2">
