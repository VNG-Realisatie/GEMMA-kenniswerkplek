      <folder name="Referentiecomponenten generiek" id="f7ffd7a4-ffa6-41e5-a4be-28f546857845">
        <element xsi:type="archimate:AggregationRelationship" id="id-030dd02e-07a4-4ff2-b1df-6932b7f618a9" source="id-37c2b614-7e96-4b76-86a6-66cd49c79923" target="id-b05eaafa-9381-45ae-a41d-7a9affaa43cd">
          <property key="Object ID" value="030dd02e-07a4-4ff2-b1df-6932b7f618a9"/>
        </element>
        <element xsi:type="archimate:FlowRelationship" name="inzage in lopende zaken en aanvragen" id="id-030e20d6-0f08-4441-bff3-71f6648c50ff" source="id-a97b6545-d5a7-485d-9b13-3ce22db5b9cf" target="id-8c2cf498-380a-4fc1-b8ce-becf802d6371">
          <property key="Object ID" value="030e20d6-0f08-4441-bff3-71f6648c50ff"/>
        </element>
        <element xsi:type="archimate:FlowRelationship" name="opvragen document" id="id-12f0af44-6cdc-473e-8cf0-6ca20a857c1f" source="id-0e99ec6c-283a-4ec9-8efa-e11468e6b878" target="id-1e437d94-acfc-47dd-9326-2bc5914dc204">
          <documentation>Het zaakafhendalcomponent dat de notificatie heeft ontvangen, vraagt het document op bij de documentregistratiecomponent.</documentation>
          <property key="Object ID" value="12f0af44-6cdc-473e-8cf0-6ca20a857c1f"/>
        </element>
        <element xsi:type="archimate:FlowRelationship" name="registratie aanvraag product of dienst" id="id-19f25fbd-2bdf-429a-afc4-c137543fc94a" source="id-f2dfbd0b-9d36-405c-bdbe-827f3296de29" target="id-a97b6545-d5a7-485d-9b13-3ce22db5b9cf">
          <property key="Object ID" value="19f25fbd-2bdf-429a-afc4-c137543fc94a"/>
        </element>
        <element xsi:type="archimate:FlowRelationship" name="gegevenslevering" id="id-1e51bfe6-b6fa-45f8-b361-fc265be4b2e1" source="id-06321658-50d1-4153-b007-6630ffabcd80" target="id-3e79874f-3a37-49bd-86ef-d48d0f2ed4a1">
          <property key="Object ID" value="1e51bfe6-b6fa-45f8-b361-fc265be4b2e1"/>
        </element>
        <element xsi:type="archimate:FlowRelationship" name="publicatie van publlieke ongestructureerde content" id="id-1ed48ce2-9732-4ae7-9bbc-8f7d9ee1e0e5" source="id-8c8117ec-8fcf-4e2c-ab31-cda3f4570642" target="id-8c8117ec-8fcf-4e2c-ab31-cda3f4570642">
          <property key="Object ID" value="1ed48ce2-9732-4ae7-9bbc-8f7d9ee1e0e5"/>
        </element>
        <element xsi:type="archimate:FlowRelationship" name="2. zaakdocumenten" id="id-21b4d21d-63ba-4222-b882-45018b5b3ec5" source="id-0e99ec6c-283a-4ec9-8efa-e11468e6b878" target="id-96f66a08-8e0b-4602-944b-73ca3ba659f2">
          <documentation>Een inwoner kan via de Mijngemeentecomponent de zaakdocumenten inzien waar hij/zij toegang toe heeft, zoals de aanvraag en de daarbij verstuurde bijlagen.</documentation>
          <property key="Object ID" value="21b4d21d-63ba-4222-b882-45018b5b3ec5"/>
        </element>
        <element xsi:type="archimate:FlowRelationship" name="instellen abonnementen" id="id-22762772-a2df-46ff-ba6b-57c610d67f7f" source="id-06321658-50d1-4153-b007-6630ffabcd80" target="id-6c681cd8-9401-4103-82fc-51c0492d67e7">
          <property key="Object ID" value="22762772-a2df-46ff-ba6b-57c610d67f7f"/>
        </element>
        <element xsi:type="archimate:FlowRelationship" name="2. Notificatie nieuw of gewijzigd document" id="id-25100293-aa79-4e60-a482-3886722bbca2" source="id-0e99ec6c-283a-4ec9-8efa-e11468e6b878" target="id-5060f0fc-6198-4936-99d3-1c5a35aae8de">
          <documentation>De Documentregistratiecomponent stuurt bij bepaalde wijzigingen (bv. een nieuw document toegevoegd aan een zaak) een notificatie naar de Notificatierouteringscomponent.</documentation>
          <property key="Object ID" value="25100293-aa79-4e60-a482-3886722bbca2"/>
        </element>
        <element xsi:type="archimate:FlowRelationship" name="4. bijwerken zaakdocumenten" id="id-2be6a5ba-33a9-43a2-a883-86739571890f" source="id-eb436669-87b4-4134-b59b-dbfda11de5bc" target="id-0e99ec6c-283a-4ec9-8efa-e11468e6b878">
          <documentation>Een KCC-medewerker kan documenten aan een zaak bijwerken of toevoegen. Bijvoorbeeld wanneer iemand een nagekomen stuk wil inleveren. Uiteraard enkel wanneer toegestaan in het betreffende proces en pas nadat de zaak door de Zaakafhandelcomponent (generiek of specifiek) is geregistreerd als zaak.
</documentation>
          <property key="Object ID" value="2be6a5ba-33a9-43a2-a883-86739571890f"/>
        </element>
        <element xsi:type="archimate:FlowRelationship" name="inzien archief" id="id-39b165e0-f37b-409d-bedc-34ec0c902e26" source="id-215355e8-af2a-4274-bd42-b57c214166fe" target="id-6244d235-9319-48dd-b7b8-8701e0bde21d">
          <documentation>Via de archiefportaalcomponent kunnen dossiers uit het archief worden doorzocht en ingezien (wanneer openbaar).</documentation>
          <property key="Object ID" value="39b165e0-f37b-409d-bedc-34ec0c902e26"/>
        </element>
        <element xsi:type="archimate:FlowRelationship" name="opdracht uitplaatsen/overbrengen/vernietigen zaken en zaakdocumenten" id="id-3c1df126-4fc8-4fc2-b42d-8ead72a6c358" source="id-b209fee8-d39a-4699-b0b4-02273c35c8c1" target="id-1e437d94-acfc-47dd-9326-2bc5914dc204">
          <documentation>De archiefbeheercomponent geeft de generieke of specifieke zaakafhandelcomponent de opdracht om een zaakdossier uit te plaatsen of over te brengen (of evt. te vernietigen).</documentation>
          <property key="Object ID" value="3c1df126-4fc8-4fc2-b42d-8ead72a6c358"/>
        </element>
        <element xsi:type="archimate:FlowRelationship" name="zaaknummer" id="id-3f444b76-9d21-4858-9cf1-a8bfcce1adfc" source="id-a97b6545-d5a7-485d-9b13-3ce22db5b9cf" target="id-1e437d94-acfc-47dd-9326-2bc5914dc204">
          <documentation>De Zaakregistratiecomponent geeft het bijbehorende zaaknummer terug.</documentation>
          <property key="Object ID" value="3f444b76-9d21-4858-9cf1-a8bfcce1adfc"/>
        </element>
        <element xsi:type="archimate:FlowRelationship" name="instellen distributieregels" id="id-43c187f3-ddf4-40fd-8d2e-1fe0fb53dc37" source="id-06321658-50d1-4153-b007-6630ffabcd80" target="id-6c681cd8-9401-4103-82fc-51c0492d67e7">
          <property key="Object ID" value="43c187f3-ddf4-40fd-8d2e-1fe0fb53dc37"/>
        </element>
        <element xsi:type="archimate:FlowRelationship" name="2b. opvragen zaaktype" id="id-4d69e06e-b558-4595-b151-7e86cc7525c1" source="id-3ef9cdd9-631c-4d3e-88c3-f756423d6314" target="id-8c2cf498-380a-4fc1-b8ce-becf802d6371">
          <documentation>De Servicebuscomponent vraagt aan de Zaaktypecataloguscomponent welk zaaktype bij de betreffende productaanvraag behoort en (eventueel) in welk systeem deze afgehandeld wordt. Dit laatste is optioneel. Wordt dit niet in de ZTC bijgehouden, dan moet de Servicebuscomponent over een tabel beschikken van zaaktypen en systemen waari deze afgehandeld worden.</documentation>
          <property key="Object ID" value="4d69e06e-b558-4595-b151-7e86cc7525c1"/>
        </element>
        <element xsi:type="archimate:FlowRelationship" name="1. Notificatie nieuwe of bijgewerkte zaak" id="id-50361514-a809-4c4c-966f-47080ba13b7d" source="id-a97b6545-d5a7-485d-9b13-3ce22db5b9cf" target="id-5060f0fc-6198-4936-99d3-1c5a35aae8de">
          <documentation>De Zakenregistratiecomponent stuurt bij bepaalde wijzigingen (statusupdates, ..) een notificatie naar de Notificatierouteringscomponent.</documentation>
          <property key="Object ID" value="50361514-a809-4c4c-966f-47080ba13b7d"/>
        </element>
        <element xsi:type="archimate:FlowRelationship" name="Levering basisgegevens" id="id-53a3adf3-1c4d-4747-9351-cb3130410922" source="id-06321658-50d1-4153-b007-6630ffabcd80" target="id-8c2cf498-380a-4fc1-b8ce-becf802d6371">
          <property key="Object ID" value="53a3adf3-1c4d-4747-9351-cb3130410922"/>
        </element>
        <element xsi:type="archimate:FlowRelationship" name="inzien en bijwerken van zaken" id="id-53a89b69-d104-4adc-9fef-526536afaf52" source="id-f2dfbd0b-9d36-405c-bdbe-827f3296de29" target="id-a97b6545-d5a7-485d-9b13-3ce22db5b9cf">
          <property key="Object ID" value="53a89b69-d104-4adc-9fef-526536afaf52"/>
        </element>
        <element xsi:type="archimate:FlowRelationship" name="1. informatie over za(a)k(en)" id="id-54cd33e4-7355-41e0-a48f-a73fc6f8918c" source="id-a97b6545-d5a7-485d-9b13-3ce22db5b9cf" target="id-96f66a08-8e0b-4602-944b-73ca3ba659f2">
          <documentation>Een inwoner kan via de Mijngemeentecomponent alle lopende en (recent) afgesloten zaken en per zaak de relevante zaakdetails inzien.</documentation>
          <property key="Object ID" value="54cd33e4-7355-41e0-a48f-a73fc6f8918c"/>
        </element>
        <element xsi:type="archimate:FlowRelationship" name="inzage in gegevens" id="id-56a16205-cd74-46be-944a-4c1e8f559555" source="id-06321658-50d1-4153-b007-6630ffabcd80" target="id-8c2cf498-380a-4fc1-b8ce-becf802d6371">
          <property key="Object ID" value="56a16205-cd74-46be-944a-4c1e8f559555"/>
        </element>
        <element xsi:type="archimate:FlowRelationship" name="2. bijwerken van (zaak)documenten" id="id-5dc37bf4-2bc8-4023-9b84-eb9851913fc6" source="id-25ee9ea7-be66-4bdd-b40c-191777a88b35" target="id-0e99ec6c-283a-4ec9-8efa-e11468e6b878">
          <documentation>De Documentbeheercomponent kan documenten en dossiers in de Documentregistratiecomponent bijwerken (bv toevoegen metadata).</documentation>
          <property key="Object ID" value="5dc37bf4-2bc8-4023-9b84-eb9851913fc6"/>
        </element>
        <element xsi:type="archimate:FlowRelationship" name="3. inzien zaakdocumenten" id="id-5e6335a3-126f-4239-aa05-f881c0f59ee0" source="id-0e99ec6c-283a-4ec9-8efa-e11468e6b878" target="id-eb436669-87b4-4134-b59b-dbfda11de5bc">
          <documentation>Een KCC medewerker heeft via de Relatiebeheercomponent inzicht in de documenten bij een zaak.</documentation>
          <property key="Object ID" value="5e6335a3-126f-4239-aa05-f881c0f59ee0"/>
        </element>
        <element xsi:type="archimate:FlowRelationship" name="opvragen gegevens" id="id-5f845477-9dcc-4216-a94e-a0aa7e775cfd" source="id-2eebab83-14b7-4e91-ac89-a2a702dcb81d" target="id-3e79874f-3a37-49bd-86ef-d48d0f2ed4a1">
          <property key="Object ID" value="5f845477-9dcc-4216-a94e-a0aa7e775cfd"/>
        </element>
        <element xsi:type="archimate:FlowRelationship" name="1. ingescand document" id="id-647b8ba7-873d-47c5-bba8-1ef6458cf875" source="id-89d557be-4c18-464e-b5fd-4f56c66c8b66" target="id-25ee9ea7-be66-4bdd-b40c-191777a88b35">
          <documentation>Het door de Scanning- en imagingcomponent ingescande document wordt doorgestuurd naar de Documentbeheercomponent. Dit kan via een koppeling, of door het uploaden van een gescand document door een medewerker.</documentation>
          <property key="Object ID" value="647b8ba7-873d-47c5-bba8-1ef6458cf875"/>
        </element>
        <element xsi:type="archimate:FlowRelationship" name="1. Opzoeken zaak" id="id-6c5bdc6a-34be-4103-b968-677e7893ce13" source="id-a97b6545-d5a7-485d-9b13-3ce22db5b9cf" target="id-96f66a08-8e0b-4602-944b-73ca3ba659f2">
          <documentation>De mijngemeentecomponent toont de lopende zaken van de klant en haalt de benodigde gegevens op van de zaak waaraan dit bijkomende document gekoppeld moet worden.</documentation>
          <property key="Object ID" value="6c5bdc6a-34be-4103-b968-677e7893ce13"/>
        </element>
        <element xsi:type="archimate:FlowRelationship" name="2. ophalen uniek zaaknummer" id="id-73878999-7d95-4b4d-9721-d5c90ab1f934" source="id-a97b6545-d5a7-485d-9b13-3ce22db5b9cf" target="id-25ee9ea7-be66-4bdd-b40c-191777a88b35">
          <documentation>De documentbeheerocmponent haalt een uniek zaaknummer op bij de Zaakregistratiecomponent (optioneel).</documentation>
          <property key="Object ID" value="73878999-7d95-4b4d-9721-d5c90ab1f934"/>
        </element>
        <element xsi:type="archimate:FlowRelationship" name="(zaak)documenten" id="id-79f1fab4-6b82-4fec-881b-335e1fddfa2f" source="id-0e99ec6c-283a-4ec9-8efa-e11468e6b878" target="id-215355e8-af2a-4274-bd42-b57c214166fe">
          <documentation>De bij een zaak horende zaakdocumenten worden vanuit de documentregistratiecomponent aangeboden aan het archiefregistratiecomponent en bij de betreffende zaak gevoegd.</documentation>
          <property key="Object ID" value="79f1fab4-6b82-4fec-881b-335e1fddfa2f"/>
        </element>
        <element xsi:type="archimate:FlowRelationship" name="opvragen zaaktype" id="id-7cb64ff1-63b3-4b95-bf51-ba5eebc8ede5" source="id-3ef9cdd9-631c-4d3e-88c3-f756423d6314" target="id-8c2cf498-380a-4fc1-b8ce-becf802d6371">
          <documentation>De generieke of specifieke Zaakafhandelcomponent vraagt de actuele versie van het zaaktype behorende bij de betreffende zaak op bij de Zaaktyperegistratiecomponent.
</documentation>
          <property key="Object ID" value="7cb64ff1-63b3-4b95-bf51-ba5eebc8ede5"/>
        </element>
        <element xsi:type="archimate:FlowRelationship" name="1. inzien zaakgegevens" id="id-7fee0556-b42d-41bf-bf99-d9d0fbe4519e" source="id-a97b6545-d5a7-485d-9b13-3ce22db5b9cf" target="id-eb436669-87b4-4134-b59b-dbfda11de5bc">
          <documentation>Een KCC medewerker heeft via de Relatiebeheercomponent inzicht in alle zaken (waar toegestaan).</documentation>
          <property key="Object ID" value="7fee0556-b42d-41bf-bf99-d9d0fbe4519e"/>
        </element>
        <element xsi:type="archimate:FlowRelationship" id="id-841f41b7-4762-4712-ab20-5581a645c4ac" source="id-3e79874f-3a37-49bd-86ef-d48d0f2ed4a1" target="id-2eebab83-14b7-4e91-ac89-a2a702dcb81d">
          <property key="Object ID" value="841f41b7-4762-4712-ab20-5581a645c4ac"/>
        </element>
        <element xsi:type="archimate:FlowRelationship" name="4. aanvraag product of dienst" id="id-8a54106a-9435-4f12-94a9-4f05fbc9eacf" source="id-25ee9ea7-be66-4bdd-b40c-191777a88b35" target="id-1e437d94-acfc-47dd-9326-2bc5914dc204">
          <documentation>Op basis van het zaaktype routeert de Documentbeheerocmponent de aanvraag naar de juiste Zaakafhandelcomponent.</documentation>
          <property key="Object ID" value="8a54106a-9435-4f12-94a9-4f05fbc9eacf"/>
        </element>
        <element xsi:type="archimate:FlowRelationship" name="notificatie nieuwe zaak door document" id="id-8bc3ad4d-d0bb-4acd-9eb3-79e197ef3929" source="id-25ee9ea7-be66-4bdd-b40c-191777a88b35" target="id-5060f0fc-6198-4936-99d3-1c5a35aae8de">
          <documentation>Indien dit document aanleiding geeft tot het starten van een nieuwe zaak, stuurt de documentbeheercomponent een notificatie naar de notificatierouteringscomonent.</documentation>
          <property key="Object ID" value="8bc3ad4d-d0bb-4acd-9eb3-79e197ef3929"/>
        </element>
        <element xsi:type="archimate:FlowRelationship" name="4. Document + metadata" id="id-8f0033fb-daa9-41ef-ac9a-070a835ffa41" source="id-25ee9ea7-be66-4bdd-b40c-191777a88b35" target="id-1e437d94-acfc-47dd-9326-2bc5914dc204">
          <documentation>De Documentbeheercomponent stuurt het nieuw binnengekomen document ovv. de benodigde metadata (in ieder geval het zaaknummer) naar de bijbehorende Zaakafhandelcomponent.</documentation>
          <property key="Object ID" value="8f0033fb-daa9-41ef-ac9a-070a835ffa41"/>
        </element>
        <element xsi:type="archimate:FlowRelationship" name="2. Document + metadata" id="id-9e1f666b-ca17-42d0-b154-7ad2198344ea" source="id-96f66a08-8e0b-4602-944b-73ca3ba659f2" target="id-1e437d94-acfc-47dd-9326-2bc5914dc204">
          <documentation>De Mijngemeentecomponent stuurt het nieuw binnengekomen document ovv. de benodigde metadata (in ieder geval het zaaknummer) naar de bijbehorende Zaakafhandelcomponent.
</documentation>
          <property key="Object ID" value="9e1f666b-ca17-42d0-b154-7ad2198344ea"/>
        </element>
        <element xsi:type="archimate:FlowRelationship" name="opvragen zaaktype" id="id-a22742a2-ff59-4781-aacf-277ca4cb9893" source="id-3ef9cdd9-631c-4d3e-88c3-f756423d6314" target="id-1e437d94-acfc-47dd-9326-2bc5914dc204">
          <documentation>Het generieke of specifieke Zaakafhandelcomponent vraagt de actuele versie van het zaaktype behorende bij de betreffende zaak op bij het Zaaktyperegistratiecomponent.
</documentation>
          <property key="Object ID" value="a22742a2-ff59-4781-aacf-277ca4cb9893"/>
        </element>
        <element xsi:type="archimate:FlowRelationship" name="1. inzien van (zaak)documenten" id="id-a4a9d948-0158-4837-919e-db9e712055f3" source="id-0e99ec6c-283a-4ec9-8efa-e11468e6b878" target="id-25ee9ea7-be66-4bdd-b40c-191777a88b35">
          <documentation>De documentbeheercomponent biedt inzicht in de documenten in de Documentregistratiecomponent</documentation>
          <property key="Object ID" value="a4a9d948-0158-4837-919e-db9e712055f3"/>
        </element>
        <element xsi:type="archimate:FlowRelationship" name="pre-fill gegevens" id="id-a5d50dab-d51a-483c-994e-6bb4bd1dce0f" source="id-06321658-50d1-4153-b007-6630ffabcd80" target="id-8c2cf498-380a-4fc1-b8ce-becf802d6371">
          <property key="Object ID" value="a5d50dab-d51a-483c-994e-6bb4bd1dce0f"/>
        </element>
        <element xsi:type="archimate:FlowRelationship" name="inzien en beheren archief" id="id-bb5481ee-8dca-4055-bda1-e257427e18fd" source="id-215355e8-af2a-4274-bd42-b57c214166fe" target="id-b209fee8-d39a-4699-b0b4-02273c35c8c1">
          <property key="Object ID" value="bb5481ee-8dca-4055-bda1-e257427e18fd"/>
        </element>
        <element xsi:type="archimate:FlowRelationship" name="3. Ophalen bijbehorend zaaktype" id="id-bc270116-5315-4003-9c35-8e33bef940d3" source="id-3ef9cdd9-631c-4d3e-88c3-f756423d6314" target="id-25ee9ea7-be66-4bdd-b40c-191777a88b35">
          <documentation>De Documentregistratiecomponent vraagt aan de Zaaktypecataloguscomponent welk zaaktype bij de betreffende productaanvraag behoort en (eventueel) in welk systeem deze afgehandeld wordt. Dit laatste is optioneel. Wordt dit niet in de ZTC bijgehouden, dan moet de Servicebuscomponent over een tabel beschikken van zaaktypen en systemen waari deze afgehandeld worden.</documentation>
          <property key="Object ID" value="bc270116-5315-4003-9c35-8e33bef940d3"/>
        </element>
        <element xsi:type="archimate:FlowRelationship" name="3. inzien van zaken" id="id-bcfe80a8-bff4-4802-a432-745f265a3516" source="id-a97b6545-d5a7-485d-9b13-3ce22db5b9cf" target="id-25ee9ea7-be66-4bdd-b40c-191777a88b35">
          <documentation>De Documentbeheercomponent kan ook zaakgegevens inzien. Wanneer het bijvoorbeeld (meta)gegevens over de zaak waarbij een of meerdere documenten behoren wil tonen, moet het deze opvragen bij de ZRC.</documentation>
          <property key="Object ID" value="bcfe80a8-bff4-4802-a432-745f265a3516"/>
        </element>
        <element xsi:type="archimate:FlowRelationship" name="3a. aanvraag product of dienst" id="id-cddf1a03-99b5-4ab9-882d-7dfaaa50ee67" source="id-5c9f683b-4454-4e3e-b93c-da50dfd6934a" target="id-8c2cf498-380a-4fc1-b8ce-becf802d6371">
          <documentation>Het ingevulde formulier wordt met eventuele bijlagen verzonden naar de servicebuscomponent.</documentation>
          <property key="Object ID" value="cddf1a03-99b5-4ab9-882d-7dfaaa50ee67"/>
        </element>
        <element xsi:type="archimate:FlowRelationship" name="2. bijwerken zaakgegevens" id="id-cdf6bc61-8a03-4faa-b821-9e9055a0a3a6" source="id-eb436669-87b4-4134-b59b-dbfda11de5bc" target="id-a97b6545-d5a7-485d-9b13-3ce22db5b9cf">
          <documentation>Een KCC medewerker kan een zaak bijwerken. Bijvoorbeeld door een telefonisch klantcontact aan de zaak toe te voegen. IN het geval van een juist binnengekomen productaanvraag kan dit pas nadat de zaak door een Zaakafhandelcomponent (generiek of specifiek) is geregistreerd als zaak.
</documentation>
          <property key="Object ID" value="cdf6bc61-8a03-4faa-b821-9e9055a0a3a6"/>
        </element>
        <element xsi:type="archimate:FlowRelationship" name="3. Opzoeken zaaktype" id="id-d173282c-f763-47aa-a2b3-aa3181713bd3" source="id-3ef9cdd9-631c-4d3e-88c3-f756423d6314" target="id-25ee9ea7-be66-4bdd-b40c-191777a88b35">
          <documentation>De medewerker inkomende Post zoekt met de Documentbeheercomponent naar een zaaktype waarbij het binnengekomen document kan horen (optioneel, indien de bijbehorende zaak niet direct duidelijk is). Ook kan hier worden opgezocht welke Zaakafhandelcomponent zaken van dit type behandelt, indien dit niet al uit de Zakenregistratiecomponent blijkt.</documentation>
          <property key="Object ID" value="d173282c-f763-47aa-a2b3-aa3181713bd3"/>
        </element>
        <element xsi:type="archimate:FlowRelationship" name="2. Opzoeken zaak" id="id-d353201a-34f5-4258-9bbc-6791d5032df0" source="id-a97b6545-d5a7-485d-9b13-3ce22db5b9cf" target="id-25ee9ea7-be66-4bdd-b40c-191777a88b35">
          <documentation>De medewerker inkomende Post zoekt met de Documentbeheercomponent naar de bij het binnengekomende stuk horende zaak.</documentation>
          <property key="Object ID" value="d353201a-34f5-4258-9bbc-6791d5032df0"/>
        </element>
        <element xsi:type="archimate:FlowRelationship" name="registratie ingescand document" id="id-d7e22b35-3b8e-4f1c-838b-7a3a5ad6ea7d" source="id-25ee9ea7-be66-4bdd-b40c-191777a88b35" target="id-0e99ec6c-283a-4ec9-8efa-e11468e6b878">
          <documentation>De medewerker registreert en metadateert het document. De Documentbeheercomponent voegt dit toe aan de Documentregistratiecomponent.</documentation>
          <property key="Object ID" value="d7e22b35-3b8e-4f1c-838b-7a3a5ad6ea7d"/>
        </element>
        <element xsi:type="archimate:FlowRelationship" name="1b. uniek zaaknummer" id="id-f0c9cb0c-42da-4657-a572-9fd9cb92a726" source="id-a97b6545-d5a7-485d-9b13-3ce22db5b9cf" target="id-8c2cf498-380a-4fc1-b8ce-becf802d6371">
          <documentation>De zakenregistratiecomponent geeft een uniek zaaknummer uit.</documentation>
          <property key="Object ID" value="f0c9cb0c-42da-4657-a572-9fd9cb92a726"/>
        </element>
        <element xsi:type="archimate:RealizationRelationship" id="id-09207f0f9e59408db3bfd6ab80452ab1" source="id-b209fee8-d39a-4699-b0b4-02273c35c8c1" target="id-e28aa50681a84733b54ca79cf6bbde7f">
          <property key="Object ID" value="2b33413f-0f2d-43ab-b49a-5ef471be783b"/>
        </element>
        <element xsi:type="archimate:RealizationRelationship" id="id-0d213318b20543b682ff7e27ddc6e311" source="id-e3a3a9b3-b778-4e12-a6a3-f72384a7fac7" target="id-10066e6b06124c3eababb0347aab6dbf">
          <property key="Object ID" value="0e49bd4e-94ac-4d07-a4ca-1560fcca6009"/>
        </element>
        <element xsi:type="archimate:RealizationRelationship" id="id-10e07a2be18c46ab8b78cc9464f371ff" source="id-eb436669-87b4-4134-b59b-dbfda11de5bc" target="id-beed047f831c4efeb6dd4d85bf46cc21">
          <property key="Object ID" value="c8af974f-bd28-42b0-9636-c938381eb628"/>
        </element>
        <element xsi:type="archimate:RealizationRelationship" id="id-1ba40181a70b44f4b08711b45835c1c4" source="id-96f66a08-8e0b-4602-944b-73ca3ba659f2" target="id-e0fe3b05d12f42d7a4c8e8fe971db913">
          <property key="Object ID" value="b98783be-82f5-4601-8bc0-2b6565274888"/>
        </element>
        <element xsi:type="archimate:RealizationRelationship" id="id-20f27da5b7de43d08232dde1f89c24b0" source="id-3f12eec9-2b11-4388-869d-9507453e3707" target="id-65bce9c985f445da998b5bbf88af9d50">
          <property key="Object ID" value="6a7069d7-b1ab-4e98-beda-d7c3109ae8f5"/>
