          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model GEMMA-match" value="exact" />
          <property key="wiki-gemma-model bronnen" value="2026-vng-gemma-2026-10-02; 2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-vng-retributies; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen" />
          <property key="wiki-gemma-model beschrijving" value="De gemeente exploiteert voorzieningen die zij bezit, zoals accommodaties, havens, parkeerplaatsen, vastgoed en begraafplaatsen. Voor het gebruik kan ze kosten in rekening brengen met een retributie of met een privaatrechtelijke overeenkomst (2026-vng-retributies, tweewegenleer)." />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsfuncties/fysieke-leefomgeving/exploitatie-fysieke-leefomgeving.md" />
