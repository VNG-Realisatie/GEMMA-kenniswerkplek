        </element>
        <element xsi:type="archimate:BusinessFunction" name="Burgerlijke stand diensten" id="id-c689b2cc-4672-4474-a82f-44273c60d384">
          <documentation>Het bijhouden van de burgerlijke staat van personen naar aanleiding van geboorte, overlijden, huwelijk en verhuizing.</documentation>
          <property key="Object ID" value="c689b2cc-4672-4474-a82f-44273c60d384" />
          <property key="Toelichting" value="Bijv. het opmaken van akten bij geboorte, huwelijk, echtscheiding en overlijden." />
          <property key="wiki-gemma-model id" value="burgerlijke-stand-diensten" />
          <property key="wiki-gemma-model herkomst" value="gekoppeld" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model GEMMA-match" value="exact" />
          <property key="wiki-gemma-model bronnen" value="2026-vng-gemma-2026-10-02; 2026-rvo-aangifte-en-akte-van-overlijden; 2026-rijk-wet-op-de-lijkbezorging-wettekst" />
          <property key="wiki-gemma-model beschrijving" value="De ambtenaar van de burgerlijke stand maakt akten op van geboorte, huwelijk en overlijden en verleent het verlof tot begraving of crematie (Wet op de lijkbezorging art. 11; RVO). De functie bedient de processen daarvoor." />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsfuncties/publieksdiensten/burgerlijke-stand-diensten.md" />
          <property key="wiki-gemma-model domein" value="Publieksdiensten" />
          <property key="wiki-gemma-model vorige definitie" value="Het bijhouden van de burgerlijke staat van personen n.a.v. geboorte, overlijden, huwelijk en verhuizing" />
