              <documentation>Inzage voor de ingeschrevene in zijn eigen gegevens in de basisregistratie personen.</documentation>
              <property key="wiki-gemma-model id" value="brp-inzagerecht" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
