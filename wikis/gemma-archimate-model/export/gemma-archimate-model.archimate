            <element xsi:type="archimate:BusinessService" name="Rijbewijs buitenlands omwisseling" id="id-34a530820e46512ea894eaa32130fe5a">
              <documentation>Het omwisselen van een buitenlands rijbewijs voor een Nederlands rijbewijs, voor wie in Nederland komt wonen.</documentation>
              <property key="wiki-gemma-model id" value="rijbewijs-buitenlands-omwisseling" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2026-utrecht-burgerzaken-rijbewijs-buitenland-omwisselen; 2026-utrecht-burgerzaken; 2026-rijk-reglement-rijbewijzen-bwbr0008074" />
              <property key="wiki-gemma-model beschrijving" value="De aanvrager maakt twee afspraken, voor het aanvragen en voor het afhalen, en levert het buitenlandse rijbewijs in; de afhaalafspraak volgt pas als de RDW laat weten dat het Nederlandse rijbewijs klaarligt (Utrecht). De UPL kent het product in persoon en met de digitale dienstverlening van de Single Digital Gateway (UPL nr. 361: kanaal In Persoon, SDG).&#10;&#10;Of omwisselen kan, bepaalt de RDW; zo niet, dan volgt rijexamen bij het CBR (Utrecht)." />
              <property key="wiki-gemma-model synoniemen" value="Rijbewijs buitenland omwisselen (beleid)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/0-bestuur-en-ondersteuning/burgerzaken/rijbewijs-buitenlands-omwisseling.md" />
