        <element xsi:type="archimate:Grouping" name="Fysieke leefomgeving" id="id-9219feb8-d58c-40c7-990f-ce5fbb2a8880">
          <documentation>Bedrijfsfuncties gericht op het beheer en onderhoud van de fysieke leefomgeving, zoals de openbare ruimte en afvalinzameling.</documentation>
          <property key="GEMMA sortering" value="c" />
          <property key="GEMMA subtype" value="Domein" />
