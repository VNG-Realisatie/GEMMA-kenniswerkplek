            <element xsi:type="archimate:BusinessService" name="Verhuismelding" id="id-eefcab86713757d1abc0b3eaac7025b0">
              <documentation>Het doorgeven van een verhuizing binnen of naar de gemeente, zodat het nieuwe adres in de basisregistratie personen komt.</documentation>
              <property key="wiki-gemma-model id" value="verhuismelding" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2026-utrecht-burgerzaken-verhuizing-doorgeven; 2026-rvig-hup-binnengemeentelijke-adreswijziging; 2026-rvig-hup-verblijfplaats" />
              <property key="wiki-gemma-model beschrijving" value="De verhuizing wordt doorgegeven vanaf vier weken voor tot vijf dagen na de verhuisdatum, online met DigiD, per post of aan de balie; de gemeente past de gegevens binnen ongeveer een week aan en geeft de verhuizing door aan organisaties (Utrecht Verhuizing doorgeven). Grondslag is art. 2.39 Wet BRP (UPL nr. 424)." />
              <property key="wiki-gemma-model synoniemen" value="Verhuizing doorgeven (beleid); Aangifte van adreswijziging (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/0-bestuur-en-ondersteuning/burgerzaken/verhuismelding.md" />
