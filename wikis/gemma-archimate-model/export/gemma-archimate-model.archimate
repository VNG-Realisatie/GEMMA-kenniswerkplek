          <property key="wiki-gemma-model soort export" value="definitief" />
        </element>
        <element xsi:type="archimate:BusinessRole" name="Rol" id="id-c2ebc94dbd2645608a4e789a014973eb">
          <documentation>Een rol is de verantwoordelijkheid voor specifiek gedrag waar een actor aan toegewezen kan worden.</documentation>
          <property key="Object ID" value="39fdcad2-9e8e-4664-a3d5-25187bc2d65a" />
