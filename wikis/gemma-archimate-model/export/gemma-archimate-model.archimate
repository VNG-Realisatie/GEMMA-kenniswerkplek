            <element xsi:type="archimate:BusinessService" name="BRP-geheimhoudingsverzoek" id="id-c469bbed8b2654029b94600899f1b9f1">
              <documentation>Het verzoek om persoonsgegevens uit de basisregistratie personen niet aan bepaalde derden te verstrekken, of om dat stop te zetten.</documentation>
              <property key="wiki-gemma-model id" value="brp-geheimhoudingsverzoek" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2026-utrecht-burgerzaken-persoonsgegevens-geheimhouden; 2026-rvig-hup-verstrekkingsbeperking" />
              <property key="wiki-gemma-model beschrijving" value="Met geheimhouding krijgen onder meer advocaten, niet-commerciële instellingen en de Stichting Interkerkelijke Ledenadministratie geen gegevens zonder toestemming; instellingen met een wettelijke taak krijgen ze wel. De aanvraag kan online met DigiD of schriftelijk, en de geheimhouding gaat mee bij een verhuizing (Utrecht Persoonsgegevens geheimhouden). Grondslag is art. 2.59 Wet BRP (UPL nr. 87)." />
              <property key="wiki-gemma-model synoniemen" value="Persoonsgegevens geheimhouden (beleid); Verzoek om verstrekkingsbeperking (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/0-bestuur-en-ondersteuning/burgerzaken/brp-geheimhoudingsverzoek.md" />
