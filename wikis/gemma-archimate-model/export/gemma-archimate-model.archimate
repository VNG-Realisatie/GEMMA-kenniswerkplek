    <folder name="Domein en doelgroep" id="id-c3ecc4a7186d49ba8de32edc84a4b765">
      <folder name="Domeinen" id="id-7aabd5bffe324f82869b0d5b21333a2b">
        <element xsi:type="archimate:Grouping" name="Openbare orde en veiligheid" id="id-4d65e4a6-1cbb-438f-99f9-f84770cf60ae">
          <documentation>Bedrijfsfuncties gericht op bestuurlijke handhaving binnen de veiligheidsketen, zoals preventiecampagnes en rampenoefeningen.</documentation>
