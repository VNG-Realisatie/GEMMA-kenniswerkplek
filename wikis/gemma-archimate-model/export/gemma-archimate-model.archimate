              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessService" name="RNI inschrijving" id="id-2f9839c8159b5698871cf6ba4211562a">
              <documentation>Inschrijving in de registratie niet-ingezetenen van wie niet in Nederland woont maar wel een relatie heeft met de Nederlandse overheid.</documentation>
              <property key="wiki-gemma-model id" value="rni-inschrijving" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
