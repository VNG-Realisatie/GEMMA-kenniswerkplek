            <element xsi:type="archimate:BusinessService" name="Persoonsgegevens verklaring onder eed of belofte" id="id-402eab9669a05fca98b4f41e1d61ae49">
              <documentation>Het afleggen van een verklaring onder eed of belofte over eigen persoonsgegevens als een brondocument ontbreekt.</documentation>
              <property key="wiki-gemma-model id" value="persoonsgegevens-verklaring-onder-eed-of-belofte" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2026-rvig-hup-immigratie" />
              <property key="wiki-gemma-model beschrijving" value="Kan een persoon bij de inschrijving een gegeven, zoals de geslachtsaanduiding, niet met een brondocument aantonen, dan neemt de gemeente een verklaring onder eed of belofte af en ontleent zij het gegeven daaraan (HUP Immigratie). Grondslag is art. 2.8 Wet BRP; verschijnen in persoon is nodig (UPL nr. 335)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/0-bestuur-en-ondersteuning/burgerzaken/persoonsgegevens-verklaring-onder-eed-of-belofte.md" />
