            <element xsi:type="archimate:BusinessService" name="Overlijdensaangifte" id="id-a3e6b76874175c568dab9b9973ff9657">
              <documentation>Het doen van aangifte van een overlijden bij de gemeente waar iemand is overleden, waarna de gemeente een akte van overlijden opmaakt.</documentation>
              <property key="wiki-gemma-model id" value="overlijdensaangifte" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-besluit-burgerlijke-stand-1994-bwbr0006493; 2026-rvo-aangifte-en-akte-van-overlijden; 2025-vng-upl-producten-en-diensten-extern; 2026-utrecht-burgerzaken-overlijden-aangifte-doen; 2026-rijk-burgerlijk-wetboek-boek-1" />
              <property key="wiki-gemma-model beschrijving" value="Aangifte doet wie het overlijden uit eigen wetenschap kent; degene die de lijkbezorging regelt kan een gemachtigde aanwijzen, meestal de uitvaartondernemer, ook elektronisch (BW 1 art. 19h). Voor de aangifte is een verklaring van overlijden van de behandelend arts of de gemeentelijke lijkschouwer nodig (Utrecht; RVO). De aangifte is gratis (Utrecht).&#10;&#10;Kanalen: online voor uitvaartondernemers met eHerkenning, met het burgerservicenummer van de overledene (Besluit burgerlijke stand art. 67a; Utrecht; RVO), of aan de balie op afspraak voor uitvaartondernemers en nabestaanden (Utrecht). Bij een lijkvinding doet de hulpofficier van justitie schriftelijk aangifte (BW 1 art. 19h lid 6; Besluit burgerlijke stand art. 62)." />
              <property key="wiki-gemma-model synoniemen" value="Aangifte van overlijden (wet); Overlijden, aangifte doen (beleid)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/0-bestuur-en-ondersteuning/burgerzaken/overlijdensaangifte.md" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model domein" value="Publieksdiensten" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessService" name="Geregistreerd partnerschap omzetting in huwelijk" id="id-b01109eba2f454e18e16a91a62425d36">
              <documentation>Het laten omzetten van een geregistreerd partnerschap in een huwelijk.</documentation>
              <property key="wiki-gemma-model id" value="geregistreerd-partnerschap-omzetting-in-huwelijk" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
