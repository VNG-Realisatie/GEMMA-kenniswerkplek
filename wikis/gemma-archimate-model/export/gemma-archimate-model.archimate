              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2024-nvvb-schema-schriftelijke-gegevensverstrekking-brp; 2026-rijk-besluit-brp-bwbr0034306; 2026-utrecht-burgerzaken-persoonsgegevens-brp-bekijken-en-overzicht-aanvragen" />
              <property key="wiki-gemma-model beschrijving" value="De ingeschrevene kan zijn gegevens ook zelf bekijken op MijnOverheid, een landelijke voorziening (Utrecht Persoonsgegevens bekijken). Grondslag is art. 2.55 Wet BRP; het college voldoet binnen vier weken aan het verzoek (UPL nr. 91)." />
              <property key="wiki-gemma-model synoniemen" value="Persoonsgegevens BRP bekijken (beleid)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/0-bestuur-en-ondersteuning/burgerzaken/brp-inzagerecht.md" />
