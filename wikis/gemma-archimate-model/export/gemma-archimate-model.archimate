      <folder name="Ketensamenwerking" id="id-a665b791c88d598582afbe693211a099">
        <folder name="7 Volksgezondheid en Milieu" id="id-6b2ee357048155f2ba4cf9acc1eff3f2">
          <folder name="Begraafplaatsen en crematoria" id="id-64852b2bcdd9595e9ab74179ede6c67d">
            <element xsi:type="archimate:BusinessInteraction" name="Bezorgen stoffelijk overschot" id="id-67035f5bdb7e5a2db35d490ce6d4b5fd">
              <documentation>De samenwerking van gemeente, houder van begraafplaats of crematorium en officier van justitie bij de bezorging van een stoffelijk overschot.</documentation>
              <property key="wiki-gemma-model id" value="bezorgen-stoffelijk-overschot" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-vng-gemma-proceshierarchie; 2026-vng-gemma-impact-ketensamenwerking" />
              <property key="wiki-gemma-model beschrijving" value="Na het overlijden wordt het stoffelijk overschot geschouwd, verleent de ambtenaar van de burgerlijke stand verlof tot begraving of crematie, en wordt het binnen de wettelijke termijn begraven, gecremeerd of ontleed (Wet op de lijkbezorging art. 3, 11, 16, 67). Zorgt niemand anders voor de bezorging, dan draagt de burgemeester er zorg voor (art. 21); bij een besmet stoffelijk overschot kan hij maatregelen treffen (art. 22a). Ook een latere opgraving hoort bij de levensloop van het stoffelijk overschot (art. 29).&#10;&#10;Het is een ketensamenwerking: bij een niet-natuurlijke dood brengt de gemeentelijke lijkschouwer verslag uit aan de officier van justitie, die een verklaring van geen bezwaar afgeeft voordat verlof kan worden verleend (art. 10, 12); een vervroegde uitvaart vraagt ook zijn instemming (art. 17). De uitvaartondernemer regelt de uitvaart namens de nabestaanden (RVO).&#10;&#10;Elke partij voert haar deel uit in een eigen levensloopproces, dat de ketensamenwerking bedient: Toestaan lijkbezorging door de gemeente als overheid, Begraven en cremeren stoffelijk overschot door de houder van de begraafplaats of het crematorium, en Verzorgen gemeentebegrafenis, waarin de burgemeester de bezorging regelt als niemand anders dat doet. Niemand stuurt het geheel aan (estafette); het ketenproces erboven is geen element (besluit redacteur 2026-10-08)." />
              <property key="wiki-gemma-model synoniemen" value="Bezorgen lijken (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsinteracties/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/bezorgen-stoffelijk-overschot.md" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="stoffelijk-overschot" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
          </folder>
        </folder>
      </folder>
      <folder name="Procesindeling naar kernobject" id="id-cfc2bdd6c566524c98097b69e78f9c7e">
        <folder name="0 Bestuur en Ondersteuning" id="id-fb9215fa0d4b5e8fa8e1421430abdf9a">
          <folder name="Burgerzaken" id="id-f486ea518ce85db88bdf42bd4b342612">
            <element xsi:type="archimate:BusinessProcess" name="Registreren kiesgerechtigdheid" id="id-0099da24b2e55b4183614a535b8cd4b9">
              <documentation>Het registreren van wie in de gemeente kiesgerechtigd is, met de uitsluiting van het kiesrecht en de deelname van EU-onderdanen aan de Europese verkiezingen.</documentation>
              <property key="wiki-gemma-model id" value="registreren-kiesgerechtigdheid" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-kieswet-bwbr0004627; 2025-vng-upl-producten-en-diensten-extern; 2026-rvig-hup-kiesrecht; 2026-rvig-hup-europees-kiesrecht; 2026-rvig-hup-nederlands-kiesrecht" />
              <property key="wiki-gemma-model beschrijving" value="Burgemeester en wethouders registreren de kiesgerechtigdheid van de ingezetenen; wie als ingezetene met een adres in de basisregistratie personen staat, wordt geacht daar te wonen (Kieswet art. B 4, D 1). Kiesgerechtigd voor de gemeenteraad zijn ook niet-Nederlanders met verblijfsrecht na vijf jaar verblijf in Nederland (art. B 3). Op verzoek delen B&amp;W onverwijld mee of iemand als kiezer is geregistreerd, en zo niet waarom; wie ten onrechte niet is geregistreerd, kan om wijziging vragen (art. D 5, D 6, D 7).&#10;&#10;Een uitsluiting van het kiesrecht volgt uit een onherroepelijke rechterlijke uitspraak; de minister van Justitie en Veiligheid meldt haar aan de burgemeester, die de persoon in kennis stelt, en de gemeente legt haar vast in de persoonslijst (art. B 5; HUP Nederlands kiesrecht). Tegenspraak: de HUP spreekt van een mededeling aan de gemeente en noemt de kennisgeving aan de persoon niet; formeel geldt de Kieswet. Een EU-onderdaan die in Nederland wil stemmen voor het Europees Parlement, verzoekt met formulier Y32 om registratie; de gemeente informeert hem daarover bij de aangifte van verblijf en adres, en de registratie eindigt op verzoek, bij vertrek of bij verkrijging van het Nederlanderschap (HUP Europees kiesrecht).&#10;&#10;De registratie van kiezers buiten Nederland is een taak van één gemeente, 's-Gravenhage (Kieswet art. D 2, D 3)." />
              <property key="wiki-gemma-model synoniemen" value="Kiezersregistratie (dagelijks gebruik)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/registreren-kiesgerechtigdheid.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="ingeschreven-persoon" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Beheren reisdocumenten" id="id-02e07906868a53b98ed532460422c997">
              <documentation>Het behandelen van aanvragen, verstrekken en uitreiken van reisdocumenten en het verwerken van vermissing, inhouding en verval ervan.</documentation>
              <property key="GEMMA type" value="Bedrijfsproces (cluster)" />
              <property key="wiki-gemma-model id" value="beheren-reisdocumenten" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-paspoortwet-bwbr0005212; 2026-utrecht-burgerzaken-paspoort-of-identiteitskaart-aanvragen; 2025-vng-upl-producten-en-diensten-extern; 2026-rijk-paspoortbesluit-bwbr0044308; 2026-rvig-hup-inhouding-inlevering-vermissing" />
              <property key="wiki-gemma-model beschrijving" value="De burgemeester neemt de aanvraag in ontvangst, verstrekt het reisdocument binnen vier weken en reikt het binnen twee weken daarna uit, voor wie als ingezetene met een adres in zijn gemeente in de basisregistratie personen staat (Paspoortwet art. 26, 40, 41, 42). Een aangewezen gemeente behandelt ook aanvragen van niet-ingezetenen (Paspoortbesluit art. 3.2, 4.2). De Nederlandse identiteitskaart heeft een eigen wet, maar valt voor vermissing, signalering en inhouding ook onder de Paspoortwet (art. 1 onder u, 25, 50b).&#10;&#10;Het reisdocument eindigt door verval van rechtswege, bijvoorbeeld na vermissing, wijziging van de naam of overlijden, of door vervallenverklaring op verzoek van een tot signalering bevoegd orgaan; de burgemeester houdt het in en onttrekt het definitief aan het verkeer (Paspoortwet art. 44, 47, 54). Het blijft rijkseigendom; de minister laat het maken en houdt het register vermiste of vervallen reisdocumenten, het basisregister reisdocumenten en het register paspoortsignaleringen bij (art. 2, 4a, 4c, 25).&#10;&#10;De bedrijfsprocessen leveren de diensten van de UPL voor reisdocumenten (paspoort, identiteitskaart, vluchtelingen- en vreemdelingenpaspoort) en de melding van vermissing. De gemeente legt de uitgereikte Nederlandse reisdocumenten en de signalering vast in categorie 12 van de persoonslijst (HUP Reisdocument)." />
              <property key="wiki-gemma-model synoniemen" value="Reisdocumenten (dagelijks gebruik)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/beheren-reisdocumenten.md" />
              <property key="wiki-gemma-model procesniveau" value="levensloopproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="reisdocument" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Behandelen verzoek om verwijdering van gegevens" id="id-066b19a1277659a7bad68fb6357d7736">
              <documentation>Het beslissen op een verzoek om gegevens van vóór een adoptie of geslachtswijziging van de persoonslijst te verwijderen.</documentation>
              <property key="wiki-gemma-model id" value="behandelen-verzoek-om-verwijdering-van-gegevens" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-utrecht-burgerzaken-persoonsgegevens-opvragen-of-aanpassen-brp; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="Na een adoptie of een wijziging van de vermelding van het geslacht kunnen de betrokkenen schriftelijk vragen de oude gegevens van de persoonslijst te verwijderen: voor een adoptiekind jonger dan 16 jaar de adoptieouders, daarna het kind zelf, en de biologische ouders voor de gegevens over het kind; bij een geslachtswijziging de ingeschrevene, of voor hem de ouder, voogd of curator (Utrecht Gegevens verwijderen). De gemeente neemt binnen vier weken een besluit waartegen bezwaar mogelijk is (Utrecht). Het afvoeren van een ten onrechte opgenomen persoonslijst is een registratiestap zonder eigen besluit (HUP Afvoeren persoonslijst)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/behandelen-verzoek-om-verwijdering-van-gegevens.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="ingeschreven-persoon" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Behandelen verzoek om correctie" id="id-0c641a76f6495bb2ac35bcadfac15e94">
              <documentation>Het beslissen op een verzoek van een ingeschrevene om onjuiste gegevens in de basisregistratie personen te corrigeren.</documentation>
              <property key="wiki-gemma-model id" value="behandelen-verzoek-om-correctie" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-utrecht-burgerzaken-persoonsgegevens-opvragen-of-aanpassen-brp; 2026-rvig-hup-correcties-en-ten-onrechte-opgenomen-gegevens; 2018-nvvb-stappenplan-identiteitswijziging-brp; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="De burger kan vragen gegevens te laten aanpassen: adresgegevens, zoals een onjuiste inschrijfdatum, of persoonsgegevens zoals naam, geslacht en geboortedatum, met bewijsstukken; de gemeente beoordeelt de bewijsstukken en neemt binnen vier weken een besluit waartegen bezwaar mogelijk is (Utrecht Persoonsgegevens aanpassen). Wijzigt daardoor in feite de identiteit, zoals bij een andere geboortedatum, dan zijn gemeenten bijzonder terughoudend; de NVVB heeft een stappenplan, een model rectificatieverzoek en een model weigeringsbeschikking (NVVB Identiteitswijziging). Correcties na een eigen constatering of een onderzoek zijn registratiestappen zonder eigen besluit (HUP Correcties)." />
              <property key="wiki-gemma-model synoniemen" value="Correctieverzoek (HUP)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/behandelen-verzoek-om-correctie.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="ingeschreven-persoon" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Vervallen verklaren reisdocument" id="id-0ccac03565425fd493243c7f19592309">
              <documentation>Het beslissen dat een ingehouden reisdocument ongeldig is, omdat een tot signalering bevoegd orgaan daar gronden voor heeft.</documentation>
              <property key="wiki-gemma-model id" value="vervallen-verklaren-reisdocument" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-paspoortwet-bwbr0005212" />
              <property key="wiki-gemma-model beschrijving" value="Na de inhouding gaat de burgemeester na of de gronden nog bestaan en kondigt hij binnen vier weken zijn voornemen aan; de houder kan vragen de beslissing acht weken aan te houden om met de autoriteit bij wie de gronden bestaan overeenstemming te bereiken. Zonder overeenstemming verklaart hij het document vervallen, tenzij de houder onevenredig wordt benadeeld; dan geeft hij het terug of verstrekt hij een document met beperkte geldigheid (Paspoortwet art. 44, 45). Hij deelt zijn beslissing mee aan de minister, die haar opneemt in het register paspoortsignaleringen (art. 45 lid 3).&#10;&#10;De gronden liggen bij andere organen: het openbaar ministerie, de minister van Justitie en Veiligheid, de rechter-commissaris, een minister of een tot invordering bevoegd orgaan zoals het college van burgemeester en wethouders (Paspoortwet art. 18 tot en met 24). Dezelfde gronden kunnen leiden tot weigering bij een aanvraag (art. 44).&#10;&#10;De burgemeester kan als met de uitvoering van de Paspoortwet belaste autoriteit zelf om weigering of vervallenverklaring verzoeken bij het gegronde vermoeden van fraude met reisdocumenten of Nederlandse identiteitskaarten (Paspoortwet art. 24 onder b); het college doet dat als tot invordering bevoegd orgaan (art. 22)." />
              <property key="wiki-gemma-model synoniemen" value="Vervallenverklaring (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/vervallen-verklaren-reisdocument.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="reisdocument" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Inschrijven levenloos geboren kind" id="id-0cdf10a6ecac5c559c40383e9b6aa4e2">
              <documentation>Het beslissen op het verzoek van een ouder om de gegevens van een levenloos geboren kind in de basisregistratie personen op te nemen.</documentation>
              <property key="wiki-gemma-model id" value="inschrijven-levenloos-geboren-kind" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-brp-bwbr0033715; 2025-vng-upl-producten-en-diensten-extern; 2026-utrecht-burgerzaken-levenloos-geboren-kind-of-overleden-pasgeboren-kind-aangifte-doen; 2026-rvig-hup-geboorte" />
              <property key="wiki-gemma-model beschrijving" value="Een levenloos geboren kind wordt alleen op verzoek van een ouder in de BRP opgenomen; een kind dat kort heeft geleefd wordt automatisch ingeschreven (HUP Geboorte; Utrecht). Het weigeren van de opname is een besluit in de zin van de Awb (Wet BRP art. 2.60; HUP Geboorte). Afbakening als bedrijfsproces: besluit redacteur 2026-10-06." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/inschrijven-levenloos-geboren-kind.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="ingeschreven-persoon" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Behandelen aanvraag reisdocument" id="id-1258ce900ddb538bbc333d1816fd932c">
              <documentation>Het in ontvangst nemen en beoordelen van een aanvraag voor een paspoort, identiteitskaart of ander reisdocument, tot verstrekking of weigering.</documentation>
              <property key="wiki-gemma-model id" value="behandelen-aanvraag-reisdocument" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-paspoortwet-bwbr0005212; 2026-utrecht-burgerzaken-paspoort-of-identiteitskaart-aanvragen; 2026-rijk-paspoortbesluit-bwbr0044308; 2025-vng-upl-producten-en-diensten-extern; 2026-vng-gemma-2026-10-02" />
              <property key="wiki-gemma-model beschrijving" value="De aanvrager verschijnt persoonlijk op afspraak aan de balie, met alle huidige reisdocumenten, ook verlopen, en een pasfoto; vanaf twaalf jaar worden twee vingerafdrukken opgenomen en de rechten worden bij de aanvraag betaald (Paspoortwet art. 28, 29, 33; Paspoortbesluit art. 3.6; Utrecht). De burgemeester verschaft zich zekerheid over de identiteit en de nationaliteit, uit het overgelegde reisdocument, de basisregistratie personen en het basisregister reisdocumenten; na vermissing of diefstal zonder ander reisdocument stelt hij de identiteit eerst vast (Paspoortbesluit art. 2.1; Utrecht).&#10;&#10;Voor een minderjarige geeft iedere persoon die het gezag uitoefent een verklaring van toestemming, online of op een formulier; de rechter kan haar vervangen (Paspoortwet art. 34; Utrecht). De burgemeester verstrekt binnen vier weken, tenzij er een mededeling van de minister over een signalering is; dan beslist hij of de gronden tot weigering nog bestaan (Paspoortwet art. 41, 44, 45). Een aanvraag kan ook de wijziging van gegevens in een eerder verstrekt reisdocument betreffen (art. 1 onder a, 43).&#10;&#10;Een vreemdelingenpaspoort wordt pas verstrekt nadat de minister van Justitie en Veiligheid heeft vastgesteld dat aan de voorwaarden is voldaan (Paspoortwet art. 40 lid 4; Utrecht: voorgelegd aan de IND en het ministerie van Buitenlandse Zaken). Een spoedaanvraag is een aanvraag met kortere levertijd tegen een hoger tarief (Utrecht).&#10;&#10;Voor personen die niet als ingezetene in de BRP staan, behandelen alleen aangewezen gemeenten de aanvraag: de specialisatie Behandelen aanvraag reisdocument niet-ingezetene (Paspoortbesluit art. 3.2, 4.2)." />
              <property key="wiki-gemma-model synoniemen" value="Verstrekken reisdocument (wet); Paspoort of identiteitskaart aanvragen (beleid)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/behandelen-aanvraag-reisdocument.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="reisdocument" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Beheren Nederlanderschap" id="id-1c1605dca7ff5e9d8a36a0279851e8b3">
              <documentation>Het behandelen van optie, naturalisatie en afstand, waarmee een persoon het Nederlanderschap verkrijgt of verliest.</documentation>
              <property key="GEMMA type" value="Bedrijfsproces (cluster)" />
              <property key="wiki-gemma-model id" value="beheren-nederlanderschap" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-rijkswet-op-het-nederlanderschap-bwbr0003738; 2026-rijk-besluit-verkrijging-verlies-nederlanderschap-bwbr0013605; 2026-utrecht-burgerzaken-nederlander-worden-door-naturalisatie-of-optie; 2026-utrecht-burgerzaken-nederlandse-nationaliteit-opgeven-of-verliezen; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="In het Europese deel van Nederland neemt de burgemeester optieverklaringen, naturalisatieverzoeken en verklaringen van afstand in ontvangst van wie in zijn gemeente is ingeschreven of verblijft (Besluit verkrijging en verlies Nederlanderschap art. 2, 7, 33, 63). Bij optie behandelt hij de verklaring zelf en bevestigt of weigert hij de verkrijging; bij naturalisatie onderzoekt hij het verzoek, adviseert hij de minister van Justitie en Veiligheid en reikt hij het uittreksel van het besluit uit; bij afstand neemt hij de verklaring in ontvangst en bevestigt hij haar (Rijkswet op het Nederlanderschap art. 6, 7; Besluit art. 11, 36-38, 60a, 60b, 63).&#10;&#10;Bij de naturalisatie is het een keten in het orkestratiemodel: de minister van Justitie en Veiligheid, in de praktijk de IND, beoordeelt het naturalisatieverzoek en beslist erover, adviseert bij sommige opties en kan het Nederlanderschap intrekken; hij houdt het openbare register van verklaringen, bevestigingen en verleningen (Rijkswet art. 6 lid 3, 7, 14, 15, 22; Utrecht). Een naturalisatie kan ook online bij de IND worden aangevraagd; de gemeente controleert dan bij een afspraak de identiteit en de geboorteakte, laat betalen en meldt dit aan de IND (Utrecht).&#10;&#10;De verkrijging en het verlies werken door in de basisregistratie personen, het reisdocument en het kiesrecht: de gemeente neemt de Nederlandse nationaliteit op of beëindigt haar, beëindigt bij verkrijging de verblijfstitel en de aanduiding Europees kiesrecht, en een Nederlands reisdocument vervalt bij verlies van rechtswege (HUP Nederlandse nationaliteit; Paspoortwet art. 47 lid 1 onder a en b).&#10;&#10;De gemeente voert haar deel uit in vier bedrijfsprocessen: Behandelen optieverklaring en Behandelen verklaring van afstand, waarin de burgemeester zelf beslist, en Behandelen naturalisatieverzoek en Houden naturalisatieceremonie, die de gemeente uitvoert voor de minister; het deel van de minister staat alleen in deze beschrijving (besluit redacteur 2026-10-08)." />
              <property key="wiki-gemma-model synoniemen" value="Verkrijging en verlies Nederlanderschap (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/beheren-nederlanderschap.md" />
              <property key="wiki-gemma-model procesniveau" value="levensloopproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="nederlanderschap" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Behandelen aanvraag rijbewijs" id="id-1eb41737dee15d44a95a29e5a9879969">
              <documentation>Het in ontvangst nemen en beoordelen van een aanvraag voor een rijbewijs, tot de afgifte of weigering, ook bij vernieuwing of vervanging.</documentation>
              <property key="wiki-gemma-model id" value="behandelen-aanvraag-rijbewijs" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wegenverkeerswet-1994-bwbr0006622; 2026-rijk-reglement-rijbewijzen-bwbr0008074; 2026-utrecht-burgerzaken-rijbewijs-aanvragen-of-verlengen; 2025-vng-upl-producten-en-diensten-extern; 2026-vng-gemma-2026-10-02" />
              <property key="wiki-gemma-model beschrijving" value="De aanvrager dient de aanvraag in bij de burgemeester van de gemeente waar hij als ingezetene staat, aan de balie op afspraak, met een ingevuld formulier, een identiteitsbewijs of eerder rijbewijs en een pasfoto; de burgemeester raadpleegt de basisregistratie personen (Wegenverkeerswet 1994 art. 113; Reglement rijbewijzen art. 27, 33; Utrecht). Verlengen en een categorie-uitbreiding kan ook online via de RDW met DigiD; de gemeente reikt het rijbewijs dan alleen uit (Utrecht). Een spoedaanvraag kost extra en levert sneller (Utrecht).&#10;&#10;Degene die afgeeft verschaft zich zekerheid over de identiteit en vergewist zich dat de bescheiden en de voorwaarden kloppen: de leeftijd, de rijvaardigheid en geschiktheid, geen ontzegging of invordering, en bij vernieuwing het eerdere rijbewijs en zo nodig een in het rijbewijzenregister geregistreerde verklaring van geschiktheid (Wegenverkeerswet 1994 art. 111, 112, 113; Reglement rijbewijzen art. 35). Die controle van de verklaring van geschiktheid, die het CBR registreert (art. 97), is een onderdeel van dit bedrijfsproces (UPL nr. 362 rijbewijs gezondheidsverklaring; Reglement rijbewijzen art. 35, 45). Daarna neemt de burgemeester het besluit tot afgifte (Wegenverkeerswet 1994 art. 116, 118a).&#10;&#10;Bij vermissing legt de aanvrager een proces-verbaal van vermissing of diefstal over, op ambtseed opgemaakt door een opsporingsambtenaar (Reglement rijbewijzen art. 39 lid 1); Utrecht spreekt van een vermissingsverklaring die men aan de balie invult, een verschil dat uit de bronnen niet te verklaren is (verificatie nodig). Een aanvrager die niet als ingezetene staat ingeschreven, dient de aanvraag in bij de burgemeester van zijn woonplaats, die haar doorgeleidt naar de RDW; die geeft dan af (Reglement rijbewijzen art. 29, 105 lid 2)." />
              <property key="wiki-gemma-model synoniemen" value="Afgeven rijbewijs (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/behandelen-aanvraag-rijbewijs.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="rijbewijs" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Bijhouden burgerlijke stand" id="id-1ec6bb6de74d5b8eb565c0f7367a1348">
              <documentation>Het opmaken en bijhouden van de akten van de burgerlijke stand in de registers van de gemeente, van opmaken tot latere vermelding en afgifte.</documentation>
              <property key="GEMMA type" value="Bedrijfsproces (cluster)" />
              <property key="wiki-gemma-model id" value="bijhouden-burgerlijke-stand" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rvig-hup-algemeen; 2026-rijk-burgerlijk-wetboek-boek-1; 2026-rijk-besluit-burgerlijke-stand-1994-bwbr0006493; 2026-rvig-hup-vaststelling-ouderschap; 2026-utrecht-burgerzaken-voornaam-of-achternaam-veranderen" />
              <property key="wiki-gemma-model beschrijving" value="De ambtenaar van de burgerlijke stand maakt de akten op van geboorte, erkenning, naamskeuze, huwelijk, geregistreerd partnerschap, omzetting en overlijden, schrijft rechterlijke uitspraken en buitenlandse akten in en voegt latere vermeldingen toe, zoals een naamswijziging, adoptie, geslachtswijziging of echtscheiding (BW 1 art. 16a, 18, 20). Hij weigert een akte bij ongenoegzame bescheiden of strijd met de openbare orde; de belanghebbende kan dan de rechtbank verzoeken (art. 18c, 27).&#10;&#10;De registers worden aan het eind van het jaar afgesloten; dubbelen en latere vermeldingen gaan naar de centrale bewaarplaats van de minister (Besluit burgerlijke stand art. 6, 7, 31). Een akte is een brondocument voor de BRP: de gemeente verwerkt haar in Bijhouden persoonsgegevens (HUP Algemeen).&#10;&#10;De bedrijfsprocessen leveren elk een akte, latere vermelding of afschrift, en daarmee de diensten van de burgerlijke stand uit de UPL. Burgemeester en wethouders wijzen de ambtenaren aan en zorgen voor de voorzieningen (BW 1 art. 16, 16d; Besluit burgerlijke stand art. 2-4)." />
              <property key="wiki-gemma-model synoniemen" value="Houden van de registers van de burgerlijke stand (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/bijhouden-burgerlijke-stand.md" />
              <property key="wiki-gemma-model procesniveau" value="levensloopproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="akte-van-de-burgerlijke-stand" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Registreren partnerschap" id="id-1f0af608032e587fb384e7e2d94d8ec0">
              <documentation>Het registreren van een geregistreerd partnerschap of het omzetten daarvan in een huwelijk, met het opmaken van de akte.</documentation>
              <property key="wiki-gemma-model id" value="registreren-partnerschap" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-burgerlijk-wetboek-boek-1; 2026-utrecht-burgerzaken-geregistreerd-partnerschap-aanvragen; 2026-rijk-besluit-burgerlijke-stand-1994-bwbr0006493; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="Het partnerschap wordt geregistreerd bij akte, opgemaakt door de ambtenaar; een ja-woord is niet verplicht (BW 1 art. 80a; Utrecht). Een partnerschap kan worden omgezet in een huwelijk met een akte van omzetting, zonder melding vooraf en zonder getuigen (BW 1 art. 80g; Utrecht). Locaties, tarieven en trouwambtenaar volgen het huwelijk (Utrecht Trouwen in Utrecht)." />
              <property key="wiki-gemma-model synoniemen" value="Registratie van partnerschap (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/registreren-partnerschap.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="akte-van-de-burgerlijke-stand" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Bijhouden persoonsgegevens" id="id-1f731112e5db53e0a1d0cfb864edc17a">
              <documentation>Het bijhouden van de gegevens van een ingeschreven persoon in de basisregistratie personen, van inschrijving tot opschorting.</documentation>
              <property key="GEMMA type" value="Bedrijfsproces (cluster)" />
              <property key="wiki-gemma-model id" value="bijhouden-persoonsgegevens" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rvig-hup-algemeen; 2026-rvig-hup-achtergronden-en-begrippen; 2023-rvig-circulaire-adresonderzoek-brp; 2025-rvig-logisch-ontwerp-brp-2025q1; 2026-rvig-hup-intergemeentelijke-adreswijziging; 2026-rijk-besluit-brp-bwbr0034306; 2026-rvig-hup-immigratie; 2026-rvig-hup-hervestiging; 2026-utrecht-burgerzaken-registratie-niet-ingezetenen-rni-inschrijven; 2026-rvig-hup-binnengemeentelijke-adreswijziging; 2026-rvig-hup-emigratie; 2026-rvig-hup-verblijfplaats; 2026-rvig-hup-verstrekkingsbeperking; 2024-nvvb-schema-schriftelijke-gegevensverstrekking-brp; 2026-utrecht-burgerzaken-persoonsgegevens-brp-bekijken-en-overzicht-aanvragen; 2025-vng-upl-producten-en-diensten-extern; 2026-rvig-hup-correcties-en-ten-onrechte-opgenomen-gegevens; 2026-utrecht-burgerzaken-persoonsgegevens-opvragen-of-aanpassen-brp; 2026-rvig-hup-wijzigen-identificatienummers; 2026-rijk-wet-brp-bwbr0033715; 2026-rvig-hup-geboorte; 2026-rvig-hup-wijziging-naamgebruik; 2026-utrecht-burgerzaken-buitenlandse-documenten-inschrijven; 2026-rvig-hup-overlijden-buitenland; 2026-rvig-hup-nederlandse-nationaliteit; 2026-rijk-kieswet-bwbr0004627; 2026-rvig-hup-kiesrecht; 2026-rvig-hup-nederlands-kiesrecht" />
              <property key="wiki-gemma-model beschrijving" value="Bijhouden omvat het inschrijven van personen en het actualiseren, corrigeren en verwijderen van gegevens (HUP Achtergronden). De bijhouding is per gebeurtenis opgezet: een aangifte van de persoon, een akte uit de registers van de burgerlijke stand of een ander document, zoals een buitenlandse akte of een rechterlijke uitspraak; de gemeente ontleent de gegevens aan zulke brondocumenten (HUP Algemeen; HUP Achtergronden). Het college van de gemeente waar een ingezetene zijn adres heeft is verantwoordelijk; bij een verhuizing naar een andere gemeente gaat de persoonslijst naar de nieuwe bijhoudingsgemeente, bij emigratie naar de RNI (HUP Achtergronden; LO BRP 1.6).&#10;&#10;Registratiestappen zonder eigen besluit of product zijn processtappen zonder pagina: het onderzoeken en in onderzoek stellen van gegevens, het vaststellen van de identiteit, het afvoeren van een persoonslijst na een dubbele inschrijving en het leggen van relaties tussen persoonslijsten (HUP Proceduregegevens; HUP Dubbelinschrijving; HUP Gerelateerden)." />
              <property key="wiki-gemma-model synoniemen" value="Bijhouding (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/bijhouden-persoonsgegevens.md" />
              <property key="wiki-gemma-model procesniveau" value="levensloopproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="ingeschreven-persoon" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Verwerken vermissing reisdocument" id="id-238659a29542550eaf6538a6e367306b">
              <documentation>Het ontvangen en registreren van de melding dat een reisdocument kwijt of gestolen is, waardoor het document ongeldig wordt.</documentation>
              <property key="wiki-gemma-model id" value="verwerken-vermissing-reisdocument" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-utrecht-burgerzaken-paspoort-of-identiteitskaart-vermissing-of-diefstal-doorgeven; 2026-rvig-hup-inhouding-inlevering-vermissing; 2026-rijk-paspoortwet-bwbr0005212; 2026-rvig-hup-reisdocument" />
              <property key="wiki-gemma-model beschrijving" value="De houder meldt de vermissing per document, online en gratis; de gemeente registreert de schriftelijke verklaring van vermissing direct (Utrecht; HUP Inhouding). Met de registratie wordt het document in het basisregister reisdocumenten automatisch ongeldig en vervalt het van rechtswege (HUP Inhouding; Paspoortwet art. 47 lid 1 onder j). De minister vermeldt vermiste reisdocumenten in het register vermiste of vervallen reisdocumenten, ter voorkoming van fraude (art. 4a).&#10;&#10;Een vermissing is onomkeerbaar: een teruggevonden document wordt nooit meer teruggegeven, maar ingeleverd bij de gemeente (HUP Inhouding; Utrecht). Wie na een vermissing een nieuw document aanvraagt zonder ander reisdocument, laat eerst de identiteit vaststellen (Utrecht)." />
              <property key="wiki-gemma-model synoniemen" value="Melding van vermissing (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/verwerken-vermissing-reisdocument.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="reisdocument" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Behandelen verzoek om volmacht" id="id-26ecf3951a895700ba357a276a10f611">
              <documentation>Het behandelen van het schriftelijke verzoek van een kiezer om bij volmacht te stemmen, tot inwilliging met een volmachtbewijs of afwijzing.</documentation>
              <property key="wiki-gemma-model id" value="behandelen-verzoek-om-volmacht" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-kieswet-bwbr0004627; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="Een kiezer die verwacht niet in persoon te kunnen stemmen, kan bij volmacht stemmen: op een schriftelijke aanvraag bij de burgemeester, of door zijn stempas of kiezerspas met de gemachtigde te ondertekenen en over te dragen, zonder tussenkomst van de gemeente (Kieswet art. L 1, L 2, L 14). Bij het verzoekschrift op een formulier wijst de kiezer een gemachtigde aan die zelf als kiezer is geregistreerd en zich bereid verklaart (art. L 8). De burgemeester beslist zo spoedig mogelijk, niet eerder dan op de dag van de kandidaatstelling; bij inwilliging maakt hij een volmachtbewijs op voor de gemachtigde en wordt de stempas van de volmachtgever ongeldig; een afwijzing deelt hij met redenen mee (art. L 6, L 11, J 7a)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/behandelen-verzoek-om-volmacht.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="stempas" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Behandelen verzoek om geheimhouding" id="id-2fb8a0f54f775b1980b9b7047ba889d1">
              <documentation>Het verwerken van een verzoek om persoonsgegevens niet aan bepaalde derden te verstrekken, of om die geheimhouding te beëindigen.</documentation>
              <property key="wiki-gemma-model id" value="behandelen-verzoek-om-geheimhouding" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-utrecht-burgerzaken-persoonsgegevens-geheimhouden; 2026-rvig-hup-verstrekkingsbeperking; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="De burger kan verstrekking aan overheidsorganen op grond van een autorisatiebesluit niet tegenhouden, maar wel schriftelijk verzoeken geen gegevens te verstrekken aan bepaalde derden (HUP Verstrekkingsbeperking). Het verzoek is vormvrij en hoeft niet te worden gemotiveerd; de gemeente stelt de identiteit vast, verwerkt het binnen vier weken, bevestigt het schriftelijk en weigert het niet als de juiste persoon het doet (HUP Verstrekkingsbeperking). Online kan het met DigiD binnen vijf werkdagen; de geheimhouding verhuist mee naar een nieuwe gemeente (Utrecht Persoonsgegevens geheimhouden)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/behandelen-verzoek-om-geheimhouding.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="ingeschreven-persoon" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Inschrijven ingezetene" id="id-3044d66d8ce65ffa81be0f88936c11e0">
              <documentation>Het inschrijven van een persoon die zich vanuit het buitenland in de gemeente vestigt als ingezetene in de basisregistratie personen.</documentation>
              <property key="wiki-gemma-model id" value="inschrijven-ingezetene" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-utrecht-burgerzaken-inschrijven-vanuit-het-buitenland; 2026-rvig-hup-immigratie; 2026-rvig-hup-hervestiging; 2026-rijk-besluit-brp-bwbr0034306; 2025-vng-upl-producten-en-diensten-extern; 2026-utrecht-burgerzaken-adoptie-kind-inschrijven" />
              <property key="wiki-gemma-model beschrijving" value="Wie zich vanuit het buitenland in de gemeente vestigt, doet uiterlijk de vijfde dag na aanvang van het verblijf in persoon aangifte van verblijf en adres (HUP Immigratie). De gemeente stelt de identiteit vast, toetst de criteria (waaronder rechtmatig verblijf), gaat na of de persoon al in de BRP of RNI voorkomt, verifieert het adres en schrijft de persoon in met een A-nummer en een BSN; binnen vier weken stuurt zij een volledig overzicht van de persoonslijst (HUP Immigratie; Utrecht Inschrijven vanuit het buitenland). Kan de geboortedatum of de vreemde nationaliteit niet uit de gewone bronnen worden ontleend, dan vraagt de gemeente een mededeling ex artikel 2.17 Wet BRP op bij de IND (NVVB mededeling art. 2.17). Ontbreekt een brondocument, dan neemt de gemeente een verklaring onder eed of belofte af (HUP Immigratie; UPL nr. 335).&#10;&#10;Bij een hervestiging staat de persoon al in de RNI: de gemeente wordt bijhoudingsgemeente en stelt alle gegevens vast aan de hand van brondocumenten (HUP Hervestiging). Het college beslist over de inschrijving (Besluit BRP art. 24)." />
              <property key="wiki-gemma-model synoniemen" value="Eerste inschrijving (LO BRP)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/inschrijven-ingezetene.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="ingeschreven-persoon" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Inschrijven ontbinding huwelijk of partnerschap" id="id-3120b4f9551e546c83b17b2a23e638bc">
              <documentation>Het inschrijven van een echtscheiding of van de beëindiging van een geregistreerd partnerschap in de registers van de burgerlijke stand.</documentation>
              <property key="wiki-gemma-model id" value="inschrijven-ontbinding-huwelijk-of-partnerschap" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-burgerlijk-wetboek-boek-1; 2026-utrecht-burgerzaken-scheiden-of-geregistreerd-partnerschap-beeindigen; 2026-rijk-besluit-burgerlijke-stand-1994-bwbr0006493; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="De advocaat stuurt de echtscheidingsbeschikking naar de gemeente waar het huwelijk is gesloten, die de echtscheiding op de huwelijksakte zet; bij een partnerschap sturen advocaat of notaris de stukken naar de gemeente van registratie (Utrecht). Bij een huwelijk in het buitenland gaat het naar Den Haag. De woongemeente verwerkt de ontbinding in de BRP (Utrecht). Een buitenlandse echtscheiding wordt verwerkt als buitenlands document (Utrecht Scheiden)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/inschrijven-ontbinding-huwelijk-of-partnerschap.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="akte-van-de-burgerlijke-stand" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Behandelen melding voorgenomen huwelijk of partnerschap" id="id-39eb386b0f6c5149a75d1211bbd14332">
              <documentation>Het ontvangen en toetsen van de melding van een voorgenomen huwelijk of geregistreerd partnerschap.</documentation>
              <property key="wiki-gemma-model id" value="behandelen-melding-voorgenomen-huwelijk-of-partnerschap" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-utrecht-burgerzaken-voorgenomen-huwelijk-of-geregistreerd-partnerschap-melden; 2026-rijk-burgerlijk-wetboek-boek-1; 2026-rijk-besluit-burgerlijke-stand-1994-bwbr0006493; 2026-utrecht-burgerzaken-trouwen-in-het-buitenland; 2025-vng-upl-producten-en-diensten-extern; 2026-utrecht-burgerzaken-trouwen-in-utrecht; 2026-utrecht-burgerzaken-geregistreerd-partnerschap-aanvragen" />
              <property key="wiki-gemma-model beschrijving" value="De aanstaande echtgenoten verstrekken hun gegevens, een verklaring over bloedverwantschap en eerdere huwelijken, de getuigen en zo nodig gegevens over het verblijfsrecht; de ambtenaar verifieert die in de BRP, bewaart de verklaring omtrent verblijfsrecht twaalf jaar voor de IND en meldt een vermoeden van een schijnhuwelijk (BW 1 art. 18, 44, 58; Besluit burgerlijke stand art. 28). Bij beletselen stuit het openbaar ministerie het huwelijk (BW 1 art. 80a lid 4). De melding vervalt na een jaar (art. 46).&#10;&#10;Online met DigiD, door beide partners elk met een eigen formulier, of aan de balie; gratis (Utrecht). Wie in het buitenland woont, meldt bij de gemeente Den Haag (Utrecht)." />
              <property key="wiki-gemma-model synoniemen" value="Kennisgeving van het voornemen te trouwen (wet); Ondertrouw (dagelijks gebruik)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/behandelen-melding-voorgenomen-huwelijk-of-partnerschap.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="akte-van-de-burgerlijke-stand" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Opmaken akte van erkenning" id="id-45ef4ca1fbe855a9bae9d7101c400ec3">
              <documentation>Het opnemen van de erkenning van een kind door een man of vrouw in een akte van erkenning, voor of na de geboorte.</documentation>
              <property key="wiki-gemma-model id" value="opmaken-akte-van-erkenning" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-burgerlijk-wetboek-boek-1; 2026-rijk-besluit-burgerlijke-stand-1994-bwbr0006493; 2026-utrecht-burgerzaken-kind-erkennen; 2026-rvig-hup-erkenning; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="De vader of duomoeder die niet met de moeder is getrouwd of een geregistreerd partnerschap heeft, kan het kind voor of na de geboorte erkennen. Toestemming is nodig van de moeder bij een kind jonger dan twaalf, van moeder en kind tussen twaalf en zestien, en van het kind zelf vanaf zestien (BW 1 art. 204; Utrecht). Bij de erkenning legt de erkenner de keuze van de achternaam vast en regelt hij het gezag: samen, of de verklaring dat de moeder alleen gezag heeft, die de ambtenaar aan de griffier meldt (BW 1 art. 251b; Utrecht).&#10;&#10;Een erkenning kan ook bij notariële akte; die leidt tot een latere vermelding op de geboorteakte. Een nietige of door de rechter vernietigde erkenning wordt gecorrigeerd of als latere vermelding verwerkt (HUP Erkenning)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/opmaken-akte-van-erkenning.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="akte-van-de-burgerlijke-stand" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Behandelen aanvraag verklaring omtrent het gedrag" id="id-4a6bc485eb1f54088c1f61f0151c7dbd">
              <documentation>Het in ontvangst nemen van een VOG-aanvraag, het controleren van de volledigheid en de identiteit en het doorzenden ervan naar de minister.</documentation>
              <property key="wiki-gemma-model id" value="behandelen-aanvraag-verklaring-omtrent-het-gedrag" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-justitiele-en-strafvorderlijke-gegevens-bwbr0014194; 2026-utrecht-burgerzaken-verklaring-omtrent-het-gedrag-aanvragen-vog; 2026-vng-gemma-impact-ketensamenwerking; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="De aanvrager die als ingezetene in de gemeente staat, dient de aanvraag van een natuurlijk persoon in bij de burgemeester, online met een scan van het formulier van de werkgever of aan de balie op afspraak met dat formulier en een identiteitsbewijs, en betaalt direct (Wet justitiële en strafvorderlijke gegevens art. 30, 32, 33; Utrecht). De burgemeester onderzoekt de volledigheid van de gegevens, verschaft zich zekerheid over de identiteit en zendt de aanvraag terstond door aan de minister; de gemeente is de minister een vergoeding verschuldigd voor aanvragen die bij haar zijn ingediend (art. 30 lid 2 en 4, 39).&#10;&#10;De minister van Justitie en Veiligheid, in de praktijk Justis, onderzoekt het gedrag en beslist binnen vier weken en stuurt de aanvrager bericht (art. 35 tot en met 37; Utrecht); de gemeente reikt de verklaring niet uit. Een aanvraag van een rechtspersoon, van wie niet als inwoner in de BRP staat ingeschreven, of die de werkgever rechtstreeks bij Justis doet, loopt buiten de gemeente om (art. 30 lid 1, 31; Utrecht).&#10;&#10;Het is het deel dat de gemeente voor de minister uitvoert, binnen het levensloopproces Afgeven verklaring omtrent het gedrag." />
              <property key="wiki-gemma-model synoniemen" value="Doorzenden aanvraag verklaring omtrent het gedrag (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/behandelen-aanvraag-verklaring-omtrent-het-gedrag.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="verklaring-omtrent-het-gedrag" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Verstrekken uittreksels en verklaringen burgerlijke stand" id="id-4de71180745a5a17a5934bb8ac1e090d">
              <documentation>Het op verzoek afgeven van afschriften en uittreksels van akten van de burgerlijke stand en van verklaringen van de ambtenaar van de burgerlijke stand.</documentation>
              <property key="wiki-gemma-model id" value="verstrekken-uittreksels-en-verklaringen-burgerlijke-stand" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-burgerlijk-wetboek-boek-1; 2026-rijk-besluit-burgerlijke-stand-1994-bwbr0006493; 2026-utrecht-burgerzaken-uittreksel-of-akte-aanvragen; 2025-vng-upl-producten-en-diensten-extern; 2026-utrecht-burgerzaken-trouwen-in-het-buitenland" />
              <property key="wiki-gemma-model beschrijving" value="Akten van de burgerlijke stand zijn openbaar, tenzij de wet anders bepaalt; een authentiek afschrift of uittreksel heeft dezelfde bewijskracht als de akte (BW 1 art. 22a, 23). Een afschrift bevat ook latere vermeldingen, een uittreksel de toestand op het moment van afgifte; meertalige uittreksels volgen de Weense overeenkomst (Besluit burgerlijke stand art. 24, 26). Utrecht verstrekt uittreksels en afschriften online, aan de balie of per post (Utrecht Uittreksel of akte aanvragen).&#10;&#10;Ook verklaringen die de ambtenaar afgeeft vallen hieronder, zoals het bewijs van in leven zijn (attestatie de vita, BW 1 art. 19k) en de verklaring van huwelijksbevoegdheid." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/verstrekken-uittreksels-en-verklaringen-burgerlijke-stand.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="akte-van-de-burgerlijke-stand" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Houden naturalisatieceremonie" id="id-4e64dad3eea45ae283de949b8f9255ca">
              <documentation>Het oproepen van nieuwe Nederlanders en het uitreiken van de bevestiging of het naturalisatiebesluit, na de verklaring van verbondenheid.</documentation>
              <property key="wiki-gemma-model id" value="houden-naturalisatieceremonie" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-utrecht-burgerzaken-nederlander-worden-door-naturalisatie-of-optie; 2025-vng-upl-producten-en-diensten-extern; 2026-rijk-besluit-verkrijging-verlies-nederlanderschap-bwbr0013605" />
              <property key="wiki-gemma-model beschrijving" value="De verkrijging door optie of naturalisatie treedt pas in werking door de uitreiking van de bevestiging of van het uittreksel van het besluit, met terugwerkende kracht tot de dagtekening (Besluit verkrijging en verlies Nederlanderschap art. 60a lid 1, 60b lid 1). De burgemeester roept de betrokkenen van zestien jaar en ouder tijdig op; bij de uitreiking legt ieder de verklaring van verbondenheid mondeling af, of schriftelijk als dat redelijkerwijs niet kan worden verlangd (art. 60a lid 2-6, 60b lid 2-6). De gemeente doet dat tijdens een naturalisatieceremonie: men wordt pas Nederlander na de ceremonie en de verklaring (Utrecht).&#10;&#10;De bevestiging wordt uitgereikt binnen negen weken nadat is vastgesteld dat aan de vereisten is voldaan; bij naturalisatie roept de burgemeester binnen zes weken na dagtekening van het besluit op. Een bevestiging die niet binnen een jaar is bekendgemaakt, vervalt; na de uitreiking bericht de burgemeester de minister (art. 60a lid 7, 11 en 12, 60b lid 2)." />
              <property key="wiki-gemma-model synoniemen" value="Uitreiken bevestiging of uittreksel (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/houden-naturalisatieceremonie.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="nederlanderschap" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Uitvoeren adresonderzoek" id="id-51cd6df863dd53da8fe6bbce08d29ad6">
              <documentation>Het onderzoeken of een persoon woont op het adres waarop hij is ingeschreven, en het besluiten over een juiste inschrijving.</documentation>
              <property key="wiki-gemma-model id" value="uitvoeren-adresonderzoek" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2023-rvig-circulaire-adresonderzoek-brp; 2026-utrecht-burgerzaken-onjuiste-inschrijving-op-uw-adres-melding-doen-adresonderzoek; 2026-nvvb-handreiking-adresonderzoek; 2026-rijk-besluit-brp-bwbr0034306" />
              <property key="wiki-gemma-model beschrijving" value="Het adresonderzoek is het instrument waarmee de gemeente een verkeerde adresinschrijving verbetert; zij start het bij twijfel over de juistheid van adresgegevens (Circulaire adresonderzoek par. 2). Aanleidingen zijn een melding van een bewoner of organisatie, een terugmelding van een bestuursorgaan, een signaal uit de Landelijke Aanpak Adreskwaliteit (LAA), een eigen constatering of een aangifte van verhuizing (Circulaire adresonderzoek; NVVB Handreiking adresonderzoek). De gemeente legt een onderzoeksdossier aan, plaatst een aantekening in onderzoek, schrijft de persoon aan, kan een huisbezoek laten afleggen door een toezichthouder BRP en neemt na een voornemen een besluit; de melder wordt over het resultaat geïnformeerd (Circulaire adresonderzoek 3.2–4.7). Een richtlijn voor de doorlooptijd is tien weken.&#10;&#10;De uitkomst is: woont nog op het adres, inschrijving op een briefadres, vestiging vanuit het buitenland, ambtshalve verhuizing binnen of naar een andere gemeente, of ambtshalve vertrek naar het buitenland of naar een onbekend land (Circulaire adresonderzoek 4.8)." />
              <property key="wiki-gemma-model synoniemen" value="Adresonderzoek (beleid)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/uitvoeren-adresonderzoek.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="verblijfplaats" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Behandelen verklaring van afstand" id="id-5a45ff71d83d5919abf2e8dd934a52bb">
              <documentation>Het in ontvangst nemen en bevestigen van een verklaring waarmee een persoon afstand doet van het Nederlanderschap.</documentation>
              <property key="wiki-gemma-model id" value="behandelen-verklaring-van-afstand" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-utrecht-burgerzaken-nederlandse-nationaliteit-opgeven-of-verliezen; 2025-vng-upl-producten-en-diensten-extern; 2026-rijk-rijkswet-op-het-nederlanderschap-bwbr0003738; 2026-rijk-besluit-verkrijging-verlies-nederlanderschap-bwbr0013605; 2026-vng-gemma-2026-10-02" />
              <property key="wiki-gemma-model beschrijving" value="Een meerderjarige met een andere nationaliteit legt de verklaring van afstand af voor de burgemeester; die stelt eerst de identiteit vast en bepaalt welke andere personen, zoals minderjarige kinderen, door de afstand het Nederlanderschap verliezen (Rijkswet op het Nederlanderschap art. 15, 16; Besluit verkrijging en verlies Nederlanderschap art. 63 lid 1-2). Kinderen van 12 tot 16 jaar mogen hun mening geven; vanaf 16 jaar legt een kind zelf een verklaring af (Utrecht).&#10;&#10;De persoon ontvangt onverwijld een bevestiging (Besluit art. 63 lid 3). De burgemeester zendt de verklaring en een afschrift van de bevestiging aan de minister en aan de bijhoudingsgemeente, en bevordert dat de afstand in de basisregistratie personen wordt verwerkt en de Nederlandse reisdocumenten en identiteitskaarten worden ingenomen (art. 64). Weigert de gemeente het verlies te bevestigen, dan staat beroep open bij de rechtbank Den Haag en daarna cassatie bij de Hoge Raad (Utrecht)." />
              <property key="wiki-gemma-model synoniemen" value="Afstand van het Nederlanderschap (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/behandelen-verklaring-van-afstand.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="nederlanderschap" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Verwerken emigratie" id="id-6c6d0392474d50fdada6188db6b42a75">
              <documentation>Het verwerken van het vertrek van een ingezetene naar het buitenland, waarna hij als niet-ingezetene in de RNI staat.</documentation>
              <property key="wiki-gemma-model id" value="verwerken-emigratie" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-utrecht-burgerzaken-emigratie-doorgeven; 2026-rvig-hup-emigratie; 2026-rijk-besluit-brp-bwbr0034306; 2025-rvig-logisch-ontwerp-brp-2025q1; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="Wie ten minste twee derde van een jaar in het buitenland gaat wonen, doet aangifte van vertrek, vanaf vijf dagen voor het vertrek; ook een verhuizing naar het Caribisch deel van het Koninkrijk is een emigratie, waarbij de persoon kosteloos een verhuisbericht krijgt (HUP Emigratie; Regeling BRP bijlage 9). Na verwerking verhuist de persoonslijst naar de RNI en blijft de laatste bijhoudingsgemeente verantwoordelijk voor rechtsfeiten van voor de emigratie (HUP Emigratie). Is de persoon niet te bereiken, dan neemt de gemeente het vertrek ambtshalve op na een adresonderzoek (HUP Emigratie; Circulaire adresonderzoek 4.8)." />
              <property key="wiki-gemma-model synoniemen" value="Uitschrijving (dagelijks gebruik)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/verwerken-emigratie.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="ingeschreven-persoon" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Verstrekken stempas" id="id-6ea9fef05e9c5a8e83e38ea3547c1974">
              <documentation>Het vaststellen, personaliseren en toezenden van stempassen aan de kiezers, en het uitreiken van een nieuwe stempas op verzoek.</documentation>
              <property key="wiki-gemma-model id" value="verstrekken-stempas" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-kieswet-bwbr0004627; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="Daags na de kandidaatstelling stelt de burgemeester de gegevens vast voor het personaliseren van de stempassen, met de informatie van de minister voor de productie (Kieswet art. J 7 lid 1 en 4). Ten minste veertien dagen voor de stemming ontvangt elke kiezer een stempas met volgnummer (art. J 7 lid 2). Wie zijn stempas kwijt is of niet heeft ontvangen, vraagt schriftelijk tot de vijfde dag voor de stemming of mondeling tot de dag voor de stemming om twaalf uur een nieuwe aan, met een kopie van een identiteitsbewijs; de oude wordt ongeldig. Een stempas die ongeldig is door een kiezerspas, volmacht, briefstembewijs, onterechte registratie of ontvreemding, wordt niet vervangen (art. J 7a, J 8)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/verstrekken-stempas.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="stempas" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Opmaken akte van naamskeuze" id="id-7056df7eb0f6578d82a604a1ba924e5b">
              <documentation>Het opnemen van de gezamenlijke verklaring van de ouders over de achternaam van hun kind in een akte van naamskeuze.</documentation>
              <property key="wiki-gemma-model id" value="opmaken-akte-van-naamskeuze" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-burgerlijk-wetboek-boek-1; 2026-rijk-besluit-burgerlijke-stand-1994-bwbr0006493; 2026-utrecht-burgerzaken-achternaam-kind-kiezen; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="Zonder keuze krijgt het kind de achternaam van de moeder, of van de vader bij gehuwde ouders; bij het eerste kind kunnen de ouders samen kiezen voor de achternaam van de andere ouder of, sinds 2024, een dubbele achternaam. Beide ouders zijn aanwezig met een geldig identiteitsbewijs (BW 1 art. 5; Utrecht). Een kind met een tweede nationaliteit kan de achternaam volgens die nationaliteit krijgen (Utrecht)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/opmaken-akte-van-naamskeuze.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="akte-van-de-burgerlijke-stand" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Inhouden reisdocument" id="id-71c579676b7455eebfb72cf0f1e6c111">
              <documentation>Het innemen van een vervallen, beschadigd of te weigeren reisdocument en het definitief aan het verkeer onttrekken ervan.</documentation>
              <property key="wiki-gemma-model id" value="inhouden-reisdocument" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-paspoortwet-bwbr0005212; 2026-rvig-hup-inhouding-inlevering-vermissing; 2026-rvig-hup-van-rechtswege-vervallen-reisdocument; 2026-rijk-paspoortbesluit-bwbr0044308; 2026-rvig-hup-reisdocument" />
              <property key="wiki-gemma-model beschrijving" value="Een reisdocument wordt ingehouden als het van rechtswege is vervallen, zo is beschadigd dat beveiligingskenmerken zijn aangetast of gegevens onleesbaar zijn, onbevoegd is gewijzigd, de gezichtsopname niet meer lijkt of er fouten in staan (Paspoortwet art. 54 lid 1). Een document dat vervallen kan worden verklaard, houdt de burgemeester in na een mededeling van de minister en hij beslist daarna over de vervallenverklaring (art. 44 lid 2, 53). Ook de politie en de grensbewaking zijn bevoegd tot inhouding (art. 50b).&#10;&#10;Inhouding gebeurt door een bevoegde autoriteit, inlevering op initiatief van de houder; een teruggevonden vermist document wordt ingeleverd en niet meer teruggegeven (HUP Inhouding). De gemeente registreert de inhouding of inlevering in de BRP en meldt een inhouding na een mededeling aan de minister (Paspoortwet art. 54 lid 5; Paspoortbesluit art. 6.1 lid 3). Het ingehouden document wordt terstond definitief aan het verkeer onttrokken, vernietigd of op verzoek van de houder ongeldig gemaakt en teruggegeven, tenzij het nog nodig is in een procedure (art. 1 onder j, 54 lid 3; Paspoortbesluit art. 7.1; HUP Inhouding)." />
              <property key="wiki-gemma-model synoniemen" value="Inhouding (wet); Inleveren reisdocument (beleid)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/inhouden-reisdocument.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="reisdocument" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Behandelen aanvraag omwisseling buitenlands rijbewijs" id="id-7580d648733e5be9baae8427b0ad99d2">
              <documentation>Het in ontvangst nemen van een aanvraag om een buitenlands rijbewijs om te wisselen en het doorgeleiden ervan naar de RDW, die beslist.</documentation>
              <property key="wiki-gemma-model id" value="behandelen-aanvraag-omwisseling-buitenlands-rijbewijs" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2026-rijk-reglement-rijbewijzen-bwbr0008074; 2026-utrecht-burgerzaken-rijbewijs-buitenland-omwisselen" />
              <property key="wiki-gemma-model beschrijving" value="Wie in Nederland woont, dient de aanvraag in bij de burgemeester van de gemeente van inschrijving en levert het buitenlandse rijbewijs in, met een paspoort, identiteitskaart of verblijfsvergunning, een pasfoto, bij een rijbewijs van buiten de EU en EER een gezondheidsverklaring van het CBR en bij de 30%-regeling de brief van de Belastingdienst (Reglement rijbewijzen art. 27, 33; Utrecht). De burgemeester geleidt de aanvraag terstond door naar de RDW, die het rijbewijs afgeeft; de gemeente stuurt het buitenlandse rijbewijs met de aanvraag naar de RDW, die het terugstuurt naar het land van afgifte (Reglement rijbewijzen art. 28, 105 lid 2, 109; Utrecht).&#10;&#10;Of omwisselen kan en wat daarvoor nodig is, bepaalt de RDW; voor een rijbewijs uit een andere lidstaat van de EU of de EER gelden de vereisten van artikel 45, en kan niet worden omgewisseld, dan volgt rijexamen bij het CBR (Reglement rijbewijzen art. 45; Utrecht). De RDW laat binnen vier weken weten of ze akkoord is; de aanvrager maakt pas daarna de afspraak om het Nederlandse rijbewijs te laten uitreiken (Utrecht, zie Uitreiken rijbewijs). De omwisseling is een deel van de afgifte, niet iets wat de gemeente zelf beslist." />
              <property key="wiki-gemma-model synoniemen" value="Omwisselen buitenlands rijbewijs (beleid)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/behandelen-aanvraag-omwisseling-buitenlands-rijbewijs.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="rijbewijs" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Uitreiken rijbewijs" id="id-76a79cd6465d5d94991c094b8e0e0064">
              <documentation>Het na de afgifte ter beschikking stellen van het rijbewijs aan de aanvrager, die daarbij zijn eerdere rijbewijs inlevert.</documentation>
              <property key="wiki-gemma-model id" value="uitreiken-rijbewijs" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wegenverkeerswet-1994-bwbr0006622; 2026-utrecht-burgerzaken-rijbewijs-aanvragen-of-verlengen; 2026-rijk-reglement-rijbewijzen-bwbr0008074" />
              <property key="wiki-gemma-model beschrijving" value="De aanvrager haalt het rijbewijs persoonlijk op, op afspraak bij dezelfde balie als waar hij het aanvroeg, en identificeert zich opnieuw (Wegenverkeerswet 1994 art. 111 lid 2; Utrecht). Bij het ophalen levert hij zijn oude rijbewijs in: het nieuwe of vervangende rijbewijs wordt niet afgegeven voordat het eerdere is ingeleverd, tenzij het verloren is (Wegenverkeerswet 1994 art. 119 lid 2, 120 lid 2).&#10;&#10;Het rijbewijs wordt niet uitgereikt, maar blijft bij degene die afgeeft, als tussen aanvraag en uitreiking een omstandigheid bekend wordt die afgifte had verhinderd (Wegenverkeerswet 1994 art. 120a). De burgemeester neemt een rijbewijs in dat is gevorderd of ongeldig is geworden en geleidt het door (art. 115). Een buitenlands rijbewijs bij omwisseling gaat terug naar het land van afgifte (Reglement rijbewijzen art. 109)." />
              <property key="wiki-gemma-model synoniemen" value="Uitreiking van het rijbewijs (wet); Rijbewijs ophalen (beleid)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/uitreiken-rijbewijs.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="rijbewijs" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Uitreiken reisdocument" id="id-7eeb2e15e527522db9f8d3db69a058f2">
              <documentation>Het na de verstrekking ter beschikking stellen van het reisdocument aan de aanvrager, die daarbij zijn oude Nederlandse reisdocumenten inlevert.</documentation>
              <property key="wiki-gemma-model id" value="uitreiken-reisdocument" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-paspoortwet-bwbr0005212; 2026-utrecht-burgerzaken-paspoort-of-identiteitskaart-aanvragen; 2026-rijk-paspoortbesluit-bwbr0044308; 2026-rvig-hup-uitreiking-registreren-van-een-reisdocument; 2026-rvig-hup-reisdocument" />
              <property key="wiki-gemma-model beschrijving" value="De uitreiking volgt binnen twee weken na de verstrekking, nadat de identiteit van de aanvrager in zijn aanwezigheid is vastgesteld (Paspoortwet art. 42 lid 2; Paspoortbesluit art. 4.6). De aanvrager levert dan al zijn Nederlandse reisdocumenten in, tenzij hij een tweede paspoort mag houden; zonder inlevering, bij een mededeling tot inhouding of als het document al van rechtswege is vervallen, volgt geen uitreiking (art. 32, 42 lid 3). Een document dat niet binnen drie maanden is opgehaald, wordt definitief aan het verkeer onttrokken (art. 42 lid 4; Utrecht: vernietigd).&#10;&#10;In Utrecht haalt de aanvrager het document persoonlijk op aan de balie, of laat het tegen betaling bezorgen op een adres in Nederland, niet bij een spoedaanvraag (Utrecht). De bijhoudingsgemeente legt het uitgereikte Nederlandse reisdocument vast in categorie 12 van de persoonslijst; de gemeente die het verstrekte, beheert het paspoortdossier (HUP Uitreiking)." />
              <property key="wiki-gemma-model synoniemen" value="Uitreiking (wet); Ophalen (beleid)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/uitreiken-reisdocument.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="reisdocument" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Inschrijven niet-ingezetene" id="id-8335638935c759c0bfc047c9869aefac">
              <documentation>Het inschrijven van een persoon die niet in Nederland woont in de registratie niet-ingezetenen, door een gemeente die RNI-loket is.</documentation>
              <property key="wiki-gemma-model id" value="inschrijven-niet-ingezetene" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-utrecht-burgerzaken-registratie-niet-ingezetenen-rni-inschrijven; 2025-vng-upl-producten-en-diensten-extern; 2026-rvig-hup-achtergronden-en-begrippen" />
              <property key="wiki-gemma-model beschrijving" value="Wie niet in Nederland woont maar een relatie heeft met de Nederlandse overheid, of hooguit vier maanden in Nederland blijft, laat zich inschrijven in de RNI en krijgt een BSN (Utrecht RNI). De inschrijving gebeurt op verzoek bij een RNI-loket of op voordracht van een aangewezen bestuursorgaan; de minister van BZK is verantwoordelijk voor de RNI (HUP Achtergronden; LO BRP 1.5.2). Utrecht schrijft sinds 2026 alleen personen met een Europees paspoort in; anderen gaan naar andere RNI-loketten (Utrecht RNI)." />
              <property key="wiki-gemma-model synoniemen" value="Inschrijving in de RNI (beleid)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/inschrijven-niet-ingezetene.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="ingeschreven-persoon" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Beheren stempassen" id="id-87abea7c7f085b34abe3f2e3472e4729">
              <documentation>Het verstrekken, vervangen en ongeldig maken van stempassen, kiezerspassen en volmachtbewijzen voor een verkiezing.</documentation>
              <property key="GEMMA type" value="Bedrijfsproces (cluster)" />
              <property key="wiki-gemma-model id" value="beheren-stempassen" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-kieswet-bwbr0004627; 2026-vng-gemma-2026-10-02; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="Bij elke verkiezing stelt de burgemeester daags na de kandidaatstelling de gegevens vast van de kiezers die op die dag in de gemeente als kiezer zijn geregistreerd en verstrekt hij hun ten minste veertien dagen voor de stemming een stempas (Kieswet art. J 7). Op verzoek reikt hij een vervangende stempas of een kiezerspas uit of verleent hij een volmacht; de stempas waarvoor iets anders in de plaats komt, wordt ongeldig en komt in het register van ongeldige stempassen (art. J 7a, J 8, K 3, K 4, L 8, L 11).&#10;&#10;De organisatie van de verkiezing zelf, met de stembureaus, de stemming en de uitslag, valt buiten dit onderwerp (besluit redacteur 2026-10-06, Afbakening Burgerzaken). De minister van Binnenlandse Zaken en Koninkrijksrelaties stelt de modellen vast en levert de informatie voor de productie van stempas en kiezerspas (art. J 7 lid 3-4, K 4 lid 4)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/beheren-stempassen.md" />
              <property key="wiki-gemma-model procesniveau" value="levensloopproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="stempas" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Behandelen naturalisatieverzoek" id="id-8bacbc2ad25c5bccbf272bcb391221c2">
              <documentation>Het in ontvangst nemen en onderzoeken van een verzoek om naturalisatie, tot het advies van de burgemeester aan de minister.</documentation>
              <property key="wiki-gemma-model id" value="behandelen-naturalisatieverzoek" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-utrecht-burgerzaken-nederlander-worden-door-naturalisatie-of-optie; 2026-rijk-besluit-verkrijging-verlies-nederlanderschap-bwbr0013605; 2025-vng-upl-producten-en-diensten-extern; 2026-rijk-rijkswet-op-het-nederlanderschap-bwbr0003738" />
              <property key="wiki-gemma-model beschrijving" value="De verzoeker dient het naturalisatieverzoek in persoon in bij de burgemeester van zijn woongemeente, op afspraak aan de balie, en betaalt het naturalisatiegeld; de geboorteakten van de aanvragers moeten eerst in de basisregistratie personen staan (Besluit verkrijging en verlies Nederlanderschap art. 3, 33, 34; Utrecht). De burgemeester toetst de gegevens aan de basisregistratie personen, onderzoekt de verblijfsrechtelijke status, informeert de verzoeker over de toetsing door de minister en brengt advies uit over het verzoek en een eventuele naamsvaststelling (art. 35, 36).&#10;&#10;Hij zendt het verzoek met zijn advies aan de minister van Justitie en Veiligheid, die beslist; de Koning verleent het Nederlanderschap op voordracht van de minister (art. 37, 38; Rijkswet op het Nederlanderschap art. 7). In de praktijk beoordeelt de IND de aanvraag en stuurt zij de verzoeker het resultaat; bij een online aanvraag via de IND controleert de gemeente bij de afspraak de identiteit en de geboorteakte, laat betalen en meldt dit aan de IND (Utrecht). Na een positief besluit volgt de uitreiking van het uittreksel tijdens de naturalisatieceremonie (Besluit art. 38, 60b)." />
              <property key="wiki-gemma-model synoniemen" value="Naturalisatie (beleid)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/behandelen-naturalisatieverzoek.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="nederlanderschap" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Verwerken adreswijziging" id="id-8e8bd36b60d658e39e878025d8f3b7af">
              <documentation>Het verwerken van een verhuizing binnen of naar de gemeente in de verblijfplaats van de ingeschreven persoon.</documentation>
              <property key="wiki-gemma-model id" value="verwerken-adreswijziging" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-utrecht-burgerzaken-verhuizing-doorgeven; 2026-rvig-hup-binnengemeentelijke-adreswijziging; 2026-rvig-hup-intergemeentelijke-adreswijziging; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="Wie binnen of naar de gemeente verhuist, doet aangifte van adreswijziging, vanaf vier weken voor tot de vijfde dag na de verhuizing; alle verhuizende personen ondertekenen, de aangifte kan schriftelijk of digitaal met DigiD en de gemeente kan de betrouwbaarheid controleren (HUP Binnengemeentelijke adreswijziging; Utrecht Verhuizing doorgeven). Bij een verhuizing vanuit een andere gemeente wordt de nieuwe gemeente bijhoudingsgemeente en neemt zij de persoonslijst over, met openstaande onderzoeken (HUP Intergemeentelijke adreswijziging). Wie bij iemand anders gaat wonen, levert een verklaring van inwoning van de hoofdbewoner (Utrecht).&#10;&#10;Een infrastructurele wijziging zonder verhuizing (straatnaamwijziging, vernummering, gemeentelijke herindeling) wordt als adreswijziging verwerkt, zonder aangifte (HUP Binnengemeentelijke en Intergemeentelijke adreswijziging)." />
              <property key="wiki-gemma-model synoniemen" value="Binnengemeentelijke adreswijziging (HUP); Intergemeentelijke adreswijziging (HUP)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/verwerken-adreswijziging.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="verblijfplaats" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Verwerken vermissing rijbewijs" id="id-914a76cd8a4251f5899b3e226a484674">
              <documentation>Het ontvangen en vastleggen van de verklaring dat een rijbewijs kwijt of gestolen is, waardoor het rijbewijs ongeldig wordt.</documentation>
              <property key="wiki-gemma-model id" value="verwerken-vermissing-rijbewijs" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wegenverkeerswet-1994-bwbr0006622; 2026-utrecht-burgerzaken-rijbewijs-aanvragen-of-verlengen; 2026-rijk-reglement-rijbewijzen-bwbr0008074" />
              <property key="wiki-gemma-model beschrijving" value="De houder geeft de vermissing online door aan de RDW met DigiD, waar ze direct wordt geregistreerd, of aan de balie van de gemeente, waar hij de vermissingsverklaring invult bij een nieuwe aanvraag of in een eigen afspraak (Utrecht). Een rijbewijs verliest zijn geldigheid door aangifte van vermissing; wie het terugvindt, levert het in bij degene die het nieuwe rijbewijs afgaf (Wegenverkeerswet 1994 art. 123 lid 1 onder h, 119 lid 4, 120 lid 3).&#10;&#10;Bij een vermoeden van misbruik na identiteitsfraude houdt de gemeente het rijbewijs in en vraagt direct een nieuw rijbewijs aan (Utrecht; Wegenverkeerswet 1994 art. 115). Het Reglement rijbewijzen vraagt bij een aanvraag na vermissing een proces-verbaal van een opsporingsambtenaar (art. 39 lid 1), terwijl Utrecht spreekt van een vermissingsverklaring die aan de balie wordt ingevuld; wat formeel geldt, volgt de wet en de verhouding is uit de bronnen niet te halen (verificatie nodig)." />
              <property key="wiki-gemma-model synoniemen" value="Melding van vermissing van het rijbewijs (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/verwerken-vermissing-rijbewijs.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="rijbewijs" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Behandelen aanvraag reisdocument niet-ingezetene" id="id-997e69d7689f50a89829fbc0085736ef">
              <documentation>Het in ontvangst nemen en beoordelen van een aanvraag voor een reisdocument van iemand die niet als ingezetene in de BRP staat, door een aangewezen gemeente.</documentation>
              <property key="wiki-gemma-model id" value="behandelen-aanvraag-reisdocument-niet-ingezetene" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2026-rijk-paspoortbesluit-bwbr0044308; 2026-rijk-paspoortwet-bwbr0005212; 2026-utrecht-burgerzaken-paspoort-of-identiteitskaart-aanvragen" />
              <property key="wiki-gemma-model beschrijving" value="Alleen de burgemeester van een bij ministeriële regeling aangewezen gemeente is bevoegd aanvragen in ontvangst te nemen en reisdocumenten te verstrekken voor personen die niet als ingezetene in de basisregistratie personen zijn ingeschreven: het nationaal paspoort, de reisdocumenten voor vluchtelingen en voor vreemdelingen en het nooddocument (Paspoortbesluit art. 3.2, 4.2; Paspoortwet art. 2 lid 1 onder a, d, e en g). Het document is hetzelfde Reisdocument als bij een ingezetene; bijzonder zijn de bevoegde gemeente en de aanvrager. Verder volgt de behandeling Behandelen aanvraag reisdocument." />
              <property key="wiki-gemma-model synoniemen" value="Verstrekken reisdocument aan niet-ingezetene (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/behandelen-aanvraag-reisdocument-niet-ingezetene.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="reisdocument" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Wijzigen geslachtsvermelding" id="id-a37f2f22408d50f3bd605262e34d191e">
              <documentation>Het ontvangen van de aangifte van een wijziging van het geslacht en het toevoegen daarvan als latere vermelding aan de geboorteakte.</documentation>
              <property key="wiki-gemma-model id" value="wijzigen-geslachtsvermelding" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-burgerlijk-wetboek-boek-1; 2026-utrecht-burgerzaken-geslacht-vermelding-aanpassen; 2026-rvig-hup-geslachtswijziging; 2025-vng-upl-producten-en-diensten-extern; 2026-rvig-hup-overschrijven-gegevens-bij-geslachtswijziging; 2026-rijk-paspoortwet-bwbr0005212; 2026-rvig-hup-van-rechtswege-vervallen-reisdocument" />
              <property key="wiki-gemma-model beschrijving" value="Aangifte kan een Nederlander van zestien jaar of ouder, of iemand met een verblijfstitel die een jaar in Nederland woont, bij de gemeente van geboorte; bij geboorte in het buitenland bij Den Haag. Alleen van man naar vrouw of omgekeerd; een non-binaire vermelding spreekt de rechter uit (BW 1 art. 28; Utrecht; HUP Geslachtswijziging). Op afspraak aan de balie, gratis (Utrecht).&#10;&#10;De woongemeente verwerkt de wijziging in de BRP; een geldig Nederlands reisdocument vervalt van rechtswege. De persoon kan daarna verzoeken de vroegere gegevens te verwijderen of te overschrijven (Wet BRP art. 2.57; HUP Geslachtswijziging; HUP Overschrijven gegevens bij geslachtswijziging)." />
              <property key="wiki-gemma-model synoniemen" value="Geslachtswijziging (HUP)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/wijzigen-geslachtsvermelding.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="akte-van-de-burgerlijke-stand" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Verwerken buitenlands document" id="id-a4d609b3be0a5ccfaa6181e13a72d63c">
              <documentation>Het beoordelen van een buitenlands document over een gebeurtenis van de burgerlijke staat en het verwerken daarvan in de basisregistratie personen.</documentation>
              <property key="wiki-gemma-model id" value="verwerken-buitenlands-document" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rvig-hup-huwelijkgeregistreerd-partnerschap; 2026-utrecht-burgerzaken-trouwen-in-het-buitenland; 2026-rijk-burgerlijk-wetboek-boek-1; 2026-utrecht-burgerzaken-buitenlandse-documenten-inschrijven; 2026-rvig-hup-overlijden-buitenland; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="Het document moet gelegaliseerd en zo nodig vertaald zijn; de gemeente beoordeelt per geval of het volstaat en kan om andere stukken vragen; ontbreekt een akte, dan kan een lager brondocument dienen (Wet BRP art. 2.8, 2.51; HUP Overlijden buitenland; Utrecht). Een huwelijk of echtscheiding in strijd met de Nederlandse openbare orde wordt niet opgenomen (HUP Huwelijk/geregistreerd partnerschap). Een registratie van een in het buitenland gesloten huwelijk is verplicht; bij een vermoeden van een schijnhuwelijk stelt de gemeente onderzoek in (Utrecht Trouwen in het buitenland).&#10;&#10;Inschrijving van de buitenlandse akte in de Nederlandse registers is een aparte stap bij de gemeente Den Haag, op verzoek of ambtshalve (BW 1 art. 25)." />
              <property key="wiki-gemma-model synoniemen" value="Buitenlandse akte verwerken (HUP)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/verwerken-buitenlands-document.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="ingeschreven-persoon" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Verstrekken overzicht gegevensverstrekkingen" id="id-b0865bca9d145725bba952ae7ff4f096">
              <documentation>Het op verzoek leveren van een overzicht aan een ingeschrevene van welke gegevens over hem aan wie zijn verstrekt.</documentation>
              <property key="wiki-gemma-model id" value="verstrekken-overzicht-gegevensverstrekkingen" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-utrecht-burgerzaken-persoonsgegevens-brp-bekijken-en-overzicht-aanvragen; 2025-vng-upl-producten-en-diensten-extern; 2025-rvig-logisch-ontwerp-brp-2025q1; 2026-rijk-besluit-brp-bwbr0034306" />
              <property key="wiki-gemma-model beschrijving" value="Wie in de gemeente staat ingeschreven, kan een overzicht vragen van de persoonsgegevens die uit de BRP zijn verstrekt en wanneer; het Ministerie van BZK levert de gegevens (vanaf 6 januari 2013), de gemeente stuurt het overzicht met een begeleidende brief per beveiligde e-mail of aangetekende post (Utrecht Persoonsgegevens bekijken). Het overzicht wordt gemaakt met de ProtocolleringsOverzichtModule (LO BRP 1.5.2)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/verstrekken-overzicht-gegevensverstrekkingen.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="ingeschreven-persoon" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Wijzigen naamgebruik" id="id-b79f22cd656a5b2cbb78731c2c485267">
              <documentation>Het beslissen op een verzoek van een (voormalig) gehuwde of geregistreerde partner welke achternaam de overheid voor hem gebruikt.</documentation>
              <property key="wiki-gemma-model id" value="wijzigen-naamgebruik" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rvig-hup-wijziging-naamgebruik; 2026-utrecht-burgerzaken-achternaamgebruik-veranderen; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="Wie getrouwd of geregistreerd partner is of was, kiest de eigen naam, de naam van de partner of een combinatie in beide volgorden (BW 1 art. 9; Utrecht). Het college geeft binnen vier weken gevolg; weigeren is gelijkgesteld aan een Awb-besluit (Wet BRP art. 2.60; HUP Wijziging naamgebruik). De keuze gaat naar andere overheidsorganisaties; op een paspoort of rijbewijs staat altijd de eigen achternaam (Utrecht)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/wijzigen-naamgebruik.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="ingeschreven-persoon" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Voltrekken huwelijk" id="id-be2cfad6c4e850449c4b3888ad5c3db2">
              <documentation>Het in het openbaar voltrekken van een huwelijk ten overstaan van de ambtenaar van de burgerlijke stand en het opmaken van de huwelijksakte.</documentation>
              <property key="wiki-gemma-model id" value="voltrekken-huwelijk" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-burgerlijk-wetboek-boek-1; 2026-utrecht-burgerzaken-trouwen-in-utrecht; 2026-rijk-besluit-burgerlijke-stand-1994-bwbr0006493; 2025-vng-upl-producten-en-diensten-extern; 2026-utrecht-burgerzaken-trouwlocaties-in-utrecht; 2026-rvig-hup-huwelijkgeregistreerd-partnerschap" />
              <property key="wiki-gemma-model beschrijving" value="Het huwelijk wordt in het openbaar voltrokken in het gemeentehuis, met twee tot vier meerderjarige getuigen; de partijen verschijnen in persoon (BW 1 art. 63, 65). Burgemeester en wethouders kunnen andere gebouwen als huis der gemeente aanwijzen: eigen locaties, vaste trouwlocaties en een locatie naar keuze die de gemeente goedkeurt (BW 1 art. 63, 64; Utrecht Trouwlocaties). De gemeente kiest de trouwambtenaar; een eigen trouwambtenaar voor één dag wordt als buitengewoon ambtenaar aangewezen (BW 1 art. 16; Utrecht).&#10;&#10;Gemeenten bieden varianten met eigen tarieven, van gratis trouwen op vaste momenten tot een locatie naar keuze (Utrecht); tarieven en wachtlijsten zijn lokaal. Bij het trouwen kunnen de ouders eenmalig de achternaam van hun gezamenlijke kinderen veranderen (Utrecht). De huwelijksakte gaat naar de woongemeenten voor de BRP." />
              <property key="wiki-gemma-model synoniemen" value="Huwelijksvoltrekking (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/voltrekken-huwelijk.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="akte-van-de-burgerlijke-stand" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Opmaken akte van overlijden" id="id-be872e70cdcc5c8b9027a167096158da">
              <documentation>Het ontvangen van de aangifte van een overlijden of lijkvinding en het opmaken van de akte van overlijden.</documentation>
              <property key="wiki-gemma-model id" value="opmaken-akte-van-overlijden" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rvig-hup-lijkvinding; 2026-rvig-hup-overlijden-buitenland; 2026-rvig-hup-rechtsvermoeden-van-overlijden; 2026-rijk-burgerlijk-wetboek-boek-1; 2026-utrecht-burgerzaken-overlijden-aangifte-doen; 2026-rijk-besluit-burgerlijke-stand-1994-bwbr0006493; 2025-vng-upl-producten-en-diensten-extern; 2026-rvig-hup-overlijden-nederland; 2026-rvo-aangifte-en-akte-van-overlijden" />
              <property key="wiki-gemma-model beschrijving" value="De ambtenaar van de burgerlijke stand van de gemeente van overlijden stelt de identiteit van de aangever vast en maakt de akte op, op grond van de verklaring van overlijden; de aangifte kan elektronisch, met het burgerservicenummer van de overledene en de verklaring van de arts (BW 1 art. 19f, 19h; Besluit burgerlijke stand art. 67a). Bij een lijkvinding maakt hij de akte op de schriftelijke aangifte van de hulpofficier van justitie; datum en plaats van de vinding gelden als datum en plaats van overlijden (Besluit burgerlijke stand art. 62; HUP Lijkvinding).&#10;&#10;De akte gaat naar de woongemeente, die het overlijden in de BRP verwerkt en de bijhouding van de persoonslijst opschort; bij een echtgenoot of geregistreerd partner wordt de ontbinding door overlijden verwerkt (HUP Overlijden in Nederland; Utrecht). Een overlijden in het buitenland of een rechtsvermoeden van overlijden wordt via een akte van inschrijving opgenomen (HUP Overlijden buitenland; HUP Rechtsvermoeden van overlijden)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/opmaken-akte-van-overlijden.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="akte-van-de-burgerlijke-stand" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Inschrijven op briefadres" id="id-c13031998c565bd9882281bc2ab4996c">
              <documentation>Het beoordelen van een aangifte van een briefadres en het inschrijven van een persoon zonder woonadres op een briefadres.</documentation>
              <property key="wiki-gemma-model id" value="inschrijven-op-briefadres" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-nvvb-beleidsregel-briefadres; 2025-vng-upl-producten-en-diensten-extern; 2026-rvig-hup-verblijfplaats" />
              <property key="wiki-gemma-model beschrijving" value="Een briefadres wordt geregistreerd als iemand geen woonadres heeft, in een aangewezen instelling verblijft of als de burgemeester opneming van het woonadres om veiligheidsredenen niet wenselijk vindt; de briefadresgever stemt schriftelijk in (HUP Verblijfplaats). Het college beoordeelt of de aangifte kan worden ingewilligd en wijst zo nodig een rechtspersoon als briefadresgever aan (HUP Verblijfplaats). Sinds 1 januari 2022 registreert de gemeente iemand zonder woonadres die geen aangifte doet ambtshalve op een briefadres; de NVVB heeft daarvoor een modelregeling met een aanvraagformulier, een toestemmingsverklaring en een beheerregeling (NVVB Beleidsregel briefadres)." />
              <property key="wiki-gemma-model synoniemen" value="Aangifte van een briefadres (HUP)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/inschrijven-op-briefadres.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="briefadres" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Behandelen optieverklaring" id="id-c1fb8ca9be3654178a7e13c12cfc45d2">
              <documentation>Het in ontvangst nemen en beoordelen van een optieverklaring, tot bevestiging of weigering van de verkrijging van het Nederlanderschap.</documentation>
              <property key="wiki-gemma-model id" value="behandelen-optieverklaring" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-utrecht-burgerzaken-nederlander-worden-door-naturalisatie-of-optie; 2026-rijk-rijkswet-op-het-nederlanderschap-bwbr0003738; 2026-rijk-besluit-verkrijging-verlies-nederlanderschap-bwbr0013605; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="De optant legt de optieverklaring in persoon af bij de burgemeester van de gemeente waar hij als ingezetene is ingeschreven of zijn hoofdverblijf heeft, op afspraak aan de balie, en betaalt het optiegeld (Besluit verkrijging en verlies Nederlanderschap art. 3, 7, 8; Utrecht). De burgemeester toetst de gegevens aan de basisregistratie personen en laat zo nodig andere autoriteiten toetsen, onderzoekt de verblijfsrechtelijke status en of er ernstige vermoedens bestaan van gevaar voor de openbare orde, en vraagt bij herkrijging advies aan de minister (art. 9, 10; Rijkswet op het Nederlanderschap art. 6 lid 3).&#10;&#10;Hij beslist binnen dertien weken na ontvangst, eenmaal te verlengen met ten hoogste dertien weken (Rijkswet art. 6 lid 5). Tegenspraak: Utrecht noemt een uitslag binnen 13 tot 26 weken; formeel geldt de wettelijke termijn, de praktijkbron geeft de termijn met verlenging als bandbreedte (besluit redacteur 2026-10-06). Daarna bericht de burgemeester de optant hoe de bevestiging wordt bekendgemaakt en weigert hij haar voor wie niet aan de vereisten voldoet; hij zendt een afschrift aan de minister en archiveert verklaring en bevestiging twaalf jaar (Besluit art. 11, 12).&#10;&#10;De bevestiging is een beschikking van de burgemeester en treedt in werking door de uitreiking, tijdens de naturalisatieceremonie (Besluit art. 60a; Utrecht)." />
              <property key="wiki-gemma-model synoniemen" value="Optie (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/behandelen-optieverklaring.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="nederlanderschap" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Afgeven verklaring omtrent het gedrag" id="id-cd5c5e8475c8569abd1cb139b9e520f4">
              <documentation>Het ontvangen en onderzoeken van een aanvraag voor een verklaring omtrent het gedrag en het afgeven of weigeren ervan, door gemeente en minister.</documentation>
              <property key="GEMMA type" value="Bedrijfsproces (cluster)" />
              <property key="wiki-gemma-model id" value="afgeven-verklaring-omtrent-het-gedrag" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-justitiele-en-strafvorderlijke-gegevens-bwbr0014194; 2025-vng-upl-producten-en-diensten-extern; 2026-utrecht-burgerzaken-verklaring-omtrent-het-gedrag-aanvragen-vog; 2026-rijk-besluit-justitiele-en-strafvorderlijke-gegevens-bwbr0016544" />
              <property key="wiki-gemma-model beschrijving" value="In het Europese deel van Nederland ontvangt de burgemeester de aanvraag van een natuurlijk persoon die als ingezetene in zijn gemeente staat, onderzoekt hij de volledigheid van de gegevens, verschaft hij zich zekerheid over de identiteit en zendt hij de aanvraag terstond door aan de minister; de gemeente kan een vergoeding verlangen en is de minister een vergoeding verschuldigd (Wet justitiële en strafvorderlijke gegevens art. 30, 39).&#10;&#10;Het is een keten in het orkestratiemodel: de minister van Justitie en Veiligheid, in de praktijk Justis, onderzoekt de justitiële gegevens en politiegegevens, neemt de aanvraag zo nodig niet in behandeling, weigert of geeft af, en beslist binnen vier weken (art. 34 tot en met 37; Utrecht). Een aanvraag van een rechtspersoon, van wie niet als inwoner in de BRP staat ingeschreven of die een werkgever rechtstreeks bij Justis doet, loopt buiten de gemeente om (art. 30 lid 1, 31; Utrecht).&#10;&#10;Het deel van de gemeente is het bedrijfsproces Behandelen aanvraag verklaring omtrent het gedrag; het deel van de minister staat alleen in deze beschrijving (besluit redacteur 2026-10-07)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/afgeven-verklaring-omtrent-het-gedrag.md" />
              <property key="wiki-gemma-model procesniveau" value="levensloopproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="verklaring-omtrent-het-gedrag" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Opmaken geboorteakte" id="id-d186796fcddd584e976e25ca49ebaac6">
              <documentation>Het ontvangen van de aangifte van een geboorte en het opmaken van de geboorteakte.</documentation>
              <property key="wiki-gemma-model id" value="opmaken-geboorteakte" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-burgerlijk-wetboek-boek-1; 2026-utrecht-burgerzaken-geboorteaangifte-doen; 2026-rijk-besluit-burgerlijke-stand-1994-bwbr0006493; 2025-vng-upl-producten-en-diensten-extern; 2026-rvig-hup-geboorte" />
              <property key="wiki-gemma-model beschrijving" value="De aangever doet binnen drie dagen aangifte in de gemeente van geboorte; verplicht is de vader of de moeder uit wie het kind niet is geboren, anders wie bij de bevalling aanwezig was of het hoofd van de instelling. Elektronisch kan alleen de moeder of de andere ouder; de ambtenaar stelt de identiteit vast en controleert de verklaring van arts of verloskundige (BW 1 art. 19e; Besluit burgerlijke stand art. 27; Utrecht). Een te late aangifte meldt hij aan het openbaar ministerie (art. 19e lid 7).&#10;&#10;De ambtenaar weigert ongepaste voornamen (BW 1 art. 4). Bij de aangifte kan ook een erkenning of een naamskeuze worden opgenomen. De geboorteakte gaat naar de woongemeente van de moeder, die het kind in de BRP inschrijft (HUP Geboorte; Utrecht)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/opmaken-geboorteakte.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="akte-van-de-burgerlijke-stand" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Behandelen verzoek om kiezerspas" id="id-e2e983038802557bb6fcd61d87f0d148">
              <documentation>Het behandelen van het verzoek van een kiezer om in een stembureau naar keuze te stemmen, tot uitreiking van een kiezerspas.</documentation>
              <property key="wiki-gemma-model id" value="behandelen-verzoek-om-kiezerspas" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2026-rijk-kieswet-bwbr0004627; 2026-vng-gemma-2026-10-02" />
              <property key="wiki-gemma-model beschrijving" value="De kiezer richt zijn verzoek schriftelijk, tot de vijfde dag voor de stemming, of mondeling in persoon, tot de dag voor de stemming om twaalf uur, aan de burgemeester van de gemeente waar hij op de dag van de kandidaatstelling als kiezer is geregistreerd, met een kopie van een identiteitsbewijs; de burgemeester maakt de termijnen bekend in het gemeenteblad (Kieswet art. K 3, K 6). Als bewijs krijgt de kiezer een kiezerspas, waarmee hij in het hele gebied van de verkiezing kan stemmen; een kwijtgeraakte kiezerspas wordt niet vervangen en de stempas wordt ongeldig (art. K 1, K 4, J 7a)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/behandelen-verzoek-om-kiezerspas.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="stempas" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Wijzigen identificatienummers" id="id-eab1b4319876559cae8350d8b12596c1">
              <documentation>Het wijzigen van het burgerservicenummer of het administratienummer van een ingeschreven persoon.</documentation>
              <property key="wiki-gemma-model id" value="wijzigen-identificatienummers" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rvig-hup-wijzigen-identificatienummers; 2026-rvig-hup-wijzigen-bsn; 2026-rvig-hup-wijzigen-administratienummer; 2026-rijk-paspoortwet-bwbr0005212; 2026-rvig-hup-van-rechtswege-vervallen-reisdocument" />
              <property key="wiki-gemma-model beschrijving" value="Het BSN wordt gewijzigd bij een dubbele inschrijving, zodat één juiste persoonslijst overblijft; het college van de bijhoudingsgemeente besluit, weegt de belangen van de persoon af (toeslagen, pensioen) en informeert hem; een geldig reisdocument vervalt dan van rechtswege (HUP Wijzigen BSN). Het A-nummer wordt gewijzigd als meer personen hetzelfde nummer hebben gekregen; de gemeente kent dan nieuwe nummers toe en meldt dat aan de andere gemeenten, de RNI en de BRP-verstrekkingsvoorziening (HUP Wijzigen administratienummer)." />
              <property key="wiki-gemma-model synoniemen" value="Wijzigen BSN (HUP); Wijzigen A-nummer (HUP)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/wijzigen-identificatienummers.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="ingeschreven-persoon" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Beheren rijbewijzen" id="id-f0cd6a881f595472b78c2f778ba87f92">
              <documentation>Het behandelen van aanvragen, afgeven en uitreiken van rijbewijzen en het verwerken van de vermissing ervan.</documentation>
              <property key="GEMMA type" value="Bedrijfsproces (cluster)" />
              <property key="wiki-gemma-model id" value="beheren-rijbewijzen" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wegenverkeerswet-1994-bwbr0006622; 2026-utrecht-burgerzaken-rijbewijs-aanvragen-of-verlengen; 2026-rijk-reglement-rijbewijzen-bwbr0008074; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="De burgemeester neemt de aanvraag in ontvangst en geeft het rijbewijs af, voor wie als ingezetene met een adres in zijn gemeente in de basisregistratie personen staat; het besluit tot afgifte neemt hij na de controle van de identiteit, de bescheiden en de voorwaarden (Wegenverkeerswet 1994 art. 113, 116, 118a; Reglement rijbewijzen art. 27, 33). De gemeente stelt het tarief vast bij plaatselijke verordening en betaalt de RDW een vergoeding voor de productie en aflevering (Wegenverkeerswet 1994 art. 111 lid 5, 121).&#10;&#10;In de bij algemene maatregel van bestuur bepaalde gevallen geeft de RDW het rijbewijs af, onder meer bij omwisseling van een rijbewijs dat buiten Nederland is afgegeven; de burgemeester geleidt de aanvraag dan terstond door (Reglement rijbewijzen art. 28, 29, 105 lid 2). De RDW produceert de rijbewijzen en beheert het rijbewijzenregister; het CBR registreert de verklaring van geschiktheid die bij vernieuwing in bepaalde gevallen is vereist (Reglement rijbewijzen art. 35, 97, 119; Wegenverkeerswet 1994 art. 126). Beide zijn zelfstandige bestuursorganen (art. 4a, 4z) en geen eigen element.&#10;&#10;Het proces omvat de levensloop van het rijbewijs: aanvraag, afgifte, uitreiking, vervanging en vermissing, tot het verlies van geldigheid (Wegenverkeerswet 1994 art. 119, 120, 123). De bedrijfsprocessen leveren de diensten van de UPL voor het rijbewijs (rijbewijs, rijbewijs verlengen en rijbewijs buitenlands omwisseling) en het doorgeven van vermissing. De gemeente toetst bij de aanvraag of een vereiste verklaring van geschiktheid bij het CBR is geregistreerd, als onderdeel van Behandelen aanvraag rijbewijs; de gezondheidsverklaring (UPL nr. 362) is geen eigen dienst (Reglement rijbewijzen art. 35, 45; Utrecht)." />
              <property key="wiki-gemma-model synoniemen" value="Rijbewijzen (dagelijks gebruik)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/beheren-rijbewijzen.md" />
              <property key="wiki-gemma-model procesniveau" value="levensloopproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="rijbewijs" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Opmaken akte levenloos geboren kind" id="id-f5e749c5543b5dd5a9f75acd6bc1ec01">
              <documentation>Het ontvangen van de aangifte van een levenloos geboren kind en het opmaken van de akte daarvan.</documentation>
              <property key="wiki-gemma-model id" value="opmaken-akte-levenloos-geboren-kind" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-burgerlijk-wetboek-boek-1; 2026-utrecht-burgerzaken-levenloos-geboren-kind-of-overleden-pasgeboren-kind-aangifte-doen; 2026-rijk-besluit-burgerlijke-stand-1994-bwbr0006493; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="De akte heet akte van geboorte (levenloos) en wordt opgenomen in het register van overlijden; geslachtsnaam en voornamen worden alleen vermeld als de ouders dat willen. De ambtenaar meldt gegevens aan het CBS (BW 1 art. 19i; Besluit burgerlijke stand art. 66). Aangifte alleen aan de balie; een late aangifte of een aanvulling van de voornaam kan nog (Utrecht). Opname in de BRP is een apart verzoek." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/opmaken-akte-levenloos-geboren-kind.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="akte-van-de-burgerlijke-stand" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Toevoegen latere vermelding" id="id-f711533cf2f257b9a6535fa176194753">
              <documentation>Het toevoegen van een rechterlijke uitspraak of een besluit over de staat van een persoon aan een akte als latere vermelding.</documentation>
              <property key="wiki-gemma-model id" value="toevoegen-latere-vermelding" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rvig-hup-vaststelling-ouderschap; 2026-rvig-hup-ontkenning-ouderschap; 2026-rijk-burgerlijk-wetboek-boek-1; 2026-rijk-besluit-burgerlijke-stand-1994-bwbr0006493; 2026-rvig-hup-adoptie; 2025-vng-upl-producten-en-diensten-extern; 2026-utrecht-burgerzaken-voornaam-of-achternaam-veranderen" />
              <property key="wiki-gemma-model beschrijving" value="Een latere vermelding legt een verandering vast die na het opmaken van de akte is ontstaan: een adoptie of herroeping daarvan, een ontkenning of gerechtelijke vaststelling van het ouderschap, een vernietigde erkenning, of een wijziging van de voornaam (rechtbank) of geslachtsnaam (Koning) (BW 1 art. 4, 7, 20; Besluit burgerlijke stand art. 53, 54; HUP Adoptie; HUP Vaststelling ouderschap). De gemeente waar de akte berust, voegt de vermelding toe; de woongemeente verwerkt de wijziging in de BRP.&#10;&#10;De gemeente beslist hier niet zelf over de staat van de persoon: de rechtbank of de Koning heeft beslist. Het geslacht (BW 1 art. 28b) en de ontbinding van een huwelijk of partnerschap hebben een eigen bedrijfsproces." />
              <property key="wiki-gemma-model synoniemen" value="Verwerken rechterlijke uitspraak (beleid)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/toevoegen-latere-vermelding.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="akte-van-de-burgerlijke-stand" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Verstrekken persoonsgegevens" id="id-f797baac19cd5ed9abdd82a96c2ba2ce">
              <documentation>Het beslissen op een verzoek om gegevens uit de basisregistratie personen en het verstrekken ervan aan de ingeschrevene of aan anderen.</documentation>
              <property key="wiki-gemma-model id" value="verstrekken-persoonsgegevens" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2024-nvvb-schema-schriftelijke-gegevensverstrekking-brp; 2026-utrecht-burgerzaken-persoonsgegevens-brp-bekijken-en-overzicht-aanvragen; 2025-vng-upl-producten-en-diensten-extern; 2026-rijk-besluit-brp-bwbr0034306; 2026-utrecht-burgerzaken-bewijs-van-in-leven-zijn-of-attestatie-de-vita-aanvragen; 2026-rijk-besluit-verkrijging-verlies-nederlanderschap-bwbr0013605" />
              <property key="wiki-gemma-model beschrijving" value="Het college ontvangt verzoeken om gegevens uit de BRP: van de ingeschrevene zelf (inzage, kopie, uittreksel; art. 2.55 Wet BRP) en van overheidsorganen, bij besluit aangewezen derden, bij gemeentelijke verordening aangewezen derden en overige verzoekers (NVVB Schema; UPL). De medewerker stelt vast wie verzoekt en waarvoor, deelt het verzoek in, verstrekt de gegevens die daarbij horen en protocolleert de verstrekking; bij een geregistreerde verstrekkingsbeperking volgt een belangenafweging (NVVB Schema). Gegevens in onderzoek worden met vermelding daarvan verstrekt; verzoeken over niet-ingezetenen gaan naar een RNI-loket (NVVB Schema).&#10;&#10;De systematische verstrekking aan afnemers loopt via de BRP-verstrekkingsvoorziening van de minister, niet via dit proces (LO BRP 1.5.2; Besluit BRP art. 37)." />
              <property key="wiki-gemma-model synoniemen" value="Schriftelijke gegevensverstrekking (beleid)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/verstrekken-persoonsgegevens.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="ingeschreven-persoon" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
          </folder>
        </folder>
        <folder name="7 Volksgezondheid en Milieu" id="id-3364b3544e3c59f39a4b2c8589421b59">
          <folder name="Begraafplaatsen en crematoria" id="id-1a0af9a2e6495028a599686576188c62">
            <element xsi:type="archimate:BusinessProcess" name="Verlenen toestemming asverstrooiing" id="id-230de6a7ba9e53e0a76ee579c8196885">
              <documentation>Het beslissen op een verzoek om as te verstrooien op een plek waar dat zonder toestemming verboden is.</documentation>
              <property key="wiki-gemma-model id" value="verlenen-toestemming-asverstrooiing" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-groningen-algemene-plaatselijke-verordening; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2026-rijk-wet-op-de-lijkbezorging-wettekst; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="Buiten de begraafplaats verleent het college op verzoek van de nabestaande die zorgdraagt voor de asbus bij bijzondere omstandigheden ontheffing van het verbod op de plaatsen uit de APV (APV Groningen art. 5:27 lid 3). Op de gemeentelijke begraafplaats geeft het college toestemming voor verstrooiing op een aangewezen plek (Groningen art. 21 lid 1–2). Beslisser is het college.&#10;&#10;Het verstrooien zelf hoort bij Bijzetten of verstrooien van de as." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/verlenen-toestemming-asverstrooiing.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="urn" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Beheren grafrechten" id="id-2644dde5bf4c5a80b29f7c7663de02c7">
              <documentation>Het beheer van een grafrecht over de hele looptijd: verlenen, verlengen, overschrijven en vervallen.</documentation>
              <property key="GEMMA type" value="Bedrijfsproces (cluster)" />
              <property key="wiki-gemma-model id" value="beheren-grafrechten" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2010-vng-model-beheersverordening-begraafplaatsen; 2026-rijk-wet-op-de-lijkbezorging-wettekst" />
              <property key="wiki-gemma-model beschrijving" value="Het grafrecht wordt schriftelijk gevestigd voor onbepaalde tijd of voor ten minste tien jaar, en op verzoek verlengd (Wet op de lijkbezorging art. 28 lid 1–3). Het college verleent het recht op aanvraag, schrijft het over en kan het vervallen verklaren; het recht vervalt ook als na een verklaring van verwaarlozing niet alsnog in het onderhoud is voorzien (Groningen art. 16–20; art. 28 lid 4–7)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/beheren-grafrechten.md" />
              <property key="wiki-gemma-model procesniveau" value="levensloopproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="grafrecht" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Ruimen graf" id="id-2de444e3552c5f908f12c6a6868cadfa">
              <documentation>Het leegmaken van een graf, waarbij de resten worden herbegraven en de as wordt verstrooid.</documentation>
              <property key="wiki-gemma-model id" value="ruimen-graf" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2010-vng-model-beheersverordening-begraafplaatsen; 2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen" />
              <property key="wiki-gemma-model beschrijving" value="Een graf wordt geruimd op last van de houder van de begraafplaats, na ten minste tien jaar na de laatste begraving en bij een particulier graf met toestemming van de rechthebbende (art. 31). Het college kondigt een ruiming ten minste een jaar vooraf aan, per brief of met een bordje bij het graf en op het mededelingenbord; de beheerder ziet toe op een respectvolle omgang met de resten, die worden herbegraven, terwijl de as wordt verstrooid (Groningen art. 27; VNG-model art. 24). Asbussen worden geruimd door verstrooiing van de as (art. 66)." />
              <property key="wiki-gemma-model synoniemen" value="Ruiming (beleid); Ruimen van graven (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/ruimen-graf.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="graf" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Beheren graven" id="id-33d71105e2d25cd892c59c94ec68d297">
              <documentation>Het beheer van een graf over de hele levensloop: uitgeven, begraven en bijzetten, onderhouden en ruimen.</documentation>
              <property key="GEMMA type" value="Bedrijfsproces (cluster)" />
              <property key="wiki-gemma-model id" value="beheren-graven" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen" />
              <property key="wiki-gemma-model beschrijving" value="De houder van de begraafplaats bepaalt bij een algemeen graf wie erin wordt begraven, houdt het register van begraven lijken bij en ruimt graven na ten minste tien jaar grafrust (Wet op de lijkbezorging art. 23, 27, 31). Op de gemeentelijke begraafplaats regelt de beheersverordening de soorten graven, de uitgifte, het onderhoud en de ruiming (Groningen art. 11–16, 23, 27)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/beheren-graven.md" />
              <property key="wiki-gemma-model procesniveau" value="levensloopproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="graf" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Beheren begraafplaatsen" id="id-35cade79cce6571e814c3084684d0397">
              <documentation>Het beheer van een begraafplaats over de hele levensloop: aanleggen, in gebruik nemen, sluiten en opheffen.</documentation>
              <property key="GEMMA type" value="Bedrijfsproces (cluster)" />
              <property key="wiki-gemma-model id" value="beheren-begraafplaatsen" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst" />
              <property key="wiki-gemma-model beschrijving" value="Elke gemeente heeft ten minste één gemeentelijke begraafplaats, alleen of samen met andere gemeenten; voor aanleg op het grondgebied van een andere gemeente is toestemming van de raad van die gemeente nodig (Wet op de lijkbezorging art. 33, 36). Voor een bijzondere begraafplaats wijst de raad de grond aan en geeft het college toestemming voor de ingebruikneming (art. 40, 41). Het college kan een gemeentelijke begraafplaats sluiten, of gesloten verklaren als er tien jaar niet is begraven (art. 43, 44). Een begraafplaats houdt op te bestaan als de grond die bestemming verloor en er geen graf meer is (art. 47)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/beheren-begraafplaatsen.md" />
              <property key="wiki-gemma-model procesniveau" value="levensloopproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="begraafplaats" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Verlenen verlof tot ontleding" id="id-3d946a179e735290aeea986a5aae209a">
              <documentation>Het afgeven van het schriftelijk verlof waarmee een stoffelijk overschot mag worden ontleed.</documentation>
              <property key="wiki-gemma-model id" value="verlenen-verlof-tot-ontleding" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-rijk-besluit-op-de-lijkbezorging-wettekst; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="Ontleding gebeurt alleen met schriftelijk verlof van de burgemeester, dat binnen drie dagen kosteloos wordt afgegeven en de plaats van ontleding vermeldt; tegen het besluit staat binnen 24 uur beroep open bij de commissaris van de Koning (Wet op de lijkbezorging art. 68). Beslisser is de burgemeester. De ontleding zelf hoort bij Uitvoeren lijkbezorging." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/verlenen-verlof-tot-ontleding.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="stoffelijk-overschot" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Stellen andere termijn" id="id-5a96b5b99c4355e799bb7898f48f7066">
              <documentation>Het toestaan dat een overledene eerder dan 36 uur of later dan de zesde werkdag na het overlijden wordt begraven of gecremeerd.</documentation>
              <property key="wiki-gemma-model id" value="stellen-andere-termijn" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-rvo-aangifte-en-akte-van-overlijden" />
              <property key="wiki-gemma-model beschrijving" value="Begraving of crematie geschiedt niet eerder dan 36 uur en uiterlijk op de zesde werkdag na het overlijden (Wet op de lijkbezorging art. 16). Na een arts te hebben gehoord kan de burgemeester van de gemeente waar het stoffelijk overschot zich bevindt een andere termijn stellen; binnen 36 uur alleen in overeenstemming met de officier van justitie (art. 17 lid 1). Tegen het besluit staat binnen 24 uur beroep open bij de commissaris van de Koning (art. 17 lid 2). De nabestaanden vragen de vergunning aan bij de gemeente waar de persoon is overleden, meestal via de uitvaartondernemer (RVO)." />
              <property key="wiki-gemma-model synoniemen" value="Andere termijn stellen (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/stellen-andere-termijn.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="stoffelijk-overschot" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Uitbaten begraafplaatsen en crematoria" id="id-5af8af7852ed53e997cd7d3cc9e4405f">
              <documentation>Het openhouden van gemeentelijke begraafplaatsen en crematoria en het ter beschikking stellen van graven en ruimte voor bijzetting en verstrooiing.</documentation>
              <property key="wiki-gemma-model id" value="uitbaten-begraafplaatsen-en-crematoria" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2026-vng-gemma-2026-10-02" />
              <property key="wiki-gemma-model beschrijving" value="Op de gemeentelijke begraafplaats en in een gemeentelijk crematorium begraaft, cremeert en zet de gemeente bij, binnen de tijden die de verordening bepaalt (Wet op de lijkbezorging art. 23, 49, 56, 62; Groningen art. 7, 21), en ruimt zij graven om ruimte vrij te maken (art. 31; Groningen art. 27). Het cluster groepeert deze bedrijfsprocessen als specialisatie van het GEMMA-proces Uitbaten gemeentelijke voorzieningen." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/uitbaten-begraafplaatsen-en-crematoria.md" />
              <property key="wiki-gemma-model procesniveau" value="cluster naar soort werk" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Onderhouden graf" id="id-6344b6861697540e8216a9c9707038a8">
              <documentation>Het onderhouden van grafbedekking en beplanting op een graf door de gemeente.</documentation>
              <property key="wiki-gemma-model id" value="onderhouden-graf" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2010-vng-model-beheersverordening-begraafplaatsen; 2026-vng-retributies" />
              <property key="wiki-gemma-model beschrijving" value="De gemeente maakt gedenktekens schoon en onderhoudt de beplanting op graven, op sommige begraafplaatsen altijd en elders op schriftelijk verzoek van de rechthebbende voor ten minste vijf jaar, tegen betaling van een recht uit de heffingsverordening (Groningen art. 23, 24 lid 3). Bij niet-betalen wordt de grafbedekking na waarschuwing verwijderd (art. 23 lid 4). Het VNG-model regelt een minimaal onderhoud door de gemeente (art. 20)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/onderhouden-graf.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="grafbedekking" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Verlenen grafrecht" id="id-72c234ccca9b5464811e0474bcd782ce">
              <documentation>Het verlenen van een grafrecht op een particulier graf aan een rechthebbende.</documentation>
              <property key="wiki-gemma-model id" value="verlenen-grafrecht" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2010-vng-model-beheersverordening-begraafplaatsen; 2026-vng-retributies" />
              <property key="wiki-gemma-model beschrijving" value="Het college verleent op schriftelijke aanvraag een recht op een particulier graf, voor 30 jaar of bij een urnengraf voor 5 tot 30 jaar (Groningen art. 16; VNG-model art. 15); de wet spreekt van het vestigen van het uitsluitend recht, voor onbepaalde tijd of ten minste tien jaar (art. 28). Beslisser is het college; het VNG-model beveelt mandaat aan de beheerder aan. Graven worden in volgorde van ligging uitgegeven (Groningen art. 14). Verlenging volgt op verzoek van de rechthebbende (art. 28 lid 1). De gemeente heft voor de uitgifte lijkbezorgingsrechten (VNG retributies)." />
              <property key="wiki-gemma-model synoniemen" value="Uitgifte van een graf (beleid); Vestigen van het uitsluitend recht op een graf (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/verlenen-grafrecht.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="grafrecht" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Vervallen verklaren grafrecht" id="id-75a1ffb3a38f5ed482179917b41d5c97">
              <documentation>Het beëindigen van een grafrecht door de gemeente, bijvoorbeeld bij verwaarlozing van het graf of het uitblijven van betaling.</documentation>
              <property key="wiki-gemma-model id" value="vervallen-verklaren-grafrecht" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2010-vng-model-beheersverordening-begraafplaatsen" />
              <property key="wiki-gemma-model beschrijving" value="Bij kennelijke verwaarlozing van het onderhoud van een particulier graf legt de houder dat vast in een verklaring van verwaarlozing; voorziet de rechthebbende niet binnen één jaar (of vijf jaar na bekendmaking bij het graf) in het onderhoud, dan vervalt het recht (art. 28 lid 4–7). Het college kan het grafrecht ook vervallen verklaren bij wanbetaling, verzuim of als het na het overlijden van de rechthebbende niet tijdig wordt overgeschreven (Groningen art. 18 lid 4, 20 lid 2; VNG-model art. 17 lid 3). Beslisser is het college." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/vervallen-verklaren-grafrecht.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="grafrecht" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Treffen maatregel bij besmet stoffelijk overschot" id="id-80882f2992c259ec970fe9e268f3f946">
              <documentation>Het nemen van maatregelen om gevaar voor de volksgezondheid door een besmet stoffelijk overschot af te wenden.</documentation>
              <property key="wiki-gemma-model id" value="treffen-maatregel-bij-besmet-stoffelijk-overschot" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-rijk-wet-publieke-gezondheid-wettekst" />
              <property key="wiki-gemma-model beschrijving" value="Is een stoffelijk overschot besmet met een infectieus of giftig agens of stof, of bestaat daarvan een gegrond vermoeden, waardoor een ernstig gevaar voor de volksgezondheid kan ontstaan, dan kan de burgemeester maatregelen treffen om dit gevaar af te wenden, na advies van de GGD (Wet op de lijkbezorging art. 22a). Beslisser is de burgemeester. De melding komt van een arts via de GGD (Wet publieke gezondheid art. 21 lid 2, 27 lid 3). De maatregel zelf is een beschikking." />
              <property key="wiki-gemma-model synoniemen" value="Treffen maatregel bij besmet lijk (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/treffen-maatregel-bij-besmet-stoffelijk-overschot.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="stoffelijk-overschot" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Verlenen vergunning grafbedekking" id="id-873fa38b3c5e556c9a1f0e7f5b577f7d">
              <documentation>Het beslissen op een aanvraag om een vergunning voor een gedenkteken of andere grafbedekking op een particulier graf.</documentation>
              <property key="wiki-gemma-model id" value="verlenen-vergunning-grafbedekking" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2010-vng-model-beheersverordening-begraafplaatsen; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="De rechthebbende van een particulier graf vraagt de vergunning aan; het college beslist en kan de vergunning weigeren als niet wordt voldaan aan de nadere regels over de aard en de afmetingen van de grafbedekking (Groningen art. 22; VNG-model art. 19). Beslisser is het college." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/verlenen-vergunning-grafbedekking.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="grafbedekking" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Schouwen stoffelijk overschot" id="id-8aeb21e52a7a5af99faf3d55995af0bb">
              <documentation>Onderzoek van een stoffelijk overschot door een arts na het overlijden, om vast te stellen of de dood een natuurlijke oorzaak heeft.</documentation>
              <property key="wiki-gemma-model id" value="schouwen-stoffelijk-overschot" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst" />
              <property key="wiki-gemma-model beschrijving" value="Elk stoffelijk overschot wordt zo spoedig mogelijk geschouwd, door de behandelend arts of door een gemeentelijke lijkschouwer (art. 3). Is de dood natuurlijk, dan volgt een verklaring van overlijden (art. 7); anders waarschuwt de lijkschouwer de officier van justitie en de ambtenaar van de burgerlijke stand (art. 10). Bij een minderjarige kan een nader onderzoek naar de doodsoorzaak volgen (art. 10a). De schouwing door de behandelend arts valt buiten het gemeentelijk perspectief." />
              <property key="wiki-gemma-model synoniemen" value="Lijkschouwing (wet); Schouwen lijk (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/schouwen-stoffelijk-overschot.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="stoffelijk-overschot" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Afgeven laissez-passer" id="id-8cec781544c351dcafada66fb7c002ce">
              <documentation>Het afgeven van het laissez-passer voor lijken voor vervoer van een stoffelijk overschot naar een verdragsstaat.</documentation>
              <property key="wiki-gemma-model id" value="afgeven-laissez-passer" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-besluit-op-de-lijkbezorging-wettekst; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="De burgemeester van de gemeente waar de akte van overlijden is ingeschreven, geeft het laissez-passer af voor vervoer naar een staat die partij is bij de Overeenkomst van Straatsburg; voor vervoer over land naar België of Luxemburg volstaat het verlof tot begraving of crematie (Besluit op de lijkbezorging art. 11 lid 1, 3). Beslisser is de burgemeester." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/afgeven-laissez-passer.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="stoffelijk-overschot" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Opgraven stoffelijk overschot" id="id-abcb82c5d790520f856afdda24be34b1">
              <documentation>Het opgraven van een stoffelijk overschot uit een graf, met vergunning van de burgemeester.</documentation>
              <property key="wiki-gemma-model id" value="opgraven-stoffelijk-overschot" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="Een stoffelijk overschot wordt slechts opgegraven met vergunning van de burgemeester en, bij een particulier graf, met toestemming van de rechthebbende; de burgemeester verbindt voorschriften aan de vergunning over geneeskundig toezicht, vervoer en bestemming (art. 29). Beslisser is de burgemeester. De rechthebbende dient de aanvraag in en schakelt een erkend bedrijf in; opgraven gebeurt in de regel pas na tien jaar grafrust (Groningen art. 28)." />
              <property key="wiki-gemma-model synoniemen" value="Opgraving (wet); Opgraven lijk (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/opgraven-stoffelijk-overschot.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="stoffelijk-overschot" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Toestaan lijkbezorging" id="id-bf2beb74813c5544b7d509dfd4a25aca">
              <documentation>Het schouwen van een stoffelijk overschot en het verlenen van verlof, vergunningen en toestemmingen voor de lijkbezorging, met zo nodig maatregelen.</documentation>
              <property key="GEMMA type" value="Bedrijfsproces (cluster)" />
              <property key="wiki-gemma-model id" value="toestaan-lijkbezorging" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2025-groningen-algemene-plaatselijke-verordening; 2026-rijk-besluit-op-de-lijkbezorging-wettekst" />
              <property key="wiki-gemma-model beschrijving" value="Geen begraving, crematie of ontleding zonder schriftelijk verlof: de ambtenaar van de burgerlijke stand verleent verlof tot begraving of crematie als hij beschikt over een verklaring van overlijden van de behandelend arts of de gemeentelijke lijkschouwer, of over een verklaring van geen bezwaar van de officier van justitie; de burgemeester verleent verlof tot ontleding (Wet op de lijkbezorging art. 3, 4, 11, 12, 68). De burgemeester kan een andere termijn stellen, geeft het laissez-passer af voor vervoer naar het buitenland, treft maatregelen bij een besmet stoffelijk overschot en verleent vergunning tot opgraving; het college staat asverstrooiing toe (art. 17, 22a, 29; Besluit op de lijkbezorging art. 11; APV Groningen art. 5:27).&#10;&#10;Het is het deel van de gemeente als overheid in de ketensamenwerking Bezorgen stoffelijk overschot; het begraven en cremeren zelf is het deel van de houder van de begraafplaats of het crematorium. De schouwing door de behandelend arts valt buiten het gemeentelijk perspectief." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/toestaan-lijkbezorging.md" />
              <property key="wiki-gemma-model procesniveau" value="levensloopproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="stoffelijk-overschot" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Verlenen vergunning bijzonder crematorium" id="id-c1affa7acf5353f9bc6f7eab26090146">
              <documentation>Het verlenen van de vergunning voor het vestigen, uitbreiden of wijzigen van een crematorium van een particuliere houder.</documentation>
              <property key="wiki-gemma-model id" value="verlenen-vergunning-bijzonder-crematorium" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst" />
              <property key="wiki-gemma-model beschrijving" value="Het vestigen, uitbreiden of wijzigen van een bijzonder crematorium behoeft een vergunning van het college (Wet op de lijkbezorging art. 53). Een vergunning voor vestiging wordt pas verleend nadat het college het voornemen ten minste dertig dagen tevoren openbaar heeft gemaakt (art. 54). Belanghebbenden kunnen in beroep bij gedeputeerde staten (art. 55)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/verlenen-vergunning-bijzonder-crematorium.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="crematorium" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Behandelen vergunningaanvragen lijkbezorging" id="id-c3bb9f903a155d4f8925239f9ee53754">
              <documentation>Het behandelen van aanvragen om een vergunning, verlof of toestemming voor de lijkbezorging en voor begraafplaatsen en crematoria.</documentation>
              <property key="wiki-gemma-model id" value="behandelen-vergunningaanvragen-lijkbezorging" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-vng-gemma-2026-10-02; 2026-rijk-besluit-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2025-groningen-algemene-plaatselijke-verordening" />
              <property key="wiki-gemma-model beschrijving" value="Binnen de lijkbezorging verleent de gemeente op aanvraag verloven, vergunningen en toestemmingen: het verlof tot begraving of crematie (Wet op de lijkbezorging art. 11), een andere termijn (art. 17), de vergunning tot opgraving (art. 29), de toestemming voor een bijzondere begraafplaats (art. 40, 41), de vergunning voor een bijzonder crematorium (art. 53), het verlof tot ontleding (art. 68), het laissez-passer voor lijken (Besluit op de lijkbezorging art. 11), de vergunning grafbedekking (Groningen art. 22) en de toestemming voor asverstrooiing (APV Groningen art. 5:27 lid 3; Groningen art. 21). Het cluster groepeert deze bedrijfsprocessen als specialisatie van het GEMMA-proces Behandelen aanvraag vergunning of ontheffing." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/behandelen-vergunningaanvragen-lijkbezorging.md" />
              <property key="wiki-gemma-model procesniveau" value="cluster naar soort werk" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Sluiten begraafplaats" id="id-d0fd7ec403a853aa853532a68ae58530">
              <documentation>Het besluit dat op een begraafplaats niet meer wordt begraven, of de geslotenverklaring na tien jaar zonder begraving.</documentation>
              <property key="wiki-gemma-model id" value="sluiten-begraafplaats" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst" />
              <property key="wiki-gemma-model beschrijving" value="Een begraafplaats kan worden gesloten; voor een gemeentelijke begraafplaats neemt het college het besluit, en van de sluiting van een andere begraafplaats wordt het college direct op de hoogte gesteld (Wet op de lijkbezorging art. 43). Is er tien jaar niet begraven, dan kan het college de begraafplaats gesloten verklaren (art. 44). Belanghebbenden kunnen in beroep bij gedeputeerde staten, die de rechthebbende op een particulier graf een schadeloosstelling ten laste van de gemeente kunnen toekennen (art. 45)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/sluiten-begraafplaats.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="begraafplaats" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Verzorgen gemeentebegrafenis" id="id-d254a261cbf8513f9768449e654e0032">
              <documentation>Het regelen en betalen van de lijkbezorging door de gemeente als niemand anders daarin voorziet.</documentation>
              <property key="GEMMA type" value="Bedrijfsproces (cluster)" />
              <property key="wiki-gemma-model id" value="verzorgen-gemeentebegrafenis" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-vng-ggm-2-5-1" />
              <property key="wiki-gemma-model beschrijving" value="Als niemand voorziet in de lijkschouwing en lijkbezorging, waarschuwt degene die het stoffelijk overschot onder zich heeft de burgemeester, die daarvoor zorg draagt (art. 20, 21 lid 1). Beslisser is de burgemeester. De kosten komen ten laste van de gemeente, die ze kan verhalen op de nalatenschap, onderhoudsplichtige verwanten of de werkgever (art. 22); dat kostenverhaal is een stap in dit proces. Een stoffelijk overschot waarvan de identiteit niet kan worden vastgesteld, wordt begraven (art. 21 lid 6). Het resultaat is een gemeentebegrafenis." />
              <property key="wiki-gemma-model synoniemen" value="Lijkbezorging door de burgemeester (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/verzorgen-gemeentebegrafenis.md" />
              <property key="wiki-gemma-model procesniveau" value="levensloopproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="gemeentebegrafenis" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Verlenen toestemming bijzondere begraafplaats" id="id-d8af547308345aad80d4bb0e78696466">
              <documentation>Het aanwijzen van grond voor een bijzondere begraafplaats en het toestaan van de ingebruikneming ervan.</documentation>
              <property key="wiki-gemma-model id" value="verlenen-toestemming-bijzondere-begraafplaats" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="Een bijzondere begraafplaats wordt aangelegd en in stand gehouden door een kerkgenootschap, een privaatrechtelijke rechtspersoon of een natuurlijk persoon (Wet op de lijkbezorging art. 37). Voor aanleg of uitbreiding wordt alleen grond gebruikt die de gemeenteraad heeft aangewezen; het college kan maatregelen voorschrijven om de grond geschikt te maken (art. 40). Voor de ingebruikneming is toestemming van het college nodig, die alleen wordt geweigerd als niet aan de wettelijke voorschriften is voldaan (art. 41). Tegen deze besluiten staat beroep open bij gedeputeerde staten (art. 42)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/verlenen-toestemming-bijzondere-begraafplaats.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="begraafplaats" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Beheren crematoria" id="id-df39047cb6b35de2925edbb67e10e4a0">
              <documentation>Het beheer van een crematorium over de hele levensloop: vestigen, uitbreiden of wijzigen, en opheffen.</documentation>
              <property key="GEMMA type" value="Bedrijfsproces (cluster)" />
              <property key="wiki-gemma-model id" value="beheren-crematoria" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst" />
              <property key="wiki-gemma-model beschrijving" value="Crematoria zijn gemeentelijk of bijzonder; een bijzonder crematorium wordt gevestigd en in werking gehouden door een kerkgenootschap, een privaatrechtelijke rechtspersoon of een natuurlijk persoon (Wet op de lijkbezorging art. 51, 52). Het college besluit tot vestiging van een gemeentelijk crematorium of verleent een vergunning voor een bijzonder crematorium, in beide gevallen na een openbare kennisgeving van ten minste dertig dagen (art. 53, 54). Bij opheffing van een bijzonder crematorium gaat het register naar het archief van de gemeente (art. 50 lid 3)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/beheren-crematoria.md" />
              <property key="wiki-gemma-model procesniveau" value="levensloopproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="crematorium" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Begraven en cremeren stoffelijk overschot" id="id-e8c7ddb2faf7584d9df021d820ef9f8b">
              <documentation>Het begraven of cremeren van een stoffelijk overschot door de houder van een begraafplaats of crematorium, tot en met de bestemming van de as.</documentation>
              <property key="GEMMA type" value="Bedrijfsproces (cluster)" />
              <property key="wiki-gemma-model id" value="begraven-en-cremeren-stoffelijk-overschot" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen" />
              <property key="wiki-gemma-model beschrijving" value="Begraving geschiedt op een begraafplaats, crematie in een crematorium (Wet op de lijkbezorging art. 23, 49). Op de gemeentelijke begraafplaats bepaalt de beheerder tijd en plaats in overleg met de uitvaartondernemer, na kennisgeving door wie de uitvaart regelt (Groningen art. 7). De houder van een crematorium houdt een register bij, bewaart de asbus minimaal een maand en zorgt daarna voor de bestemming van de as: bijzetting, verstrooiing of meegeven aan de nabestaande (art. 50, 59, 62).&#10;&#10;Het is het deel van de houder van de begraafplaats of het crematorium in de ketensamenwerking Bezorgen stoffelijk overschot. De gemeente voert het uit als houder van de gemeentelijke begraafplaats of van een gemeentelijk crematorium (art. 33); bij een bijzondere begraafplaats of een particulier crematorium doet de particuliere houder het." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/begraven-en-cremeren-stoffelijk-overschot.md" />
              <property key="wiki-gemma-model procesniveau" value="levensloopproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="stoffelijk-overschot" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Uitvoeren lijkbezorging" id="id-f3fef18c03185926a98c84015a0dae05">
              <documentation>Het begraven, cremeren of op een andere wettelijke wijze bezorgen van een stoffelijk overschot.</documentation>
              <property key="wiki-gemma-model id" value="uitvoeren-lijkbezorging" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen" />
              <property key="wiki-gemma-model beschrijving" value="De lijkbezorging geschiedt door begraving, crematie of op een andere wettelijk voorziene wijze, en omvat ook het geven van een bestemming aan de as (art. 1, 18 lid 2). Ze vereist een verlof tot begraving of crematie (art. 11) en volgt, waar mogelijk, de wens van de overledene (art. 19). Op de gemeentelijke begraafplaats bepaalt de beheerder tijd en plaats in overleg met de uitvaartondernemer, na kennisgeving door wie de uitvaart regelt (Groningen art. 7). Begraving, crematie en ontleding zijn varianten zonder eigen pagina; het bijzetten of verstrooien van de as is een eigen bedrijfsproces." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/uitvoeren-lijkbezorging.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="stoffelijk-overschot" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Bijzetten of verstrooien van de as" id="id-f72e2ea91a40554590885208703a5f48">
              <documentation>Het geven van een bestemming aan de as na een crematie: bijzetten van de urn, verstrooien van de as of meegeven aan de nabestaande.</documentation>
              <property key="wiki-gemma-model id" value="bijzetten-of-verstrooien-van-de-as" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen" />
              <property key="wiki-gemma-model beschrijving" value="Na de crematie bewaart de houder van het crematorium de asbus minimaal een maand en zorgt hij daarna dat de asbus wordt bijgezet, de as wordt verstrooid, de asbus aan de nabestaande wordt meegegeven of naar het buitenland gaat (Wet op de lijkbezorging art. 59). Een asbus wordt bijgezet in een crematorium, in of op een graf of op een afzonderlijke plaats op een begraafplaats, of in een bewaarplaats; in een particulier graf alleen met toestemming van de rechthebbende (art. 62). De houder van de plaats van bijzetting houdt een register bij en kan de asbus op verzoek aan de nabestaande meegeven (art. 63, 65). Verstrooien door een houder mag alleen op een daartoe bestemd terrein of in open zee (art. 66a); op de gemeentelijke begraafplaats kan het college incidentele asverstrooiing op een aangewezen plek toestaan (Groningen art. 21)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/bijzetten-of-verstrooien-van-de-as.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="urn" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Verlenen verlof tot begraving of crematie" id="id-f99078369b645c1f80d4b1767a539fcc">
              <documentation>Het afgeven van het schriftelijk verlof waarmee een stoffelijk overschot mag worden begraven of gecremeerd.</documentation>
              <property key="wiki-gemma-model id" value="verlenen-verlof-tot-begraving-of-crematie" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-rvo-aangifte-en-akte-van-overlijden; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="Geen begraving of crematie geschiedt zonder schriftelijk verlof van de ambtenaar van de burgerlijke stand, dat kosteloos wordt afgegeven (art. 11). Hij verleent het alleen als hij beschikt over een verklaring van overlijden van de behandelend arts of de gemeentelijke lijkschouwer, of over een verklaring van geen bezwaar van de officier van justitie (art. 12). De stukken worden bij de akte van overlijden gevoegd (art. 13). In de praktijk krijgt de uitvaartondernemer het verlof na de aangifte van overlijden (Ondernemersplein)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/verlenen-verlof-tot-begraving-of-crematie.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="stoffelijk-overschot" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
          </folder>
        </folder>
      </folder>
      <folder name="Producten" id="id-2036e647274c5af5818a37739cf9a460">
        <folder name="7 Volksgezondheid en Milieu" id="id-9b2c096aa97c5ffea6adba7e89883833">
          <folder name="Begraafplaatsen en crematoria" id="id-72675453814a56dca88224af923978c7">
            <element xsi:type="archimate:Product" name="Grafuitgifte" id="id-8d4fd52a89f35252a2ad5988de55110d">
              <documentation>Een particulier graf, urnengraf of urnennis op een gemeentelijke begraafplaats, met het uitsluitend recht daarop voor een vaste termijn.</documentation>
              <property key="wiki-gemma-model id" value="grafuitgifte" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2010-vng-model-beheersverordening-begraafplaatsen; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2026-vng-retributies" />
              <property key="wiki-gemma-model beschrijving" value="De gemeente geeft op haar begraafplaatsen particuliere graven, urnengraven en urnennissen uit (VNG-model art. 11, 13–15; Groningen art. 14, 16). Het product bundelt de dienst Graf aanvragen en de afspraak Grafrecht. De gemeente heft er lijkbezorgingsrechten voor; die staan in de UPL als het product grafrechten (Gemeentewet art. 229; VNG retributies).&#10;&#10;De UPL geeft als grondslag art. 11 van de model-beheersverordening (indeling graven en asbezorging); de uitgifte zelf staat in art. 13 tot 15 van dat model (UPL)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/producten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/grafuitgifte.md" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model domein" value="Fysieke leefomgeving" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
          </folder>
        </folder>
      </folder>
      <folder name="Rollen" id="id-8952e40c37b1557a9e0fe6b1dbcd6ebb">
        <folder name="0 Bestuur en Ondersteuning" id="id-b1da476977cd5440a145fb3cea8b33ea">
          <folder name="Burgerzaken" id="id-78ba4899a1425cabab8448fa4029f554">
            <element xsi:type="archimate:BusinessRole" name="Ouder" id="id-02e3990e97385be4a5c95c41206d8973">
              <documentation>Hoedanigheid van wie juridisch moeder of andere ouder van een kind is, door geboorte, huwelijk, erkenning, vaststelling of adoptie.</documentation>
              <property key="wiki-gemma-model id" value="ouder" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-burgerlijk-wetboek-boek-1; 2026-rvig-hup-geboorte; 2026-utrecht-burgerzaken-geboorteaangifte-doen; 2026-rijk-wet-brp-bwbr0033715; 2026-utrecht-burgerzaken-kind-erkennen; 2026-utrecht-burgerzaken-levenloos-geboren-kind-of-overleden-pasgeboren-kind-aangifte-doen; 2026-utrecht-burgerzaken-achternaam-kind-kiezen; 2026-rijk-paspoortwet-bwbr0005212; 2026-utrecht-burgerzaken-paspoort-of-identiteitskaart-aanvragen; 2026-utrecht-burgerzaken-paspoort-of-identiteitskaart-vermissing-of-diefstal-doorgeven" />
              <property key="wiki-gemma-model beschrijving" value="Een kind heeft juridisch altijd een moeder, de vrouw uit wie het is geboren of de adoptiefmoeder, en hoogstens één andere ouder: de echtgenoot of partner van de moeder, de erkenner, de ouder van wie het ouderschap is vastgesteld of de adoptiefouder (BW 1 art. 198, 199; HUP Geboorte). In de gemeentelijke praktijk heet de vrouwelijke andere ouder duomoeder (Utrecht). De ouder doet aangifte van geboorte, erkent het kind, kiest samen met de andere ouder de achternaam en heeft gezag over een minderjarig kind (BW 1 art. 5, 19e, 203, 247).&#10;&#10;Voor een reisdocument van een minderjarige geeft iedere ouder met gezag toestemming, online of op een formulier; een ouder meldt de vermissing van het reisdocument van een kind tot en met elf jaar (Paspoortwet art. 34; Utrecht)." />
              <property key="wiki-gemma-model synoniemen" value="Moeder (wet); Vader (wet); Duomoeder (beleid); Erkenner (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/ouder.md" />
              <property key="wiki-gemma-model doelgroep" value="inwoners en ondernemers" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessRole" name="Houder van het rijbewijs" id="id-15a7b2910a3e5ad6a770b92ea695d845">
              <documentation>Hoedanigheid van degene aan wie een rijbewijs is of wordt afgegeven en die het aanvraagt, ophaalt, vermissing meldt en inlevert.</documentation>
              <property key="wiki-gemma-model id" value="houder-van-het-rijbewijs" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wegenverkeerswet-1994-bwbr0006622; 2026-rijk-reglement-rijbewijzen-bwbr0008074; 2026-utrecht-burgerzaken-rijbewijs-aanvragen-of-verlengen; 2026-utrecht-burgerzaken-rijbewijs-buitenland-omwisselen" />
              <property key="wiki-gemma-model beschrijving" value="Het Reglement rijbewijzen spreekt van de aanvrager, de Wegenverkeerswet 1994 van de houder van een rijbewijs. In de gemeentelijke praktijk is het dezelfde persoon in opeenvolgende fasen: hij vraagt aan met een identiteitsbewijs en een pasfoto, haalt het nieuwe rijbewijs persoonlijk op, levert het oude in, geeft een vermissing door en levert een teruggevonden rijbewijs in (Reglement rijbewijzen art. 27, 33; Wegenverkeerswet 1994 art. 111 lid 2, 119 lid 2 en 4; Utrecht)." />
              <property key="wiki-gemma-model synoniemen" value="Aanvrager rijbewijs (wet); Rijbewijshouder (beleid)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/houder-van-het-rijbewijs.md" />
              <property key="wiki-gemma-model doelgroep" value="inwoners en ondernemers" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessRole" name="Optant" id="id-1ba2e344926d50668160294ea7e69bbb">
              <documentation>Hoedanigheid van degene die een optieverklaring aflegt om Nederlander te worden.</documentation>
              <property key="wiki-gemma-model id" value="optant" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-besluit-verkrijging-verlies-nederlanderschap-bwbr0013605" />
              <property key="wiki-gemma-model beschrijving" value="De optant legt de verklaring schriftelijk en in persoon af, verstrekt gegevens over zichzelf en de personen die hij in zijn optie betrekt, en verklaart dat die naar waarheid zijn (Besluit verkrijging en verlies Nederlanderschap art. 3, 6). Voor een minderjarige treedt de wettelijke vertegenwoordiger op (Rijkswet op het Nederlanderschap art. 2 lid 3; Besluit art. 60a lid 2). Na de bevestiging verschijnt de optant op oproeping bij de uitreiking en legt hij de verklaring van verbondenheid af (Besluit art. 60a). Utrecht spreekt van aanvrager." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/optant.md" />
              <property key="wiki-gemma-model doelgroep" value="inwoners en ondernemers" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessRole" name="Houder van het reisdocument" id="id-1f353cf8b2da52a8ba87a2badab9a4f3">
              <documentation>Hoedanigheid van degene op wiens naam een reisdocument is of wordt gesteld en die het aanvraagt, ophaalt, vermissing meldt en inlevert.</documentation>
              <property key="wiki-gemma-model id" value="houder-van-het-reisdocument" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-paspoortwet-bwbr0005212; 2026-rvig-hup-inhouding-inlevering-vermissing; 2026-utrecht-burgerzaken-paspoort-of-identiteitskaart-aanvragen; 2026-utrecht-burgerzaken-paspoort-of-identiteitskaart-vermissing-of-diefstal-doorgeven; 2026-rijk-paspoortbesluit-bwbr0044308" />
              <property key="wiki-gemma-model beschrijving" value="De wet onderscheidt de aanvrager, die een aanvraag indient of op wie zij betrekking heeft, en de houder, op wiens naam het reisdocument is gesteld en voor wie het is uitgereikt (Paspoortwet art. 1 onder b en f). In de gemeentelijke praktijk is het dezelfde persoon in opeenvolgende fasen: hij verschijnt persoonlijk bij de aanvraag, legt al zijn reisdocumenten over, haalt het nieuwe document op en levert de oude in, meldt een vermissing en levert een vervallen of teruggevonden document in (art. 28, 29, 32, 56; Utrecht). Voor een minderjarige vraagt de ouder of voogd aan en geeft de toestemming (art. 34)." />
              <property key="wiki-gemma-model synoniemen" value="Aanvrager (wet); Houder (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/houder-van-het-reisdocument.md" />
              <property key="wiki-gemma-model doelgroep" value="inwoners en ondernemers" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessRole" name="Aanvrager van de verklaring omtrent het gedrag" id="id-a09954e2b4a756a7bf6b8243ff777012">
              <documentation>Hoedanigheid van degene omtrent wiens gedrag een verklaring omtrent het gedrag wordt gevraagd en die de aanvraag indient.</documentation>
              <property key="wiki-gemma-model id" value="aanvrager-van-de-verklaring-omtrent-het-gedrag" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-justitiele-en-strafvorderlijke-gegevens-bwbr0014194; 2026-utrecht-burgerzaken-verklaring-omtrent-het-gedrag-aanvragen-vog" />
              <property key="wiki-gemma-model beschrijving" value="De wet kent de aanvrager, degene omtrent wiens gedrag de verklaring wordt gevraagd, of een vertegenwoordiger van de rechtspersoon (Wet justitiële en strafvorderlijke gegevens art. 33). De aanvraag bevat de voornamen, de geboortedatum en het doel, en de aanvrager of degene te wiens behoeve de verklaring wordt gevraagd, geeft het risico voor de samenleving op (art. 32). In de praktijk heeft vaak een werkgever of een andere organisatie het aanvraagformulier ingevuld; de aanvrager zelf dient in en betaalt (Utrecht)." />
              <property key="wiki-gemma-model synoniemen" value="Aanvrager VOG (beleid); Aanvrager verklaring omtrent het gedrag (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/aanvrager-van-de-verklaring-omtrent-het-gedrag.md" />
              <property key="wiki-gemma-model doelgroep" value="inwoners en ondernemers" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessRole" name="Verzoeker om naturalisatie" id="id-b03ac95a30345b4e8d84f6d85235efde">
              <documentation>Hoedanigheid van degene die een verzoek om naturalisatie indient om Nederlander te worden.</documentation>
              <property key="wiki-gemma-model id" value="verzoeker-om-naturalisatie" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-besluit-verkrijging-verlies-nederlanderschap-bwbr0013605; 2026-utrecht-burgerzaken-nederlander-worden-door-naturalisatie-of-optie; 2026-rijk-rijkswet-op-het-nederlanderschap-bwbr0003738" />
              <property key="wiki-gemma-model beschrijving" value="De verzoeker dient het verzoek schriftelijk, ondertekend en in persoon in, ook voor de minderjarige kinderen die in de naturalisatie delen; voor een minderjarige treedt de wettelijke vertegenwoordiger op (Rijkswet op het Nederlanderschap art. 2 lid 3, 7, 11; Besluit verkrijging en verlies Nederlanderschap art. 3, 31). Na het besluit verschijnt hij op oproeping bij de uitreiking en legt hij de verklaring van verbondenheid af (Besluit art. 60b)." />
              <property key="wiki-gemma-model synoniemen" value="Verzoeker (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/verzoeker-om-naturalisatie.md" />
              <property key="wiki-gemma-model doelgroep" value="inwoners en ondernemers" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
          </folder>
        </folder>
        <element xsi:type="archimate:BusinessRole" name="Beheerder van de begraafplaats" id="id-0b6bb452a0fc5152a59a86b77fe09422">
          <documentation>Ambtenaar die belast is met de dagelijkse leiding van de gemeentelijke begraafplaatsen.</documentation>
          <property key="wiki-gemma-model id" value="beheerder-van-de-begraafplaats" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2010-vng-model-beheersverordening-begraafplaatsen" />
          <property key="wiki-gemma-model beschrijving" value="De beheerder bepaalt tijd en plaats van begravingen in overleg met de uitvaartondernemer, ontvangt en toetst de stukken (verlof, machtiging) en aanvragen, houdt het register van begraven lijken bij, handhaaft de orde en ziet toe op ruiming (Groningen art. 1 e, 4–9, 27, 30). Het VNG-model beveelt aan de beheerder aan te wijzen als aanspreekpunt voor burgers en aanvragen, met mandaat om te beslissen (toelichting 2)." />
          <property key="wiki-gemma-model synoniemen" value="Beheerder (beleid)" />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/beheerder-van-de-begraafplaats.md" />
          <property key="wiki-gemma-model doelgroep" value="gemeente" />
        </element>
        <element xsi:type="archimate:BusinessRole" name="Bijhoudingsgemeente" id="id-21ee5aa7e6ad5b49802973485b3e3974">
          <documentation>Verantwoordelijkheid van een gemeente voor de bijhouding van de gegevens van de ingezetenen die er hun adres hebben.</documentation>
          <property key="wiki-gemma-model id" value="bijhoudingsgemeente" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2026-rvig-hup-intergemeentelijke-adreswijziging; 2026-rvig-hup-emigratie; 2026-rvig-hup-wijzigen-bsn; 2026-rvig-hup-achtergronden-en-begrippen" />
          <property key="wiki-gemma-model beschrijving" value="Het college van de gemeente waar een ingezetene zijn adres heeft, is verantwoordelijk voor de bijhouding van zijn gegevens (HUP Achtergronden). Bij een verhuizing naar een andere gemeente wordt die de nieuwe bijhoudingsgemeente; na emigratie blijft de laatste bijhoudingsgemeente verantwoordelijk voor rechtsfeiten van voor de emigratie (HUP Intergemeentelijke adreswijziging; HUP Emigratie)." />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/bijhoudingsgemeente.md" />
          <property key="wiki-gemma-model doelgroep" value="gemeente" />
        </element>
        <element xsi:type="archimate:BusinessRole" name="Briefadresgever" id="id-339066946d2c5fd59ac2ad56f0263ba2">
          <documentation>Verantwoordelijkheid van een persoon of aangewezen rechtspersoon om post voor de houder van een briefadres in ontvangst te nemen en door te geven.</documentation>
          <property key="wiki-gemma-model id" value="briefadresgever" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2026-rvig-hup-verblijfplaats" />
          <property key="wiki-gemma-model beschrijving" value="De briefadresgever is een natuurlijk persoon of een door het college aangewezen rechtspersoon; hij stemt schriftelijk in, zorgt dat geschriften voor de houder worden doorgegeven en verstrekt het college inlichtingen (HUP Verblijfplaats). Zonder briefadresgever registreert de gemeente een adres van de gemeente zelf (HUP Verblijfplaats)." />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/briefadresgever.md" />
          <property key="wiki-gemma-model doelgroep" value="inwoners en ondernemers" />
        </element>
        <element xsi:type="archimate:BusinessRole" name="Ambtenaar van de burgerlijke stand" id="id-3b44289d234957ecad7e1c725acf246a">
          <documentation>Ambtenaar die bevoegd is akten van de burgerlijke stand op te maken.</documentation>
          <property key="wiki-gemma-model id" value="ambtenaar-van-de-burgerlijke-stand" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-rvo-aangifte-en-akte-van-overlijden; 2026-rijk-burgerlijk-wetboek-boek-1; 2026-rijk-besluit-burgerlijke-stand-1994-bwbr0006493" />
          <property key="wiki-gemma-model beschrijving" value="De ambtenaar van de burgerlijke stand maakt de akten van de burgerlijke stand op, waaronder de akte van overlijden na aangifte bij de gemeente waar iemand is overleden (Wet op de lijkbezorging art. 13, 14; Ondernemersplein)." />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/ambtenaar-van-de-burgerlijke-stand.md" />
          <property key="wiki-gemma-model doelgroep" value="gemeente" />
        </element>
        <element xsi:type="archimate:BusinessRole" name="Aangever" id="id-4f74cda77d82593ba83734350ebc1468">
          <documentation>Hoedanigheid van wie bij de gemeente aangifte doet van een feit voor de basisregistratie personen of de burgerlijke stand, voor zichzelf of een ander.</documentation>
          <property key="wiki-gemma-model id" value="aangever" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2026-rvig-hup-verblijfplaats; 2026-rijk-burgerlijk-wetboek-boek-1; 2026-rvig-hup-emigratie; 2026-utrecht-burgerzaken-levenloos-geboren-kind-of-overleden-pasgeboren-kind-aangifte-doen" />
          <property key="wiki-gemma-model beschrijving" value="Een meerderjarige doet zelf aangifte van verblijf en adres, adreswijziging en vertrek; ouders, voogden en verzorgers zijn verplicht aangifte te doen voor minderjarigen; echtgenoten, partners en ouders met een meerderjarig kind zijn bevoegd voor elkaar; het hoofd van een instelling kan aangifte doen voor wie er verblijft (HUP Verblijfplaats). Het college kan verplichten in persoon te verschijnen (HUP Verblijfplaats; Besluit BRP art. 30).&#10;&#10;Bij de burgerlijke stand doet de aangever aangifte bij de ambtenaar van de burgerlijke stand: van een geboorte (de vader of moeder, of wie bij de bevalling aanwezig was; BW 1 art. 19e), van een overlijden (wie het uit eigen wetenschap weet, of een gemachtigde zoals de uitvaartondernemer; art. 19h), van een levenloos geboren kind (art. 19i) en van de wijziging van de vermelding van het geslacht (art. 28). De ambtenaar stelt de identiteit van de aangever vast (art. 19e lid 8)." />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/aangever.md" />
          <property key="wiki-gemma-model doelgroep" value="inwoners en ondernemers" />
        </element>
        <element xsi:type="archimate:BusinessRole" name="Houder van de begraafplaats" id="id-77e415928f565e74b91359fde6ad9da7">
          <documentation>Verantwoordelijkheid voor het in stand houden en beheren van een begraafplaats.</documentation>
          <property key="wiki-gemma-model id" value="houder-van-de-begraafplaats" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2010-vng-model-beheersverordening-begraafplaatsen; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen" />
          <property key="wiki-gemma-model beschrijving" value="De houder van de begraafplaats stelt voor een begraving de identiteit van het stoffelijk overschot vast (art. 8), bepaalt wie in een algemeen graf wordt begraven (art. 23), houdt het register van begraven lijken (art. 27), doet mededeling van het verstrijken van termijnen (art. 27a, 28 lid 2), kan een verklaring van verwaarlozing opstellen (art. 28 lid 4) en geeft last tot het ruimen van graven (art. 31). Bij een gemeentelijke begraafplaats is de gemeente houder; bij een bijzondere begraafplaats een kerkgenootschap, rechtspersoon of natuurlijk persoon (art. 37)." />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/houder-van-de-begraafplaats.md" />
          <property key="wiki-gemma-model doelgroep" value="gemeente" />
        </element>
        <element xsi:type="archimate:BusinessRole" name="Gemeentelijke lijkschouwer" id="id-7a33463e2bb35989ab38d88aa0e2a173">
          <documentation>Arts die door het college is benoemd om stoffelijke overschotten te schouwen.</documentation>
          <property key="wiki-gemma-model id" value="gemeentelijke-lijkschouwer" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst" />
          <property key="wiki-gemma-model beschrijving" value="Burgemeester en wethouders benoemen een of meer gemeentelijke lijkschouwers, uitsluitend forensisch artsen (art. 4, 5). Normaal schouwt de behandelend arts het stoffelijk overschot; de gemeentelijke lijkschouwer is de uitzondering en schouwt alleen als de behandelend arts dat niet doet, geeft een verklaring van overlijden af of waarschuwt bij een niet-natuurlijke dood de officier van justitie en de ambtenaar van de burgerlijke stand, en leidt het nader onderzoek bij een minderjarige (art. 3, 7, 10, 10a). Hij kan de elektronische weg openstellen voor mededelingen van de behandelend arts (art. 7 lid 3)." />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/gemeentelijke-lijkschouwer.md" />
          <property key="wiki-gemma-model doelgroep" value="gemeente" />
        </element>
        <element xsi:type="archimate:BusinessRole" name="Kostendrager" id="id-7ef9e7cf4e2158848fdf94c3f5304bce">
          <documentation>Verantwoordelijkheid voor het dragen van de kosten van een voorziening of handeling.</documentation>
          <property key="wiki-gemma-model id" value="kostendrager" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst" />
          <property key="wiki-gemma-model beschrijving" value="Een kostendrager betaalt voor een voorziening of handeling die een ander uitvoert of die hij zelf laat uitvoeren, en kan de kosten soms verhalen." />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/kostendrager.md" />
          <property key="wiki-gemma-model doelgroep" value="gemeente" />
        </element>
        <element xsi:type="archimate:BusinessRole" name="Toezichthouder BRP" id="id-c5359c92fe845af58a4d30b4dbd85edc">
          <documentation>Verantwoordelijkheid voor het toezicht op de juistheid van de inschrijving in de basisregistratie personen, onder meer met een huisbezoek.</documentation>
          <property key="wiki-gemma-model id" value="toezichthouder-brp" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2023-rvig-circulaire-adresonderzoek-brp" />
          <property key="wiki-gemma-model beschrijving" value="De toezichthouder BRP heeft de bevoegdheid inlichtingen op te vragen en legt bij een adresonderzoek huisbezoeken af; het college kan ook externen tot onbezoldigd ambtenaar en toezichthouder benoemen (Circulaire adresonderzoek 4.4, 4.5)." />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/toezichthouder-brp.md" />
          <property key="wiki-gemma-model doelgroep" value="gemeente" />
        </element>
        <element xsi:type="archimate:BusinessRole" name="Rechthebbende op het graf" id="id-cb6de84aee08550d85ac3727aad8bec2">
          <documentation>Wie het grafrecht op een particulier graf heeft en bepaalt wie daarin wordt begraven of bijgezet.</documentation>
          <property key="wiki-gemma-model id" value="rechthebbende-op-het-graf" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2010-vng-model-beheersverordening-begraafplaatsen" />
          <property key="wiki-gemma-model beschrijving" value="De rechthebbende bepaalt wie in het particulier graf wordt begraven (art. 23 lid 2), geeft toestemming voor opgraving en ruiming (art. 29, 31), vraagt verlenging, overschrijving en een vergunning voor de grafbedekking aan, onderhoudt de grafbedekking en kan afstand doen van het recht (Groningen art. 16, 18, 19, 22, 24). Dat kan een natuurlijk persoon of een rechtspersoon zijn (Groningen art. 1 w)." />
          <property key="wiki-gemma-model synoniemen" value="Rechthebbende (beleid)" />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/rechthebbende-op-het-graf.md" />
          <property key="wiki-gemma-model doelgroep" value="inwoners en ondernemers" />
        </element>
        <element xsi:type="archimate:BusinessRole" name="RNI-loket" id="id-ccc943c53eb35f5591901dce3e5ffbbf">
          <documentation>Verantwoordelijkheid van een daartoe aangewezen gemeente om personen in de registratie niet-ingezetenen in te schrijven en hun gegevens te verstrekken.</documentation>
          <property key="wiki-gemma-model id" value="rni-loket" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2026-rvig-hup-achtergronden-en-begrippen; 2026-utrecht-burgerzaken-registratie-niet-ingezetenen-rni-inschrijven; 2024-nvvb-schema-schriftelijke-gegevensverstrekking-brp" />
          <property key="wiki-gemma-model beschrijving" value="Niet elke gemeente is RNI-loket; wie niet bij een loket terecht kan, gaat naar een ander loket (Utrecht RNI). Het college van het RNI-loket is bevoegd schriftelijk gegevens over niet-ingezetenen te verstrekken; andere gemeenten sturen zulke verzoeken door (NVVB Schema). De minister van BZK is verantwoordelijk voor de RNI (HUP Achtergronden). Het RNI-loket is een verantwoordelijkheid, geen kanaal." />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/rni-loket.md" />
          <property key="wiki-gemma-model doelgroep" value="gemeente" />
        </element>
        <element xsi:type="archimate:BusinessRole" name="Degene die in de lijkbezorging voorziet" id="id-e816170ab8e354c192c34c534cfa3355">
          <documentation>Wie de lijkbezorging van een overledene regelt en daarvoor het verlof aanvraagt.</documentation>
          <property key="wiki-gemma-model id" value="degene-die-in-de-lijkbezorging-voorziet" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2010-vng-model-beheersverordening-begraafplaatsen" />
          <property key="wiki-gemma-model beschrijving" value="Degene die in de lijkbezorging voorziet vraagt het verlof tot begraving of crematie aan, of is redelijkerwijs in diens plaats getreden; de lijkbezorging volgt zoveel mogelijk de wens van de overledene (art. 18, 19). Op de gemeentelijke begraafplaats doet hij de kennisgeving van begraven of bijzetten en ondertekent hij zo nodig de machtiging (Groningen art. 7 lid 2, 9). In de praktijk vervult vaak de uitvaartondernemer deze rol namens de nabestaanden." />
          <property key="wiki-gemma-model synoniemen" value="Degene die in de uitvaart voorziet (beleid)" />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/degene-die-in-de-lijkbezorging-voorziet.md" />
          <property key="wiki-gemma-model doelgroep" value="inwoners en ondernemers" />
        </element>
        <element xsi:type="archimate:BusinessRole" name="Houder van een plaats van bijzetting" id="id-f97e7a1412ff52749ee3016217299bdb">
          <documentation>Verantwoordelijkheid voor een plaats waar urnen worden bijgezet.</documentation>
          <property key="wiki-gemma-model id" value="houder-van-een-plaats-van-bijzetting" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen" />
          <property key="wiki-gemma-model beschrijving" value="De houder van een plaats van bijzetting houdt een openbaar register van de bijgezette asbussen, stelt ze op verzoek ter beschikking en ruimt ze door verstrooiing van de as (art. 63, 65, 66). Het register gaat bij opheffing naar het archief van de gemeente (art. 65 lid 3)." />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/houder-van-een-plaats-van-bijzetting.md" />
          <property key="wiki-gemma-model doelgroep" value="gemeente" />
        </element>
        <element xsi:type="archimate:BusinessRole" name="Houder van het crematorium" id="id-fafdec9a745a5861ae1b04f2947fa87b">
          <documentation>Verantwoordelijkheid voor een crematorium, het bergen van de as en de bestemming daarvan.</documentation>
          <property key="wiki-gemma-model id" value="houder-van-het-crematorium" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst" />
          <property key="wiki-gemma-model beschrijving" value="De houder van het crematorium bergt de as in asbussen, bewaart ze en zorgt voor de bestemming van de as, en houdt een openbaar register van gecremeerde stoffelijke overschotten (art. 50, 58, 59). Bij een gemeentelijk crematorium is de gemeente houder, bij een bijzonder crematorium een kerkgenootschap, rechtspersoon of natuurlijk persoon (art. 51, 52)." />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/houder-van-het-crematorium.md" />
          <property key="wiki-gemma-model doelgroep" value="gemeente" />
        </element>
        <element xsi:type="archimate:BusinessRole" name="Nabestaande" id="id-fef4ddc0626658c98d617a3cf964afab">
          <documentation>Naaste van een overledene die zorg draagt voor de uitvaart of de urn.</documentation>
          <property key="wiki-gemma-model id" value="nabestaande" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2010-vng-model-beheersverordening-begraafplaatsen; 2025-groningen-algemene-plaatselijke-verordening" />
          <property key="wiki-gemma-model beschrijving" value="De nabestaande draagt zorg voor de asbus, geeft opdracht tot bijzetting of verstrooiing en kan de as laten meegeven (art. 58–60, 62). Op de gemeentelijke begraafplaats kan hij werkzaamheden bij de begraving zelf verrichten en bij ruiming de resten laten herbegraven of cremeren (Groningen art. 7 lid 4, 27 lid 4; VNG-model art. 24 lid 4)." />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/nabestaande.md" />
          <property key="wiki-gemma-model doelgroep" value="inwoners en ondernemers" />
        </element>
      </folder>
    </folder>
  </folder>
