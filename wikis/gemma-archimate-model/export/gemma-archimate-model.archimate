            <element xsi:type="archimate:BusinessService" name="Legalisatie handtekening" id="id-48e1b543cdd55f42884fc388ef30176d">
              <documentation>Het bewijzen dat een handtekening echt is, doordat de gemeente haar vergelijkt met de handtekening op het identiteitsbewijs.</documentation>
              <property key="wiki-gemma-model id" value="legalisatie-handtekening" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2026-utrecht-burgerzaken-handtekening-laten-legaliseren-bewijzen-dat-de-handtekening-echt-is" />
              <property key="wiki-gemma-model beschrijving" value="De aanvrager tekent bij voorkeur aan de balie met een ambtenaar erbij en kan niemand anders sturen; het tarief is € 21,20 per handtekening in 2026 (2026-utrecht-burgerzaken-handtekening-laten-legaliseren-bewijzen-dat-de-handtekening-echt-is). De UPL noemt art. 23 Wet griffierechten burgerlijke zaken als grondslag (2025-vng-upl-producten-en-diensten-extern, nr. 226), maar dat artikel stelt alleen het griffierecht vast (€ 25 per handtekening, meerdere handtekeningen van dezelfde persoon op hetzelfde stuk tellen als één; 2026-rijk-wet-griffierechten-burgerlijke-zaken-bwbr0028899, art. 23 lid 2) en geeft de gemeente geen taak of bevoegdheid: de wet is bron voor het tarief en geen beleidskader (besluit redacteur 2026-10-07). De bevoegdheidsgrondslag van de gemeentelijke legalisatie is in de wet niet gevonden (verificatie nodig): ook de Wet regels inzake heffing van rechten voor legalisatie van handtekeningen (BWBR0005125) en de O. en W.-regeling legalisatie handtekeningen (BWBR0005229) regelen alleen rechten voor het Rijk, en gemeenten mandateren het afgeven van legalisatieverklaringen aan ambtenaren zonder wetsartikel te noemen." />
              <property key="wiki-gemma-model synoniemen" value="Handtekening legaliseren (beleid)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/0-bestuur-en-ondersteuning/burgerzaken/legalisatie-handtekening.md" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model domein" value="Publieksdiensten" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessService" name="Naturalisatieoptie" id="id-4abf3ab2d8e15c7ab6d41f1e839559cb">
              <documentation>Het afleggen van een optieverklaring om door bevestiging van de burgemeester Nederlander te worden.</documentation>
              <property key="wiki-gemma-model id" value="naturalisatieoptie" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2026-utrecht-burgerzaken-nederlander-worden-door-naturalisatie-of-optie; 2026-rijk-besluit-verkrijging-verlies-nederlanderschap-bwbr0013605" />
              <property key="wiki-gemma-model beschrijving" value="Wie al langer in Nederland woont of een andere optiegrond heeft, kan door optie Nederlander worden: hij verklaart dat hij Nederlander wil worden en de burgemeester beslist (Utrecht; Rijkswet op het Nederlanderschap art. 6). Aanvragen kan op afspraak aan de balie, alleen voor wie in de gemeente in de BRP staat; de gemeente rekent leges, met een verlaagde prijs bij een asielvergunning voor onbepaalde tijd of als staatloze (Utrecht). Grondslag art. 6 Rijkswet; doelgroep burger; niet digitaal, bewijs in persoon (UPL nr. 262). De UPL-naam noemt de optie een vorm van naturalisatie; in de wet zijn optie en naturalisatie twee wegen tot verkrijging (Besluit verkrijging en verlies Nederlanderschap art. 1 onder c en d; procesarchitectuur-terugmelding)." />
              <property key="wiki-gemma-model synoniemen" value="Nederlander worden door optie (beleid)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/0-bestuur-en-ondersteuning/burgerzaken/naturalisatieoptie.md" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model domein" value="Publieksdiensten" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessService" name="Volmachtbewijs verkiezingen" id="id-51096dd90f7e554a98c6519e9b0a787d">
              <documentation>Het aanvragen van een volmacht, zodat een andere kiezer met een volmachtbewijs namens de aanvrager stemt.</documentation>
              <property key="wiki-gemma-model id" value="volmachtbewijs-verkiezingen" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2026-rijk-kieswet-bwbr0004627" />
              <property key="wiki-gemma-model beschrijving" value="Een kiezer die niet in persoon kan stemmen, vraagt met een formulier bij de burgemeester een volmacht aan en wijst een gemachtigde aan; bij inwilliging krijgt de gemachtigde een volmachtbewijs. De kiezer kan ook zijn stempas of kiezerspas omzetten in een volmachtbewijs en aan de gemachtigde overdragen (Kieswet art. L 1, L 2, L 6, L 8, L 11, L 14). Grondslag art. L 14 en L 8 Kieswet; doelgroep burger; niet digitaal (UPL nr. 453). De volmacht is de dienst, het volmachtbewijs een onderdeel (besluit redacteur 2026-10-06)." />
              <property key="wiki-gemma-model synoniemen" value="Stemmen bij volmacht (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/0-bestuur-en-ondersteuning/burgerzaken/volmachtbewijs-verkiezingen.md" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model domein" value="Publieksdiensten" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessService" name="BRP-inzagerecht" id="id-53a58c67ea50591dbad42150c7ff9acd">
              <documentation>Inzage voor de ingeschrevene in zijn eigen gegevens in de basisregistratie personen.</documentation>
              <property key="wiki-gemma-model id" value="brp-inzagerecht" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2024-nvvb-schema-schriftelijke-gegevensverstrekking-brp; 2026-rijk-besluit-brp-bwbr0034306; 2026-utrecht-burgerzaken-persoonsgegevens-brp-bekijken-en-overzicht-aanvragen" />
              <property key="wiki-gemma-model beschrijving" value="De ingeschrevene kan zijn gegevens ook zelf bekijken op MijnOverheid, een landelijke voorziening (Utrecht Persoonsgegevens bekijken). Grondslag is art. 2.55 Wet BRP; het college voldoet binnen vier weken aan het verzoek (UPL nr. 91)." />
              <property key="wiki-gemma-model synoniemen" value="Persoonsgegevens BRP bekijken (beleid)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/0-bestuur-en-ondersteuning/burgerzaken/brp-inzagerecht.md" />
