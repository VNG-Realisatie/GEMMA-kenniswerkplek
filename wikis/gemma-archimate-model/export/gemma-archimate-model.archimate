        <element xsi:type="archimate:Grouping" name="Publieksdiensten" id="id-bb4253a5-24b4-414c-beac-eba1d8c2e1b6">
          <documentation>Bedrijfsfuncties gericht op het leveren van gemeentelijke producten en diensten, vaak op aanvraag van inwoners of bedrijven. Voorbeelden zijn reisdocumenten en sportstimulering.</documentation>
          <property key="GEMMA sortering" value="d" />
