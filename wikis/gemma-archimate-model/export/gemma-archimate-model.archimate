              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessService" name="Stemrecht" id="id-1e814f61b8f156488b6dcee362bcc824">
              <documentation>Het registreren als kiezer van wie kiesgerechtigd is, en op verzoek meedelen of iemand als kiezer is geregistreerd.</documentation>
              <property key="wiki-gemma-model id" value="stemrecht" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2026-rijk-kieswet-bwbr0004627" />
              <property key="wiki-gemma-model beschrijving" value="Kiesgerechtigd voor de gemeenteraad zijn ingezetenen van achttien jaar en ouder, ook niet-Nederlanders met verblijfsrecht na vijf jaar verblijf; een EU-onderdaan kan zich registreren voor de verkiezing van het Europees Parlement (Kieswet art. B 1-B 3; HUP Europees kiesrecht). De gemeente registreert de kiesgerechtigdheid en deelt op verzoek mee of iemand als kiezer is geregistreerd (art. D 1, D 5). Grondslag art. B 1, B 2, B 2a, B 3 en Y 2 Kieswet; doelgroep burger, SDG; niet digitaal (UPL nr. 398). De UPL-naam noemt het recht; de dienst is de registratie en de mededeling (procesarchitectuur-terugmelding)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/0-bestuur-en-ondersteuning/burgerzaken/stemrecht.md" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model domein" value="Publieksdiensten" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessService" name="Reisdocument niet-ingezetene" id="id-263e3ad0178d5383a2b706ceefa4c30f">
              <documentation>Het aanvragen van een paspoort of ander reisdocument door iemand die niet als ingezetene in de BRP staat, bij een daartoe aangewezen gemeente.</documentation>
              <property key="wiki-gemma-model id" value="reisdocument-niet-ingezetene" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
