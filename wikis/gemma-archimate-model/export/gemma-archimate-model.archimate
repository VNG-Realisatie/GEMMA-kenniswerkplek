            <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
            <property key="wiki-gemma-model beleidsdomein" value="Belastingen" />
            <property key="wiki-gemma-model vorige definitie" value="Een door de overheid opgelegde verplichting tot betaling" />
          </element>
          <element xsi:type="archimate:BusinessObject" name="Briefadres" id="id-69e3c6f1bdcc4824a0af6b45213b5c31">
            <documentation>Adres waar post voor een ingeschreven persoon zonder woonadres in ontvangst wordt genomen door een briefadresgever.</documentation>
            <property key="GEMMA URL" value="https://gemmaonline.nl/index.php/GEMMA/id-af282ab4-d6c4-4a5f-8126-db9b70cff048" />
            <property key="GGM-datum-tijd-export" value="10122024-112046" />
            <property key="GGM-guid" value="{3015DCE3-7C05-4160-A717-533553258C15}" />
