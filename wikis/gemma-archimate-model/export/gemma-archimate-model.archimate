          </element>
          <element xsi:type="archimate:BusinessObject" name="Verblijfplaats" id="id-9a240ef1e16e476887b3c67526facb98">
            <documentation>Het adres waar een ingeschreven persoon woont of, zonder woonadres, zijn post ontvangt, met de periode waarin dat adres geldt.</documentation>
            <property key="GEMMA URL" value="https://gemmaonline.nl/index.php/GEMMA/id-397f0d07-8500-40ea-9d3a-a142dc9a94f9" />
            <property key="GGM-datum-tijd-export" value="10122024-112046" />
            <property key="GGM-guid" value="{0028CB85-5EF0-45aa-A06F-4A8F14E71AB8}" />
            <property key="GGM-uml-type" value="Class" />
            <property key="Let op" value="&quot;ggm-&quot; properties worden beheerd in het GGM informatiemodel" />
            <property key="Object ID" value="397f0d07-8500-40ea-9d3a-a142dc9a94f9" />
            <property key="wiki-gemma-model id" value="verblijfplaats" />
            <property key="wiki-gemma-model herkomst" value="gekoppeld" />
            <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
