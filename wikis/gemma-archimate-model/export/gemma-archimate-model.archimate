        <element xsi:type="archimate:BusinessActor" name="College van B&amp;W" id="id-af1a85d2-b6d6-44da-b562-ef2ccd69108e">
          <documentation>Dagelijks bestuur van de gemeente, bestaande uit de burgemeester en de wethouders.</documentation>
          <property key="Object ID" value="af1a85d2-b6d6-44da-b562-ef2ccd69108e" />
          <property key="wiki-gemma-model id" value="college-van-b-w" />
          <property key="wiki-gemma-model herkomst" value="gekoppeld" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model GEMMA-match" value="exact" />
          <property key="wiki-gemma-model bronnen" value="2024-rijk-gemeentewet-wettekst; 2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen" />
          <property key="wiki-gemma-model beschrijving" value="Het college bestaat uit de burgemeester, die voorzitter is, en de wethouders (Gemeentewet art. 34). Het voert het dagelijks bestuur van de gemeente, voor zover de wet dat niet aan de raad of de burgemeester opdraagt (art. 160)." />
          <property key="wiki-gemma-model synoniemen" value="Burgemeester en wethouders (wet); College (GEMMA)" />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/actoren/college-van-b-w.md" />
          <property key="wiki-gemma-model doelgroep" value="gemeente" />
          <property key="wiki-gemma-model vorige naam" value="College" />
        </element>
        <element xsi:type="archimate:BusinessActor" name="Gemeenteraad" id="id-b69cb101-8708-47de-9ac1-e138f205a49f">
          <documentation>Bestuursorgaan van de gemeente dat de gehele bevolking vertegenwoordigt en de gemeentelijke verordeningen vaststelt.</documentation>
          <property key="Object ID" value="b69cb101-8708-47de-9ac1-e138f205a49f" />
          <property key="wiki-gemma-model id" value="gemeenteraad" />
          <property key="wiki-gemma-model herkomst" value="gekoppeld" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model GEMMA-match" value="exact" />
          <property key="wiki-gemma-model bronnen" value="2024-rijk-gemeentewet-wettekst; 2026-rijk-wet-op-de-lijkbezorging-wettekst" />
          <property key="wiki-gemma-model beschrijving" value="De raad vertegenwoordigt de gehele bevolking van de gemeente (Gemeentewet art. 7). Hij stelt de gemeentelijke verordeningen vast, voor zover die bevoegdheid niet bij het college of de burgemeester ligt (art. 147, 149), en benoemt de wethouders (art. 35). De burgemeester is voorzitter van de raad (art. 9)." />
          <property key="wiki-gemma-model synoniemen" value="Raad (wet)" />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/actoren/gemeenteraad.md" />
          <property key="wiki-gemma-model doelgroep" value="gemeente" />
        </element>
        <element xsi:type="archimate:BusinessRole" name="Ketenpartner" id="id-e03a0402-1890-4a21-8143-c44a8ba53ea4">
          <documentation>Verantwoordelijkheid van een andere organisatie voor haar deel van een ketenproces dat zij met de gemeente uitvoert.</documentation>
          <property key="Object ID" value="e03a0402-1890-4a21-8143-c44a8ba53ea4" />
          <property key="wiki-gemma-model id" value="ketenpartner" />
          <property key="wiki-gemma-model herkomst" value="gekoppeld" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model GEMMA-match" value="exact" />
          <property key="wiki-gemma-model bronnen" value="2026-vng-gemma-2026-10-02; 2026-rijk-wet-op-de-lijkbezorging-wettekst" />
          <property key="wiki-gemma-model beschrijving" value="Een ketenpartner is een andere organisatie die een eigen deel van een ketenproces uitvoert, vanuit een eigen wettelijke taak, en niet als klant of alleen als adviseur. GEMMA kent de rol Ketenpartner in de procesarchitectuur en de doelgroep Ketenpartners." />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/ketenpartner.md" />
          <property key="wiki-gemma-model doelgroep" value="ketenpartners" />
        </element>
        <element xsi:type="archimate:BusinessRole" name="Adviseur" id="id-f3219a6a-532f-482d-897c-dafe0dc70bb0">
          <documentation>Verantwoordelijkheid voor het geven van advies aan wie een besluit neemt.</documentation>
          <property key="Object ID" value="f3219a6a-532f-482d-897c-dafe0dc70bb0" />
          <property key="wiki-gemma-model id" value="adviseur" />
          <property key="wiki-gemma-model herkomst" value="gekoppeld" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model GEMMA-match" value="sterk" />
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-rijk-wet-publieke-gezondheid-wettekst" />
          <property key="wiki-gemma-model beschrijving" value="Een adviseur geeft een bestuursorgaan vooraf advies over een besluit. De wet bepaalt wanneer advies nodig is, bijvoorbeeld het advies van de GGD aan de burgemeester bij een besmet stoffelijk overschot (Wet op de lijkbezorging art. 22a) of aan het college bij besluiten met belangrijke gevolgen voor de publieke gezondheid (Wet publieke gezondheid art. 16)." />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/adviseur.md" />
          <property key="wiki-gemma-model doelgroep" value="ketenpartners" />
        </element>
      </folder>
      <folder name="Processenlandschap" id="0934a45e-4ff5-4480-b259-f6cb68c58af3">
        <element xsi:type="archimate:BusinessProcess" name="Onderhouden" id="id-1a739ba4-08d4-4b65-84d8-4ea89499b4ca">
          <documentation>Het planmatig (preventief) onderhouden van de openbare ruimte, zoals het maaien van bermen, het onderhoud van plantsoenen, schilderen van gemeente-eigendommen en gebouwen.</documentation>
          <property key="GEMMA type" value="Bedrijfsproces" />
          <property key="Object ID" value="1a739ba4-08d4-4b65-84d8-4ea89499b4ca" />
        </element>
        <element xsi:type="archimate:BusinessProcess" name="Behandelen aangifte of melding" id="id-1d4d0829-9ed4-49a3-a661-e91c2fc25072">
          <documentation>Het behandelen van aangiften van de gebeurtenissen behorende bij de Burgerlijke Stand of een melding van een andere gebeurtenis die of feit dat o.a. tot gevolg heeft dat de (basis)registraties van de gemeente bijgewerkt dienen te worden. De klant of ketenpartner doet vrijwel altijd aangifte omdat hij/zij hiertoe verplicht is. De klant of ketenpartner krijgt steeds een antwoord ter verificatie van de gemeente wanneer de aangifte verwerkt is en het proces ten einde is.</documentation>
          <property key="GEMMA type" value="Bedrijfsproces" />
          <property key="Object ID" value="1d4d0829-9ed4-49a3-a661-e91c2fc25072" />
        </element>
        <element xsi:type="archimate:BusinessProcess" name="Behandelen aanvraag product" id="id-49fe8555-b001-4c86-9a81-20491e16af75">
          <documentation>Het afhandelen van aanvragen voor producten of diensten die min of meer "gereed op de plank" liggen. Hooguit worden deze producten nog gepersonifieerd. Deze producten zijn vaak "klaar terwijl u wacht"; ze kunnen direct worden meegenomen mits aan enkele direct toetsbare eisen wordt voldaan (uittreksel GBA, ja/nee sticker, ..) maar ook een rijbewijs of paspoort valt hieronder.</documentation>
          <property key="GEMMA type" value="Bedrijfsproces" />
          <property key="Object ID" value="49fe8555-b001-4c86-9a81-20491e16af75" />
        </element>
        <element xsi:type="archimate:BusinessProcess" name="Behandelen melding" id="id-729e05ea-f9f7-4583-a645-ec4e573b74ce">
          <documentation>Het in ontvangst nemen en afhandelen van een medeling en het resultaat hiervan terugkoppelen naar de melder. Bij een melding meldt men klant iets aan de gemeente en verwacht men dat de gemeente daar actie op onderneemt. Voorbeelden zijn een melding openbare ruimte, een melding omtrent overbewoning of een melding met betrekking tot het niet naleven van de leerplichtwet. Dit zijn andersoortige meldingen dan die bedoeld onder behandelen aangiften en meldingen om twee redenen: deze meldingen hebben betrekking op een al dan niet door de gemeente geleverde dienst (bv. beheren openbare ruimte) en het palet aan acties/antwoorden is diverser dan bij aangiften en meldingen, waar het vrijwel altijd het bijwerken van een registratie is.</documentation>
          <property key="GEMMA type" value="Bedrijfsproces" />
          <property key="Object ID" value="729e05ea-f9f7-4583-a645-ec4e573b74ce" />
        </element>
        <element xsi:type="archimate:BusinessProcess" name="Behandelen aanvraag vergunning of ontheffing" id="id-85fdb525-85a2-40d0-b90c-f4cfd4306ef7">
          <documentation>Het behandelen van een verzoek van een klant om toestemming voor activiteiten die te boek staat als vergunning/ontheffing-plichtig.</documentation>
          <property key="GEMMA type" value="Bedrijfsproces" />
          <property key="Object ID" value="85fdb525-85a2-40d0-b90c-f4cfd4306ef7" />
        </element>
        <element xsi:type="archimate:BusinessProcess" name="Uitbaten gemeentelijke voorzieningen" id="id-de88d348-dcce-4b8a-a3f6-cac6351a8311">
          <documentation>Het openhouden van gemeentelijke voorzieningen zoals sportvelden, musea, parkeergarages, wijkcentra en consultatiebureaus en het ter beschikking stellen van de daaraan gerelateerde middelen zoals ruimtes of dranghekken, bijvoorbeeld voor een zelfhulpgroep of een buurtfeest ten behoeve van het versterken van de sociale cohesie. Ook het tegen een vergoeding ter beschikking stellen van ruimte voor bijvoorbeeld de bibliotheek valt hieronder vanwege het maatschappelijke karakter.</documentation>
          <property key="GEMMA type" value="Bedrijfsproces" />
          <property key="Object ID" value="de88d348-dcce-4b8a-a3f6-cac6351a8311" />
        </element>
      </folder>
    </folder>
    <folder name="wiki-gemma-model" id="id-3ef5a0169d2f54359b09a230fc0db425">
      <folder name="Actoren" id="id-c5aa4922a2be5a13b9e6861a2532c407">
        <element xsi:type="archimate:BusinessActor" name="Kerkgenootschap" id="id-1258be4e5c78553ebdec35fc7b592d1f">
          <documentation>Kerkelijke gemeenschap, met inbegrip van haar zelfstandige onderdelen en de lichamen waarin kerkgenootschappen zijn verenigd.</documentation>
          <property key="wiki-gemma-model id" value="kerkgenootschap" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2026-rijk-bw2-rechtspersonen; 2026-rijk-wet-op-de-lijkbezorging-wettekst" />
          <property key="wiki-gemma-model beschrijving" value="Kerkgenootschappen, hun zelfstandige onderdelen en de lichamen waarin zij zijn verenigd, hebben rechtspersoonlijkheid en worden geregeerd door hun eigen statuut, voor zover dat niet in strijd is met de wet (BW Boek 2 art. 2)." />
          <property key="wiki-gemma-model synoniemen" value="Gezindte (beleid)" />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/actoren/kerkgenootschap.md" />
          <property key="wiki-gemma-model doelgroep" value="ketenpartners" />
        </element>
        <element xsi:type="archimate:BusinessActor" name="GGD" id="id-15f549fec72f5677a16d1f4867dba8ed">
          <documentation>Gezondheidsdienst die de colleges van de gemeenten in een regio via een gemeenschappelijke regeling instellen en in stand houden voor de publieke gezondheid.</documentation>
          <property key="wiki-gemma-model id" value="ggd" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-publieke-gezondheid-wettekst; 2026-rijk-wet-op-de-lijkbezorging-wettekst" />
          <property key="wiki-gemma-model beschrijving" value="De colleges van burgemeester en wethouders van de gemeenten in een regio stellen de gemeentelijke gezondheidsdienst via een gemeenschappelijke regeling in en houden haar in stand (Wet publieke gezondheid art. 14 lid 1); de regeling stelt een openbaar lichaam in, zodat de GGD eigen rechtspersoonlijkheid heeft (art. 14 lid 2). De gemeenten zijn zo mede-eigenaar en opdrachtgever. De GGD staat onder leiding van een directeur publieke gezondheid (art. 14 lid 3)." />
          <property key="wiki-gemma-model synoniemen" value="Gemeentelijke gezondheidsdienst (wet)" />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/actoren/ggd.md" />
          <property key="wiki-gemma-model doelgroep" value="ketenpartners" />
        </element>
        <element xsi:type="archimate:BusinessActor" name="Uitvaartondernemer" id="id-1637928fd4755f61899e995a10b0b2a2">
          <documentation>Onderneming die in opdracht van nabestaanden de uitvaart verzorgt.</documentation>
          <property key="wiki-gemma-model id" value="uitvaartondernemer" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2010-vng-model-beheersverordening-begraafplaatsen; 2026-rvo-aangifte-en-akte-van-overlijden; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen" />
          <property key="wiki-gemma-model beschrijving" value="De uitvaartondernemer doet voor de nabestaanden aangifte van overlijden bij de gemeente waar de persoon is overleden, en krijgt van de gemeente de akte van overlijden en het verlof tot begraven of cremeren; voor het vervroegen of uitstellen van de uitvaart vraagt hij een vergunning aan (Ondernemersplein). De beheerder bepaalt tijd en plaats van een begraving in overleg met de uitvaartondernemer; personeel van uitvaartondernemingen volgt op de begraafplaats de aanwijzingen van de beheerder (Groningen art. 5, 7; VNG-model art. 4)." />
          <property key="wiki-gemma-model synoniemen" value="Uitvaartonderneming (beleid)" />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/actoren/uitvaartondernemer.md" />
          <property key="wiki-gemma-model doelgroep" value="inwoners en ondernemers" />
        </element>
        <element xsi:type="archimate:BusinessActor" name="Arts" id="id-22b4e0e7131557c791031332c5111c55">
          <documentation>Persoon die als arts mensen medisch onderzoekt en behandelt.</documentation>
          <property key="wiki-gemma-model id" value="arts" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-rvo-aangifte-en-akte-van-overlijden" />
          <property key="wiki-gemma-model beschrijving" value="Lijkschouwing gebeurt door de behandelende arts of door een gemeentelijke lijkschouwer (Wet op de lijkbezorging art. 3). Behandelend is de hoedanigheid: de arts die de overledene voor het overlijden behandelde. Is die ervan overtuigd dat de dood een natuurlijke oorzaak heeft, dan geeft hij een verklaring van overlijden af (art. 7). De nabestaanden hebben die nodig voor de aangifte (RVO), en zonder die verklaring verleent de ambtenaar van de burgerlijke stand geen verlof tot begraving of crematie (art. 12).&#10;&#10;Kan de behandelende arts geen verklaring afgeven, of gaat het om euthanasie of hulp bij zelfdoding, dan doet hij met een formulier mededeling aan de gemeentelijke lijkschouwer (art. 7 lid 2 en 6). Bij een overleden minderjarige geeft hij de verklaring pas af na overleg met de gemeentelijke lijkschouwer, en geeft hij die op verzoek de informatie voor een nader onderzoek naar de doodsoorzaak (art. 10a).&#10;&#10;Het college benoemt een of meer gemeentelijke lijkschouwers, uitsluitend artsen die als forensisch arts zijn ingeschreven (art. 4, 5). De medische behandeling zelf blijft buiten het model: die is de interne zaak van de arts als ketenpartner." />
          <property key="wiki-gemma-model synoniemen" value="Behandelende arts (wet)" />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/actoren/arts.md" />
          <property key="wiki-gemma-model doelgroep" value="ketenpartners" />
        </element>
        <element xsi:type="archimate:BusinessActor" name="Gemeente" id="id-62d468135540549c9c9e83c9551de3c9">
          <documentation>Een gemeente als rechtspersoon, met een raad, een college van burgemeester en wethouders en een burgemeester.</documentation>
          <property key="wiki-gemma-model id" value="gemeente" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2024-rijk-gemeentewet-wettekst; 2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-rijk-bw2-rechtspersonen; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2026-rvig-hup-achtergronden-en-begrippen; 2026-utrecht-burgerzaken-registratie-niet-ingezetenen-rni-inschrijven" />
          <property key="wiki-gemma-model beschrijving" value="De actor Gemeente staat voor een gemeente als rechtspersoon (BW Boek 2 art. 1), met een raad, een college van burgemeester en wethouders en een burgemeester als organen (Gemeentewet art. 6). Het is een soort partij: elke gemeente, niet een afzonderlijke gemeente zoals Amsterdam of Utrecht.&#10;&#10;Wat een gemeente moet of mag doen, zijn verantwoordelijkheden. Die staan in het model als rollen die de gemeente vervult, zoals houder van een begraafplaats of kostendrager; de actor is de partij die ze vervult. Het GGM en GEMMA kennen daarnaast het bedrijfsobject Gemeente als gedeelte van het grondgebied; dat is een ander begrip." />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/actoren/gemeente.md" />
          <property key="wiki-gemma-model doelgroep" value="gemeente" />
        </element>
        <element xsi:type="archimate:BusinessActor" name="Burgemeester" id="id-ab1fb457a4585841b98353e315234233">
          <documentation>Bestuursorgaan van de gemeente, voorzitter van gemeenteraad en college, benoemd bij koninklijk besluit.</documentation>
          <property key="wiki-gemma-model id" value="burgemeester" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2024-rijk-gemeentewet-wettekst; 2026-rijk-wet-op-de-lijkbezorging-wettekst" />
          <property key="wiki-gemma-model beschrijving" value="De burgemeester wordt bij koninklijk besluit benoemd voor zes jaar (Gemeentewet art. 61) en is voorzitter van de raad en van het college (art. 9, 34). De burgemeester vertegenwoordigt de gemeente in en buiten rechte (art. 171)." />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/actoren/burgemeester.md" />
          <property key="wiki-gemma-model doelgroep" value="gemeente" />
        </element>
        <element xsi:type="archimate:BusinessActor" name="Officier van justitie" id="id-f5e980fae70a582382175a86c6a6ab48">
          <documentation>Lid van het openbaar ministerie dat beslist over strafrechtelijk onderzoek, ook naar een niet-natuurlijke dood.</documentation>
          <property key="wiki-gemma-model id" value="officier-van-justitie" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-rvo-aangifte-en-akte-van-overlijden" />
          <property key="wiki-gemma-model beschrijving" value="Bij een niet-natuurlijke dood brengt de gemeentelijke lijkschouwer verslag uit aan de officier van justitie, die een verklaring van geen bezwaar tegen begraving of crematie afgeeft als er geen strafrechtelijk onderzoek nodig is (Wet op de lijkbezorging art. 10, 12). Zonder die verklaring verleent de ambtenaar van de burgerlijke stand geen verlof. Een uitvaart binnen 36 uur vraagt ook zijn instemming (art. 17; RVO)." />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/actoren/officier-van-justitie.md" />
          <property key="wiki-gemma-model doelgroep" value="ketenpartners" />
        </element>
      </folder>
      <folder name="Bedrijfsobjecten" id="id-6f52878c0f9852ed9500f17e04fe4102">
        <folder name="0 Bestuur en Ondersteuning" id="id-e3735d6154f25f1d8f3696dbe45aa590">
          <folder name="Besluitvorming" id="id-1bcc7b0b932156468cfe63ef37acbb30">
            <element xsi:type="archimate:BusinessObject" name="Vergunning" id="id-268057e5fe5b546fbc837693094bd785">
              <documentation>Beschikking waarmee een bestuursorgaan toestemming geeft voor een handeling die zonder die toestemming niet mag.</documentation>
              <property key="wiki-gemma-model id" value="vergunning" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2026-rvo-aangifte-en-akte-van-overlijden; 2026-rijk-algemene-wet-bestuursrecht-wettekst" />
              <property key="wiki-gemma-model beschrijving" value="Een vergunning is een beschikking (Awb art. 1:3 lid 2) waarmee een bestuursorgaan toestemming geeft voor een handeling die zonder die toestemming niet mag. Wetten noemen zo'n toestemming ook verlof, ontheffing of toestemming." />
              <property key="wiki-gemma-model synoniemen" value="Verlof (wet); Toestemming (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsobjecten/0-bestuur-en-ondersteuning/besluitvorming/vergunning.md" />
              <property key="wiki-gemma-model objectniveau" value="generiek" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Besluitvorming" />
            </element>
          </folder>
        </folder>
        <folder name="7 Volksgezondheid en Milieu" id="id-1c44d463fe60558cb6e92dc274189bf3">
          <folder name="Begraafplaatsen en crematoria" id="id-f19ab3ba794158a3bfd4c5d51b53ce5a">
            <element xsi:type="archimate:BusinessObject" name="Graf" id="id-0c4079e5f4ac5b43b4ff3c59b6ce6ae8">
              <documentation>Plaats op een begraafplaats waarin stoffelijke overschotten worden begraven of urnen worden bijgezet.</documentation>
              <property key="wiki-gemma-model id" value="graf" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2010-vng-model-beheersverordening-begraafplaatsen" />
              <property key="wiki-gemma-model beschrijving" value="Een graf ligt op een begraafplaats en bestaat uit een of meer grafruimtes (Groningen art. 1 h, k); het is een zandgraf of keldergraf (VNG-model art. 1 b). De wet onderscheidt het algemeen graf, waarin de houder van de begraafplaats bepaalt wie er begraven wordt, en het particulier graf, waarop een grafrecht rust (art. 23 lid 2). Gemeenten delen graven verder in naar doelgroep, inhoud en termijn; die grafsoorten zijn specialisaties zonder eigen pagina. De houder houdt een openbaar register van de begraven stoffelijke overschotten met hun plaats (art. 27; Groningen art. 30); dat register is de vorm waarin de gegevens van graven worden bijgehouden en krijgt geen eigen pagina. Graven van historische betekenis staan op een lijst; over het ruimen daarvan beslist de raad (VNG-model art. 26)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsobjecten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/graf.md" />
              <property key="wiki-gemma-model objectniveau" value="kernobject" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessObject" name="Urn" id="id-335b3517a93f5205a1825c67c87cb60e">
              <documentation>Houder waarin de as van een overledene wordt geborgen en wordt bewaard, bijgezet of verstrooid.</documentation>
              <property key="wiki-gemma-model id" value="urn" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2026-vng-retributies" />
              <property key="wiki-gemma-model beschrijving" value="Na de crematie wordt de as geborgen in een of meer gesloten asbussen met naam en nummer (art. 58). De asbus wordt bijgezet in een graf, urnengraf, urnennis of bewaarplaats, verstrooid, aan de nabestaande meegegeven of naar het buitenland gezonden (art. 59, 62). Een sierurn is een voorwerp ter berging van een of meer asbussen (Groningen art. 1 x); in het gangbare gebruik heet het geheel urn (VNG retributies). De as zelf is de inhoud van de urn, geen eigen element." />
              <property key="wiki-gemma-model synoniemen" value="Asbus (wet); Sierurn (beleid)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsobjecten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/urn.md" />
              <property key="wiki-gemma-model objectniveau" value="subobject" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessObject" name="Begraafplaats" id="id-4ecb72536f3755cea1b5d6611a1aa65e">
              <documentation>Terrein waar stoffelijke overschotten worden begraven en urnen worden bijgezet, aangelegd en in stand gehouden door een houder.</documentation>
              <property key="wiki-gemma-model id" value="begraafplaats" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2026-vng-wet-op-de-lijkbezorging" />
              <property key="wiki-gemma-model beschrijving" value="Elke gemeente heeft ten minste één gemeentelijke begraafplaats, voor zich of samen met andere gemeenten (art. 33). Daarnaast bestaan bijzondere begraafplaatsen van een kerkgenootschap, rechtspersoon of natuurlijk persoon (art. 24, 37). De gemeente beslist over grond voor en ingebruikname van bijzondere begraafplaatsen en kan begraafplaatsen sluiten (art. 40, 41, 43, 44). Op de begraafplaats liggen graven, urnenmuren en verstrooiingsplaatsen (Groningen art. 1). Een begraafplaats is een fysieke plaats, maar wordt hier als gemeentelijke voorziening beschreven (besluit redacteur 2026-09-30)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsobjecten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/begraafplaats.md" />
              <property key="wiki-gemma-model objectniveau" value="kernobject" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessObject" name="Grafbedekking" id="id-60c80a79d05150f38339b75b4e76f46b">
              <documentation>Gedenkteken en grafbeplanting op een graf, gedenkplaats of verstrooiingsplaats.</documentation>
              <property key="wiki-gemma-model id" value="grafbedekking" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2010-vng-model-beheersverordening-begraafplaatsen" />
              <property key="wiki-gemma-model beschrijving" value="Voor een grafbedekking is een vergunning van het college nodig, die de rechthebbende aanvraagt (Groningen art. 22; VNG-model art. 19). De rechthebbende onderhoudt haar, of laat dat tegen betaling door de gemeente doen (art. 23, 24). Na afloop van de termijn van het graf kan het college de grafbedekking verwijderen; ze vervalt dan aan de gemeente (art. 26). Zolang het graf niet geruimd mag worden, is wat erop geplaatst is eigendom van de rechthebbende (Wet op de lijkbezorging art. 32a)." />
              <property key="wiki-gemma-model synoniemen" value="Gedenkteken (beleid); Grafmonument (beleid)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsobjecten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/grafbedekking.md" />
              <property key="wiki-gemma-model objectniveau" value="subobject" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessObject" name="Stoffelijk overschot" id="id-a2c7cb8f384257778067e70f75d4f2c8">
              <documentation>Het lichaam van een overledene of doodgeborene.</documentation>
              <property key="wiki-gemma-model id" value="stoffelijk-overschot" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst" />
              <property key="wiki-gemma-model beschrijving" value="Het stoffelijk overschot wordt geschouwd, begraven, gecremeerd of ontleed, en soms opgegraven (art. 1, 3, 29). Bij een begraving of crematie stelt de houder de identiteit vast aan de hand van het nummer op kist en document (art. 8). Een doodgeborene (na ten minste 24 weken zwangerschap) valt ook onder het begrip lijk (wet) en daarmee onder stoffelijk overschot; dat is een indeling, geen eigen element (art. 2 lid 1 b)." />
              <property key="wiki-gemma-model synoniemen" value="Lijk (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsobjecten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/stoffelijk-overschot.md" />
              <property key="wiki-gemma-model objectniveau" value="kernobject" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessObject" name="Crematorium" id="id-b1adea73dd0d54d490565e755aefcc6a">
              <documentation>Inrichting waar stoffelijke overschotten worden gecremeerd en de as wordt geborgen.</documentation>
              <property key="wiki-gemma-model id" value="crematorium" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst" />
              <property key="wiki-gemma-model beschrijving" value="Crematoria zijn gemeentelijk of bijzonder (art. 51). Een bijzonder crematorium wordt gevestigd door een kerkgenootschap, rechtspersoon of natuurlijk persoon, met een vergunning van burgemeester en wethouders (art. 52, 53). De houder bergt de as, zorgt voor de bestemming ervan en houdt een openbaar register (art. 50, 58, 59)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsobjecten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/crematorium.md" />
              <property key="wiki-gemma-model objectniveau" value="kernobject" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:Contract" name="Grafrecht" id="id-f1059419577a5403a5d95aa332436032">
              <documentation>Uitsluitend recht om in een particulier graf stoffelijke overschotten te laten begraven of urnen te laten bijzetten, voor bepaalde of onbepaalde tijd.</documentation>
              <property key="wiki-gemma-model id" value="grafrecht" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2010-vng-model-beheersverordening-begraafplaatsen; 2026-vng-retributies" />
              <property key="wiki-gemma-model beschrijving" value="Het grafrecht wordt schriftelijk gevestigd, voor onbepaalde tijd of voor ten minste tien jaar, en op verzoek verlengd (art. 28). De gemeente verleent het op aanvraag, voor 30 jaar bij een particulier graf of 5 tot 30 jaar bij een urnengraf (Groningen art. 16). Het recht kan worden overgeschreven (Groningen art. 18; VNG-model art. 17), de rechthebbende kan er afstand van doen (art. 19), en het vervalt door verloop van de termijn of wordt vervallen verklaard, bijvoorbeeld bij verwaarlozing of niet-betalen (art. 28 lid 4–6; Groningen art. 20). Verlenging, overschrijving en afstand zijn stappen in de levenscyclus van het grafrecht, geen eigen elementen.&#10;&#10;Het grafrecht is een afspraak (besluit redacteur 2026-09-30): het legt de rechten en plichten van houder en rechthebbende vast, ook als de gemeente het in de vorm van een besluit op aanvraag verleent. De toelichting op het VNG-model noemt het een beschikking van het college (toelichting art. 17); die tegenspraak is met het besluit afgewogen." />
              <property key="wiki-gemma-model synoniemen" value="Uitsluitend recht op een graf (wet); Recht op een particulier graf (beleid); Uitsluitend recht tot begraven (beleid)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsobjecten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/grafrecht.md" />
              <property key="wiki-gemma-model objectniveau" value="kernobject" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
          </folder>
        </folder>
      </folder>
      <folder name="Diensten" id="id-872b531894df54a999b59e47435b8de0">
        <folder name="0 Bestuur en Ondersteuning" id="id-82c19d6383365c21886b3db5af5764a8">
          <folder name="Burgerzaken" id="id-da4f62039e21514898b85b7d7e6b3171">
            <element xsi:type="archimate:BusinessService" name="BRP-uittreksel" id="id-081aa0417405511fbf21a7f2ee7552b0">
              <documentation>Een gewaarmerkt uittreksel met de eigen gegevens uit de basisregistratie personen, als officieel bewijs van inschrijving.</documentation>
              <property key="wiki-gemma-model id" value="brp-uittreksel" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
