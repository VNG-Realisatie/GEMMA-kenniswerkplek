    <folder name="Bedrijfsfuncties" id="cd6a614c-7771-41f7-b7fe-571ea9e79956">
      <folder name="Sub(sub)bedrijfsfuncties" id="ea07cf61-9f11-47d7-86bd-698cca04272e">
        <element xsi:type="archimate:BusinessFunction" name="Lijkbezorging" id="id-30deba14-c60a-49b2-b6d2-740a6d2539f5">
          <documentation>Het geheel van gemeentelijke taken rond het bezorgen van een overledene: schouwen, begraven of cremeren, graven uitgeven, opgraven en ruimen.</documentation>
          <property key="Object ID" value="30deba14-c60a-49b2-b6d2-740a6d2539f5"/>
          <property key="Toelichting" value="Bijv. het uitgeven van grafrechten en verlenen van vergunningen voor plaatsen van grafstenen. BIj het verzorgen van diensten bij begrafenissen valt te denken aan: het graven van een graf, voorlopen, diverse diensten in de Aula e.d."/>
          <property key="wiki-gemma-model id" value="lijkbezorging"/>
          <property key="wiki-gemma-model herkomst" value="gekoppeld"/>
          <property key="wiki-gemma-model exportdatum" value="2026-10-02T11:42:07"/>
          <property key="wiki-gemma-model soort export" value="definitief"/>
          <property key="wiki-gemma-model status" value="goedgekeurd"/>
          <property key="wiki-gemma-model GEMMA-match" value="partieel"/>
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-vng-wet-op-de-lijkbezorging"/>
          <property key="wiki-gemma-model beschrijving" value="Lijkbezorging geschiedt door begraving, crematie of een andere wettelijke wijze (Wet op de lijkbezorging art. 1). De gemeente schouwt lijken via de gemeentelijke lijkschouwer, geeft het verlof tot begraving of crematie af, heeft ten minste één gemeentelijke begraafplaats, geeft graven uit, staat opgraving en ruiming toe en draagt zorg voor de lijkbezorging als niemand daarin voorziet (art. 4, 11, 21, 28, 29, 31, 33). De functie bedient de processen daarvoor."/>
          <property key="wiki-gemma-model synoniemen" value="Exploiteren van begraafplaatsen (GEMMA)"/>
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsfuncties/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/lijkbezorging.md"/>
          <property key="wiki-gemma-model vorige naam" value="Exploiteren van begraafplaatsen"/>
          <property key="wiki-gemma-model vorige definitie" value="Het exploiteren van begraafplaatsen, inclusief ondersteunende diensten die bij het uitvoeren van een begrafenis verzorgd worden."/>
        </element>
      </folder>
    </folder>
    <folder name="Bedrijfsrollen" id="0b0a986f-3ca6-477b-b272-77d6c5c6b4e2">
      <element xsi:type="archimate:BusinessRole" name="Gemeente" id="id-17a7441705094ba9b385c25497844778">
        <documentation>Hoedanigheid van het openbaar lichaam met rechtspersoonlijkheid dat het lokale bestuur vormt, met een raad, een college en een burgemeester.</documentation>
        <property key="GEMMA subtype" value="Doelgroep"/>
        <property key="GEMMA type" value="Groep"/>
        <property key="Object ID" value="ff2d196f-11e0-4328-b78a-0714eb1c4e92"/>
        <property key="wiki-gemma-model id" value="gemeente"/>
        <property key="wiki-gemma-model herkomst" value="gekoppeld"/>
        <property key="wiki-gemma-model exportdatum" value="2026-10-02T11:42:07"/>
        <property key="wiki-gemma-model soort export" value="definitief"/>
        <property key="wiki-gemma-model status" value="goedgekeurd"/>
        <property key="wiki-gemma-model GEMMA-match" value="zwak"/>
        <property key="wiki-gemma-model bronnen" value="2024-rijk-gemeentewet-wettekst; 2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-rijk-bw2-rechtspersonen; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen"/>
        <property key="wiki-gemma-model beschrijving" value="Gemeente is de hoedanigheid waarin een afzonderlijke gemeente, zoals Amsterdam of Utrecht, optreedt. Die afzonderlijke gemeenten zijn de actoren: rechtspersonen (BW Boek 2 art. 1) met een raad, een college en een burgemeester (Gemeentewet art. 6). Het GGM en GEMMA kennen daarnaast het bedrijfsobject Gemeente als gedeelte van het grondgebied; dat is een ander begrip."/>
        <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/gemeente.md"/>
        <property key="wiki-gemma-model vorige definitie" value="Groepering van applicatieservices ten behoeve van de (medewerkers) van de gemeente"/>
      </element>
    </folder>
    <folder name="Procesarchitectuur" id="4352aea1-c4a6-4747-b583-307fff53b12a">
      <folder name="Actoren en rollen" id="b8ecb27e-75db-449f-8fa3-e4ad2cb0f4b4">
        <element xsi:type="archimate:BusinessRole" name="Beslisser" id="id-8ee6ba79-47ed-47d5-8fc4-a707fbea233e">
          <documentation>Verantwoordelijkheid voor het nemen van het besluit in een proces.</documentation>
          <property key="Object ID" value="8ee6ba79-47ed-47d5-8fc4-a707fbea233e"/>
          <property key="wiki-gemma-model id" value="beslisser"/>
          <property key="wiki-gemma-model herkomst" value="gekoppeld"/>
          <property key="wiki-gemma-model exportdatum" value="2026-10-02T11:42:07"/>
          <property key="wiki-gemma-model soort export" value="definitief"/>
          <property key="wiki-gemma-model status" value="goedgekeurd"/>
          <property key="wiki-gemma-model GEMMA-match" value="sterk"/>
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2024-rijk-gemeentewet-wettekst"/>
          <property key="wiki-gemma-model beschrijving" value="Wie beslist, volgt uit de wet of verordening die de bevoegdheid toekent: de burgemeester, het college van burgemeester en wethouders of de gemeenteraad. Welk orgaan in een proces beslist, staat in de beschrijving van dat proces (besluit redacteur 2026-10-01)."/>
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/beslisser.md"/>
        </element>
        <element xsi:type="archimate:BusinessRole" name="Beheerder" id="id-a96ec982-643b-4c36-aa13-f36a51b85694">
          <documentation>Ambtenaar die belast is met de dagelijkse leiding van de gemeentelijke begraafplaatsen.</documentation>
          <property key="Object ID" value="a96ec982-643b-4c36-aa13-f36a51b85694"/>
          <property key="wiki-gemma-model id" value="beheerder"/>
          <property key="wiki-gemma-model herkomst" value="gekoppeld"/>
          <property key="wiki-gemma-model exportdatum" value="2026-10-02T11:42:07"/>
          <property key="wiki-gemma-model soort export" value="definitief"/>
          <property key="wiki-gemma-model status" value="goedgekeurd"/>
          <property key="wiki-gemma-model GEMMA-match" value="zwak"/>
          <property key="wiki-gemma-model bronnen" value="2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2010-vng-model-beheersverordening-begraafplaatsen"/>
          <property key="wiki-gemma-model beschrijving" value="De beheerder bepaalt tijd en plaats van begravingen in overleg met de uitvaartondernemer, ontvangt en toetst de stukken (verlof, machtiging) en aanvragen, houdt het register van begraven lijken bij, handhaaft de orde en ziet toe op ruiming (Groningen art. 1 e, 4–9, 27, 30). Het VNG-model beveelt aan de beheerder aan te wijzen als aanspreekpunt voor burgers en aanvragen, met mandaat om te beslissen (toelichting 2)."/>
          <property key="wiki-gemma-model synoniemen" value="Beheerder van de begraafplaats (beleid)"/>
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/beheerder.md"/>
        </element>
        <element xsi:type="archimate:BusinessActor" name="College van B&amp;W" id="id-af1a85d2-b6d6-44da-b562-ef2ccd69108e">
          <documentation>Dagelijks bestuur van de gemeente, bestaande uit de burgemeester en de wethouders.</documentation>
          <property key="Object ID" value="af1a85d2-b6d6-44da-b562-ef2ccd69108e"/>
          <property key="wiki-gemma-model id" value="college-van-b-w"/>
          <property key="wiki-gemma-model herkomst" value="gekoppeld"/>
          <property key="wiki-gemma-model exportdatum" value="2026-10-02T11:42:07"/>
          <property key="wiki-gemma-model soort export" value="definitief"/>
          <property key="wiki-gemma-model status" value="goedgekeurd"/>
          <property key="wiki-gemma-model GEMMA-match" value="exact"/>
          <property key="wiki-gemma-model bronnen" value="2024-rijk-gemeentewet-wettekst; 2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen"/>
          <property key="wiki-gemma-model beschrijving" value="Het college bestaat uit de burgemeester, die voorzitter is, en de wethouders (Gemeentewet art. 34). Het voert het dagelijks bestuur van de gemeente, voor zover de wet dat niet aan de raad of de burgemeester opdraagt (art. 160)."/>
          <property key="wiki-gemma-model synoniemen" value="Burgemeester en wethouders (wet); College (GEMMA)"/>
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/actoren/college-van-b-w.md"/>
          <property key="wiki-gemma-model vorige naam" value="College"/>
        </element>
        <element xsi:type="archimate:BusinessActor" name="Gemeenteraad" id="id-b69cb101-8708-47de-9ac1-e138f205a49f">
          <documentation>Bestuursorgaan van de gemeente dat de gehele bevolking vertegenwoordigt en de gemeentelijke verordeningen vaststelt.</documentation>
          <property key="Object ID" value="b69cb101-8708-47de-9ac1-e138f205a49f"/>
          <property key="wiki-gemma-model id" value="gemeenteraad"/>
          <property key="wiki-gemma-model herkomst" value="gekoppeld"/>
          <property key="wiki-gemma-model exportdatum" value="2026-10-02T11:42:07"/>
          <property key="wiki-gemma-model soort export" value="definitief"/>
          <property key="wiki-gemma-model status" value="goedgekeurd"/>
          <property key="wiki-gemma-model GEMMA-match" value="exact"/>
          <property key="wiki-gemma-model bronnen" value="2024-rijk-gemeentewet-wettekst; 2026-rijk-wet-op-de-lijkbezorging-wettekst"/>
          <property key="wiki-gemma-model beschrijving" value="De raad vertegenwoordigt de gehele bevolking van de gemeente (Gemeentewet art. 7). Hij stelt de gemeentelijke verordeningen vast, voor zover die bevoegdheid niet bij het college of de burgemeester ligt (art. 147, 149), en benoemt de wethouders (art. 35). De burgemeester is voorzitter van de raad (art. 9)."/>
          <property key="wiki-gemma-model synoniemen" value="Raad (wet)"/>
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/actoren/gemeenteraad.md"/>
        </element>
        <element xsi:type="archimate:BusinessRole" name="Adviseur" id="id-f3219a6a-532f-482d-897c-dafe0dc70bb0">
          <documentation>Verantwoordelijkheid voor het geven van advies aan wie een besluit neemt.</documentation>
          <property key="Object ID" value="f3219a6a-532f-482d-897c-dafe0dc70bb0"/>
          <property key="wiki-gemma-model id" value="adviseur"/>
          <property key="wiki-gemma-model herkomst" value="gekoppeld"/>
          <property key="wiki-gemma-model exportdatum" value="2026-10-02T11:42:07"/>
          <property key="wiki-gemma-model soort export" value="definitief"/>
          <property key="wiki-gemma-model status" value="goedgekeurd"/>
          <property key="wiki-gemma-model GEMMA-match" value="sterk"/>
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-rijk-wet-publieke-gezondheid-wettekst"/>
          <property key="wiki-gemma-model beschrijving" value="Een adviseur geeft een bestuursorgaan vooraf advies over een besluit. De wet bepaalt wanneer advies nodig is, bijvoorbeeld het advies van de GGD aan de burgemeester bij een besmet lijk (Wet op de lijkbezorging art. 22a) of aan het college bij besluiten met belangrijke gevolgen voor de publieke gezondheid (Wet publieke gezondheid art. 16)."/>
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/adviseur.md"/>
        </element>
      </folder>
    </folder>
    <folder name="wiki-gemma-model" id="id-3ef5a0169d2f54359b09a230fc0db425">
      <folder name="Actoren" id="id-c5aa4922a2be5a13b9e6861a2532c407">
        <element xsi:type="archimate:BusinessActor" name="Kerkgenootschap" id="id-1258be4e5c78553ebdec35fc7b592d1f">
          <documentation>Kerkelijke gemeenschap, met inbegrip van haar zelfstandige onderdelen en de lichamen waarin kerkgenootschappen zijn verenigd.</documentation>
          <property key="wiki-gemma-model id" value="kerkgenootschap"/>
          <property key="wiki-gemma-model herkomst" value="nieuw"/>
          <property key="wiki-gemma-model exportdatum" value="2026-10-02T11:42:07"/>
          <property key="wiki-gemma-model soort export" value="definitief"/>
          <property key="wiki-gemma-model status" value="goedgekeurd"/>
          <property key="wiki-gemma-model bronnen" value="2026-rijk-bw2-rechtspersonen; 2026-rijk-wet-op-de-lijkbezorging-wettekst"/>
          <property key="wiki-gemma-model beschrijving" value="Kerkgenootschappen, hun zelfstandige onderdelen en de lichamen waarin zij zijn verenigd, hebben rechtspersoonlijkheid en worden geregeerd door hun eigen statuut, voor zover dat niet in strijd is met de wet (BW Boek 2 art. 2)."/>
          <property key="wiki-gemma-model synoniemen" value="Gezindte (beleid)"/>
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/actoren/kerkgenootschap.md"/>
        </element>
        <element xsi:type="archimate:BusinessActor" name="GGD" id="id-15f549fec72f5677a16d1f4867dba8ed">
          <documentation>Gezondheidsdienst die de colleges van de gemeenten in een regio via een gemeenschappelijke regeling instellen en in stand houden voor de publieke gezondheid.</documentation>
          <property key="wiki-gemma-model id" value="ggd"/>
          <property key="wiki-gemma-model herkomst" value="nieuw"/>
          <property key="wiki-gemma-model exportdatum" value="2026-10-02T11:42:07"/>
          <property key="wiki-gemma-model soort export" value="definitief"/>
          <property key="wiki-gemma-model status" value="goedgekeurd"/>
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-publieke-gezondheid-wettekst; 2026-rijk-wet-op-de-lijkbezorging-wettekst"/>
          <property key="wiki-gemma-model beschrijving" value="De colleges van burgemeester en wethouders van de gemeenten in een regio stellen de gemeentelijke gezondheidsdienst via een gemeenschappelijke regeling in en houden haar in stand (Wet publieke gezondheid art. 14 lid 1); de regeling stelt een openbaar lichaam in, zodat de GGD eigen rechtspersoonlijkheid heeft (art. 14 lid 2). De gemeenten zijn zo mede-eigenaar en opdrachtgever. De GGD staat onder leiding van een directeur publieke gezondheid (art. 14 lid 3)."/>
          <property key="wiki-gemma-model synoniemen" value="Gemeentelijke gezondheidsdienst (wet)"/>
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/actoren/ggd.md"/>
        </element>
        <element xsi:type="archimate:BusinessActor" name="Uitvaartondernemer" id="id-1637928fd4755f61899e995a10b0b2a2">
          <documentation>Onderneming die in opdracht van nabestaanden de uitvaart verzorgt.</documentation>
          <property key="wiki-gemma-model id" value="uitvaartondernemer"/>
          <property key="wiki-gemma-model herkomst" value="nieuw"/>
          <property key="wiki-gemma-model exportdatum" value="2026-10-02T11:42:07"/>
          <property key="wiki-gemma-model soort export" value="definitief"/>
          <property key="wiki-gemma-model status" value="goedgekeurd"/>
          <property key="wiki-gemma-model bronnen" value="2010-vng-model-beheersverordening-begraafplaatsen; 2026-rvo-aangifte-en-akte-van-overlijden; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen"/>
          <property key="wiki-gemma-model beschrijving" value="De uitvaartondernemer doet voor de nabestaanden aangifte van overlijden bij de gemeente waar de persoon is overleden, en krijgt van de gemeente de akte van overlijden en het verlof tot begraven of cremeren; voor het vervroegen of uitstellen van de uitvaart vraagt hij een vergunning aan (Ondernemersplein). De beheerder bepaalt tijd en plaats van een begraving in overleg met de uitvaartondernemer; personeel van uitvaartondernemingen volgt op de begraafplaats de aanwijzingen van de beheerder (Groningen art. 5, 7; VNG-model art. 4)."/>
          <property key="wiki-gemma-model synoniemen" value="Uitvaartonderneming (beleid)"/>
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/actoren/uitvaartondernemer.md"/>
        </element>
        <element xsi:type="archimate:BusinessActor" name="Burgemeester" id="id-ab1fb457a4585841b98353e315234233">
          <documentation>Bestuursorgaan van de gemeente, voorzitter van gemeenteraad en college, benoemd bij koninklijk besluit.</documentation>
          <property key="wiki-gemma-model id" value="burgemeester"/>
          <property key="wiki-gemma-model herkomst" value="nieuw"/>
          <property key="wiki-gemma-model exportdatum" value="2026-10-02T11:42:07"/>
          <property key="wiki-gemma-model soort export" value="definitief"/>
          <property key="wiki-gemma-model status" value="goedgekeurd"/>
          <property key="wiki-gemma-model bronnen" value="2024-rijk-gemeentewet-wettekst; 2026-rijk-wet-op-de-lijkbezorging-wettekst"/>
          <property key="wiki-gemma-model beschrijving" value="De burgemeester wordt bij koninklijk besluit benoemd voor zes jaar (Gemeentewet art. 61) en is voorzitter van de raad en van het college (art. 9, 34). De burgemeester vertegenwoordigt de gemeente in en buiten rechte (art. 171)."/>
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/actoren/burgemeester.md"/>
        </element>
      </folder>
      <folder name="Bedrijfsobjecten" id="id-6f52878c0f9852ed9500f17e04fe4102">
        <folder name="0 Bestuur en Ondersteuning" id="id-e3735d6154f25f1d8f3696dbe45aa590">
          <folder name="Besluitvorming" id="id-1bcc7b0b932156468cfe63ef37acbb30">
            <element xsi:type="archimate:BusinessObject" name="Vergunning" id="id-268057e5fe5b546fbc837693094bd785">
              <documentation>Beschikking waarmee een bestuursorgaan toestemming geeft voor een handeling die zonder die toestemming niet mag.</documentation>
              <property key="wiki-gemma-model id" value="vergunning"/>
              <property key="wiki-gemma-model herkomst" value="nieuw"/>
              <property key="wiki-gemma-model exportdatum" value="2026-10-02T11:42:07"/>
              <property key="wiki-gemma-model soort export" value="definitief"/>
              <property key="wiki-gemma-model status" value="goedgekeurd"/>
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2026-rvo-aangifte-en-akte-van-overlijden; 2026-rijk-algemene-wet-bestuursrecht-wettekst"/>
              <property key="wiki-gemma-model beschrijving" value="Een vergunning is een beschikking (Awb art. 1:3 lid 2) waarmee een bestuursorgaan toestemming geeft voor een handeling die zonder die toestemming niet mag. Wetten noemen zo'n toestemming ook verlof, ontheffing of toestemming."/>
              <property key="wiki-gemma-model synoniemen" value="Verlof (wet); Toestemming (wet)"/>
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsobjecten/0-bestuur-en-ondersteuning/besluitvorming/vergunning.md"/>
            </element>
          </folder>
        </folder>
        <folder name="7 Volksgezondheid en Milieu" id="id-1c44d463fe60558cb6e92dc274189bf3">
          <folder name="Begraafplaatsen en crematoria" id="id-f19ab3ba794158a3bfd4c5d51b53ce5a">
            <element xsi:type="archimate:BusinessObject" name="Graf" id="id-0c4079e5f4ac5b43b4ff3c59b6ce6ae8">
              <documentation>Plaats op een begraafplaats waarin lijken worden begraven of urnen worden bijgezet.</documentation>
              <property key="wiki-gemma-model id" value="graf"/>
              <property key="wiki-gemma-model herkomst" value="nieuw"/>
              <property key="wiki-gemma-model exportdatum" value="2026-10-02T11:42:07"/>
              <property key="wiki-gemma-model soort export" value="definitief"/>
              <property key="wiki-gemma-model status" value="goedgekeurd"/>
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2010-vng-model-beheersverordening-begraafplaatsen"/>
              <property key="wiki-gemma-model beschrijving" value="Een graf ligt op een begraafplaats en bestaat uit een of meer grafruimtes (Groningen art. 1 h, k); het is een zandgraf of keldergraf (VNG-model art. 1 b). De wet onderscheidt het algemeen graf, waarin de houder van de begraafplaats bepaalt wie er begraven wordt, en het particulier graf, waarop een grafrecht rust (art. 23 lid 2). Gemeenten delen graven verder in naar doelgroep, inhoud en termijn; die grafsoorten zijn specialisaties zonder eigen pagina. De houder houdt een openbaar register van de begraven lijken met hun plaats (art. 27; Groningen art. 30); dat register is de vorm waarin de gegevens van graven worden bijgehouden en krijgt geen eigen pagina. Graven van historische betekenis staan op een lijst; over het ruimen daarvan beslist de raad (VNG-model art. 26)."/>
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsobjecten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/graf.md"/>
            </element>
            <element xsi:type="archimate:BusinessObject" name="Plaats van bijzetting" id="id-2e78fe31ecfe53479a36e3e0a37b06bf">
              <documentation>Plaats waar urnen worden bijgezet, zoals een urnengraf, urnennis, crematorium of bewaarplaats.</documentation>
              <property key="wiki-gemma-model id" value="plaats-van-bijzetting"/>
              <property key="wiki-gemma-model herkomst" value="nieuw"/>
              <property key="wiki-gemma-model exportdatum" value="2026-10-02T11:42:07"/>
              <property key="wiki-gemma-model soort export" value="definitief"/>
              <property key="wiki-gemma-model status" value="goedgekeurd"/>
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen"/>
              <property key="wiki-gemma-model beschrijving" value="Een asbus kan worden bijgezet in een crematorium, in of op een graf, op een begraafplaats of in een bewaarplaats (art. 62). De houder van de plaats van bijzetting houdt een openbaar register van de bijgezette asbussen en ruimt ze (art. 65, 66). Een bewaarplaats buiten crematorium of begraafplaats vergt een vergunning van burgemeester en wethouders (art. 64)."/>
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsobjecten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/plaats-van-bijzetting.md"/>
            </element>
            <element xsi:type="archimate:BusinessObject" name="Urn" id="id-335b3517a93f5205a1825c67c87cb60e">
              <documentation>Houder waarin de as van een overledene wordt geborgen en wordt bewaard, bijgezet of verstrooid.</documentation>
              <property key="wiki-gemma-model id" value="urn"/>
              <property key="wiki-gemma-model herkomst" value="nieuw"/>
              <property key="wiki-gemma-model exportdatum" value="2026-10-02T11:42:07"/>
              <property key="wiki-gemma-model soort export" value="definitief"/>
              <property key="wiki-gemma-model status" value="goedgekeurd"/>
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2026-vng-retributies"/>
              <property key="wiki-gemma-model beschrijving" value="Na de crematie wordt de as geborgen in een of meer gesloten asbussen met naam en nummer (art. 58). De asbus wordt bijgezet in een graf, urnengraf, urnennis of bewaarplaats, verstrooid, aan de nabestaande meegegeven of naar het buitenland gezonden (art. 59, 62). Een sierurn is een voorwerp ter berging van een of meer asbussen (Groningen art. 1 x); in het gangbare gebruik heet het geheel urn (VNG retributies). De as zelf is de inhoud van de urn, geen eigen element."/>
              <property key="wiki-gemma-model synoniemen" value="Asbus (wet); Sierurn (beleid)"/>
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsobjecten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/urn.md"/>
            </element>
            <element xsi:type="archimate:BusinessObject" name="Begraafplaats" id="id-4ecb72536f3755cea1b5d6611a1aa65e">
              <documentation>Terrein waar lijken worden begraven en urnen worden bijgezet, aangelegd en in stand gehouden door een houder.</documentation>
              <property key="wiki-gemma-model id" value="begraafplaats"/>
              <property key="wiki-gemma-model herkomst" value="nieuw"/>
              <property key="wiki-gemma-model exportdatum" value="2026-10-02T11:42:07"/>
              <property key="wiki-gemma-model soort export" value="definitief"/>
              <property key="wiki-gemma-model status" value="goedgekeurd"/>
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2026-vng-wet-op-de-lijkbezorging"/>
              <property key="wiki-gemma-model beschrijving" value="Elke gemeente heeft ten minste één gemeentelijke begraafplaats, voor zich of samen met andere gemeenten (art. 33). Daarnaast bestaan bijzondere begraafplaatsen van een kerkgenootschap, rechtspersoon of natuurlijk persoon (art. 24, 37). De gemeente beslist over grond voor en ingebruikname van bijzondere begraafplaatsen en kan begraafplaatsen sluiten (art. 40, 41, 43, 44). Op de begraafplaats liggen graven, urnenmuren en verstrooiingsplaatsen (Groningen art. 1). Een begraafplaats is een fysieke plaats, maar wordt hier als gemeentelijke voorziening beschreven (besluit redacteur 2026-09-30)."/>
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsobjecten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/begraafplaats.md"/>
            </element>
            <element xsi:type="archimate:BusinessObject" name="Grafbedekking" id="id-60c80a79d05150f38339b75b4e76f46b">
              <documentation>Gedenkteken en grafbeplanting op een graf, gedenkplaats of verstrooiingsplaats.</documentation>
              <property key="wiki-gemma-model id" value="grafbedekking"/>
              <property key="wiki-gemma-model herkomst" value="nieuw"/>
              <property key="wiki-gemma-model exportdatum" value="2026-10-02T11:42:07"/>
              <property key="wiki-gemma-model soort export" value="definitief"/>
              <property key="wiki-gemma-model status" value="goedgekeurd"/>
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2010-vng-model-beheersverordening-begraafplaatsen"/>
              <property key="wiki-gemma-model beschrijving" value="Voor een grafbedekking is een vergunning van het college nodig, die de rechthebbende aanvraagt (Groningen art. 22; VNG-model art. 19). De rechthebbende onderhoudt haar, of laat dat tegen betaling door de gemeente doen (art. 23, 24). Na afloop van de termijn van het graf kan het college de grafbedekking verwijderen; ze vervalt dan aan de gemeente (art. 26). Zolang het graf niet geruimd mag worden, is wat erop geplaatst is eigendom van de rechthebbende (Wet op de lijkbezorging art. 32a)."/>
              <property key="wiki-gemma-model synoniemen" value="Gedenkteken (beleid); Grafmonument (beleid)"/>
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsobjecten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/grafbedekking.md"/>
            </element>
            <element xsi:type="archimate:BusinessObject" name="Verklaring van geen bezwaar" id="id-69d5b132841e5e549bb23c15253e34c8">
              <documentation>Verklaring van de officier van justitie dat hij geen bezwaar heeft tegen begraving of crematie.</documentation>
              <property key="wiki-gemma-model id" value="verklaring-van-geen-bezwaar"/>
              <property key="wiki-gemma-model herkomst" value="nieuw"/>
              <property key="wiki-gemma-model exportdatum" value="2026-10-02T11:42:07"/>
              <property key="wiki-gemma-model soort export" value="definitief"/>
              <property key="wiki-gemma-model status" value="goedgekeurd"/>
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-rvo-aangifte-en-akte-van-overlijden"/>
              <property key="wiki-gemma-model beschrijving" value="Bij een niet-natuurlijke dood geeft de officier van justitie een verklaring van geen bezwaar af; die vervangt de verklaring van overlijden als grond voor het verlof tot begraving of crematie (art. 12). Ook voor het vervroegen van een uitvaart is zo'n verklaring nodig (Ondernemersplein). De afweging van de officier zelf valt buiten dit model; de verklaring is invoer voor de gemeente."/>
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsobjecten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/verklaring-van-geen-bezwaar.md"/>
            </element>
            <element xsi:type="archimate:BusinessObject" name="Verklaring van overlijden" id="id-97c49003100c5918b7e5b6119a27ccdf">
              <documentation>Verklaring van de schouwer dat de dood door een natuurlijke oorzaak is ingetreden.</documentation>
              <property key="wiki-gemma-model id" value="verklaring-van-overlijden"/>
              <property key="wiki-gemma-model herkomst" value="nieuw"/>
              <property key="wiki-gemma-model exportdatum" value="2026-10-02T11:42:07"/>
              <property key="wiki-gemma-model soort export" value="definitief"/>
              <property key="wiki-gemma-model status" value="goedgekeurd"/>
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-rvo-aangifte-en-akte-van-overlijden"/>
              <property key="wiki-gemma-model beschrijving" value="De behandelend arts of de gemeentelijke lijkschouwer geeft de verklaring van overlijden af als hij ervan overtuigd is dat de dood door een natuurlijke oorzaak is ingetreden (art. 7 lid 1). Zonder deze verklaring, of een verklaring van geen bezwaar, verleent de ambtenaar van de burgerlijke stand geen verlof tot begraving of crematie (art. 12)."/>
              <property key="wiki-gemma-model synoniemen" value="A-verklaring (dagelijks gebruik)"/>
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsobjecten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/verklaring-van-overlijden.md"/>
            </element>
            <element xsi:type="archimate:BusinessObject" name="Lijk" id="id-a2c7cb8f384257778067e70f75d4f2c8">
              <documentation>Het lichaam van een overledene of doodgeborene.</documentation>
              <property key="wiki-gemma-model id" value="lijk"/>
              <property key="wiki-gemma-model herkomst" value="nieuw"/>
              <property key="wiki-gemma-model exportdatum" value="2026-10-02T11:42:07"/>
              <property key="wiki-gemma-model soort export" value="definitief"/>
              <property key="wiki-gemma-model status" value="goedgekeurd"/>
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst"/>
              <property key="wiki-gemma-model beschrijving" value="Het lijk wordt geschouwd, begraven, gecremeerd of ontleed, en soms opgegraven (art. 1, 3, 29). Bij een begraving of crematie stelt de houder de identiteit vast aan de hand van het nummer op kist en document (art. 8). Een doodgeborene (na ten minste 24 weken zwangerschap) valt ook onder het begrip lijk; dat is een indeling, geen eigen element (art. 2 lid 1 b)."/>
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsobjecten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/lijk.md"/>
            </element>
            <element xsi:type="archimate:BusinessObject" name="Crematorium" id="id-b1adea73dd0d54d490565e755aefcc6a">
              <documentation>Inrichting waar lijken worden gecremeerd en de as wordt geborgen.</documentation>
              <property key="wiki-gemma-model id" value="crematorium"/>
              <property key="wiki-gemma-model herkomst" value="nieuw"/>
              <property key="wiki-gemma-model exportdatum" value="2026-10-02T11:42:07"/>
              <property key="wiki-gemma-model soort export" value="definitief"/>
              <property key="wiki-gemma-model status" value="goedgekeurd"/>
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst"/>
              <property key="wiki-gemma-model beschrijving" value="Crematoria zijn gemeentelijk of bijzonder (art. 51). Een bijzonder crematorium wordt gevestigd door een kerkgenootschap, rechtspersoon of natuurlijk persoon, met een vergunning van burgemeester en wethouders (art. 52, 53). De houder bergt de as, zorgt voor de bestemming ervan en houdt een openbaar register (art. 50, 58, 59)."/>
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsobjecten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/crematorium.md"/>
            </element>
            <element xsi:type="archimate:Contract" name="Grafrecht" id="id-f1059419577a5403a5d95aa332436032">
              <documentation>Uitsluitend recht om in een particulier graf lijken te laten begraven of urnen te laten bijzetten, voor bepaalde of onbepaalde tijd.</documentation>
              <property key="wiki-gemma-model id" value="grafrecht"/>
              <property key="wiki-gemma-model herkomst" value="nieuw"/>
              <property key="wiki-gemma-model exportdatum" value="2026-10-02T11:42:07"/>
              <property key="wiki-gemma-model soort export" value="definitief"/>
              <property key="wiki-gemma-model status" value="goedgekeurd"/>
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2010-vng-model-beheersverordening-begraafplaatsen; 2026-vng-retributies"/>
              <property key="wiki-gemma-model beschrijving" value="Het grafrecht wordt schriftelijk gevestigd, voor onbepaalde tijd of voor ten minste tien jaar, en op verzoek verlengd (art. 28). De gemeente verleent het op aanvraag, voor 30 jaar bij een particulier graf of 5 tot 30 jaar bij een urnengraf (Groningen art. 16). Het recht kan worden overgeschreven (Groningen art. 18; VNG-model art. 17), de rechthebbende kan er afstand van doen (art. 19), en het vervalt door verloop van de termijn of wordt vervallen verklaard, bijvoorbeeld bij verwaarlozing of niet-betalen (art. 28 lid 4–6; Groningen art. 20). Verlenging, overschrijving en afstand zijn stappen in de levenscyclus van het grafrecht, geen eigen elementen.&#xA;&#xA;Het grafrecht is een afspraak (besluit redacteur 2026-09-30): het legt de rechten en plichten van houder en rechthebbende vast, ook als de gemeente het in de vorm van een besluit op aanvraag verleent. De toelichting op het VNG-model noemt het een beschikking van het college (toelichting art. 17); die tegenspraak is met het besluit afgewogen."/>
              <property key="wiki-gemma-model synoniemen" value="Uitsluitend recht op een graf (wet); Recht op een particulier graf (beleid); Uitsluitend recht tot begraven (beleid)"/>
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsobjecten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/grafrecht.md"/>
            </element>
          </folder>
        </folder>
      </folder>
      <folder name="Bedrijfsprocessen" id="id-5b0e779d1cdf525e97afd8206a0c9b7d">
        <folder name="7 Volksgezondheid en Milieu" id="id-a96a5ccc044a5ed5802437e5d2847fa4">
          <folder name="Begraafplaatsen en crematoria" id="id-e900db3e34235cd6a9c892ecf1e48382">
            <element xsi:type="archimate:BusinessProcess" name="Ruimen graf" id="id-2de444e3552c5f908f12c6a6868cadfa">
              <documentation>Het leegmaken van een graf, waarbij de resten worden herbegraven en de as wordt verstrooid.</documentation>
              <property key="wiki-gemma-model id" value="ruimen-graf"/>
              <property key="wiki-gemma-model herkomst" value="nieuw"/>
              <property key="wiki-gemma-model exportdatum" value="2026-10-02T11:42:07"/>
              <property key="wiki-gemma-model soort export" value="definitief"/>
              <property key="wiki-gemma-model status" value="goedgekeurd"/>
              <property key="wiki-gemma-model bronnen" value="2010-vng-model-beheersverordening-begraafplaatsen; 2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen"/>
              <property key="wiki-gemma-model beschrijving" value="Een graf wordt geruimd op last van de houder van de begraafplaats, na ten minste tien jaar na de laatste begraving en bij een particulier graf met toestemming van de rechthebbende (art. 31). Het college kondigt een ruiming ten minste een jaar vooraf aan, per brief of met een bordje bij het graf en op het mededelingenbord; de beheerder ziet toe op een respectvolle omgang met de resten, die worden herbegraven, terwijl de as wordt verstrooid (Groningen art. 27; VNG-model art. 24). Asbussen worden geruimd door verstrooiing van de as (art. 66)."/>
              <property key="wiki-gemma-model synoniemen" value="Ruiming (beleid); Ruimen van graven (wet)"/>
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/ruimen-graf.md"/>
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Onderhouden graf" id="id-6344b6861697540e8216a9c9707038a8">
              <documentation>Het onderhouden van grafbedekking en beplanting op een graf door de gemeente.</documentation>
              <property key="wiki-gemma-model id" value="onderhouden-graf"/>
              <property key="wiki-gemma-model herkomst" value="nieuw"/>
              <property key="wiki-gemma-model exportdatum" value="2026-10-02T11:42:07"/>
              <property key="wiki-gemma-model soort export" value="definitief"/>
              <property key="wiki-gemma-model status" value="goedgekeurd"/>
              <property key="wiki-gemma-model bronnen" value="2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2010-vng-model-beheersverordening-begraafplaatsen; 2026-vng-retributies"/>
              <property key="wiki-gemma-model beschrijving" value="De gemeente maakt gedenktekens schoon en onderhoudt de beplanting op graven, op sommige begraafplaatsen altijd en elders op schriftelijk verzoek van de rechthebbende voor ten minste vijf jaar, tegen betaling van een recht uit de heffingsverordening (Groningen art. 23, 24 lid 3). Bij niet-betalen wordt de grafbedekking na waarschuwing verwijderd (art. 23 lid 4). Het VNG-model regelt een minimaal onderhoud door de gemeente (art. 20)."/>
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/onderhouden-graf.md"/>
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Verlenen grafrecht" id="id-72c234ccca9b5464811e0474bcd782ce">
              <documentation>Het verlenen van een grafrecht op een particulier graf aan een rechthebbende.</documentation>
              <property key="wiki-gemma-model id" value="verlenen-grafrecht"/>
              <property key="wiki-gemma-model herkomst" value="nieuw"/>
              <property key="wiki-gemma-model exportdatum" value="2026-10-02T11:42:07"/>
              <property key="wiki-gemma-model soort export" value="definitief"/>
              <property key="wiki-gemma-model status" value="goedgekeurd"/>
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2010-vng-model-beheersverordening-begraafplaatsen; 2026-vng-retributies"/>
              <property key="wiki-gemma-model beschrijving" value="Het college verleent op schriftelijke aanvraag een recht op een particulier graf, voor 30 jaar of bij een urnengraf voor 5 tot 30 jaar (Groningen art. 16; VNG-model art. 15); de wet spreekt van het vestigen van het uitsluitend recht, voor onbepaalde tijd of ten minste tien jaar (art. 28). Beslisser is het college; het VNG-model beveelt mandaat aan de beheerder aan. Graven worden in volgorde van ligging uitgegeven (Groningen art. 14). Verlenging volgt op verzoek van de rechthebbende (art. 28 lid 1). De gemeente heft voor de uitgifte lijkbezorgingsrechten (VNG retributies)."/>
              <property key="wiki-gemma-model synoniemen" value="Uitgifte van een graf (beleid); Vestigen van het uitsluitend recht op een graf (wet)"/>
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/verlenen-grafrecht.md"/>
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Vervallen verklaren grafrecht" id="id-75a1ffb3a38f5ed482179917b41d5c97">
              <documentation>Het beëindigen van een grafrecht door de gemeente, bijvoorbeeld bij verwaarlozing van het graf of het uitblijven van betaling.</documentation>
              <property key="wiki-gemma-model id" value="vervallen-verklaren-grafrecht"/>
              <property key="wiki-gemma-model herkomst" value="nieuw"/>
              <property key="wiki-gemma-model exportdatum" value="2026-10-02T11:42:07"/>
              <property key="wiki-gemma-model soort export" value="definitief"/>
              <property key="wiki-gemma-model status" value="goedgekeurd"/>
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2010-vng-model-beheersverordening-begraafplaatsen"/>
              <property key="wiki-gemma-model beschrijving" value="Bij kennelijke verwaarlozing van het onderhoud van een particulier graf legt de houder dat vast in een verklaring van verwaarlozing; voorziet de rechthebbende niet binnen één jaar (of vijf jaar na bekendmaking bij het graf) in het onderhoud, dan vervalt het recht (art. 28 lid 4–7). Het college kan het grafrecht ook vervallen verklaren bij wanbetaling, verzuim of als het na het overlijden van de rechthebbende niet tijdig wordt overgeschreven (Groningen art. 18 lid 4, 20 lid 2; VNG-model art. 17 lid 3). Beslisser is het college."/>
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/vervallen-verklaren-grafrecht.md"/>
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Treffen maatregel bij besmet lijk" id="id-80882f2992c259ec970fe9e268f3f946">
              <documentation>Het nemen van maatregelen om gevaar voor de volksgezondheid door een besmet lijk af te wenden.</documentation>
              <property key="wiki-gemma-model id" value="treffen-maatregel-bij-besmet-lijk"/>
              <property key="wiki-gemma-model herkomst" value="nieuw"/>
              <property key="wiki-gemma-model exportdatum" value="2026-10-02T11:42:07"/>
              <property key="wiki-gemma-model soort export" value="definitief"/>
              <property key="wiki-gemma-model status" value="goedgekeurd"/>
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-rijk-wet-publieke-gezondheid-wettekst"/>
              <property key="wiki-gemma-model beschrijving" value="Is een lijk besmet met een infectieus of giftig agens of stof, of bestaat daarvan een gegrond vermoeden, waardoor een ernstig gevaar voor de volksgezondheid kan ontstaan, dan kan de burgemeester maatregelen treffen om dit gevaar af te wenden, na advies van de GGD (Wet op de lijkbezorging art. 22a). Beslisser is de burgemeester. De melding komt van een arts via de GGD (Wet publieke gezondheid art. 21 lid 2, 27 lid 3). De maatregel zelf is een beschikking."/>
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/treffen-maatregel-bij-besmet-lijk.md"/>
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Schouwen lijk" id="id-8aeb21e52a7a5af99faf3d55995af0bb">
              <documentation>Onderzoek van een lijk door een arts na het overlijden, om vast te stellen of de dood een natuurlijke oorzaak heeft.</documentation>
              <property key="wiki-gemma-model id" value="schouwen-lijk"/>
              <property key="wiki-gemma-model herkomst" value="nieuw"/>
              <property key="wiki-gemma-model exportdatum" value="2026-10-02T11:42:07"/>
              <property key="wiki-gemma-model soort export" value="definitief"/>
              <property key="wiki-gemma-model status" value="goedgekeurd"/>
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst"/>
              <property key="wiki-gemma-model beschrijving" value="Elk lijk wordt zo spoedig mogelijk geschouwd, door de behandelend arts of door een gemeentelijke lijkschouwer (art. 3). Is de dood natuurlijk, dan volgt een verklaring van overlijden (art. 7); anders waarschuwt de lijkschouwer de officier van justitie en de ambtenaar van de burgerlijke stand (art. 10). Bij een minderjarige kan een nader onderzoek naar de doodsoorzaak volgen (art. 10a). De schouwing door de behandelend arts valt buiten het gemeentelijk perspectief."/>
              <property key="wiki-gemma-model synoniemen" value="Lijkschouwing (wet)"/>
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/schouwen-lijk.md"/>
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Opgraven lijk" id="id-abcb82c5d790520f856afdda24be34b1">
              <documentation>Het opgraven van een lijk uit een graf, met vergunning van de burgemeester.</documentation>
              <property key="wiki-gemma-model id" value="opgraven-lijk"/>
              <property key="wiki-gemma-model herkomst" value="nieuw"/>
              <property key="wiki-gemma-model exportdatum" value="2026-10-02T11:42:07"/>
              <property key="wiki-gemma-model soort export" value="definitief"/>
              <property key="wiki-gemma-model status" value="goedgekeurd"/>
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen"/>
              <property key="wiki-gemma-model beschrijving" value="Een lijk wordt slechts opgegraven met vergunning van de burgemeester en, bij een particulier graf, met toestemming van de rechthebbende; de burgemeester verbindt voorschriften aan de vergunning over geneeskundig toezicht, vervoer en bestemming (art. 29). Beslisser is de burgemeester. De rechthebbende dient de aanvraag in en schakelt een erkend bedrijf in; opgraven gebeurt in de regel pas na tien jaar grafrust (Groningen art. 28)."/>
              <property key="wiki-gemma-model synoniemen" value="Opgraving (wet)"/>
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/opgraven-lijk.md"/>
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Verzorgen gemeentebegrafenis" id="id-d254a261cbf8513f9768449e654e0032">
              <documentation>Het regelen en betalen van de lijkbezorging door de gemeente als niemand anders daarin voorziet.</documentation>
              <property key="wiki-gemma-model id" value="verzorgen-gemeentebegrafenis"/>
              <property key="wiki-gemma-model herkomst" value="nieuw"/>
              <property key="wiki-gemma-model exportdatum" value="2026-10-02T11:42:07"/>
              <property key="wiki-gemma-model soort export" value="definitief"/>
              <property key="wiki-gemma-model status" value="goedgekeurd"/>
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst"/>
              <property key="wiki-gemma-model beschrijving" value="Als niemand voorziet in de lijkschouwing en lijkbezorging, waarschuwt degene die het lijk onder zich heeft de burgemeester, die daarvoor zorg draagt (art. 20, 21 lid 1). Beslisser is de burgemeester. De kosten komen ten laste van de gemeente, die ze kan verhalen op de nalatenschap, onderhoudsplichtige verwanten of de werkgever (art. 22); dat kostenverhaal is een stap in dit proces. Een lijk waarvan de identiteit niet kan worden vastgesteld, wordt begraven (art. 21 lid 6). Het resultaat is een gemeentebegrafenis."/>
              <property key="wiki-gemma-model synoniemen" value="Lijkbezorging door de burgemeester (wet)"/>
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/verzorgen-gemeentebegrafenis.md"/>
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Uitvoeren lijkbezorging" id="id-f3fef18c03185926a98c84015a0dae05">
              <documentation>Het begraven, cremeren of op een andere wettelijke wijze bezorgen van een lijk, met de bestemming van de as.</documentation>
              <property key="wiki-gemma-model id" value="uitvoeren-lijkbezorging"/>
              <property key="wiki-gemma-model herkomst" value="nieuw"/>
              <property key="wiki-gemma-model exportdatum" value="2026-10-02T11:42:07"/>
              <property key="wiki-gemma-model soort export" value="definitief"/>
              <property key="wiki-gemma-model status" value="goedgekeurd"/>
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen"/>
              <property key="wiki-gemma-model beschrijving" value="De lijkbezorging geschiedt door begraving, crematie of op een andere wettelijk voorziene wijze, en omvat ook het geven van een bestemming aan de as (art. 1, 18 lid 2). Ze vereist een verlof tot begraving of crematie (art. 11) en volgt, waar mogelijk, de wens van de overledene (art. 19). Op de gemeentelijke begraafplaats bepaalt de beheerder tijd en plaats in overleg met de uitvaartondernemer, na kennisgeving door wie de uitvaart regelt (Groningen art. 7). Begraving, crematie, ontleding, bijzetting en verstrooiing zijn varianten zonder eigen pagina."/>
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/uitvoeren-lijkbezorging.md"/>
            </element>
          </folder>
        </folder>
      </folder>
      <folder name="Diensten" id="id-872b531894df54a999b59e47435b8de0">
        <folder name="7 Volksgezondheid en Milieu" id="id-12f5c027dc2c55ed9418808b270a4182">
          <folder name="Begraafplaatsen en crematoria" id="id-09eba3199df458099a0dcbf0fcd2c658">
            <element xsi:type="archimate:BusinessService" name="Onderhoud van graven" id="id-1d72274738755c51ba065825f7a8f293">
              <documentation>Onderhoud van grafmonumenten en grafbeplanting door de gemeente, tegen betaling door de rechthebbende.</documentation>
              <property key="wiki-gemma-model id" value="onderhoud-van-graven"/>
              <property key="wiki-gemma-model herkomst" value="nieuw"/>
              <property key="wiki-gemma-model exportdatum" value="2026-10-02T11:42:07"/>
              <property key="wiki-gemma-model soort export" value="definitief"/>
              <property key="wiki-gemma-model status" value="goedgekeurd"/>
              <property key="wiki-gemma-model bronnen" value="2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2026-vng-retributies"/>
              <property key="wiki-gemma-model beschrijving" value="Op verzoek van de rechthebbende, of op sommige begraafplaatsen altijd, onderhoudt de gemeente de grafbedekking tegen betaling van een recht uit de heffingsverordening (Groningen art. 23, 24; VNG retributies). Een retributie is een tegenprestatie voor zo'n dienst (VNG retributies)."/>
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/onderhoud-van-graven.md"/>
            </element>
            <element xsi:type="archimate:BusinessService" name="Graf aanvragen" id="id-dd3cb81e680059828143496df77fbbd1">
              <documentation>Een particulier graf, urnengraf of urnennis laten uitgeven, met het grafrecht daarop.</documentation>
              <property key="wiki-gemma-model id" value="graf-aanvragen"/>
              <property key="wiki-gemma-model herkomst" value="nieuw"/>
              <property key="wiki-gemma-model exportdatum" value="2026-10-02T11:42:07"/>
              <property key="wiki-gemma-model soort export" value="definitief"/>
              <property key="wiki-gemma-model status" value="goedgekeurd"/>
              <property key="wiki-gemma-model bronnen" value="2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2010-vng-model-beheersverordening-begraafplaatsen; 2026-vng-retributies"/>
              <property key="wiki-gemma-model beschrijving" value="Wie een graf wil, dient een schriftelijke aanvraag in; het college verleent het recht voor een vaste termijn, voor zover er ruimte is, en de gemeente heft er lijkbezorgingsrechten voor (Groningen art. 16; VNG-model art. 15; VNG retributies). Het VNG-model beveelt aan aanvragen in te dienen bij de beheerder van de begraafplaats (toelichting 2)."/>
              <property key="wiki-gemma-model synoniemen" value="Grafrecht aanvragen (beleid)"/>
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/graf-aanvragen.md"/>
            </element>
            <element xsi:type="archimate:BusinessService" name="Uitvaart vervroegen of uitstellen" id="id-fd16f7c92e325b1181001c7f52db758e">
              <documentation>Toestemming van de gemeente om een overledene eerder dan 36 uur of later dan zes werkdagen na het overlijden te begraven of te cremeren.</documentation>
              <property key="wiki-gemma-model id" value="uitvaart-vervroegen-of-uitstellen"/>
              <property key="wiki-gemma-model herkomst" value="nieuw"/>
              <property key="wiki-gemma-model exportdatum" value="2026-10-02T11:42:07"/>
              <property key="wiki-gemma-model soort export" value="definitief"/>
              <property key="wiki-gemma-model status" value="goedgekeurd"/>
              <property key="wiki-gemma-model bronnen" value="2026-rvo-aangifte-en-akte-van-overlijden; 2026-rijk-wet-op-de-lijkbezorging-wettekst"/>
              <property key="wiki-gemma-model beschrijving" value="Begraven of cremeren mag niet eerder dan 36 uur en uiterlijk op de zesde werkdag na het overlijden (art. 16). Na een arts te hebben gehoord kan de burgemeester een andere termijn stellen; eerder dan 36 uur alleen in overeenstemming met de officier van justitie (art. 17). De uitvaartondernemer vraagt de vergunning namens de nabestaanden aan bij de gemeente waar de persoon is overleden, bijvoorbeeld om religieuze redenen of omdat familie uit het buitenland moet komen (Ondernemersplein)."/>
              <property key="wiki-gemma-model synoniemen" value="Andere termijn (wet)"/>
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/uitvaart-vervroegen-of-uitstellen.md"/>
            </element>
          </folder>
        </folder>
      </folder>
      <folder name="Gebeurtenissen" id="id-54ffca2a1c5c53ff8b9171266c105373">
        <element xsi:type="archimate:BusinessEvent" name="Besmet lijk gemeld" id="id-2fea955930dd520eba7426ee1cf72121">
          <documentation>De burgemeester heeft van de GGD de melding ontvangen dat een lijk besmet is met gevaar voor de volksgezondheid.</documentation>
          <property key="wiki-gemma-model id" value="besmet-lijk-gemeld"/>
          <property key="wiki-gemma-model herkomst" value="nieuw"/>
          <property key="wiki-gemma-model exportdatum" value="2026-10-02T11:42:07"/>
          <property key="wiki-gemma-model soort export" value="definitief"/>
          <property key="wiki-gemma-model status" value="goedgekeurd"/>
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-publieke-gezondheid-wettekst; 2026-rijk-wet-op-de-lijkbezorging-wettekst"/>
          <property key="wiki-gemma-model beschrijving" value="De arts die vaststelt dat een lijk besmet is met een infectieus of giftig agens of stof met ernstig gevaar voor de volksgezondheid, meldt dat onverwijld aan de GGD (Wet publieke gezondheid art. 21 lid 2); de GGD geeft de ontvangst onverwijld door aan de burgemeester van de gemeente waarin het lijk zich bevindt (art. 27 lid 3)."/>
          <property key="wiki-gemma-model synoniemen" value="Melding besmet lijk (wet)"/>
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/gebeurtenissen/besmet-lijk-gemeld.md"/>
        </element>
        <element xsi:type="archimate:BusinessEvent" name="Verval van het grafrecht" id="id-e9b245662c175440ad0b5585bbbe18df">
          <documentation>Het einde van een grafrecht door verloop van de termijn, afstand, opheffing van de begraafplaats of vervallenverklaring.</documentation>
          <property key="wiki-gemma-model id" value="verval-van-het-grafrecht"/>
          <property key="wiki-gemma-model herkomst" value="nieuw"/>
          <property key="wiki-gemma-model exportdatum" value="2026-10-02T11:42:07"/>
          <property key="wiki-gemma-model soort export" value="definitief"/>
          <property key="wiki-gemma-model status" value="goedgekeurd"/>
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen"/>
          <property key="wiki-gemma-model beschrijving" value="Een grafrecht vervalt door het verlopen van de termijn, door afstand of door opheffing van de begraafplaats; het college kan het vervallen verklaren bij niet-betalen, verzuim of als het na overlijden van de rechthebbende niet wordt overgeschreven, en het recht vervalt na een niet opgevolgde verklaring van verwaarlozing (Groningen art. 20; art. 28 lid 6). Daarna kunnen de grafbedekking worden verwijderd en het graf worden geruimd (Groningen art. 20 lid 4, 26)."/>
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/gebeurtenissen/verval-van-het-grafrecht.md"/>
        </element>
        <element xsi:type="archimate:BusinessEvent" name="Overlijden" id="id-edb09f226d2b51f7a95e3dc16d5cb699">
          <documentation>Het sterven van een persoon.</documentation>
          <property key="wiki-gemma-model id" value="overlijden"/>
          <property key="wiki-gemma-model herkomst" value="nieuw"/>
          <property key="wiki-gemma-model exportdatum" value="2026-10-02T11:42:07"/>
          <property key="wiki-gemma-model soort export" value="definitief"/>
          <property key="wiki-gemma-model status" value="goedgekeurd"/>
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-rvo-aangifte-en-akte-van-overlijden"/>
          <property key="wiki-gemma-model beschrijving" value="Het overlijden van een persoon wordt aangegeven bij de gemeente waar de persoon is overleden; voor de aangifte is een verklaring van overlijden nodig (Ondernemersplein)."/>
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/gebeurtenissen/overlijden.md"/>
        </element>
      </folder>
      <folder name="Rollen" id="id-8952e40c37b1557a9e0fe6b1dbcd6ebb">
        <element xsi:type="archimate:BusinessRole" name="Ambtenaar van de burgerlijke stand" id="id-3b44289d234957ecad7e1c725acf246a">
          <documentation>Ambtenaar die bevoegd is akten van de burgerlijke stand op te maken.</documentation>
          <property key="wiki-gemma-model id" value="ambtenaar-van-de-burgerlijke-stand"/>
          <property key="wiki-gemma-model herkomst" value="nieuw"/>
          <property key="wiki-gemma-model exportdatum" value="2026-10-02T11:42:07"/>
          <property key="wiki-gemma-model soort export" value="definitief"/>
          <property key="wiki-gemma-model status" value="goedgekeurd"/>
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-rvo-aangifte-en-akte-van-overlijden"/>
          <property key="wiki-gemma-model beschrijving" value="De ambtenaar van de burgerlijke stand maakt de akten van de burgerlijke stand op, waaronder de akte van overlijden na aangifte bij de gemeente waar iemand is overleden (Wet op de lijkbezorging art. 13, 14; Ondernemersplein)."/>
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/ambtenaar-van-de-burgerlijke-stand.md"/>
        </element>
        <element xsi:type="archimate:BusinessRole" name="Houder van de begraafplaats" id="id-77e415928f565e74b91359fde6ad9da7">
          <documentation>Verantwoordelijkheid voor het in stand houden en beheren van een begraafplaats.</documentation>
          <property key="wiki-gemma-model id" value="houder-van-de-begraafplaats"/>
          <property key="wiki-gemma-model herkomst" value="nieuw"/>
          <property key="wiki-gemma-model exportdatum" value="2026-10-02T11:42:07"/>
          <property key="wiki-gemma-model soort export" value="definitief"/>
          <property key="wiki-gemma-model status" value="goedgekeurd"/>
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2010-vng-model-beheersverordening-begraafplaatsen"/>
          <property key="wiki-gemma-model beschrijving" value="De houder van de begraafplaats stelt voor een begraving de identiteit van het lijk vast (art. 8), bepaalt wie in een algemeen graf wordt begraven (art. 23), houdt het register van begraven lijken (art. 27), doet mededeling van het verstrijken van termijnen (art. 27a, 28 lid 2), kan een verklaring van verwaarlozing opstellen (art. 28 lid 4) en geeft last tot het ruimen van graven (art. 31). Bij een gemeentelijke begraafplaats is de gemeente houder; bij een bijzondere begraafplaats een kerkgenootschap, rechtspersoon of natuurlijk persoon (art. 37)."/>
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/houder-van-de-begraafplaats.md"/>
        </element>
        <element xsi:type="archimate:BusinessRole" name="Gemeentelijke lijkschouwer" id="id-7a33463e2bb35989ab38d88aa0e2a173">
          <documentation>Arts die door het college is benoemd om lijken te schouwen.</documentation>
          <property key="wiki-gemma-model id" value="gemeentelijke-lijkschouwer"/>
          <property key="wiki-gemma-model herkomst" value="nieuw"/>
          <property key="wiki-gemma-model exportdatum" value="2026-10-02T11:42:07"/>
          <property key="wiki-gemma-model soort export" value="definitief"/>
          <property key="wiki-gemma-model status" value="goedgekeurd"/>
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst"/>
          <property key="wiki-gemma-model beschrijving" value="Burgemeester en wethouders benoemen een of meer gemeentelijke lijkschouwers, uitsluitend forensisch artsen (art. 4, 5). De lijkschouwer schouwt het lijk als de behandelend arts dat niet doet, geeft een verklaring van overlijden af of waarschuwt bij een niet-natuurlijke dood de officier van justitie en de ambtenaar van de burgerlijke stand, en leidt het nader onderzoek bij een minderjarige (art. 3, 7, 10, 10a). Hij kan de elektronische weg openstellen voor mededelingen van de behandelend arts (art. 7 lid 3)."/>
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/gemeentelijke-lijkschouwer.md"/>
        </element>
        <element xsi:type="archimate:BusinessRole" name="Rechthebbende op het graf" id="id-cb6de84aee08550d85ac3727aad8bec2">
          <documentation>Wie het grafrecht op een particulier graf heeft en bepaalt wie daarin wordt begraven of bijgezet.</documentation>
          <property key="wiki-gemma-model id" value="rechthebbende-op-het-graf"/>
          <property key="wiki-gemma-model herkomst" value="nieuw"/>
          <property key="wiki-gemma-model exportdatum" value="2026-10-02T11:42:07"/>
          <property key="wiki-gemma-model soort export" value="definitief"/>
          <property key="wiki-gemma-model status" value="goedgekeurd"/>
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2010-vng-model-beheersverordening-begraafplaatsen"/>
          <property key="wiki-gemma-model beschrijving" value="De rechthebbende bepaalt wie in het particulier graf wordt begraven (art. 23 lid 2), geeft toestemming voor opgraving en ruiming (art. 29, 31), vraagt verlenging, overschrijving en een vergunning voor de grafbedekking aan, onderhoudt de grafbedekking en kan afstand doen van het recht (Groningen art. 16, 18, 19, 22, 24). Dat kan een natuurlijk persoon of een rechtspersoon zijn (Groningen art. 1 w)."/>
          <property key="wiki-gemma-model synoniemen" value="Rechthebbende (beleid)"/>
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/rechthebbende-op-het-graf.md"/>
        </element>
        <element xsi:type="archimate:BusinessRole" name="Degene die in de lijkbezorging voorziet" id="id-e816170ab8e354c192c34c534cfa3355">
          <documentation>Wie de lijkbezorging van een overledene regelt en daarvoor het verlof aanvraagt.</documentation>
          <property key="wiki-gemma-model id" value="degene-die-in-de-lijkbezorging-voorziet"/>
          <property key="wiki-gemma-model herkomst" value="nieuw"/>
          <property key="wiki-gemma-model exportdatum" value="2026-10-02T11:42:07"/>
          <property key="wiki-gemma-model soort export" value="definitief"/>
          <property key="wiki-gemma-model status" value="goedgekeurd"/>
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2010-vng-model-beheersverordening-begraafplaatsen"/>
          <property key="wiki-gemma-model beschrijving" value="Degene die in de lijkbezorging voorziet vraagt het verlof tot begraving of crematie aan, of is redelijkerwijs in diens plaats getreden; de lijkbezorging volgt zoveel mogelijk de wens van de overledene (art. 18, 19). Op de gemeentelijke begraafplaats doet hij de kennisgeving van begraven of bijzetten en ondertekent hij zo nodig de machtiging (Groningen art. 7 lid 2, 9). In de praktijk vervult vaak de uitvaartondernemer deze rol namens de nabestaanden."/>
          <property key="wiki-gemma-model synoniemen" value="Degene die in de uitvaart voorziet (beleid)"/>
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/degene-die-in-de-lijkbezorging-voorziet.md"/>
        </element>
        <element xsi:type="archimate:BusinessRole" name="Houder van een plaats van bijzetting" id="id-f97e7a1412ff52749ee3016217299bdb">
          <documentation>Verantwoordelijkheid voor een plaats waar urnen worden bijgezet.</documentation>
          <property key="wiki-gemma-model id" value="houder-van-een-plaats-van-bijzetting"/>
          <property key="wiki-gemma-model herkomst" value="nieuw"/>
          <property key="wiki-gemma-model exportdatum" value="2026-10-02T11:42:07"/>
          <property key="wiki-gemma-model soort export" value="definitief"/>
          <property key="wiki-gemma-model status" value="goedgekeurd"/>
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen"/>
          <property key="wiki-gemma-model beschrijving" value="De houder van een plaats van bijzetting houdt een openbaar register van de bijgezette asbussen, stelt ze op verzoek ter beschikking en ruimt ze door verstrooiing van de as (art. 63, 65, 66). Het register gaat bij opheffing naar het archief van de gemeente (art. 65 lid 3)."/>
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/houder-van-een-plaats-van-bijzetting.md"/>
        </element>
        <element xsi:type="archimate:BusinessRole" name="Houder van het crematorium" id="id-fafdec9a745a5861ae1b04f2947fa87b">
          <documentation>Verantwoordelijkheid voor een crematorium, het bergen van de as en de bestemming daarvan.</documentation>
          <property key="wiki-gemma-model id" value="houder-van-het-crematorium"/>
          <property key="wiki-gemma-model herkomst" value="nieuw"/>
          <property key="wiki-gemma-model exportdatum" value="2026-10-02T11:42:07"/>
          <property key="wiki-gemma-model soort export" value="definitief"/>
          <property key="wiki-gemma-model status" value="goedgekeurd"/>
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst"/>
          <property key="wiki-gemma-model beschrijving" value="De houder van het crematorium bergt de as in asbussen, bewaart ze en zorgt voor de bestemming van de as, en houdt een openbaar register van gecremeerde lijken (art. 50, 58, 59). Bij een gemeentelijk crematorium is de gemeente houder, bij een bijzonder crematorium een kerkgenootschap, rechtspersoon of natuurlijk persoon (art. 51, 52)."/>
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/houder-van-het-crematorium.md"/>
        </element>
        <element xsi:type="archimate:BusinessRole" name="Nabestaande" id="id-fef4ddc0626658c98d617a3cf964afab">
          <documentation>Naaste van een overledene die zorg draagt voor de uitvaart of de urn.</documentation>
          <property key="wiki-gemma-model id" value="nabestaande"/>
          <property key="wiki-gemma-model herkomst" value="nieuw"/>
          <property key="wiki-gemma-model exportdatum" value="2026-10-02T11:42:07"/>
          <property key="wiki-gemma-model soort export" value="definitief"/>
          <property key="wiki-gemma-model status" value="goedgekeurd"/>
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2010-vng-model-beheersverordening-begraafplaatsen"/>
          <property key="wiki-gemma-model beschrijving" value="De nabestaande draagt zorg voor de asbus, geeft opdracht tot bijzetting of verstrooiing en kan de as laten meegeven (art. 58–60, 62). Op de gemeentelijke begraafplaats kan hij werkzaamheden bij de begraving zelf verrichten en bij ruiming de resten laten herbegraven of cremeren (Groningen art. 7 lid 4, 27 lid 4; VNG-model art. 24 lid 4)."/>
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/nabestaande.md"/>
        </element>
      </folder>
    </folder>
  </folder>
  <folder name="Application" id="8aa1ca69-de12-497b-a538-48f327cb37b2" type="application"/>
  <folder name="Technology &amp; Physical" id="d5745061-4cb2-49f5-8598-10ff5fbf5e02" type="technology"/>
  <folder name="Motivation" id="301f18c5-e0d4-4813-af2a-f936b7ffe42b" type="motivation">
    <folder name="wiki-gemma-model" id="id-06cf3b673119556db59ccce705f6df1e">
      <folder name="Beleidskaders" id="id-b6f3bffb69ca575287dff372c8952482">
        <element xsi:type="archimate:Driver" name="Wet op de lijkbezorging" id="id-58cba76204ce551b9650abf0d9fbf686">
          <documentation>Wet die regelt hoe een lijk wordt geschouwd, begraven, gecremeerd of anders bezorgd, en welke taken de gemeente daarbij heeft.</documentation>
          <property key="wiki-gemma-model id" value="wet-op-de-lijkbezorging"/>
          <property key="wiki-gemma-model herkomst" value="nieuw"/>
          <property key="wiki-gemma-model exportdatum" value="2026-10-02T11:42:07"/>
          <property key="wiki-gemma-model soort export" value="definitief"/>
          <property key="wiki-gemma-model status" value="goedgekeurd"/>
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-vng-wet-op-de-lijkbezorging"/>
          <property key="wiki-gemma-model beschrijving" value="De Wet op de lijkbezorging (BWBR0005009) bepaalt wat een lijk is, hoe lijkschouwing, begraving, crematie en ontleding verlopen, en welke besluiten burgemeester, college en raad daarbij nemen (art. 1–4, 11, 21, 29, 68). Ze verplicht elke gemeente tot ten minste één gemeentelijke begraafplaats (art. 33) en regelt het uitsluitend recht op een graf, de ruiming en de sluiting van begraafplaatsen (art. 28, 31, 43)."/>
          <property key="wiki-gemma-model pagina" value="motivatie/beleidskaders/wet-op-de-lijkbezorging.md"/>
        </element>
        <element xsi:type="archimate:Driver" name="Model-beheersverordening begraafplaatsen" id="id-698780f0d7a7536b9a3bd66c7edae03d">
          <documentation>Model van de VNG voor de verordening waarin een gemeente het beheer en het gebruik van haar begraafplaatsen regelt.</documentation>
          <property key="wiki-gemma-model id" value="model-beheersverordening-begraafplaatsen"/>
          <property key="wiki-gemma-model herkomst" value="nieuw"/>
          <property key="wiki-gemma-model exportdatum" value="2026-10-02T11:42:07"/>
          <property key="wiki-gemma-model soort export" value="definitief"/>
          <property key="wiki-gemma-model status" value="goedgekeurd"/>
          <property key="wiki-gemma-model bronnen" value="2010-vng-model-beheersverordening-begraafplaatsen; 2026-vng-wet-op-de-lijkbezorging"/>
          <property key="wiki-gemma-model beschrijving" value="De raad stelt de beheersverordening vast op grond van art. 35 Wet op de lijkbezorging en art. 149 Gemeentewet; het model geeft de begripsbepalingen (particulier en algemeen graf, urnengraf, urnennis, gedenkplaats, rechthebbende, gebruiker, beheerder) en de regels voor uitgifte, termijnen, overschrijving, afstand, grafbedekking, onderhoud en ruiming (aanhef, art. 1–24).&#xA;&#xA;De openbare versie is die van 2010, met toelichting; nieuwere versies staan in de Kennisbank decentrale regelgeving van SDU. De toelichting citeert art. 28 lid 7 Wet op de lijkbezorging nog met een termijn van twintig jaar; de huidige wet zegt tien jaar (tegenspraak)."/>
          <property key="wiki-gemma-model synoniemen" value="VNG Model beheersverordening begraafplaatsen (beleid)"/>
          <property key="wiki-gemma-model pagina" value="motivatie/beleidskaders/model-beheersverordening-begraafplaatsen.md"/>
        </element>
      </folder>
    </folder>
  </folder>
  <folder name="Implementation &amp; Migration" id="a033d248-d40c-4e64-bca8-1a5531d64161" type="implementation_migration"/>
  <folder name="Other" id="3b800cff-3343-4c3a-8656-44c4810198e8" type="other"/>
  <folder name="Relations" id="71e4e05c-205f-4535-a3a8-c159f1049ea5" type="relations">
    <folder name="wiki-gemma-model" id="id-82a867f6dfd2579ab1af611f30ab8f9d">
      <element xsi:type="archimate:AssociationRelationship" name="betreft (vergunning grafbedekking)" id="id-00c0b2985e075c269fa52f191c6c75ba" source="id-268057e5fe5b546fbc837693094bd785" target="id-60c80a79d05150f38339b75b4e76f46b" directed="true">
