            <element xsi:type="archimate:BusinessService" name="Zakenpaspoort" id="id-10fbde46d55e5305a80a01a60bd7e985">
              <documentation>Het aanvragen en ophalen van een nationaal paspoort met 66 in plaats van 34 bladzijden.</documentation>
              <property key="wiki-gemma-model id" value="zakenpaspoort" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2026-utrecht-burgerzaken-paspoort-of-identiteitskaart-aanvragen; 2026-rvig-hup-uitreiking-registreren-van-een-reisdocument; 2026-rijk-paspoortwet-bwbr0005212" />
              <property key="wiki-gemma-model beschrijving" value="Een zakenpaspoort is een gewoon paspoort met extra bladzijden; het kan niet naast een normaal paspoort worden aangevraagd en kost hetzelfde (Utrecht). De Paspoortwet kent het niet als eigen soort; in het documentnummer heeft het de letter B (HUP Uitreiking). De UPL noemt als grondslag art. 3 Paspoortuitvoeringsregeling Buitenland 2001 (UPL nr. 494); zie de terugmelding over de grondslag." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/0-bestuur-en-ondersteuning/burgerzaken/zakenpaspoort.md" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model domein" value="Publieksdiensten" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessService" name="Naturalisatieverzoek" id="id-1374915f80c55289961e5e5f72d87887">
              <documentation>Het indienen van een verzoek om naturalisatie, dat de gemeente onderzoekt en met haar advies doorstuurt naar de minister.</documentation>
              <property key="wiki-gemma-model id" value="naturalisatieverzoek" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2026-utrecht-burgerzaken-nederlander-worden-door-naturalisatie-of-optie; 2026-rijk-besluit-verkrijging-verlies-nederlanderschap-bwbr0013605" />
              <property key="wiki-gemma-model beschrijving" value="Wie nog niet zo lang in Nederland woont, kan door naturalisatie Nederlander worden; de Koning beslist (Utrecht; Rijkswet op het Nederlanderschap art. 7). Aanvragen kan op afspraak aan de balie of online bij de IND met daarna een afspraak bij de gemeente; de gemeente rekent leges, met een verlaagde prijs bij een asielvergunning voor onbepaalde tijd of als staatloze (Utrecht). Het verzoek is schriftelijk, ondertekend en in persoon ingediend (Besluit verkrijging en verlies Nederlanderschap art. 3, 33). Grondslag art. 7 Rijkswet; doelgroep burger, SDG; niet digitaal, bewijs in persoon (UPL nr. 263). Het alsnog Nederlander worden van een kind na de naturalisatie van de ouder (na-naturalisatie) loopt via de IND (Utrecht)." />
              <property key="wiki-gemma-model synoniemen" value="Nederlander worden door naturalisatie (beleid); Verzoek om verlening (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/0-bestuur-en-ondersteuning/burgerzaken/naturalisatieverzoek.md" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model domein" value="Publieksdiensten" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessService" name="BRP-wijzigingsverzoek" id="id-140bcdf33b1b50489151ad8a57766322">
              <documentation>Het verzoek om onjuiste eigen gegevens in de basisregistratie personen te laten corrigeren.</documentation>
              <property key="wiki-gemma-model id" value="brp-wijzigingsverzoek" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2026-utrecht-burgerzaken-persoonsgegevens-opvragen-of-aanpassen-brp; 2018-nvvb-stappenplan-identiteitswijziging-brp" />
              <property key="wiki-gemma-model beschrijving" value="Adresgegevens aanpassen kan online of per post, persoonsgegevens zoals naam, geslacht en geboortedatum alleen persoonlijk of per post, met bewijsstukken (Utrecht Persoonsgegevens aanpassen). Grondslag is art. 2.58 Wet BRP; de aanvraag kan digitaal (UPL nr. 95)." />
              <property key="wiki-gemma-model synoniemen" value="Persoonsgegevens aanpassen (beleid); Rectificatieverzoek (beleid)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/0-bestuur-en-ondersteuning/burgerzaken/brp-wijzigingsverzoek.md" />
              <property key="wiki-gemma-model afnemer" value="extern" />
