              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessService" name="Bewijs van in leven zijn" id="id-e958088015b45973b7c677b6b2cbdf8e">
              <documentation>Het verkrijgen van een bewijs dat iemand in leven is, als uittreksel uit de BRP of als internationale attestatie de vita.</documentation>
              <property key="wiki-gemma-model id" value="bewijs-van-in-leven-zijn" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2026-utrecht-burgerzaken-bewijs-van-in-leven-zijn-of-attestatie-de-vita-aanvragen; 2026-rijk-burgerlijk-wetboek-boek-1" />
              <property key="wiki-gemma-model beschrijving" value="Het bewijs van in leven zijn is een uittreksel uit de BRP bij de gemeente van inschrijving, ook met DigiD of een machtiging; de attestatie de vita is internationaal, ook bij een andere gemeente te krijgen, en alleen persoonlijk aan de balie aan te vragen, zonder machtiging (Utrecht; BW 1 art. 19k). Gratis voor een pensioenregeling; anders Utrecht € 21,20 of € 17,80 in 2026 (Utrecht). Grondslag art. 19k BW 1 (UPL nr. 61)." />
              <property key="wiki-gemma-model synoniemen" value="Attestatie de vita (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/0-bestuur-en-ondersteuning/burgerzaken/bewijs-van-in-leven-zijn.md" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model domein" value="Publieksdiensten" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessService" name="Verhuismelding" id="id-eefcab86713757d1abc0b3eaac7025b0">
              <documentation>Het doorgeven van een verhuizing binnen of naar de gemeente, zodat het nieuwe adres in de basisregistratie personen komt.</documentation>
              <property key="wiki-gemma-model id" value="verhuismelding" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2026-utrecht-burgerzaken-verhuizing-doorgeven; 2026-rvig-hup-binnengemeentelijke-adreswijziging; 2026-rvig-hup-verblijfplaats" />
              <property key="wiki-gemma-model beschrijving" value="De verhuizing wordt doorgegeven vanaf vier weken voor tot vijf dagen na de verhuisdatum, online met DigiD, per post of aan de balie; de gemeente past de gegevens binnen ongeveer een week aan en geeft de verhuizing door aan organisaties (Utrecht Verhuizing doorgeven). Grondslag is art. 2.39 Wet BRP (UPL nr. 424)." />
              <property key="wiki-gemma-model synoniemen" value="Verhuizing doorgeven (beleid); Aangifte van adreswijziging (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/0-bestuur-en-ondersteuning/burgerzaken/verhuismelding.md" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model domein" value="Publieksdiensten" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessService" name="Rijbewijs aanvragen" id="id-f2a866bed0475e00bbcaa006a33256a8">
              <documentation>Het aanvragen en ophalen van een Nederlands rijbewijs, voor het eerst, bij vernieuwing of ter vervanging van een verloren rijbewijs.</documentation>
              <property key="wiki-gemma-model id" value="rijbewijs-aanvragen" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2026-utrecht-burgerzaken-rijbewijs-aanvragen-of-verlengen; 2026-utrecht-burgerzaken; 2026-rijk-wegenverkeerswet-1994-bwbr0006622" />
              <property key="wiki-gemma-model beschrijving" value="De aanvrager komt op afspraak aan de balie, met zijn vorige rijbewijs of een identiteitsbewijs en een pasfoto, en haalt het rijbewijs vijf werkdagen later persoonlijk op; per afspraak behandelt de gemeente één aanvraag en een spoedaanvraag kost extra (Utrecht). Een eerste rijbewijs vraagt een verklaring van geschiktheid en geeft een beginnersrijbewijs; een groot rijbewijs of een aanvraag vanaf 75 jaar vraagt een medische keuring (Utrecht; Reglement rijbewijzen art. 35). De gezondheidsverklaring (UPL nr. 362) is een onderdeel van deze dienst: de gemeente verkoopt haar niet, de aanvrager koopt haar bij het CBR, en de gemeente controleert bij het besluit over de aanvraag of de verklaring van geschiktheid is geregistreerd (Reglement rijbewijzen art. 35, 45, 97).&#10;&#10;De UPL noemt als grondslag art. 26 Reglement rijbewijzen, dat alleen de wijze van aanvragen aanwijst; de bevoegdheid van de burgemeester tot afgifte staat in de Wegenverkeerswet 1994 (art. 116), zie de terugmelding." />
              <property key="wiki-gemma-model synoniemen" value="Rijbewijs (UPL); Rijbewijs aanvragen of verlengen (beleid)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/0-bestuur-en-ondersteuning/burgerzaken/rijbewijs-aanvragen.md" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model domein" value="Publieksdiensten" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessService" name="Geslachtswijzigingsaangifte" id="id-faee3407e1eb56508c89f03f8c449c77">
              <documentation>Het doen van aangifte van de wijziging van de vermelding van het geslacht in de geboorteakte.</documentation>
              <property key="wiki-gemma-model id" value="geslachtswijzigingsaangifte" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2026-utrecht-burgerzaken-geslacht-vermelding-aanpassen; 2026-rijk-burgerlijk-wetboek-boek-1" />
              <property key="wiki-gemma-model beschrijving" value="Op afspraak aan de balie, gratis; Utrecht vergoedt inwoners de kosten van de deskundigenverklaring en van nieuwe identiteitsdocumenten (Utrecht). Grondslag art. 28 BW 1 (UPL nr. 159)." />
              <property key="wiki-gemma-model synoniemen" value="Geslacht, vermelding aanpassen (beleid)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/0-bestuur-en-ondersteuning/burgerzaken/geslachtswijzigingsaangifte.md" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model domein" value="Publieksdiensten" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessService" name="Identiteitskaart" id="id-fafc6557fd355fee8002bdba3249fb2f">
              <documentation>Het aanvragen en ophalen van een Nederlandse identiteitskaart, waarmee een Nederlander zich identificeert en naar een deel van de landen kan reizen.</documentation>
              <property key="wiki-gemma-model id" value="identiteitskaart" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2026-rijk-paspoortwet-bwbr0005212; 2026-utrecht-burgerzaken-paspoort-of-identiteitskaart-aanvragen" />
              <property key="wiki-gemma-model beschrijving" value="Een ID-kaart is goedkoper dan een paspoort, maar niet voor alle landen geldig; ze kan naast een paspoort bestaan. Een kind jonger dan twaalf jaar heeft toestemming van de ouders of gezaghebbers nodig (Utrecht; Wet op de Nederlandse identiteitskaart art. 22). Sinds 2026-10-01 regelt de Wet op de Nederlandse identiteitskaart de aanvraag, verstrekking, uitreiking, weigering, het verval en de inhouding van de kaart (art. 11, 15-39); de Paspoortwet levert de registers van de minister (Paspoortwet art. 1 onder u, 4a, 25). De UPL noemt als grondslag art. 16a Paspoortwet (UPL nr. 186); die paragraaf is per 2026-10-01 vervallen, zie de terugmelding over de grondslag." />
              <property key="wiki-gemma-model synoniemen" value="ID-kaart (beleid); Nederlandse identiteitskaart (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/0-bestuur-en-ondersteuning/burgerzaken/identiteitskaart.md" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model domein" value="Publieksdiensten" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessService" name="Voornaamwijziging" id="id-ff78d5a3381d5121845ad36b0d37e75a">
              <documentation>Het laten opnemen van een door de rechtbank gewijzigde voornaam in de geboorteakte en de basisregistratie personen.</documentation>
              <property key="wiki-gemma-model id" value="voornaamwijziging" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2026-utrecht-burgerzaken-voornaam-of-achternaam-veranderen; 2026-rijk-burgerlijk-wetboek-boek-1" />
              <property key="wiki-gemma-model beschrijving" value="Het verzoek gaat met een advocaat naar de rechtbank; de gemeente heeft een eigen handeling na de beschikking en het product wordt daarom opgenomen (besluit redacteur 2026-10-06). Grondslag art. 4 BW 1 (UPL nr. 460)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/0-bestuur-en-ondersteuning/burgerzaken/voornaamwijziging.md" />
