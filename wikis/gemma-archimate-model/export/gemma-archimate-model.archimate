  <folder name="Motivation" id="301f18c5-e0d4-4813-af2a-f936b7ffe42b" type="motivation">
    <folder name="wiki-gemma-model" id="id-06cf3b673119556db59ccce705f6df1e">
      <folder name="Beleidskaders" id="id-b6f3bffb69ca575287dff372c8952482">
        <folder name="0 Bestuur en Ondersteuning" id="id-f2f74f8c3e485ff996abe265d4cb2e83">
          <folder name="Burgerzaken" id="id-0a291099813d54f0909aa7ff74461c7a">
            <element xsi:type="archimate:Driver" name="Wegenverkeerswet 1994" id="id-1b68c2aca65650909771ad8c0d2bca52">
              <documentation>Wet over het verkeer op de weg, met de regels voor de aanvraag, afgifte en geldigheid van rijbewijzen en de taken van de RDW en het CBR.</documentation>
              <property key="wiki-gemma-model id" value="wegenverkeerswet-1994" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wegenverkeerswet-1994-bwbr0006622; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="De Wegenverkeerswet 1994 (BWBR0006622) regelt het verkeer op de weg. Voor Burgerzaken telt hoofdstuk VI: de rijbewijsplicht (art. 107), de voorwaarden voor afgifte (art. 111, 112), de aanvraag (art. 113), de afgifte door de burgemeester of de RDW (art. 116), het nieuwe en het vervangende rijbewijs (art. 119, 120), de uitreiking (art. 120a), de geldigheid en het verlies ervan (art. 122, 123) en het rijbewijzenregister van de RDW (art. 126). De RDW en het CBR zijn zelfstandige bestuursorganen (art. 4a, 4z). Kentekens, voertuigeisen, rijonderricht, het onderzoek naar rijvaardigheid en de maatregelen na overtredingen vallen buiten dit onderwerp." />
              <property key="wiki-gemma-model pagina" value="motivatie/beleidskaders/wegenverkeerswet-1994.md" />
              <property key="wiki-gemma-model regelgever" value="rijk" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:Driver" name="Kieswet" id="id-1cdc4a42201a5ac6bf454b017afc2b74">
              <documentation>Wet over het kiesrecht en de verkiezing van de vertegenwoordigende organen, waaronder de gemeenteraad.</documentation>
              <property key="wiki-gemma-model id" value="kieswet" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-kieswet-bwbr0004627; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="De Kieswet (BWBR0004627) regelt wie kiesgerechtigd is (hoofdstuk B), de registratie van de kiesgerechtigdheid door burgemeester en wethouders (D), de stempas (J), de kiezerspas (K) en het stemmen bij volmacht (L), en daarnaast de kandidaatstelling, de stembureaus, de stemming en de uitslag, die buiten dit onderwerp vallen (besluit redacteur 2026-10-06, Afbakening Burgerzaken)." />
              <property key="wiki-gemma-model pagina" value="motivatie/beleidskaders/kieswet.md" />
              <property key="wiki-gemma-model regelgever" value="rijk" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:Driver" name="Reglement rijbewijzen" id="id-2042c9ba48405f48bcee0a0f29f27d73">
              <documentation>Algemene maatregel van bestuur met de regels voor de aanvraag, afgifte en omwisseling van rijbewijzen en de verklaringen van rijvaardigheid en geschiktheid.</documentation>
              <property key="wiki-gemma-model id" value="reglement-rijbewijzen" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-reglement-rijbewijzen-bwbr0008074; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="Het Reglement rijbewijzen (BWBR0008074) werkt de Wegenverkeerswet 1994 uit: de aanvraag bij de burgemeester van de gemeente van inschrijving (hoofdstuk II, art. 26 tot en met 45), de verklaringen van rijvaardigheid en geschiktheid die het CBR registreert (hoofdstuk III en IV, art. 97 en 100) en de afgifte (hoofdstuk V, art. 104a tot en met 121). De gezondheidsverklaring dient de aanvrager bij het CBR in (art. 100). Rijexamens, vakbekwaamheid en de registratie van gegevens vallen buiten dit onderwerp." />
              <property key="wiki-gemma-model pagina" value="motivatie/beleidskaders/reglement-rijbewijzen.md" />
              <property key="wiki-gemma-model regelgever" value="rijk" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:Driver" name="Wet basisregistratie personen" id="id-33d01296fc3c51c7ba551b7ad63d3675">
              <documentation>Wet die de basisregistratie personen regelt: de inschrijving en bijhouding van gegevens over ingezetenen en niet-ingezetenen en de verstrekking daarvan.</documentation>
              <property key="wiki-gemma-model id" value="wet-basisregistratie-personen" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-brp-bwbr0033715; 2025-vng-upl-producten-en-diensten-extern; 2026-rijk-besluit-brp-bwbr0034306; 2026-rvig-hup-algemeen; 2026-rvig-hup-achtergronden-en-begrippen" />
              <property key="wiki-gemma-model beschrijving" value="De Wet BRP wordt uitgewerkt in het Besluit BRP, de Regeling BRP en het Logisch Ontwerp BRP (Besluit BRP; LO BRP). Het college houdt de gegevens van de ingezetenen bij; de minister van BZK de RNI en de centrale voorzieningen (HUP Achtergronden). De UPL noemt de wet als grondslag van onder meer de BRP-inschrijving, de verhuismelding, de aangifte van vertrek, het briefadres, het uittreksel en de geheimhouding (UPL)." />
              <property key="wiki-gemma-model synoniemen" value="Wet BRP (dagelijks gebruik)" />
              <property key="wiki-gemma-model pagina" value="motivatie/beleidskaders/wet-basisregistratie-personen.md" />
              <property key="wiki-gemma-model regelgever" value="rijk" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:Driver" name="Rijkswet op het Nederlanderschap" id="id-4ea0ea099a0c5478aa0b691c99ee2115">
              <documentation>Rijkswet over de verkrijging, het verlies en de vaststelling van het Nederlanderschap.</documentation>
              <property key="wiki-gemma-model id" value="rijkswet-op-het-nederlanderschap" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-rijkswet-op-het-nederlanderschap-bwbr0003738; 2025-vng-upl-producten-en-diensten-extern; 2026-utrecht-burgerzaken-nederlandse-nationaliteit-opgeven-of-verliezen; 2026-rijk-besluit-verkrijging-verlies-nederlanderschap-bwbr0013605" />
              <property key="wiki-gemma-model beschrijving" value="De Rijkswet op het Nederlanderschap (BWBR0003738) regelt de verkrijging van rechtswege (art. 3-5), door optie (art. 6) en door verlening (art. 7-13), het verlies (art. 14-16), de vaststelling door de rechtbank Den Haag (art. 17-20) en het openbare register van de minister van Justitie en Veiligheid (art. 22). Ze noemt de gemeente niet: de autoriteiten die verzoeken en verklaringen in ontvangst nemen, worden bij algemene maatregel van rijksbestuur aangewezen (art. 21); het Besluit verkrijging en verlies Nederlanderschap wijst daarvoor de burgemeester aan." />
              <property key="wiki-gemma-model pagina" value="motivatie/beleidskaders/rijkswet-op-het-nederlanderschap.md" />
              <property key="wiki-gemma-model regelgever" value="rijk" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:Driver" name="Besluit burgerlijke stand 1994" id="id-5f5e281cea0451a2916ff475dfd164d3">
              <documentation>Algemene maatregel van bestuur die de ambtsuitoefening van de ambtenaar van de burgerlijke stand, de registers en de inhoud van de akten regelt.</documentation>
              <property key="wiki-gemma-model id" value="besluit-burgerlijke-stand-1994" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-besluit-burgerlijke-stand-1994-bwbr0006493" />
              <property key="wiki-gemma-model beschrijving" value="Het besluit werkt titel 4 van Boek 1 BW uit. Hoofdstuk 1 regelt de ambtsuitoefening en de voorzieningen van de gemeente, het houden, afsluiten en overbrengen van de registers naar de centrale bewaarplaats, en afschriften en uittreksels (art. 1-7, 26, 30, 31). Hoofdstuk 2 legt per aktesoort de gegevens vast (art. 36-66); de elektronische aangifte van overlijden en kennisgeving van een huwelijk gaan met het burgerservicenummer (art. 67a)." />
              <property key="wiki-gemma-model synoniemen" value="Besluit burgerlijke stand (dagelijks gebruik)" />
              <property key="wiki-gemma-model pagina" value="motivatie/beleidskaders/besluit-burgerlijke-stand-1994.md" />
              <property key="wiki-gemma-model regelgever" value="rijk" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:Driver" name="Paspoortwet" id="id-65e99dda04575ed5b7b081a00d79b960">
              <documentation>Rijkswet over de soorten reisdocumenten, de aanspraak erop en de aanvraag, verstrekking, uitreiking, vervallenverklaring, het verval en de inhouding.</documentation>
              <property key="wiki-gemma-model id" value="paspoortwet" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-paspoortwet-bwbr0005212; 2026-utrecht-burgerzaken-paspoort-of-identiteitskaart-aanvragen" />
              <property key="wiki-gemma-model beschrijving" value="De Paspoortwet (BWBR0005212) regelt de soorten reisdocumenten en wie er recht op heeft (art. 2, 9 tot en met 16), de registers van de minister (art. 4a, 4c), de rechten die de gemeente als gemeentelijke belasting heft (art. 7), de gronden en de signalering voor weigering of vervallenverklaring (hoofdstuk III), de aanvraag (hoofdstuk IV), de verstrekking, uitreiking en wijziging (hoofdstuk V), de weigering of vervallenverklaring (hoofdstuk VI), het verval van rechtswege (hoofdstuk VII) en de inhouding en inlevering (hoofdstuk VIII). De Nederlandse identiteitskaart heeft sinds 2026-10-01 alleen nog een eigen wet; de Paspoortwet noemt haar bij vermissing, signalering en inhouding." />
              <property key="wiki-gemma-model pagina" value="motivatie/beleidskaders/paspoortwet.md" />
              <property key="wiki-gemma-model regelgever" value="rijk" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:Driver" name="Paspoortbesluit" id="id-676399ff2e08523799e2bb00c1ffe6ba">
              <documentation>Algemene maatregel van rijksbestuur die de Paspoortwet uitwerkt, zoals de geldigheid, de aanvraag en de bevoegdheden van burgemeesters.</documentation>
              <property key="wiki-gemma-model id" value="paspoortbesluit" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-paspoortbesluit-bwbr0044308" />
              <property key="wiki-gemma-model beschrijving" value="Het Paspoortbesluit (BWBR0044308) regelt de geldigheidsduur per soort reisdocument (art. 2.2), de vaststelling van identiteit en Nederlanderschap (art. 2.1), het faciliteitenpaspoort en het tweede paspoort (art. 2.12 tot en met 2.15), de aanvullende bevoegdheden van burgemeesters (art. 3.1, 3.2, 4.1, 4.2), het afzien van vingerafdrukken (art. 3.6), de identiteitsvaststelling bij de uitreiking (art. 4.6), de mededeling aan de minister bij een niet ingeleverd vervallen reisdocument (art. 6.1) en de definitieve onttrekking aan het verkeer (art. 7.1). Het noemt het register paspoortsignaleringen en het reisdocumentenstation (art. 1.1)." />
              <property key="wiki-gemma-model pagina" value="motivatie/beleidskaders/paspoortbesluit.md" />
              <property key="wiki-gemma-model regelgever" value="rijk" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:Driver" name="Besluit basisregistratie personen" id="id-a1295c99991754a891e3527247d98b99">
              <documentation>Algemene maatregel van bestuur die de Wet basisregistratie personen uitwerkt, onder meer voor inschrijving, aangifte, adresonderzoek en verstrekking.</documentation>
              <property key="wiki-gemma-model id" value="besluit-basisregistratie-personen" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-besluit-brp-bwbr0034306" />
              <property key="wiki-gemma-model beschrijving" value="Het Besluit BRP (BWBR0034306) regelt wie niet als ingezetene wordt ingeschreven (art. 21, 22), de ondersteuning van het adresonderzoek met de Landelijke Aanpak Adreskwaliteit (art. 28a tot en met 28g), de aangifteplicht en het verschijnen in persoon (art. 29, 30), de verstrekking aan overheidsorganen en derden (hoofdstuk 3, art. 37 tot en met 46) en de beveiliging van de gemeentelijke voorziening (art. 6)." />
              <property key="wiki-gemma-model synoniemen" value="Besluit BRP (dagelijks gebruik)" />
              <property key="wiki-gemma-model pagina" value="motivatie/beleidskaders/besluit-basisregistratie-personen.md" />
              <property key="wiki-gemma-model regelgever" value="rijk" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:Driver" name="Wet op de Nederlandse identiteitskaart" id="id-b2211719c92f50ddb6fe5d842136a89c">
              <documentation>Wet over de Nederlandse identiteitskaart, de aanspraak erop en de aanvraag, verstrekking, uitreiking, weigering, het verval en de inhouding.</documentation>
              <property key="wiki-gemma-model id" value="wet-op-de-nederlandse-identiteitskaart" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-nederlandse-identiteitskaart-bwbr0052951" />
              <property key="wiki-gemma-model beschrijving" value="De Wet op de Nederlandse identiteitskaart (BWBR0052951, sinds 2026-10-01) regelt de identiteitskaart buiten de Paspoortwet: de gegevens op de kaart en het publiek identificatiemiddel (art. 3, 4), de aanspraak (art. 11), de aanvraag, de verstrekking en de uitreiking door de burgemeester voor ingezetenen van zijn gemeente (art. 15-27), de weigering (art. 13, 28), het verval van rechtswege (art. 30), de inhouding en inlevering (art. 35-39) en de rechten die de gemeente als gemeentelijke belasting heft (art. 9). Een vervallenverklaring door de burgemeester kent de wet niet. Voor de registers van de minister verwijst ze naar de Paspoortwet (art. 5, 5a, 14)." />
              <property key="wiki-gemma-model pagina" value="motivatie/beleidskaders/wet-op-de-nederlandse-identiteitskaart.md" />
              <property key="wiki-gemma-model regelgever" value="rijk" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:Driver" name="Besluit verkrijging en verlies Nederlanderschap" id="id-b78273a66b0f56519493d09772f5d839">
              <documentation>Algemene maatregel van rijksbestuur die de bevoegde autoriteiten aanwijst en de behandeling van optie, naturalisatie en afstand regelt.</documentation>
              <property key="wiki-gemma-model id" value="besluit-verkrijging-en-verlies-nederlanderschap" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-besluit-verkrijging-verlies-nederlanderschap-bwbr0013605; 2025-vng-upl-producten-en-diensten-extern; 2026-utrecht-burgerzaken-nederlandse-nationaliteit-opgeven-of-verliezen" />
              <property key="wiki-gemma-model beschrijving" value="Het Besluit verkrijging en verlies Nederlanderschap (BWBR0013605) werkt de Rijkswet op het Nederlanderschap uit, onder meer art. 21. Het wijst in het Europese deel van Nederland de burgemeesters aan (art. 2) en regelt de ontvangst en behandeling van de optieverklaring (art. 7-12), het naturalisatieverzoek met het advies aan de minister (art. 31-38), de uitreiking van de bevestiging en het uittreksel met de verklaring van verbondenheid (art. 60a, 60b), het bewijs van het Nederlanderschap (art. 61) en de verklaring van afstand (art. 62-64). Gemeente, college, ambtenaar van de burgerlijke stand en IND komen er niet in voor. Een beslistermijn voor de optie noemt het besluit niet; die staat in de Rijkswet (art. 6 lid 5)." />
              <property key="wiki-gemma-model pagina" value="motivatie/beleidskaders/besluit-verkrijging-en-verlies-nederlanderschap.md" />
              <property key="wiki-gemma-model regelgever" value="rijk" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:Driver" name="Wet justitiële en strafvorderlijke gegevens" id="id-f8922345ce8357b9984f5148afe48764">
              <documentation>Wet over de verwerking en verstrekking van justitiële en strafvorderlijke gegevens, met de regels voor de aanvraag en afgifte van de VOG.</documentation>
              <property key="wiki-gemma-model id" value="wet-justitiele-en-strafvorderlijke-gegevens" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-justitiele-en-strafvorderlijke-gegevens-bwbr0014194; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="De Wet justitiële en strafvorderlijke gegevens (BWBR0014194) regelt de verwerking en verstrekking van justitiële en strafvorderlijke gegevens, de rechten van de betrokkene, controle en toezicht en de persoonsdossiers. Voor Burgerzaken telt titel 2, afdeling 5 (art. 28 tot en met 39) over de verklaring omtrent het gedrag: de definitie (art. 28), de beschikking (art. 29), de aanvraag bij de burgemeester en de doorzending (art. 30, 31), het onderzoek en de weigering door de minister (art. 34 tot en met 38) en de kosten (art. 39). De rest van de wet valt buiten dit onderwerp. Het Besluit justitiële en strafvorderlijke gegevens werkt het onderzoek van de minister uit en geeft de gemeente geen taak; het is een bron, geen beleidskader." />
              <property key="wiki-gemma-model pagina" value="motivatie/beleidskaders/wet-justitiele-en-strafvorderlijke-gegevens.md" />
              <property key="wiki-gemma-model regelgever" value="rijk" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:Driver" name="Burgerlijk Wetboek Boek 1" id="id-fd2488c7dce15a288a8b700f61b42b13">
              <documentation>Boek van het Burgerlijk Wetboek over personen- en familierecht: naam, burgerlijke stand, huwelijk, partnerschap, afstamming, adoptie en gezag.</documentation>
              <property key="wiki-gemma-model id" value="burgerlijk-wetboek-boek-1" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-burgerlijk-wetboek-boek-1; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="Titel 4 regelt de burgerlijke stand: de ambtenaar, de registers, de akten, de latere vermeldingen en de afgifte van afschriften en uittreksels (BW 1 art. 16-29). Het Besluit burgerlijke stand 1994 werkt deze titel uit. Voor de gemeente gaat het verder om de naam (art. 4-9), het huwelijk en het geregistreerd partnerschap (art. 30-80g), de ontbinding (art. 149-151), afstamming en erkenning (art. 197-207), adoptie (art. 227) en gezag (art. 244-253t).&#10;&#10;Andere organen beslissen per geval: de rechtbank over voornamen, adoptie, echtscheiding en verbetering van akten, de Koning over de geslachtsnaam, het openbaar ministerie over stuiting; de gemeente schrijft hun uitspraken en besluiten in (BW 1 art. 4, 7, 20, 24, 80a)." />
              <property key="wiki-gemma-model synoniemen" value="BW 1 (dagelijks gebruik); Personen- en familierecht (wet)" />
              <property key="wiki-gemma-model pagina" value="motivatie/beleidskaders/burgerlijk-wetboek-boek-1.md" />
              <property key="wiki-gemma-model regelgever" value="rijk" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
          </folder>
        </folder>
        <folder name="7 Volksgezondheid en Milieu" id="id-cb186694bf085428aab64bec48d69e46">
          <folder name="Begraafplaatsen en crematoria" id="id-c16abd88342c50689fcdc5cd49c8469e">
            <element xsi:type="archimate:Driver" name="Wet op de lijkbezorging" id="id-58cba76204ce551b9650abf0d9fbf686">
              <documentation>Wet die regelt hoe een stoffelijk overschot wordt geschouwd, begraven, gecremeerd of anders bezorgd, en welke taken de gemeente daarbij heeft.</documentation>
              <property key="wiki-gemma-model id" value="wet-op-de-lijkbezorging" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-vng-wet-op-de-lijkbezorging" />
              <property key="wiki-gemma-model beschrijving" value="De Wet op de lijkbezorging (BWBR0005009) bepaalt wat een lijk is, hoe lijkschouwing, begraving, crematie en ontleding verlopen, en welke besluiten burgemeester, college en raad daarbij nemen (art. 1–4, 11, 21, 29, 68). Ze verplicht elke gemeente tot ten minste één gemeentelijke begraafplaats (art. 33) en regelt het uitsluitend recht op een graf, de ruiming en de sluiting van begraafplaatsen (art. 28, 31, 43)." />
              <property key="wiki-gemma-model pagina" value="motivatie/beleidskaders/wet-op-de-lijkbezorging.md" />
              <property key="wiki-gemma-model regelgever" value="rijk" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:Driver" name="Model-beheersverordening begraafplaatsen" id="id-698780f0d7a7536b9a3bd66c7edae03d">
              <documentation>Model van de VNG voor de verordening waarin een gemeente het beheer en het gebruik van haar begraafplaatsen regelt.</documentation>
              <property key="wiki-gemma-model id" value="model-beheersverordening-begraafplaatsen" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2010-vng-model-beheersverordening-begraafplaatsen; 2026-vng-wet-op-de-lijkbezorging; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="De raad stelt de beheersverordening vast op grond van art. 35 Wet op de lijkbezorging en art. 149 Gemeentewet; het model geeft de begripsbepalingen (particulier en algemeen graf, urnengraf, urnennis, gedenkplaats, rechthebbende, gebruiker, beheerder) en de regels voor uitgifte, termijnen, overschrijving, afstand, grafbedekking, onderhoud en ruiming (aanhef, art. 1–24).&#10;&#10;De openbare versie is die van 2010, met toelichting; nieuwere versies staan in de Kennisbank decentrale regelgeving van SDU. De toelichting citeert art. 28 lid 7 Wet op de lijkbezorging nog met een termijn van twintig jaar; de huidige wet zegt tien jaar (tegenspraak)." />
              <property key="wiki-gemma-model synoniemen" value="VNG Model beheersverordening begraafplaatsen (beleid)" />
              <property key="wiki-gemma-model pagina" value="motivatie/beleidskaders/model-beheersverordening-begraafplaatsen.md" />
              <property key="wiki-gemma-model regelgever" value="VNG-model" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:Driver" name="Besluit op de lijkbezorging" id="id-c263c16949c15730b9ef86d9ddb548db">
              <documentation>Algemene maatregel van bestuur die de Wet op de lijkbezorging uitwerkt, onder meer voor het vervoer van een stoffelijk overschot naar en uit het buitenland.</documentation>
              <property key="wiki-gemma-model id" value="besluit-op-de-lijkbezorging" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-besluit-op-de-lijkbezorging-wettekst; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="Het Besluit op de lijkbezorging (BWBR0009080) regelt de modellen van de verklaring van overlijden, de eisen aan kist, graf en grafkelder, de inhoud van de registers van crematorium en plaats van bijzetting en het vervoer naar en uit het buitenland (art. 2–11). Voor de gemeente gaat het vooral om het laissez-passer voor lijken (art. 11) en de beslistermijn voor het verlof tot ontleding (art. 17)." />
              <property key="wiki-gemma-model pagina" value="motivatie/beleidskaders/besluit-op-de-lijkbezorging.md" />
              <property key="wiki-gemma-model regelgever" value="rijk" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
          </folder>
        </folder>
      </folder>
