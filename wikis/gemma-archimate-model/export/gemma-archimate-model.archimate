            <element xsi:type="archimate:BusinessService" name="Kiezerspas" id="id-0e705ae03a7b52acbb1cf3570de2eed7">
              <documentation>Het aanvragen van een kiezerspas om bij een verkiezing in een stembureau naar keuze te stemmen.</documentation>
              <property key="wiki-gemma-model id" value="kiezerspas" />
