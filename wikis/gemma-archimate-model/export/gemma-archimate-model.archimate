        <folder name="7 Volksgezondheid en Milieu" id="id-12f5c027dc2c55ed9418808b270a4182">
          <folder name="Begraafplaatsen en crematoria" id="id-09eba3199df458099a0dcbf0fcd2c658">
            <element xsi:type="archimate:BusinessService" name="Bijzettingenregister" id="id-0d5ef53ae1e2582497bed7d3cf463923">
              <documentation>Inzage in het openbare register van alle daar bijgezette asbussen dat de houder van een plaats van bijzetting bijhoudt.</documentation>
              <property key="wiki-gemma-model id" value="bijzettingenregister" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-vng-gemma-2026-10-02" />
              <property key="wiki-gemma-model beschrijving" value="De houder van een plaats van bijzetting houdt een register bij van alle daar bijgezette asbussen; het register is openbaar en gaat bij opheffing naar het archief van de gemeente waar de plaats lag (Wet op de lijkbezorging art. 65). Is de gemeente houder, dan biedt zij de inzage aan. Het register zelf is een representatie, zonder pagina; de inhoud staat in het Besluit op de lijkbezorging (art. 10).&#10;&#10;De UPL noemt alleen bedrijven als afnemer en rekent het product tot de Dienstenwet (UPL)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/bijzettingenregister.md" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model domein" value="Fysieke leefomgeving" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessService" name="Grafonderhoud" id="id-1d72274738755c51ba065825f7a8f293">
              <documentation>Onderhoud van grafmonumenten en grafbeplanting door de gemeente, tegen betaling door de rechthebbende.</documentation>
              <property key="wiki-gemma-model id" value="grafonderhoud" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2026-vng-retributies" />
              <property key="wiki-gemma-model beschrijving" value="Op verzoek van de rechthebbende, of op sommige begraafplaatsen altijd, onderhoudt de gemeente de grafbedekking tegen betaling van een recht uit de heffingsverordening (Groningen art. 23, 24; VNG retributies). Een retributie is een tegenprestatie voor zo'n dienst (VNG retributies)." />
              <property key="wiki-gemma-model synoniemen" value="Onderhoud van graven (beleid)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/grafonderhoud.md" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model domein" value="Fysieke leefomgeving" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessService" name="Begraafplaatsregister" id="id-305a37f587655b18aea37ebb9d56ad7b">
              <documentation>Inzage in het openbare register van de stoffelijke overschotten die op een begraafplaats zijn begraven, met de plaats van het graf.</documentation>
              <property key="wiki-gemma-model id" value="begraafplaatsregister" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-vng-gemma-2026-10-02" />
              <property key="wiki-gemma-model beschrijving" value="De houder van een begraafplaats houdt een register bij van alle daar begraven stoffelijke overschotten, met de plaats waar zij begraven zijn; het register is openbaar en gaat bij opheffing naar het archief van de gemeente waar de plaats lag (Wet op de lijkbezorging art. 27). Is de gemeente houder, dan biedt zij de inzage aan. Het register zelf is het Register van begraven lijken, een representatie van Graf.&#10;&#10;De UPL noemt alleen bedrijven als afnemer en rekent het product tot de Dienstenwet (UPL)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/begraafplaatsregister.md" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model domein" value="Publieksdiensten" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessService" name="Vervoersdocumenten stoffelijk overschot" id="id-373542f45c955ea3821e396811898f65">
              <documentation>Het document van de gemeente waarmee een stoffelijk overschot ongehinderd naar het buitenland wordt vervoerd.</documentation>
              <property key="wiki-gemma-model id" value="vervoersdocumenten-stoffelijk-overschot" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2026-rijk-besluit-op-de-lijkbezorging-wettekst; 2026-rvo-aangifte-en-akte-van-overlijden" />
              <property key="wiki-gemma-model beschrijving" value="Vervoer naar een staat die partij is bij de Overeenkomst van Straatsburg gaat ongehinderd met een laissez-passer voor lijken van de burgemeester van de gemeente waar de akte van overlijden is ingeschreven (Besluit op de lijkbezorging art. 11 lid 1). Voor vervoer over land naar België of Luxemburg volstaat het verlof tot begraving of crematie (art. 11 lid 3). Bij binnenkomst wordt het document aan de douane overgelegd (art. 11 lid 5)." />
              <property key="wiki-gemma-model synoniemen" value="Laissez-passer voor lijken (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/vervoersdocumenten-stoffelijk-overschot.md" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model domein" value="Fysieke leefomgeving" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessService" name="Asverstrooiing" id="id-4186be8d8a9d52169f555ffab23dfc48">
              <documentation>Toestemming van de gemeente om as te verstrooien op een plek waar dat zonder toestemming niet mag.</documentation>
              <property key="wiki-gemma-model id" value="asverstrooiing" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2025-groningen-algemene-plaatselijke-verordening; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen" />
              <property key="wiki-gemma-model beschrijving" value="Buiten de begraafplaats is asverstrooiing vrij, behalve op de plaatsen die de APV verbiedt en bij hinder of overlast; het college kan op verzoek van de nabestaande die zorgdraagt voor de asbus bij bijzondere omstandigheden ontheffing verlenen, behalve voor begraafplaatsen, crematoriumterreinen, schoolpleinen en kinderspeelplaatsen (APV Groningen art. 5:27, 5:28). Op de gemeentelijke begraafplaats is verstrooien verboden zonder toestemming van het college, op een aangewezen plek en onder toezicht van een medewerker van de begraafplaats (Groningen art. 21).&#10;&#10;De UPL geeft als grondslag art. 5:36 van de model-APV en rekent het product tot het GEMMA-domein Openbare orde en veiligheid (UPL).&#10;&#10;Tegenspraak: de APV definieert incidentele asverstrooiing als verstrooien op een plek die de overledene of nabestaande kiest, buiten een permanent daartoe bestemd terrein (APV Groningen art. 5:26); de beheersverordening als verstrooien op een plek die de gemeente aanwijst, op of buiten de begraafplaats (Groningen art. 1). Beide vallen onder deze dienst." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/asverstrooiing.md" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model domein" value="Openbare orde en veiligheid" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessService" name="Verlof tot begraven" id="id-6291bb8caa9a52b5a5d78ec4b2bde141">
              <documentation>Toestemming van de gemeente om een stoffelijk overschot te begraven of te cremeren.</documentation>
              <property key="wiki-gemma-model id" value="verlof-tot-begraven" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2026-rijk-wet-op-de-lijkbezorging-wettekst; 2010-vng-model-beheersverordening-begraafplaatsen; 2026-rvo-aangifte-en-akte-van-overlijden" />
              <property key="wiki-gemma-model beschrijving" value="Geen begraving of crematie zonder schriftelijk verlof van de ambtenaar van de burgerlijke stand, dat kosteloos wordt afgegeven (Wet op de lijkbezorging art. 11). De UPL-naam noemt alleen begraven; het verlof geldt ook voor crematie. Voor vervoer over land naar België of Luxemburg volstaat het verlof (Besluit op de lijkbezorging art. 11 lid 3).&#10;&#10;De UPL rekent het product tot Iv3 0.2 (Burgerzaken) en het GEMMA-domein Fysieke leefomgeving (UPL). In dit model staat het bij de begraafplaatsen en crematoria, naast het bedrijfsproces dat het levert, en in de functie-indeling bij het domein van de UPL." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/verlof-tot-begraven.md" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model domein" value="Fysieke leefomgeving" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessService" name="Bijzondere begraafplaats toestemming" id="id-8a7199128b1158cf85e54b8427b6b794">
              <documentation>Toestemming van de gemeente om een bijzondere begraafplaats aan te leggen, uit te breiden of in gebruik te nemen.</documentation>
              <property key="wiki-gemma-model id" value="bijzondere-begraafplaats-toestemming" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2026-rijk-wet-op-de-lijkbezorging-wettekst" />
              <property key="wiki-gemma-model beschrijving" value="Een bijzondere begraafplaats wordt aangelegd en in stand gehouden door een kerkgenootschap, een privaatrechtelijke rechtspersoon of een natuurlijk persoon (Wet op de lijkbezorging art. 37). Voor aanleg of uitbreiding wordt alleen grond gebruikt die de gemeenteraad heeft aangewezen (art. 40 lid 1); voor de ingebruikneming is toestemming van burgemeester en wethouders nodig, die alleen wordt geweigerd als niet aan de wettelijke voorschriften is voldaan (art. 41)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/bijzondere-begraafplaats-toestemming.md" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model domein" value="Publieksdiensten" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessService" name="Crematoriumregister" id="id-9d97c3b0a3bd5d128b041d65ae6f38e6">
              <documentation>Inzage in het openbare register van alle daar gecremeerde stoffelijke overschotten en de bestemming van de as dat de houder van een crematorium bijhoudt.</documentation>
              <property key="wiki-gemma-model id" value="crematoriumregister" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-vng-gemma-2026-10-02" />
              <property key="wiki-gemma-model beschrijving" value="De houder van een crematorium houdt een register bij van alle daar gecremeerde stoffelijke overschotten en de bestemming van de as; het register is openbaar en gaat bij opheffing naar het archief van de gemeente waar de plaats lag (Wet op de lijkbezorging art. 50). Is de gemeente houder, dan biedt zij de inzage aan. Het register zelf is een representatie, zonder pagina; de inhoud staat in het Besluit op de lijkbezorging (art. 10).&#10;&#10;De UPL noemt alleen bedrijven als afnemer en rekent het product tot de Dienstenwet (UPL)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/crematoriumregister.md" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model domein" value="Fysieke leefomgeving" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessService" name="Gedenkteken plaatsingsvergunning" id="id-a8bd91490cd855889da99a459bcaeb02">
              <documentation>Vergunning van de gemeente voor het plaatsen en hebben van een gedenkteken of andere grafbedekking op een graf.</documentation>
              <property key="wiki-gemma-model id" value="gedenkteken-plaatsingsvergunning" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2010-vng-model-beheersverordening-begraafplaatsen; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen" />
              <property key="wiki-gemma-model beschrijving" value="Voor het hebben van een grafbedekking is een schriftelijke vergunning van het college nodig; de rechthebbende van een particulier graf vraagt haar aan (VNG-model art. 19 lid 1–2; Groningen art. 22 lid 1–2). Het college kan nadere regels stellen over de aanvraag, de aard en de afmetingen van de grafbedekking en kan de vergunning weigeren (Groningen art. 22 lid 3–4). De beheersverordeningen spreken van vergunning grafbedekking; de UPL van gedenkteken plaatsingsvergunning (UPL)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/gedenkteken-plaatsingsvergunning.md" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model domein" value="Fysieke leefomgeving" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessService" name="Graf aanvragen" id="id-dd3cb81e680059828143496df77fbbd1">
              <documentation>Een particulier graf, urnengraf of urnennis laten uitgeven, met het grafrecht daarop.</documentation>
              <property key="wiki-gemma-model id" value="graf-aanvragen" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2010-vng-model-beheersverordening-begraafplaatsen; 2026-vng-retributies" />
              <property key="wiki-gemma-model beschrijving" value="Wie een graf wil, dient een schriftelijke aanvraag in; het college verleent het recht voor een vaste termijn, voor zover er ruimte is, en de gemeente heft er lijkbezorgingsrechten voor (Groningen art. 16; VNG-model art. 15; VNG retributies). Het VNG-model beveelt aan aanvragen in te dienen bij de beheerder van de begraafplaats (toelichting 2)." />
              <property key="wiki-gemma-model synoniemen" value="Grafrecht aanvragen (beleid)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/graf-aanvragen.md" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model domein" value="Fysieke leefomgeving" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessService" name="Herbegraven of alsnog cremeren" id="id-e542a05685cb5e80afbb2f7dc79e4976">
              <documentation>Toestemming van de gemeente om een begraven stoffelijk overschot op te graven en elders te begraven of te cremeren.</documentation>
              <property key="wiki-gemma-model id" value="herbegraven-of-alsnog-cremeren" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen" />
              <property key="wiki-gemma-model beschrijving" value="Een stoffelijk overschot wordt alleen opgegraven met vergunning van de burgemeester van de gemeente waar het is begraven en, bij een particulier graf, met toestemming van de rechthebbende (Wet op de lijkbezorging art. 29 lid 1). Een opgegraven stoffelijk overschot mag worden gecremeerd op verzoek van de persoon uit art. 18 (art. 29 lid 3). De rechthebbende dient de aanvraag in bij de burgemeester (Groningen art. 28 lid 1)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/herbegraven-of-alsnog-cremeren.md" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model domein" value="Fysieke leefomgeving" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessService" name="Ontleding stoffelijk overschot toestemming" id="id-f214c09b96ed57f2a77e9ef9b591b0e6">
              <documentation>Toestemming van de gemeente om een stoffelijk overschot in het belang van de wetenschap of het wetenschappelijk onderwijs te laten ontleden.</documentation>
              <property key="wiki-gemma-model id" value="ontleding-stoffelijk-overschot-toestemming" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2026-rijk-wet-op-de-lijkbezorging-wettekst" />
              <property key="wiki-gemma-model beschrijving" value="Ontleding gebeurt alleen als de overledene of, bij gebreke daarvan, de nabestaanden het stoffelijk overschot daartoe hebben bestemd (Wet op de lijkbezorging art. 67), en met schriftelijk verlof van de burgemeester, dat binnen drie dagen kosteloos wordt afgegeven en de plaats van ontleding vermeldt (art. 68 lid 1). Bij een stoffelijk overschot uit het buitenland beslist de burgemeester uiterlijk op de derde dag na het binnenbrengen (Besluit op de lijkbezorging art. 17).&#10;&#10;De UPL noemt bedrijven als afnemer en geeft het product geen Iv3-taakveld (UPL)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/ontleding-stoffelijk-overschot-toestemming.md" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model domein" value="Fysieke leefomgeving" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessService" name="Uitvaart vervroegen of uitstellen" id="id-fd16f7c92e325b1181001c7f52db758e">
              <documentation>Toestemming van de gemeente om een overledene eerder dan 36 uur of later dan zes werkdagen na het overlijden te begraven of te cremeren.</documentation>
              <property key="wiki-gemma-model id" value="uitvaart-vervroegen-of-uitstellen" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rvo-aangifte-en-akte-van-overlijden; 2026-rijk-wet-op-de-lijkbezorging-wettekst" />
              <property key="wiki-gemma-model beschrijving" value="Begraven of cremeren mag niet eerder dan 36 uur en uiterlijk op de zesde werkdag na het overlijden (art. 16). Na een arts te hebben gehoord kan de burgemeester een andere termijn stellen; eerder dan 36 uur alleen in overeenstemming met de officier van justitie (art. 17). De uitvaartondernemer vraagt de vergunning namens de nabestaanden aan bij de gemeente waar de persoon is overleden, bijvoorbeeld om religieuze redenen of omdat familie uit het buitenland moet komen (Ondernemersplein)." />
              <property key="wiki-gemma-model synoniemen" value="Andere termijn (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/uitvaart-vervroegen-of-uitstellen.md" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model domein" value="Publieksdiensten" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
          </folder>
        </folder>
      </folder>
      <folder name="Gebeurtenissen" id="id-54ffca2a1c5c53ff8b9171266c105373">
        <folder name="0 Bestuur en Ondersteuning" id="id-54968b6563eb5230a228f740f35bec21">
          <folder name="Burgerzaken" id="id-b50cb16de11857f2a54cdf3a15e54fd6">
            <element xsi:type="archimate:BusinessEvent" name="Geboorte" id="id-25c72a3457ff5a7888c759d0365b5536">
              <documentation>Het levend ter wereld komen van een kind.</documentation>
              <property key="wiki-gemma-model id" value="geboorte" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-burgerlijk-wetboek-boek-1; 2026-rvig-hup-geboorte; 2026-utrecht-burgerzaken-geboorteaangifte-doen" />
              <property key="wiki-gemma-model beschrijving" value="Binnen drie dagen na de geboorte wordt aangifte gedaan in de gemeente van geboorte (BW 1 art. 19e). Een kind heeft juridisch altijd een moeder en hoogstens één andere ouder; het wordt in de BRP ingeschreven als de moeder ingezetene is, anders op aangifte van verblijf en adres (HUP Geboorte). Een kind dat levend is geboren maar vóór de aangifte overleed, krijgt een geboorteakte en een akte van overlijden (HUP Overlijden; Utrecht Levenloos geboren kind)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/gebeurtenissen/geboorte.md" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessEvent" name="Ontbinding huwelijk of partnerschap" id="id-40c424b59cb05da8bfc97f0c8a4259e5">
              <documentation>Het eindigen van een huwelijk door echtscheiding of van een geregistreerd partnerschap door beëindiging, anders dan door overlijden.</documentation>
              <property key="wiki-gemma-model id" value="ontbinding-huwelijk-of-partnerschap" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-utrecht-burgerzaken-scheiden-of-geregistreerd-partnerschap-beeindigen; 2026-rijk-burgerlijk-wetboek-boek-1" />
              <property key="wiki-gemma-model beschrijving" value="Scheiden gaat via de rechtbank met een advocaat; een geregistreerd partnerschap kan zonder rechter worden beëindigd met een verklaring van advocaten of notarissen, behalve bij minderjarige kinderen of onenigheid (BW 1 art. 80c; Utrecht). De advocaat of notaris stuurt de stukken naar de gemeente van de akte; de ontbinding geldt vanaf de inschrijving (Utrecht; BW 1 art. 163). Een huwelijk of partnerschap eindigt ook door overlijden; dat is de gebeurtenis Overlijden." />
              <property key="wiki-gemma-model synoniemen" value="Echtscheiding (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/gebeurtenissen/ontbinding-huwelijk-of-partnerschap.md" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessEvent" name="Verlies van het Nederlanderschap" id="id-68b64a5949d451b6b3aca3e716340fd5">
              <documentation>Het moment waarop een persoon het Nederlanderschap verliest, door afstand, een andere nationaliteit, verblijf in het buitenland of intrekking.</documentation>
              <property key="wiki-gemma-model id" value="verlies-van-het-nederlanderschap" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-rijkswet-op-het-nederlanderschap-bwbr0003738; 2026-utrecht-burgerzaken-nederlandse-nationaliteit-opgeven-of-verliezen; 2026-rvig-hup-nederlandse-nationaliteit; 2026-rijk-besluit-verkrijging-verlies-nederlanderschap-bwbr0013605; 2026-rvig-hup-nationaliteit; 2026-rijk-paspoortwet-bwbr0005212" />
              <property key="wiki-gemma-model beschrijving" value="Het Nederlanderschap gaat voor een meerderjarige verloren door het vrijwillig verkrijgen van een andere nationaliteit, door een verklaring van afstand, door dertien jaar hoofdverblijf buiten het Koninkrijk en de EU met ook een vreemde nationaliteit, of door intrekking door de minister; een minderjarige verliest het onder meer met zijn ouder (Rijkswet op het Nederlanderschap art. 14-16). Utrecht onderscheidt het opgeven, door een verklaring van afstand, van het verliezen zonder bewuste keuze.&#10;&#10;In de basisregistratie personen wordt de Nederlandse nationaliteit beëindigd en worden vreemde of onbekende nationaliteiten weer opgenomen; een Nederlands reisdocument vervalt van rechtswege en de burgemeester bevordert dat het wordt ingenomen (HUP Nederlandse nationaliteit; Paspoortwet art. 47 lid 1 onder a; Besluit verkrijging en verlies Nederlanderschap art. 64 lid 3)." />
              <property key="wiki-gemma-model synoniemen" value="Verlies Nederlanderschap (informatiemodel)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/gebeurtenissen/verlies-van-het-nederlanderschap.md" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessEvent" name="Uitsluiting van het kiesrecht" id="id-748f23acc02a5208b74179b565d05718">
              <documentation>Het moment waarop een persoon bij onherroepelijke rechterlijke uitspraak van het kiesrecht is uitgesloten.</documentation>
              <property key="wiki-gemma-model id" value="uitsluiting-van-het-kiesrecht" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-kieswet-bwbr0004627; 2026-rvig-hup-nederlands-kiesrecht" />
              <property key="wiki-gemma-model beschrijving" value="Een uitsluiting van het kiesrecht volgt altijd uit een onherroepelijke rechterlijke uitspraak, geldt voor bepaalde of onbepaalde tijd en voor alle verkiezingen, en kan Nederlanders en vreemdelingen treffen; ze wordt beoordeeld naar de toestand op de dag van de kandidaatstelling (Kieswet art. B 5 lid 1; HUP Nederlands kiesrecht). De minister van Justitie en Veiligheid doet mededeling aan de burgemeester van de woongemeente, die de persoon in kennis stelt (art. B 5 lid 2-3). Ook de lidstaat van nationaliteit kan een EU-onderdaan van het Europees kiesrecht uitsluiten (HUP Europees kiesrecht). De uitsluiting eindigt na een nieuwe mededeling of op de einddatum (HUP Nederlands kiesrecht)." />
              <property key="wiki-gemma-model synoniemen" value="Ontzetting uit het kiesrecht (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/gebeurtenissen/uitsluiting-van-het-kiesrecht.md" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessEvent" name="Adoptie" id="id-7629515efdb253b097ab571cb7d0c8ba">
              <documentation>Het door een uitspraak van de rechtbank ontstaan van de familierechtelijke betrekking tussen een kind en zijn adoptiefouders.</documentation>
              <property key="wiki-gemma-model id" value="adoptie" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-burgerlijk-wetboek-boek-1; 2026-rvig-hup-adoptie; 2026-utrecht-burgerzaken-adoptie-kind-inschrijven; 2026-rijk-besluit-burgerlijke-stand-1994-bwbr0006493; 2026-rijk-wet-brp-bwbr0033715" />
              <property key="wiki-gemma-model beschrijving" value="Adoptie geschiedt door een uitspraak van de rechtbank op verzoek van twee personen samen of één persoon alleen (BW 1 art. 227); een buitenlandse adoptie wordt erkend op grond van het Haags adoptieverdrag of een verklaring voor recht (HUP Adoptie). De adoptie zelf is geen gemeentelijk product; de gemeente verwerkt de uitspraak (Utrecht). Adoptiefouders krijgen het gezag van rechtswege; een herroeping van de adoptie wordt ook als latere vermelding verwerkt (HUP Adoptie; Besluit burgerlijke stand art. 53, 54)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/gebeurtenissen/adoptie.md" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessEvent" name="Vermissing van het reisdocument" id="id-932248a453e75b42a5261530c20def91">
              <documentation>Het moment waarop de houder niet meer over zijn reisdocument beschikt, doordat het kwijt of gestolen is.</documentation>
              <property key="wiki-gemma-model id" value="vermissing-van-het-reisdocument" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-paspoortwet-bwbr0005212; 2026-utrecht-burgerzaken-paspoort-of-identiteitskaart-vermissing-of-diefstal-doorgeven; 2026-rvig-hup-inhouding-inlevering-vermissing" />
              <property key="wiki-gemma-model beschrijving" value="Diefstal is een vorm van vermissing. Wie een reisdocument van een ander vindt, zorgt dat het bij een tot inhouding bevoegde autoriteit komt (Paspoortwet art. 5). Een ingenomen document is geen vermissing: wie een nieuw document aanvraagt, legt dan een verklaring van de innemende autoriteit over (art. 31 lid 2). Het formele begrip sluit de inname door een bevoegde autoriteit uit; de herkenbare definitie noemt alleen kwijt of gestolen, wat op hetzelfde neerkomt." />
              <property key="wiki-gemma-model synoniemen" value="Vermissing (wet); Diefstal (beleid)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/gebeurtenissen/vermissing-van-het-reisdocument.md" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessEvent" name="Naamswijziging" id="id-9b87103f0ebf50c49fc2626885f9b5bd">
              <documentation>Het wijzigen van de voornaam door de rechtbank of van de geslachtsnaam bij koninklijk besluit.</documentation>
              <property key="wiki-gemma-model id" value="naamswijziging" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rvig-hup-wijziging-voornaam; 2026-rvig-hup-naamswijziging-en-naamgebruik; 2026-utrecht-burgerzaken-voornaam-of-achternaam-veranderen; 2026-rijk-burgerlijk-wetboek-boek-1; 2026-rvig-hup-vaststelling-geslachtsnaam; 2026-rvig-hup-wijziging-geslachtsnaam; 2026-rijk-paspoortwet-bwbr0005212; 2026-rvig-hup-van-rechtswege-vervallen-reisdocument" />
              <property key="wiki-gemma-model beschrijving" value="Een voornaam laat men wijzigen bij de rechtbank, een achternaam via Justis bij koninklijk besluit; de gemeente beslist er niet over maar neemt de nieuwe naam op (BW 1 art. 4 lid 4, 7; Utrecht). Een geldig Nederlands reisdocument vervalt bij een naamswijziging van rechtswege (HUP Erkenning). Het naamgebruik is iets anders: de keuze welke achternaam de overheid gebruikt (BW 1 art. 9)." />
              <property key="wiki-gemma-model synoniemen" value="Wijziging van de geslachtsnaam (wet); Wijziging voornaam (HUP)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/gebeurtenissen/naamswijziging.md" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessEvent" name="Verkrijging van het Nederlanderschap" id="id-9da74645bb5f5d1ab4e153f125e6ca7e">
              <documentation>Het moment waarop een persoon Nederlander wordt, van rechtswege of door de uitreiking van de bevestiging van de optie of het naturalisatiebesluit.</documentation>
              <property key="wiki-gemma-model id" value="verkrijging-van-het-nederlanderschap" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-rijkswet-op-het-nederlanderschap-bwbr0003738; 2026-rvig-hup-nederlandse-nationaliteit; 2026-rijk-besluit-verkrijging-verlies-nederlanderschap-bwbr0013605; 2026-rvig-hup-vreemde-nationaliteit; 2026-rijk-paspoortwet-bwbr0005212; 2026-rvig-hup-verblijfstitel; 2026-rvig-hup-europees-kiesrecht" />
              <property key="wiki-gemma-model beschrijving" value="Het Nederlanderschap wordt verkregen van rechtswege, bij geboorte, erkenning of adoptie, of door optie of verlening (Rijkswet op het Nederlanderschap art. 3-7). Bij optie en naturalisatie treedt de verkrijging in werking door de uitreiking van de bevestiging of van het uittreksel van het besluit, en werkt terug tot de dagtekening (Besluit verkrijging en verlies Nederlanderschap art. 60a, 60b).&#10;&#10;In de basisregistratie personen wordt de Nederlandse nationaliteit opgenomen, met de datum van naturalisatie of optiebevestiging als ingangsdatum; de registratie van vreemde en onbekende nationaliteiten en van staatloosheid, de verblijfstitel en de aanduiding Europees kiesrecht worden beëindigd (HUP Nederlandse nationaliteit; HUP Vreemde nationaliteit; HUP Verblijfstitel; HUP Europees kiesrecht). Een reisdocument voor vluchtelingen of vreemdelingen vervalt van rechtswege (Paspoortwet art. 47 lid 1 onder b)." />
              <property key="wiki-gemma-model synoniemen" value="Verkrijging Nederlanderschap (informatiemodel)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/gebeurtenissen/verkrijging-van-het-nederlanderschap.md" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessEvent" name="Vaststelling ouderschap" id="id-a3c0ebd6ad045daa977cc241db75c445">
              <documentation>Het door een uitspraak van de rechtbank ontstaan van het juridisch ouderschap van een man of vrouw over een kind.</documentation>
              <property key="wiki-gemma-model id" value="vaststelling-ouderschap" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-burgerlijk-wetboek-boek-1; 2026-rvig-hup-vaststelling-ouderschap" />
              <property key="wiki-gemma-model beschrijving" value="De rechtbank stelt het ouderschap vast op verzoek van de moeder of het kind (BW 1 art. 207); de gemeente verwerkt de uitspraak (HUP Vaststelling ouderschap). Naast geboorte, erkenning, adoptie en ontkenning is het een van de gronden van de afstamming (HUP Afstamming)." />
              <property key="wiki-gemma-model synoniemen" value="Gerechtelijke vaststelling van het ouderschap (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/gebeurtenissen/vaststelling-ouderschap.md" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessEvent" name="Vermissing van het rijbewijs" id="id-cb3a7892d63c545c8f36252a29b39f86">
              <documentation>Het moment waarop de houder niet meer over zijn rijbewijs beschikt, doordat het kwijt of gestolen is.</documentation>
              <property key="wiki-gemma-model id" value="vermissing-van-het-rijbewijs" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wegenverkeerswet-1994-bwbr0006622; 2026-utrecht-burgerzaken-rijbewijs-aanvragen-of-verlengen" />
              <property key="wiki-gemma-model beschrijving" value="Diefstal of beroving is een vorm van vermissing; bij diefstal of beroving adviseert Utrecht ook aangifte bij de politie te doen, wat niet verplicht is maar nodig kan zijn voor de verzekering (Utrecht). Een rijbewijs dat bij identiteitsfraude of een datalek is betrokken, laat men op dezelfde manier ongeldig maken, ook als het niet kwijt is (Utrecht)." />
              <property key="wiki-gemma-model synoniemen" value="Aangifte van vermissing van het rijbewijs (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/gebeurtenissen/vermissing-van-het-rijbewijs.md" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessEvent" name="Verval van het reisdocument" id="id-dab60a0503595700baf444cabf85f7c7">
              <documentation>Het ongeldig worden van een reisdocument zonder besluit, onder meer door verlopen geldigheid, gewijzigde persoonsgegevens, overlijden of vermissing.</documentation>
              <property key="wiki-gemma-model id" value="verval-van-het-reisdocument" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-paspoortwet-bwbr0005212; 2026-rvig-hup-van-rechtswege-vervallen-reisdocument" />
              <property key="wiki-gemma-model beschrijving" value="Een reisdocument vervalt van rechtswege als de houder het Nederlanderschap verliest, de geldigheidsduur verstrijkt, de geslachtsnaam, voornamen, geboortedatum, het geslacht of het burgerservicenummer van de houder wijzigen, de houder overlijdt, het document is ingenomen, bij de aanvraag onjuiste gegevens zijn gebruikt of de houder het als vermist heeft gemeld (Paspoortwet art. 47 lid 1). Ook de intrekking van de verklaring van toestemming kan het document van rechtswege doen vervallen (art. 48).&#10;&#10;De bijhoudingsgemeente registreert het verval alleen als het document niet al is ingehouden, ingeleverd of als vermist gemeld, en schrijft de houder aan om het in te leveren; bij overlijden en vermissing komen de gegevens automatisch in het basisregister reisdocumenten (HUP Van rechtswege vervallen). Levert de houder het niet in, dan deelt de burgemeester dat mee aan de minister, die hem in het register paspoortsignaleringen kan vermelden (Paspoortwet art. 47 lid 2; Paspoortbesluit art. 6.1)." />
              <property key="wiki-gemma-model synoniemen" value="Van rechtswege vervallen (wet); Ongeldig worden (beleid)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/gebeurtenissen/verval-van-het-reisdocument.md" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessEvent" name="Ontkenning ouderschap" id="id-dc4e53ce86815a9fa57ef601e929fd90">
              <documentation>Het vervallen van het juridisch ouderschap van een ouder die niet de biologische ouder is, door een uitspraak of verklaring.</documentation>
              <property key="wiki-gemma-model id" value="ontkenning-ouderschap" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-burgerlijk-wetboek-boek-1; 2026-rijk-besluit-burgerlijke-stand-1994-bwbr0006493; 2026-rvig-hup-ontkenning-ouderschap" />
              <property key="wiki-gemma-model beschrijving" value="De vader, de moeder of het kind kan het ouderschap ontkennen op de grond dat de ouder niet de biologische ouder is (BW 1 art. 200); de moeder uit wie het kind is geboren kan in bepaalde gevallen zelf een verklaring afleggen bij de ambtenaar (HUP Ontkenning ouderschap). Ook de geslachtsnaam van het kind kan daardoor veranderen." />
              <property key="wiki-gemma-model synoniemen" value="Ontkenning van het vaderschap (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/gebeurtenissen/ontkenning-ouderschap.md" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessEvent" name="Levenloze geboorte" id="id-f02bbfa5ea1f508d8d7d0aca20bd0ecc">
              <documentation>Het ter wereld komen van een kind dat bij de geboorte niet leeft.</documentation>
              <property key="wiki-gemma-model id" value="levenloze-geboorte" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-burgerlijk-wetboek-boek-1; 2026-utrecht-burgerzaken-levenloos-geboren-kind-of-overleden-pasgeboren-kind-aangifte-doen; 2026-rvig-hup-geboorte" />
              <property key="wiki-gemma-model beschrijving" value="De akte wordt opgemaakt in het register van overlijden, met alleen een geslachtsnaam en voornamen als de ouders dat willen (BW 1 art. 19i; Besluit burgerlijke stand art. 66). Opname in de BRP gebeurt alleen op verzoek van een ouder (HUP Geboorte; Utrecht). Een levenloos geboren kind is ook een doodgeborene in de zin van de Wet op de lijkbezorging (art. 2)." />
              <property key="wiki-gemma-model synoniemen" value="Levenloos geboren kind (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/gebeurtenissen/levenloze-geboorte.md" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
          </folder>
        </folder>
        <element xsi:type="archimate:BusinessEvent" name="Besmet stoffelijk overschot gemeld" id="id-2fea955930dd520eba7426ee1cf72121">
          <documentation>De burgemeester heeft van de GGD de melding ontvangen dat een stoffelijk overschot besmet is met gevaar voor de volksgezondheid.</documentation>
          <property key="wiki-gemma-model id" value="besmet-stoffelijk-overschot-gemeld" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-publieke-gezondheid-wettekst; 2026-rijk-wet-op-de-lijkbezorging-wettekst" />
          <property key="wiki-gemma-model beschrijving" value="De arts die vaststelt dat een stoffelijk overschot besmet is met een infectieus of giftig agens of stof met ernstig gevaar voor de volksgezondheid, meldt dat onverwijld aan de GGD (Wet publieke gezondheid art. 21 lid 2); de GGD geeft de ontvangst onverwijld door aan de burgemeester van de gemeente waarin het stoffelijk overschot zich bevindt (art. 27 lid 3)." />
          <property key="wiki-gemma-model synoniemen" value="Melding besmet lijk (wet); Besmet lijk gemeld (wet)" />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/gebeurtenissen/besmet-stoffelijk-overschot-gemeld.md" />
        </element>
        <element xsi:type="archimate:BusinessEvent" name="Verhuizing" id="id-77c9804ccc645fc783720c33074f4a15">
          <documentation>Het gaan wonen van een persoon op een ander adres in Nederland.</documentation>
          <property key="wiki-gemma-model id" value="verhuizing" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2026-utrecht-burgerzaken-verhuizing-doorgeven; 2026-rvig-hup-binnengemeentelijke-adreswijziging; 2026-rvig-hup-intergemeentelijke-adreswijziging" />
          <property key="wiki-gemma-model beschrijving" value="Bij een verhuizing binnen of naar een gemeente doet de persoon aangifte van adreswijziging in de nieuwe gemeente (Utrecht Verhuizing doorgeven; HUP Intergemeentelijke adreswijziging)." />
          <property key="wiki-gemma-model synoniemen" value="Adreswijziging (wet)" />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/gebeurtenissen/verhuizing.md" />
        </element>
        <element xsi:type="archimate:BusinessEvent" name="Emigratie" id="id-a8bdaf61b10f560790e1081c07ff78e6">
          <documentation>Het vertrek van een ingezetene om ten minste acht maanden van een jaar in het buitenland te wonen.</documentation>
          <property key="wiki-gemma-model id" value="emigratie" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2026-utrecht-burgerzaken-emigratie-doorgeven; 2026-rvig-hup-emigratie" />
          <property key="wiki-gemma-model beschrijving" value="Wie in een jaar acht maanden of langer in het buitenland gaat wonen, emigreert; ook een verhuizing naar het Caribisch deel van het Koninkrijk geldt als emigratie (Utrecht Emigratie doorgeven; HUP Emigratie)." />
          <property key="wiki-gemma-model synoniemen" value="Vertrek naar het buitenland (wet)" />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/gebeurtenissen/emigratie.md" />
        </element>
        <element xsi:type="archimate:BusinessEvent" name="Verval van het grafrecht" id="id-e9b245662c175440ad0b5585bbbe18df">
          <documentation>Het einde van een grafrecht door verloop van de termijn, afstand, opheffing van de begraafplaats of vervallenverklaring.</documentation>
          <property key="wiki-gemma-model id" value="verval-van-het-grafrecht" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen" />
          <property key="wiki-gemma-model beschrijving" value="Een grafrecht vervalt door het verlopen van de termijn, door afstand of door opheffing van de begraafplaats; het college kan het vervallen verklaren bij niet-betalen, verzuim of als het na overlijden van de rechthebbende niet wordt overgeschreven, en het recht vervalt na een niet opgevolgde verklaring van verwaarlozing (Groningen art. 20; art. 28 lid 6). Daarna kunnen de grafbedekking worden verwijderd en het graf worden geruimd (Groningen art. 20 lid 4, 26)." />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/gebeurtenissen/verval-van-het-grafrecht.md" />
        </element>
        <element xsi:type="archimate:BusinessEvent" name="Overlijden" id="id-edb09f226d2b51f7a95e3dc16d5cb699">
          <documentation>Het sterven van een persoon.</documentation>
          <property key="wiki-gemma-model id" value="overlijden" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-rvo-aangifte-en-akte-van-overlijden; 2026-rijk-burgerlijk-wetboek-boek-1; 2026-rvig-hup-overlijden-nederland; 2026-utrecht-burgerzaken-overlijden-aangifte-doen; 2026-rijk-paspoortwet-bwbr0005212; 2026-rvig-hup-van-rechtswege-vervallen-reisdocument" />
          <property key="wiki-gemma-model beschrijving" value="Het overlijden van een persoon wordt aangegeven bij de gemeente waar de persoon is overleden; voor de aangifte is een verklaring van overlijden nodig (Ondernemersplein)." />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/gebeurtenissen/overlijden.md" />
        </element>
        <element xsi:type="archimate:BusinessEvent" name="Vestiging vanuit het buitenland" id="id-ff55aaa5317851d7a3aab994579773c2">
          <documentation>Het gaan wonen in een Nederlandse gemeente van een persoon die in het buitenland woonde.</documentation>
          <property key="wiki-gemma-model id" value="vestiging-vanuit-het-buitenland" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2023-rvig-circulaire-adresonderzoek-brp; 2026-utrecht-burgerzaken-inschrijven-vanuit-het-buitenland; 2026-rvig-hup-immigratie; 2026-rvig-hup-hervestiging" />
          <property key="wiki-gemma-model beschrijving" value="Wie vanuit het buitenland in een gemeente komt wonen, of het komende half jaar ten minste vier maanden, schrijft zich binnen vijf dagen in (Utrecht Inschrijven vanuit het buitenland). Stond de persoon nooit in de BRP of RNI, dan is het een immigratie (eerste inschrijving); stond hij in de RNI, dan een hervestiging (HUP Immigratie; HUP Hervestiging)." />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/gebeurtenissen/vestiging-vanuit-het-buitenland.md" />
        </element>
      </folder>
