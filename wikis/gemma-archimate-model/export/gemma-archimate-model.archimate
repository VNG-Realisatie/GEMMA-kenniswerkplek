        </element>
        <element xsi:type="archimate:BusinessActor" name="College van B&amp;W" id="id-af1a85d2-b6d6-44da-b562-ef2ccd69108e">
          <documentation>Dagelijks bestuur van de gemeente, bestaande uit de burgemeester en de wethouders.</documentation>
          <property key="Object ID" value="af1a85d2-b6d6-44da-b562-ef2ccd69108e" />
          <property key="wiki-gemma-model id" value="college-van-b-w" />
          <property key="wiki-gemma-model herkomst" value="gekoppeld" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model GEMMA-match" value="exact" />
          <property key="wiki-gemma-model bronnen" value="2024-rijk-gemeentewet-wettekst; 2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen" />
          <property key="wiki-gemma-model beschrijving" value="Het college bestaat uit de burgemeester, die voorzitter is, en de wethouders (Gemeentewet art. 34). Het voert het dagelijks bestuur van de gemeente, voor zover de wet dat niet aan de raad of de burgemeester opdraagt (art. 160)." />
          <property key="wiki-gemma-model synoniemen" value="Burgemeester en wethouders (wet); College (GEMMA)" />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/actoren/college-van-b-w.md" />
          <property key="wiki-gemma-model doelgroep" value="gemeente" />
          <property key="wiki-gemma-model vorige naam" value="College" />
        </element>
        <element xsi:type="archimate:BusinessActor" name="Gemeenteraad" id="id-b69cb101-8708-47de-9ac1-e138f205a49f">
          <documentation>Bestuursorgaan van de gemeente dat de gehele bevolking vertegenwoordigt en de gemeentelijke verordeningen vaststelt.</documentation>
          <property key="Object ID" value="b69cb101-8708-47de-9ac1-e138f205a49f" />
          <property key="wiki-gemma-model id" value="gemeenteraad" />
          <property key="wiki-gemma-model herkomst" value="gekoppeld" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model GEMMA-match" value="exact" />
          <property key="wiki-gemma-model bronnen" value="2024-rijk-gemeentewet-wettekst; 2026-rijk-wet-op-de-lijkbezorging-wettekst" />
          <property key="wiki-gemma-model beschrijving" value="De raad vertegenwoordigt de gehele bevolking van de gemeente (Gemeentewet art. 7). Hij stelt de gemeentelijke verordeningen vast, voor zover die bevoegdheid niet bij het college of de burgemeester ligt (art. 147, 149), en benoemt de wethouders (art. 35). De burgemeester is voorzitter van de raad (art. 9)." />
          <property key="wiki-gemma-model synoniemen" value="Raad (wet)" />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/actoren/gemeenteraad.md" />
          <property key="wiki-gemma-model doelgroep" value="gemeente" />
        </element>
        <element xsi:type="archimate:BusinessRole" name="Ketenpartner" id="id-e03a0402-1890-4a21-8143-c44a8ba53ea4">
          <documentation>Verantwoordelijkheid van een andere organisatie voor haar deel van een ketenproces dat zij met de gemeente uitvoert.</documentation>
          <property key="Object ID" value="e03a0402-1890-4a21-8143-c44a8ba53ea4" />
          <property key="wiki-gemma-model id" value="ketenpartner" />
          <property key="wiki-gemma-model herkomst" value="gekoppeld" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model GEMMA-match" value="exact" />
          <property key="wiki-gemma-model bronnen" value="2026-vng-gemma-2026-10-02; 2026-rijk-wet-op-de-lijkbezorging-wettekst" />
          <property key="wiki-gemma-model beschrijving" value="Een ketenpartner is een andere organisatie die een eigen deel van een ketenproces uitvoert, vanuit een eigen wettelijke taak, en niet als klant of alleen als adviseur. GEMMA kent de rol Ketenpartner in de procesarchitectuur en de doelgroep Ketenpartners." />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/ketenpartner.md" />
          <property key="wiki-gemma-model doelgroep" value="ketenpartners" />
        </element>
        <element xsi:type="archimate:BusinessRole" name="Adviseur" id="id-f3219a6a-532f-482d-897c-dafe0dc70bb0">
          <documentation>Verantwoordelijkheid voor het geven van advies aan wie een besluit neemt.</documentation>
          <property key="Object ID" value="f3219a6a-532f-482d-897c-dafe0dc70bb0" />
          <property key="wiki-gemma-model id" value="adviseur" />
          <property key="wiki-gemma-model herkomst" value="gekoppeld" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model GEMMA-match" value="sterk" />
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-rijk-wet-publieke-gezondheid-wettekst" />
          <property key="wiki-gemma-model beschrijving" value="Een adviseur geeft een bestuursorgaan vooraf advies over een besluit. De wet bepaalt wanneer advies nodig is, bijvoorbeeld het advies van de GGD aan de burgemeester bij een besmet stoffelijk overschot (Wet op de lijkbezorging art. 22a) of aan het college bij besluiten met belangrijke gevolgen voor de publieke gezondheid (Wet publieke gezondheid art. 16)." />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/adviseur.md" />
          <property key="wiki-gemma-model doelgroep" value="ketenpartners" />
        </element>
      </folder>
      <folder name="Processenlandschap" id="0934a45e-4ff5-4480-b259-f6cb68c58af3">
        <element xsi:type="archimate:BusinessProcess" name="Onderhouden" id="id-1a739ba4-08d4-4b65-84d8-4ea89499b4ca">
          <documentation>Het planmatig (preventief) onderhouden van de openbare ruimte, zoals het maaien van bermen, het onderhoud van plantsoenen, schilderen van gemeente-eigendommen en gebouwen.</documentation>
          <property key="GEMMA type" value="Bedrijfsproces" />
          <property key="Object ID" value="1a739ba4-08d4-4b65-84d8-4ea89499b4ca" />
        </element>
        <element xsi:type="archimate:BusinessProcess" name="Behandelen aanvraag product" id="id-49fe8555-b001-4c86-9a81-20491e16af75">
          <documentation>Het afhandelen van aanvragen voor producten of diensten die min of meer "gereed op de plank" liggen. Hooguit worden deze producten nog gepersonifieerd. Deze producten zijn vaak "klaar terwijl u wacht"; ze kunnen direct worden meegenomen mits aan enkele direct toetsbare eisen wordt voldaan (uittreksel GBA, ja/nee sticker, ..) maar ook een rijbewijs of paspoort valt hieronder.</documentation>
          <property key="GEMMA type" value="Bedrijfsproces" />
          <property key="Object ID" value="49fe8555-b001-4c86-9a81-20491e16af75" />
        </element>
        <element xsi:type="archimate:BusinessProcess" name="Behandelen melding" id="id-729e05ea-f9f7-4583-a645-ec4e573b74ce">
          <documentation>Het in ontvangst nemen en afhandelen van een medeling en het resultaat hiervan terugkoppelen naar de melder. Bij een melding meldt men klant iets aan de gemeente en verwacht men dat de gemeente daar actie op onderneemt. Voorbeelden zijn een melding openbare ruimte, een melding omtrent overbewoning of een melding met betrekking tot het niet naleven van de leerplichtwet. Dit zijn andersoortige meldingen dan die bedoeld onder behandelen aangiften en meldingen om twee redenen: deze meldingen hebben betrekking op een al dan niet door de gemeente geleverde dienst (bv. beheren openbare ruimte) en het palet aan acties/antwoorden is diverser dan bij aangiften en meldingen, waar het vrijwel altijd het bijwerken van een registratie is.</documentation>
          <property key="GEMMA type" value="Bedrijfsproces" />
          <property key="Object ID" value="729e05ea-f9f7-4583-a645-ec4e573b74ce" />
        </element>
        <element xsi:type="archimate:BusinessProcess" name="Behandelen aanvraag vergunning of ontheffing" id="id-85fdb525-85a2-40d0-b90c-f4cfd4306ef7">
          <documentation>Het behandelen van een verzoek van een klant om toestemming voor activiteiten die te boek staat als vergunning/ontheffing-plichtig.</documentation>
          <property key="GEMMA type" value="Bedrijfsproces" />
          <property key="Object ID" value="85fdb525-85a2-40d0-b90c-f4cfd4306ef7" />
        </element>
        <element xsi:type="archimate:BusinessProcess" name="Uitbaten gemeentelijke voorzieningen" id="id-de88d348-dcce-4b8a-a3f6-cac6351a8311">
          <documentation>Het openhouden van gemeentelijke voorzieningen zoals sportvelden, musea, parkeergarages, wijkcentra en consultatiebureaus en het ter beschikking stellen van de daaraan gerelateerde middelen zoals ruimtes of dranghekken, bijvoorbeeld voor een zelfhulpgroep of een buurtfeest ten behoeve van het versterken van de sociale cohesie. Ook het tegen een vergoeding ter beschikking stellen van ruimte voor bijvoorbeeld de bibliotheek valt hieronder vanwege het maatschappelijke karakter.</documentation>
          <property key="GEMMA type" value="Bedrijfsproces" />
          <property key="Object ID" value="de88d348-dcce-4b8a-a3f6-cac6351a8311" />
        </element>
      </folder>
    </folder>
    <folder name="wiki-gemma-model" id="id-3ef5a0169d2f54359b09a230fc0db425">
      <folder name="Actoren" id="id-c5aa4922a2be5a13b9e6861a2532c407">
        <element xsi:type="archimate:BusinessActor" name="Kerkgenootschap" id="id-1258be4e5c78553ebdec35fc7b592d1f">
          <documentation>Kerkelijke gemeenschap, met inbegrip van haar zelfstandige onderdelen en de lichamen waarin kerkgenootschappen zijn verenigd.</documentation>
          <property key="wiki-gemma-model id" value="kerkgenootschap" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2026-rijk-bw2-rechtspersonen; 2026-rijk-wet-op-de-lijkbezorging-wettekst" />
          <property key="wiki-gemma-model beschrijving" value="Kerkgenootschappen, hun zelfstandige onderdelen en de lichamen waarin zij zijn verenigd, hebben rechtspersoonlijkheid en worden geregeerd door hun eigen statuut, voor zover dat niet in strijd is met de wet (BW Boek 2 art. 2)." />
          <property key="wiki-gemma-model synoniemen" value="Gezindte (beleid)" />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/actoren/kerkgenootschap.md" />
          <property key="wiki-gemma-model doelgroep" value="ketenpartners" />
        </element>
        <element xsi:type="archimate:BusinessActor" name="GGD" id="id-15f549fec72f5677a16d1f4867dba8ed">
          <documentation>Gezondheidsdienst die de colleges van de gemeenten in een regio via een gemeenschappelijke regeling instellen en in stand houden voor de publieke gezondheid.</documentation>
          <property key="wiki-gemma-model id" value="ggd" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-publieke-gezondheid-wettekst; 2026-rijk-wet-op-de-lijkbezorging-wettekst" />
          <property key="wiki-gemma-model beschrijving" value="De colleges van burgemeester en wethouders van de gemeenten in een regio stellen de gemeentelijke gezondheidsdienst via een gemeenschappelijke regeling in en houden haar in stand (Wet publieke gezondheid art. 14 lid 1); de regeling stelt een openbaar lichaam in, zodat de GGD eigen rechtspersoonlijkheid heeft (art. 14 lid 2). De gemeenten zijn zo mede-eigenaar en opdrachtgever. De GGD staat onder leiding van een directeur publieke gezondheid (art. 14 lid 3)." />
          <property key="wiki-gemma-model synoniemen" value="Gemeentelijke gezondheidsdienst (wet)" />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/actoren/ggd.md" />
          <property key="wiki-gemma-model doelgroep" value="ketenpartners" />
        </element>
        <element xsi:type="archimate:BusinessActor" name="Uitvaartondernemer" id="id-1637928fd4755f61899e995a10b0b2a2">
          <documentation>Onderneming die in opdracht van nabestaanden de uitvaart verzorgt.</documentation>
          <property key="wiki-gemma-model id" value="uitvaartondernemer" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2010-vng-model-beheersverordening-begraafplaatsen; 2026-rvo-aangifte-en-akte-van-overlijden; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen" />
          <property key="wiki-gemma-model beschrijving" value="De uitvaartondernemer doet voor de nabestaanden aangifte van overlijden bij de gemeente waar de persoon is overleden, en krijgt van de gemeente de akte van overlijden en het verlof tot begraven of cremeren; voor het vervroegen of uitstellen van de uitvaart vraagt hij een vergunning aan (Ondernemersplein). De beheerder bepaalt tijd en plaats van een begraving in overleg met de uitvaartondernemer; personeel van uitvaartondernemingen volgt op de begraafplaats de aanwijzingen van de beheerder (Groningen art. 5, 7; VNG-model art. 4)." />
          <property key="wiki-gemma-model synoniemen" value="Uitvaartonderneming (beleid)" />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/actoren/uitvaartondernemer.md" />
          <property key="wiki-gemma-model doelgroep" value="inwoners en ondernemers" />
        </element>
        <element xsi:type="archimate:BusinessActor" name="Arts" id="id-22b4e0e7131557c791031332c5111c55">
          <documentation>Persoon die als arts mensen medisch onderzoekt en behandelt.</documentation>
          <property key="wiki-gemma-model id" value="arts" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-rvo-aangifte-en-akte-van-overlijden" />
          <property key="wiki-gemma-model beschrijving" value="Lijkschouwing gebeurt door de behandelende arts of door een gemeentelijke lijkschouwer (Wet op de lijkbezorging art. 3). Behandelend is de hoedanigheid: de arts die de overledene voor het overlijden behandelde. Is die ervan overtuigd dat de dood een natuurlijke oorzaak heeft, dan geeft hij een verklaring van overlijden af (art. 7). De nabestaanden hebben die nodig voor de aangifte (RVO), en zonder die verklaring verleent de ambtenaar van de burgerlijke stand geen verlof tot begraving of crematie (art. 12).&#10;&#10;Kan de behandelende arts geen verklaring afgeven, of gaat het om euthanasie of hulp bij zelfdoding, dan doet hij met een formulier mededeling aan de gemeentelijke lijkschouwer (art. 7 lid 2 en 6). Bij een overleden minderjarige geeft hij de verklaring pas af na overleg met de gemeentelijke lijkschouwer, en geeft hij die op verzoek de informatie voor een nader onderzoek naar de doodsoorzaak (art. 10a).&#10;&#10;Het college benoemt een of meer gemeentelijke lijkschouwers, uitsluitend artsen die als forensisch arts zijn ingeschreven (art. 4, 5). De medische behandeling zelf blijft buiten het model: die is de interne zaak van de arts als ketenpartner." />
          <property key="wiki-gemma-model synoniemen" value="Behandelende arts (wet)" />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/actoren/arts.md" />
          <property key="wiki-gemma-model doelgroep" value="ketenpartners" />
        </element>
        <element xsi:type="archimate:BusinessActor" name="Gemeente" id="id-62d468135540549c9c9e83c9551de3c9">
          <documentation>Een gemeente als rechtspersoon, met een raad, een college van burgemeester en wethouders en een burgemeester.</documentation>
          <property key="wiki-gemma-model id" value="gemeente" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2024-rijk-gemeentewet-wettekst; 2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-rijk-bw2-rechtspersonen; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen" />
          <property key="wiki-gemma-model beschrijving" value="De actor Gemeente staat voor een gemeente als rechtspersoon (BW Boek 2 art. 1), met een raad, een college van burgemeester en wethouders en een burgemeester als organen (Gemeentewet art. 6). Het is een soort partij: elke gemeente, niet een afzonderlijke gemeente zoals Amsterdam of Utrecht.&#10;&#10;Wat een gemeente moet of mag doen, zijn verantwoordelijkheden. Die staan in het model als rollen die de gemeente vervult, zoals houder van een begraafplaats of kostendrager; de actor is de partij die ze vervult. Het GGM en GEMMA kennen daarnaast het bedrijfsobject Gemeente als gedeelte van het grondgebied; dat is een ander begrip." />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/actoren/gemeente.md" />
          <property key="wiki-gemma-model doelgroep" value="gemeente" />
        </element>
        <element xsi:type="archimate:BusinessActor" name="Burgemeester" id="id-ab1fb457a4585841b98353e315234233">
          <documentation>Bestuursorgaan van de gemeente, voorzitter van gemeenteraad en college, benoemd bij koninklijk besluit.</documentation>
          <property key="wiki-gemma-model id" value="burgemeester" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2024-rijk-gemeentewet-wettekst; 2026-rijk-wet-op-de-lijkbezorging-wettekst" />
          <property key="wiki-gemma-model beschrijving" value="De burgemeester wordt bij koninklijk besluit benoemd voor zes jaar (Gemeentewet art. 61) en is voorzitter van de raad en van het college (art. 9, 34). De burgemeester vertegenwoordigt de gemeente in en buiten rechte (art. 171)." />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/actoren/burgemeester.md" />
          <property key="wiki-gemma-model doelgroep" value="gemeente" />
        </element>
        <element xsi:type="archimate:BusinessActor" name="Officier van justitie" id="id-f5e980fae70a582382175a86c6a6ab48">
          <documentation>Lid van het openbaar ministerie dat beslist over strafrechtelijk onderzoek, ook naar een niet-natuurlijke dood.</documentation>
          <property key="wiki-gemma-model id" value="officier-van-justitie" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-rvo-aangifte-en-akte-van-overlijden" />
          <property key="wiki-gemma-model beschrijving" value="Bij een niet-natuurlijke dood brengt de gemeentelijke lijkschouwer verslag uit aan de officier van justitie, die een verklaring van geen bezwaar tegen begraving of crematie afgeeft als er geen strafrechtelijk onderzoek nodig is (Wet op de lijkbezorging art. 10, 12). Zonder die verklaring verleent de ambtenaar van de burgerlijke stand geen verlof. Een uitvaart binnen 36 uur vraagt ook zijn instemming (art. 17; RVO)." />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/actoren/officier-van-justitie.md" />
          <property key="wiki-gemma-model doelgroep" value="ketenpartners" />
        </element>
      </folder>
      <folder name="Bedrijfsobjecten" id="id-6f52878c0f9852ed9500f17e04fe4102">
        <folder name="0 Bestuur en Ondersteuning" id="id-e3735d6154f25f1d8f3696dbe45aa590">
          <folder name="Besluitvorming" id="id-1bcc7b0b932156468cfe63ef37acbb30">
            <element xsi:type="archimate:BusinessObject" name="Vergunning" id="id-268057e5fe5b546fbc837693094bd785">
              <documentation>Beschikking waarmee een bestuursorgaan toestemming geeft voor een handeling die zonder die toestemming niet mag.</documentation>
              <property key="wiki-gemma-model id" value="vergunning" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2026-rvo-aangifte-en-akte-van-overlijden; 2026-rijk-algemene-wet-bestuursrecht-wettekst" />
              <property key="wiki-gemma-model beschrijving" value="Een vergunning is een beschikking (Awb art. 1:3 lid 2) waarmee een bestuursorgaan toestemming geeft voor een handeling die zonder die toestemming niet mag. Wetten noemen zo'n toestemming ook verlof, ontheffing of toestemming." />
              <property key="wiki-gemma-model synoniemen" value="Verlof (wet); Toestemming (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsobjecten/0-bestuur-en-ondersteuning/besluitvorming/vergunning.md" />
              <property key="wiki-gemma-model objectniveau" value="generiek" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Besluitvorming" />
            </element>
          </folder>
        </folder>
        <folder name="7 Volksgezondheid en Milieu" id="id-1c44d463fe60558cb6e92dc274189bf3">
          <folder name="Begraafplaatsen en crematoria" id="id-f19ab3ba794158a3bfd4c5d51b53ce5a">
            <element xsi:type="archimate:BusinessObject" name="Graf" id="id-0c4079e5f4ac5b43b4ff3c59b6ce6ae8">
              <documentation>Plaats op een begraafplaats waarin stoffelijke overschotten worden begraven of urnen worden bijgezet.</documentation>
              <property key="wiki-gemma-model id" value="graf" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2010-vng-model-beheersverordening-begraafplaatsen" />
              <property key="wiki-gemma-model beschrijving" value="Een graf ligt op een begraafplaats en bestaat uit een of meer grafruimtes (Groningen art. 1 h, k); het is een zandgraf of keldergraf (VNG-model art. 1 b). De wet onderscheidt het algemeen graf, waarin de houder van de begraafplaats bepaalt wie er begraven wordt, en het particulier graf, waarop een grafrecht rust (art. 23 lid 2). Gemeenten delen graven verder in naar doelgroep, inhoud en termijn; die grafsoorten zijn specialisaties zonder eigen pagina. De houder houdt een openbaar register van de begraven stoffelijke overschotten met hun plaats (art. 27; Groningen art. 30); dat register is de vorm waarin de gegevens van graven worden bijgehouden en krijgt geen eigen pagina. Graven van historische betekenis staan op een lijst; over het ruimen daarvan beslist de raad (VNG-model art. 26)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsobjecten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/graf.md" />
              <property key="wiki-gemma-model objectniveau" value="kernobject" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessObject" name="Urn" id="id-335b3517a93f5205a1825c67c87cb60e">
              <documentation>Houder waarin de as van een overledene wordt geborgen en wordt bewaard, bijgezet of verstrooid.</documentation>
              <property key="wiki-gemma-model id" value="urn" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2026-vng-retributies" />
              <property key="wiki-gemma-model beschrijving" value="Na de crematie wordt de as geborgen in een of meer gesloten asbussen met naam en nummer (art. 58). De asbus wordt bijgezet in een graf, urnengraf, urnennis of bewaarplaats, verstrooid, aan de nabestaande meegegeven of naar het buitenland gezonden (art. 59, 62). Een sierurn is een voorwerp ter berging van een of meer asbussen (Groningen art. 1 x); in het gangbare gebruik heet het geheel urn (VNG retributies). De as zelf is de inhoud van de urn, geen eigen element." />
              <property key="wiki-gemma-model synoniemen" value="Asbus (wet); Sierurn (beleid)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsobjecten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/urn.md" />
              <property key="wiki-gemma-model objectniveau" value="subobject" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessObject" name="Begraafplaats" id="id-4ecb72536f3755cea1b5d6611a1aa65e">
              <documentation>Terrein waar stoffelijke overschotten worden begraven en urnen worden bijgezet, aangelegd en in stand gehouden door een houder.</documentation>
              <property key="wiki-gemma-model id" value="begraafplaats" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2026-vng-wet-op-de-lijkbezorging" />
              <property key="wiki-gemma-model beschrijving" value="Elke gemeente heeft ten minste één gemeentelijke begraafplaats, voor zich of samen met andere gemeenten (art. 33). Daarnaast bestaan bijzondere begraafplaatsen van een kerkgenootschap, rechtspersoon of natuurlijk persoon (art. 24, 37). De gemeente beslist over grond voor en ingebruikname van bijzondere begraafplaatsen en kan begraafplaatsen sluiten (art. 40, 41, 43, 44). Op de begraafplaats liggen graven, urnenmuren en verstrooiingsplaatsen (Groningen art. 1). Een begraafplaats is een fysieke plaats, maar wordt hier als gemeentelijke voorziening beschreven (besluit redacteur 2026-09-30)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsobjecten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/begraafplaats.md" />
              <property key="wiki-gemma-model objectniveau" value="kernobject" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessObject" name="Grafbedekking" id="id-60c80a79d05150f38339b75b4e76f46b">
              <documentation>Gedenkteken en grafbeplanting op een graf, gedenkplaats of verstrooiingsplaats.</documentation>
              <property key="wiki-gemma-model id" value="grafbedekking" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2010-vng-model-beheersverordening-begraafplaatsen" />
              <property key="wiki-gemma-model beschrijving" value="Voor een grafbedekking is een vergunning van het college nodig, die de rechthebbende aanvraagt (Groningen art. 22; VNG-model art. 19). De rechthebbende onderhoudt haar, of laat dat tegen betaling door de gemeente doen (art. 23, 24). Na afloop van de termijn van het graf kan het college de grafbedekking verwijderen; ze vervalt dan aan de gemeente (art. 26). Zolang het graf niet geruimd mag worden, is wat erop geplaatst is eigendom van de rechthebbende (Wet op de lijkbezorging art. 32a)." />
              <property key="wiki-gemma-model synoniemen" value="Gedenkteken (beleid); Grafmonument (beleid)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsobjecten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/grafbedekking.md" />
              <property key="wiki-gemma-model objectniveau" value="subobject" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessObject" name="Stoffelijk overschot" id="id-a2c7cb8f384257778067e70f75d4f2c8">
              <documentation>Het lichaam van een overledene of doodgeborene.</documentation>
              <property key="wiki-gemma-model id" value="stoffelijk-overschot" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst" />
              <property key="wiki-gemma-model beschrijving" value="Het stoffelijk overschot wordt geschouwd, begraven, gecremeerd of ontleed, en soms opgegraven (art. 1, 3, 29). Bij een begraving of crematie stelt de houder de identiteit vast aan de hand van het nummer op kist en document (art. 8). Een doodgeborene (na ten minste 24 weken zwangerschap) valt ook onder het begrip lijk (wet) en daarmee onder stoffelijk overschot; dat is een indeling, geen eigen element (art. 2 lid 1 b)." />
              <property key="wiki-gemma-model synoniemen" value="Lijk (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsobjecten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/stoffelijk-overschot.md" />
              <property key="wiki-gemma-model objectniveau" value="kernobject" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessObject" name="Crematorium" id="id-b1adea73dd0d54d490565e755aefcc6a">
              <documentation>Inrichting waar stoffelijke overschotten worden gecremeerd en de as wordt geborgen.</documentation>
              <property key="wiki-gemma-model id" value="crematorium" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst" />
              <property key="wiki-gemma-model beschrijving" value="Crematoria zijn gemeentelijk of bijzonder (art. 51). Een bijzonder crematorium wordt gevestigd door een kerkgenootschap, rechtspersoon of natuurlijk persoon, met een vergunning van burgemeester en wethouders (art. 52, 53). De houder bergt de as, zorgt voor de bestemming ervan en houdt een openbaar register (art. 50, 58, 59)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsobjecten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/crematorium.md" />
              <property key="wiki-gemma-model objectniveau" value="kernobject" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:Contract" name="Grafrecht" id="id-f1059419577a5403a5d95aa332436032">
              <documentation>Uitsluitend recht om in een particulier graf stoffelijke overschotten te laten begraven of urnen te laten bijzetten, voor bepaalde of onbepaalde tijd.</documentation>
              <property key="wiki-gemma-model id" value="grafrecht" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2010-vng-model-beheersverordening-begraafplaatsen; 2026-vng-retributies" />
              <property key="wiki-gemma-model beschrijving" value="Het grafrecht wordt schriftelijk gevestigd, voor onbepaalde tijd of voor ten minste tien jaar, en op verzoek verlengd (art. 28). De gemeente verleent het op aanvraag, voor 30 jaar bij een particulier graf of 5 tot 30 jaar bij een urnengraf (Groningen art. 16). Het recht kan worden overgeschreven (Groningen art. 18; VNG-model art. 17), de rechthebbende kan er afstand van doen (art. 19), en het vervalt door verloop van de termijn of wordt vervallen verklaard, bijvoorbeeld bij verwaarlozing of niet-betalen (art. 28 lid 4–6; Groningen art. 20). Verlenging, overschrijving en afstand zijn stappen in de levenscyclus van het grafrecht, geen eigen elementen.&#10;&#10;Het grafrecht is een afspraak (besluit redacteur 2026-09-30): het legt de rechten en plichten van houder en rechthebbende vast, ook als de gemeente het in de vorm van een besluit op aanvraag verleent. De toelichting op het VNG-model noemt het een beschikking van het college (toelichting art. 17); die tegenspraak is met het besluit afgewogen." />
              <property key="wiki-gemma-model synoniemen" value="Uitsluitend recht op een graf (wet); Recht op een particulier graf (beleid); Uitsluitend recht tot begraven (beleid)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsobjecten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/grafrecht.md" />
              <property key="wiki-gemma-model objectniveau" value="kernobject" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
          </folder>
        </folder>
      </folder>
      <folder name="Diensten" id="id-872b531894df54a999b59e47435b8de0">
        <folder name="7 Volksgezondheid en Milieu" id="id-12f5c027dc2c55ed9418808b270a4182">
          <folder name="Begraafplaatsen en crematoria" id="id-09eba3199df458099a0dcbf0fcd2c658">
            <element xsi:type="archimate:BusinessService" name="Bijzettingenregister" id="id-0d5ef53ae1e2582497bed7d3cf463923">
              <documentation>Inzage in het openbare register van alle daar bijgezette asbussen dat de houder van een plaats van bijzetting bijhoudt.</documentation>
              <property key="wiki-gemma-model id" value="bijzettingenregister" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-vng-gemma-2026-10-02" />
              <property key="wiki-gemma-model beschrijving" value="De houder van een plaats van bijzetting houdt een register bij van alle daar bijgezette asbussen; het register is openbaar en gaat bij opheffing naar het archief van de gemeente waar de plaats lag (Wet op de lijkbezorging art. 65). Is de gemeente houder, dan biedt zij de inzage aan. Het register zelf is een representatie, zonder pagina; de inhoud staat in het Besluit op de lijkbezorging (art. 10).&#10;&#10;De UPL noemt alleen bedrijven als afnemer en rekent het product tot de Dienstenwet (UPL)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/bijzettingenregister.md" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model domein" value="Fysieke leefomgeving" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessService" name="Grafonderhoud" id="id-1d72274738755c51ba065825f7a8f293">
              <documentation>Onderhoud van grafmonumenten en grafbeplanting door de gemeente, tegen betaling door de rechthebbende.</documentation>
              <property key="wiki-gemma-model id" value="grafonderhoud" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2026-vng-retributies" />
              <property key="wiki-gemma-model beschrijving" value="Op verzoek van de rechthebbende, of op sommige begraafplaatsen altijd, onderhoudt de gemeente de grafbedekking tegen betaling van een recht uit de heffingsverordening (Groningen art. 23, 24; VNG retributies). Een retributie is een tegenprestatie voor zo'n dienst (VNG retributies)." />
              <property key="wiki-gemma-model synoniemen" value="Onderhoud van graven (beleid)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/grafonderhoud.md" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model domein" value="Fysieke leefomgeving" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessService" name="Begraafplaatsregister" id="id-305a37f587655b18aea37ebb9d56ad7b">
              <documentation>Inzage in het openbare register van de stoffelijke overschotten die op een begraafplaats zijn begraven, met de plaats van het graf.</documentation>
              <property key="wiki-gemma-model id" value="begraafplaatsregister" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-vng-gemma-2026-10-02" />
              <property key="wiki-gemma-model beschrijving" value="De houder van een begraafplaats houdt een register bij van alle daar begraven stoffelijke overschotten, met de plaats waar zij begraven zijn; het register is openbaar en gaat bij opheffing naar het archief van de gemeente waar de plaats lag (Wet op de lijkbezorging art. 27). Is de gemeente houder, dan biedt zij de inzage aan. Het register zelf is het Register van begraven lijken, een representatie van Graf.&#10;&#10;De UPL noemt alleen bedrijven als afnemer en rekent het product tot de Dienstenwet (UPL)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/begraafplaatsregister.md" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model domein" value="Publieksdiensten" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessService" name="Vervoersdocumenten stoffelijk overschot" id="id-373542f45c955ea3821e396811898f65">
              <documentation>Het document van de gemeente waarmee een stoffelijk overschot ongehinderd naar het buitenland wordt vervoerd.</documentation>
              <property key="wiki-gemma-model id" value="vervoersdocumenten-stoffelijk-overschot" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2026-rijk-besluit-op-de-lijkbezorging-wettekst; 2026-rvo-aangifte-en-akte-van-overlijden" />
              <property key="wiki-gemma-model beschrijving" value="Vervoer naar een staat die partij is bij de Overeenkomst van Straatsburg gaat ongehinderd met een laissez-passer voor lijken van de burgemeester van de gemeente waar de akte van overlijden is ingeschreven (Besluit op de lijkbezorging art. 11 lid 1). Voor vervoer over land naar België of Luxemburg volstaat het verlof tot begraving of crematie (art. 11 lid 3). Bij binnenkomst wordt het document aan de douane overgelegd (art. 11 lid 5)." />
              <property key="wiki-gemma-model synoniemen" value="Laissez-passer voor lijken (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/vervoersdocumenten-stoffelijk-overschot.md" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model domein" value="Fysieke leefomgeving" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessService" name="Asverstrooiing" id="id-4186be8d8a9d52169f555ffab23dfc48">
              <documentation>Toestemming van de gemeente om as te verstrooien op een plek waar dat zonder toestemming niet mag.</documentation>
              <property key="wiki-gemma-model id" value="asverstrooiing" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2025-groningen-algemene-plaatselijke-verordening; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen" />
              <property key="wiki-gemma-model beschrijving" value="Buiten de begraafplaats is asverstrooiing vrij, behalve op de plaatsen die de APV verbiedt en bij hinder of overlast; het college kan op verzoek van de nabestaande die zorgdraagt voor de asbus bij bijzondere omstandigheden ontheffing verlenen, behalve voor begraafplaatsen, crematoriumterreinen, schoolpleinen en kinderspeelplaatsen (APV Groningen art. 5:27, 5:28). Op de gemeentelijke begraafplaats is verstrooien verboden zonder toestemming van het college, op een aangewezen plek en onder toezicht van een medewerker van de begraafplaats (Groningen art. 21).&#10;&#10;De UPL geeft als grondslag art. 5:36 van de model-APV en rekent het product tot het GEMMA-domein Openbare orde en veiligheid (UPL).&#10;&#10;Tegenspraak: de APV definieert incidentele asverstrooiing als verstrooien op een plek die de overledene of nabestaande kiest, buiten een permanent daartoe bestemd terrein (APV Groningen art. 5:26); de beheersverordening als verstrooien op een plek die de gemeente aanwijst, op of buiten de begraafplaats (Groningen art. 1). Beide vallen onder deze dienst." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/asverstrooiing.md" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model domein" value="Openbare orde en veiligheid" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessService" name="Verlof tot begraven" id="id-6291bb8caa9a52b5a5d78ec4b2bde141">
              <documentation>Toestemming van de gemeente om een stoffelijk overschot te begraven of te cremeren.</documentation>
              <property key="wiki-gemma-model id" value="verlof-tot-begraven" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2026-rijk-wet-op-de-lijkbezorging-wettekst; 2010-vng-model-beheersverordening-begraafplaatsen; 2026-rvo-aangifte-en-akte-van-overlijden" />
              <property key="wiki-gemma-model beschrijving" value="Geen begraving of crematie zonder schriftelijk verlof van de ambtenaar van de burgerlijke stand, dat kosteloos wordt afgegeven (Wet op de lijkbezorging art. 11). De UPL-naam noemt alleen begraven; het verlof geldt ook voor crematie. Voor vervoer over land naar België of Luxemburg volstaat het verlof (Besluit op de lijkbezorging art. 11 lid 3).&#10;&#10;De UPL rekent het product tot Iv3 0.2 (Burgerzaken) en het GEMMA-domein Fysieke leefomgeving (UPL). In dit model staat het bij de begraafplaatsen en crematoria, naast het deelproces dat het levert, en in de functie-indeling bij het domein van de UPL." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/verlof-tot-begraven.md" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model domein" value="Fysieke leefomgeving" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessService" name="Bijzondere begraafplaats toestemming" id="id-8a7199128b1158cf85e54b8427b6b794">
              <documentation>Toestemming van de gemeente om een bijzondere begraafplaats aan te leggen, uit te breiden of in gebruik te nemen.</documentation>
              <property key="wiki-gemma-model id" value="bijzondere-begraafplaats-toestemming" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2026-rijk-wet-op-de-lijkbezorging-wettekst" />
              <property key="wiki-gemma-model beschrijving" value="Een bijzondere begraafplaats wordt aangelegd en in stand gehouden door een kerkgenootschap, een privaatrechtelijke rechtspersoon of een natuurlijk persoon (Wet op de lijkbezorging art. 37). Voor aanleg of uitbreiding wordt alleen grond gebruikt die de gemeenteraad heeft aangewezen (art. 40 lid 1); voor de ingebruikneming is toestemming van burgemeester en wethouders nodig, die alleen wordt geweigerd als niet aan de wettelijke voorschriften is voldaan (art. 41)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/bijzondere-begraafplaats-toestemming.md" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model domein" value="Publieksdiensten" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessService" name="Crematoriumregister" id="id-9d97c3b0a3bd5d128b041d65ae6f38e6">
              <documentation>Inzage in het openbare register van alle daar gecremeerde stoffelijke overschotten en de bestemming van de as dat de houder van een crematorium bijhoudt.</documentation>
              <property key="wiki-gemma-model id" value="crematoriumregister" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-vng-gemma-2026-10-02" />
              <property key="wiki-gemma-model beschrijving" value="De houder van een crematorium houdt een register bij van alle daar gecremeerde stoffelijke overschotten en de bestemming van de as; het register is openbaar en gaat bij opheffing naar het archief van de gemeente waar de plaats lag (Wet op de lijkbezorging art. 50). Is de gemeente houder, dan biedt zij de inzage aan. Het register zelf is een representatie, zonder pagina; de inhoud staat in het Besluit op de lijkbezorging (art. 10).&#10;&#10;De UPL noemt alleen bedrijven als afnemer en rekent het product tot de Dienstenwet (UPL)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/crematoriumregister.md" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model domein" value="Fysieke leefomgeving" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessService" name="Gedenkteken plaatsingsvergunning" id="id-a8bd91490cd855889da99a459bcaeb02">
              <documentation>Vergunning van de gemeente voor het plaatsen en hebben van een gedenkteken of andere grafbedekking op een graf.</documentation>
              <property key="wiki-gemma-model id" value="gedenkteken-plaatsingsvergunning" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2010-vng-model-beheersverordening-begraafplaatsen; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen" />
              <property key="wiki-gemma-model beschrijving" value="Voor het hebben van een grafbedekking is een schriftelijke vergunning van het college nodig; de rechthebbende van een particulier graf vraagt haar aan (VNG-model art. 19 lid 1–2; Groningen art. 22 lid 1–2). Het college kan nadere regels stellen over de aanvraag, de aard en de afmetingen van de grafbedekking en kan de vergunning weigeren (Groningen art. 22 lid 3–4). De beheersverordeningen spreken van vergunning grafbedekking; de UPL van gedenkteken plaatsingsvergunning (UPL)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/gedenkteken-plaatsingsvergunning.md" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model domein" value="Fysieke leefomgeving" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessService" name="Graf aanvragen" id="id-dd3cb81e680059828143496df77fbbd1">
              <documentation>Een particulier graf, urnengraf of urnennis laten uitgeven, met het grafrecht daarop.</documentation>
              <property key="wiki-gemma-model id" value="graf-aanvragen" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2010-vng-model-beheersverordening-begraafplaatsen; 2026-vng-retributies" />
              <property key="wiki-gemma-model beschrijving" value="Wie een graf wil, dient een schriftelijke aanvraag in; het college verleent het recht voor een vaste termijn, voor zover er ruimte is, en de gemeente heft er lijkbezorgingsrechten voor (Groningen art. 16; VNG-model art. 15; VNG retributies). Het VNG-model beveelt aan aanvragen in te dienen bij de beheerder van de begraafplaats (toelichting 2)." />
              <property key="wiki-gemma-model synoniemen" value="Grafrecht aanvragen (beleid)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/graf-aanvragen.md" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model domein" value="Fysieke leefomgeving" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessService" name="Herbegraven of alsnog cremeren" id="id-e542a05685cb5e80afbb2f7dc79e4976">
              <documentation>Toestemming van de gemeente om een begraven stoffelijk overschot op te graven en elders te begraven of te cremeren.</documentation>
              <property key="wiki-gemma-model id" value="herbegraven-of-alsnog-cremeren" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen" />
              <property key="wiki-gemma-model beschrijving" value="Een stoffelijk overschot wordt alleen opgegraven met vergunning van de burgemeester van de gemeente waar het is begraven en, bij een particulier graf, met toestemming van de rechthebbende (Wet op de lijkbezorging art. 29 lid 1). Een opgegraven stoffelijk overschot mag worden gecremeerd op verzoek van de persoon uit art. 18 (art. 29 lid 3). De rechthebbende dient de aanvraag in bij de burgemeester (Groningen art. 28 lid 1)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/herbegraven-of-alsnog-cremeren.md" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model domein" value="Fysieke leefomgeving" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessService" name="Ontleding stoffelijk overschot toestemming" id="id-f214c09b96ed57f2a77e9ef9b591b0e6">
              <documentation>Toestemming van de gemeente om een stoffelijk overschot in het belang van de wetenschap of het wetenschappelijk onderwijs te laten ontleden.</documentation>
              <property key="wiki-gemma-model id" value="ontleding-stoffelijk-overschot-toestemming" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2026-rijk-wet-op-de-lijkbezorging-wettekst" />
              <property key="wiki-gemma-model beschrijving" value="Ontleding gebeurt alleen als de overledene of, bij gebreke daarvan, de nabestaanden het stoffelijk overschot daartoe hebben bestemd (Wet op de lijkbezorging art. 67), en met schriftelijk verlof van de burgemeester, dat binnen drie dagen kosteloos wordt afgegeven en de plaats van ontleding vermeldt (art. 68 lid 1). Bij een stoffelijk overschot uit het buitenland beslist de burgemeester uiterlijk op de derde dag na het binnenbrengen (Besluit op de lijkbezorging art. 17).&#10;&#10;De UPL noemt bedrijven als afnemer en geeft het product geen Iv3-taakveld (UPL)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/ontleding-stoffelijk-overschot-toestemming.md" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model domein" value="Fysieke leefomgeving" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessService" name="Uitvaart vervroegen of uitstellen" id="id-fd16f7c92e325b1181001c7f52db758e">
              <documentation>Toestemming van de gemeente om een overledene eerder dan 36 uur of later dan zes werkdagen na het overlijden te begraven of te cremeren.</documentation>
              <property key="wiki-gemma-model id" value="uitvaart-vervroegen-of-uitstellen" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rvo-aangifte-en-akte-van-overlijden; 2026-rijk-wet-op-de-lijkbezorging-wettekst" />
              <property key="wiki-gemma-model beschrijving" value="Begraven of cremeren mag niet eerder dan 36 uur en uiterlijk op de zesde werkdag na het overlijden (art. 16). Na een arts te hebben gehoord kan de burgemeester een andere termijn stellen; eerder dan 36 uur alleen in overeenstemming met de officier van justitie (art. 17). De uitvaartondernemer vraagt de vergunning namens de nabestaanden aan bij de gemeente waar de persoon is overleden, bijvoorbeeld om religieuze redenen of omdat familie uit het buitenland moet komen (Ondernemersplein)." />
              <property key="wiki-gemma-model synoniemen" value="Andere termijn (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/uitvaart-vervroegen-of-uitstellen.md" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model domein" value="Publieksdiensten" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
          </folder>
        </folder>
      </folder>
      <folder name="Gebeurtenissen" id="id-54ffca2a1c5c53ff8b9171266c105373">
        <element xsi:type="archimate:BusinessEvent" name="Besmet stoffelijk overschot gemeld" id="id-2fea955930dd520eba7426ee1cf72121">
          <documentation>De burgemeester heeft van de GGD de melding ontvangen dat een stoffelijk overschot besmet is met gevaar voor de volksgezondheid.</documentation>
          <property key="wiki-gemma-model id" value="besmet-stoffelijk-overschot-gemeld" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-publieke-gezondheid-wettekst; 2026-rijk-wet-op-de-lijkbezorging-wettekst" />
          <property key="wiki-gemma-model beschrijving" value="De arts die vaststelt dat een stoffelijk overschot besmet is met een infectieus of giftig agens of stof met ernstig gevaar voor de volksgezondheid, meldt dat onverwijld aan de GGD (Wet publieke gezondheid art. 21 lid 2); de GGD geeft de ontvangst onverwijld door aan de burgemeester van de gemeente waarin het stoffelijk overschot zich bevindt (art. 27 lid 3)." />
          <property key="wiki-gemma-model synoniemen" value="Melding besmet lijk (wet); Besmet lijk gemeld (wet)" />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/gebeurtenissen/besmet-stoffelijk-overschot-gemeld.md" />
        </element>
        <element xsi:type="archimate:BusinessEvent" name="Verval van het grafrecht" id="id-e9b245662c175440ad0b5585bbbe18df">
          <documentation>Het einde van een grafrecht door verloop van de termijn, afstand, opheffing van de begraafplaats of vervallenverklaring.</documentation>
          <property key="wiki-gemma-model id" value="verval-van-het-grafrecht" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen" />
          <property key="wiki-gemma-model beschrijving" value="Een grafrecht vervalt door het verlopen van de termijn, door afstand of door opheffing van de begraafplaats; het college kan het vervallen verklaren bij niet-betalen, verzuim of als het na overlijden van de rechthebbende niet wordt overgeschreven, en het recht vervalt na een niet opgevolgde verklaring van verwaarlozing (Groningen art. 20; art. 28 lid 6). Daarna kunnen de grafbedekking worden verwijderd en het graf worden geruimd (Groningen art. 20 lid 4, 26)." />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/gebeurtenissen/verval-van-het-grafrecht.md" />
        </element>
        <element xsi:type="archimate:BusinessEvent" name="Overlijden" id="id-edb09f226d2b51f7a95e3dc16d5cb699">
          <documentation>Het sterven van een persoon.</documentation>
          <property key="wiki-gemma-model id" value="overlijden" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-rvo-aangifte-en-akte-van-overlijden" />
          <property key="wiki-gemma-model beschrijving" value="Het overlijden van een persoon wordt aangegeven bij de gemeente waar de persoon is overleden; voor de aangifte is een verklaring van overlijden nodig (Ondernemersplein)." />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/gebeurtenissen/overlijden.md" />
        </element>
      </folder>
      <folder name="Procesindeling naar taak" id="id-5a2ea782586655bcb03c08a86e6935c9">
        <folder name="7 Volksgezondheid en Milieu" id="id-b6d15ba2baa35732a8115e44ce770f1a">
          <folder name="Begraafplaatsen en crematoria" id="id-89b6653d88455d32b8d84704fe50f5fe">
            <element xsi:type="archimate:BusinessProcess" name="Verlenen toestemming asverstrooiing" id="id-230de6a7ba9e53e0a76ee579c8196885">
              <documentation>Het beslissen op een verzoek om as te verstrooien op een plek waar dat zonder toestemming verboden is.</documentation>
              <property key="wiki-gemma-model id" value="verlenen-toestemming-asverstrooiing" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-groningen-algemene-plaatselijke-verordening; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2026-rijk-wet-op-de-lijkbezorging-wettekst; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="Buiten de begraafplaats verleent het college op verzoek van de nabestaande die zorgdraagt voor de asbus bij bijzondere omstandigheden ontheffing van het verbod op de plaatsen uit de APV (APV Groningen art. 5:27 lid 3). Op de gemeentelijke begraafplaats geeft het college toestemming voor verstrooiing op een aangewezen plek (Groningen art. 21 lid 1–2). Beslisser is het college.&#10;&#10;Het verstrooien zelf hoort bij Bijzetten of verstrooien van de as." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/verlenen-toestemming-asverstrooiing.md" />
              <property key="wiki-gemma-model procesniveau" value="deelproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="urn" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Beheren grafrechten" id="id-2644dde5bf4c5a80b29f7c7663de02c7">
              <documentation>Het beheer van een grafrecht over de hele looptijd: verlenen, verlengen, overschrijven en vervallen.</documentation>
              <property key="wiki-gemma-model id" value="beheren-grafrechten" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2010-vng-model-beheersverordening-begraafplaatsen; 2026-rijk-wet-op-de-lijkbezorging-wettekst" />
              <property key="wiki-gemma-model beschrijving" value="Het grafrecht wordt schriftelijk gevestigd voor onbepaalde tijd of voor ten minste tien jaar, en op verzoek verlengd (Wet op de lijkbezorging art. 28 lid 1–3). Het college verleent het recht op aanvraag, schrijft het over en kan het vervallen verklaren; het recht vervalt ook als na een verklaring van verwaarlozing niet alsnog in het onderhoud is voorzien (Groningen art. 16–20; art. 28 lid 4–7)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/beheren-grafrechten.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="grafrecht" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Ruimen graf" id="id-2de444e3552c5f908f12c6a6868cadfa">
              <documentation>Het leegmaken van een graf, waarbij de resten worden herbegraven en de as wordt verstrooid.</documentation>
              <property key="wiki-gemma-model id" value="ruimen-graf" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2010-vng-model-beheersverordening-begraafplaatsen; 2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen" />
              <property key="wiki-gemma-model beschrijving" value="Een graf wordt geruimd op last van de houder van de begraafplaats, na ten minste tien jaar na de laatste begraving en bij een particulier graf met toestemming van de rechthebbende (art. 31). Het college kondigt een ruiming ten minste een jaar vooraf aan, per brief of met een bordje bij het graf en op het mededelingenbord; de beheerder ziet toe op een respectvolle omgang met de resten, die worden herbegraven, terwijl de as wordt verstrooid (Groningen art. 27; VNG-model art. 24). Asbussen worden geruimd door verstrooiing van de as (art. 66)." />
              <property key="wiki-gemma-model synoniemen" value="Ruiming (beleid); Ruimen van graven (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/ruimen-graf.md" />
              <property key="wiki-gemma-model procesniveau" value="deelproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="graf" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Beheren graven" id="id-33d71105e2d25cd892c59c94ec68d297">
              <documentation>Het beheer van een graf over de hele levensloop: uitgeven, begraven en bijzetten, onderhouden en ruimen.</documentation>
              <property key="wiki-gemma-model id" value="beheren-graven" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen" />
              <property key="wiki-gemma-model beschrijving" value="De houder van de begraafplaats bepaalt bij een algemeen graf wie erin wordt begraven, houdt het register van begraven lijken bij en ruimt graven na ten minste tien jaar grafrust (Wet op de lijkbezorging art. 23, 27, 31). Op de gemeentelijke begraafplaats regelt de beheersverordening de soorten graven, de uitgifte, het onderhoud en de ruiming (Groningen art. 11–16, 23, 27)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/beheren-graven.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="graf" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Beheren begraafplaatsen" id="id-35cade79cce6571e814c3084684d0397">
              <documentation>Het beheer van een begraafplaats over de hele levensloop: aanleggen, in gebruik nemen, sluiten en opheffen.</documentation>
              <property key="wiki-gemma-model id" value="beheren-begraafplaatsen" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst" />
              <property key="wiki-gemma-model beschrijving" value="Elke gemeente heeft ten minste één gemeentelijke begraafplaats, alleen of samen met andere gemeenten; voor aanleg op het grondgebied van een andere gemeente is toestemming van de raad van die gemeente nodig (Wet op de lijkbezorging art. 33, 36). Voor een bijzondere begraafplaats wijst de raad de grond aan en geeft het college toestemming voor de ingebruikneming (art. 40, 41). Het college kan een gemeentelijke begraafplaats sluiten, of gesloten verklaren als er tien jaar niet is begraven (art. 43, 44). Een begraafplaats houdt op te bestaan als de grond die bestemming verloor en er geen graf meer is (art. 47)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/beheren-begraafplaatsen.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="begraafplaats" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Verlenen verlof tot ontleding" id="id-3d946a179e735290aeea986a5aae209a">
              <documentation>Het afgeven van het schriftelijk verlof waarmee een stoffelijk overschot mag worden ontleed.</documentation>
              <property key="wiki-gemma-model id" value="verlenen-verlof-tot-ontleding" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-rijk-besluit-op-de-lijkbezorging-wettekst; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="Ontleding gebeurt alleen met schriftelijk verlof van de burgemeester, dat binnen drie dagen kosteloos wordt afgegeven en de plaats van ontleding vermeldt; tegen het besluit staat binnen 24 uur beroep open bij de commissaris van de Koning (Wet op de lijkbezorging art. 68). Beslisser is de burgemeester. De ontleding zelf hoort bij Uitvoeren lijkbezorging." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/verlenen-verlof-tot-ontleding.md" />
              <property key="wiki-gemma-model procesniveau" value="deelproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="stoffelijk-overschot" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Stellen andere termijn" id="id-5a96b5b99c4355e799bb7898f48f7066">
              <documentation>Het toestaan dat een overledene eerder dan 36 uur of later dan de zesde werkdag na het overlijden wordt begraven of gecremeerd.</documentation>
              <property key="wiki-gemma-model id" value="stellen-andere-termijn" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-rvo-aangifte-en-akte-van-overlijden" />
              <property key="wiki-gemma-model beschrijving" value="Begraving of crematie geschiedt niet eerder dan 36 uur en uiterlijk op de zesde werkdag na het overlijden (Wet op de lijkbezorging art. 16). Na een arts te hebben gehoord kan de burgemeester van de gemeente waar het stoffelijk overschot zich bevindt een andere termijn stellen; binnen 36 uur alleen in overeenstemming met de officier van justitie (art. 17 lid 1). Tegen het besluit staat binnen 24 uur beroep open bij de commissaris van de Koning (art. 17 lid 2). De nabestaanden vragen de vergunning aan bij de gemeente waar de persoon is overleden, meestal via de uitvaartondernemer (RVO)." />
              <property key="wiki-gemma-model synoniemen" value="Andere termijn stellen (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/stellen-andere-termijn.md" />
              <property key="wiki-gemma-model procesniveau" value="deelproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="stoffelijk-overschot" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Uitbaten begraafplaatsen en crematoria" id="id-5af8af7852ed53e997cd7d3cc9e4405f">
              <documentation>Het openhouden van gemeentelijke begraafplaatsen en crematoria en het ter beschikking stellen van graven en ruimte voor bijzetting en verstrooiing.</documentation>
              <property key="wiki-gemma-model id" value="uitbaten-begraafplaatsen-en-crematoria" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2026-vng-gemma-2026-10-02" />
              <property key="wiki-gemma-model beschrijving" value="Op de gemeentelijke begraafplaats en in een gemeentelijk crematorium begraaft, cremeert en zet de gemeente bij, binnen de tijden die de verordening bepaalt (Wet op de lijkbezorging art. 23, 49, 56, 62; Groningen art. 7, 21), en ruimt zij graven om ruimte vrij te maken (art. 31; Groningen art. 27). Het cluster groepeert deze deelprocessen als specialisatie van het GEMMA-proces Uitbaten gemeentelijke voorzieningen." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/uitbaten-begraafplaatsen-en-crematoria.md" />
              <property key="wiki-gemma-model procesniveau" value="cluster naar soort werk" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Bezorgen stoffelijk overschot" id="id-5be7592f534f5579bbc0e06512b526f1">
              <documentation>Het proces van overlijden tot de bezorging van het stoffelijk overschot: schouwen, verlof verlenen, begraven of cremeren, en zo nodig zorg door de gemeente.</documentation>
              <property key="wiki-gemma-model id" value="bezorgen-stoffelijk-overschot" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2025-groningen-algemene-plaatselijke-verordening; 2026-rijk-besluit-op-de-lijkbezorging-wettekst" />
              <property key="wiki-gemma-model beschrijving" value="Na het overlijden wordt het stoffelijk overschot geschouwd, verleent de ambtenaar van de burgerlijke stand verlof tot begraving of crematie, en wordt het binnen de wettelijke termijn begraven, gecremeerd of ontleed (Wet op de lijkbezorging art. 3, 11, 16, 67). Zorgt niemand anders voor de bezorging, dan draagt de burgemeester er zorg voor (art. 21); bij een besmet stoffelijk overschot kan hij maatregelen treffen (art. 22a). Ook een latere opgraving hoort bij de levensloop van het stoffelijk overschot (art. 29).&#10;&#10;Het is een ketenproces: bij een niet-natuurlijke dood brengt de gemeentelijke lijkschouwer verslag uit aan de officier van justitie, die een verklaring van geen bezwaar afgeeft voordat verlof kan worden verleend (art. 10, 12); een vervroegde uitvaart vraagt ook zijn instemming (art. 17). De uitvaartondernemer regelt de uitvaart namens de nabestaanden (RVO)." />
              <property key="wiki-gemma-model synoniemen" value="Bezorgen lijken (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/bezorgen-stoffelijk-overschot.md" />
              <property key="wiki-gemma-model procesniveau" value="ketenproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="stoffelijk-overschot" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Onderhouden graf" id="id-6344b6861697540e8216a9c9707038a8">
              <documentation>Het onderhouden van grafbedekking en beplanting op een graf door de gemeente.</documentation>
              <property key="wiki-gemma-model id" value="onderhouden-graf" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2010-vng-model-beheersverordening-begraafplaatsen; 2026-vng-retributies" />
              <property key="wiki-gemma-model beschrijving" value="De gemeente maakt gedenktekens schoon en onderhoudt de beplanting op graven, op sommige begraafplaatsen altijd en elders op schriftelijk verzoek van de rechthebbende voor ten minste vijf jaar, tegen betaling van een recht uit de heffingsverordening (Groningen art. 23, 24 lid 3). Bij niet-betalen wordt de grafbedekking na waarschuwing verwijderd (art. 23 lid 4). Het VNG-model regelt een minimaal onderhoud door de gemeente (art. 20)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/onderhouden-graf.md" />
              <property key="wiki-gemma-model procesniveau" value="deelproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="grafbedekking" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Verlenen grafrecht" id="id-72c234ccca9b5464811e0474bcd782ce">
              <documentation>Het verlenen van een grafrecht op een particulier graf aan een rechthebbende.</documentation>
              <property key="wiki-gemma-model id" value="verlenen-grafrecht" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2010-vng-model-beheersverordening-begraafplaatsen; 2026-vng-retributies" />
              <property key="wiki-gemma-model beschrijving" value="Het college verleent op schriftelijke aanvraag een recht op een particulier graf, voor 30 jaar of bij een urnengraf voor 5 tot 30 jaar (Groningen art. 16; VNG-model art. 15); de wet spreekt van het vestigen van het uitsluitend recht, voor onbepaalde tijd of ten minste tien jaar (art. 28). Beslisser is het college; het VNG-model beveelt mandaat aan de beheerder aan. Graven worden in volgorde van ligging uitgegeven (Groningen art. 14). Verlenging volgt op verzoek van de rechthebbende (art. 28 lid 1). De gemeente heft voor de uitgifte lijkbezorgingsrechten (VNG retributies)." />
              <property key="wiki-gemma-model synoniemen" value="Uitgifte van een graf (beleid); Vestigen van het uitsluitend recht op een graf (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/verlenen-grafrecht.md" />
              <property key="wiki-gemma-model procesniveau" value="deelproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="grafrecht" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Vervallen verklaren grafrecht" id="id-75a1ffb3a38f5ed482179917b41d5c97">
              <documentation>Het beëindigen van een grafrecht door de gemeente, bijvoorbeeld bij verwaarlozing van het graf of het uitblijven van betaling.</documentation>
              <property key="wiki-gemma-model id" value="vervallen-verklaren-grafrecht" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2010-vng-model-beheersverordening-begraafplaatsen" />
              <property key="wiki-gemma-model beschrijving" value="Bij kennelijke verwaarlozing van het onderhoud van een particulier graf legt de houder dat vast in een verklaring van verwaarlozing; voorziet de rechthebbende niet binnen één jaar (of vijf jaar na bekendmaking bij het graf) in het onderhoud, dan vervalt het recht (art. 28 lid 4–7). Het college kan het grafrecht ook vervallen verklaren bij wanbetaling, verzuim of als het na het overlijden van de rechthebbende niet tijdig wordt overgeschreven (Groningen art. 18 lid 4, 20 lid 2; VNG-model art. 17 lid 3). Beslisser is het college." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/vervallen-verklaren-grafrecht.md" />
              <property key="wiki-gemma-model procesniveau" value="deelproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="grafrecht" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Treffen maatregel bij besmet stoffelijk overschot" id="id-80882f2992c259ec970fe9e268f3f946">
              <documentation>Het nemen van maatregelen om gevaar voor de volksgezondheid door een besmet stoffelijk overschot af te wenden.</documentation>
              <property key="wiki-gemma-model id" value="treffen-maatregel-bij-besmet-stoffelijk-overschot" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-rijk-wet-publieke-gezondheid-wettekst" />
              <property key="wiki-gemma-model beschrijving" value="Is een stoffelijk overschot besmet met een infectieus of giftig agens of stof, of bestaat daarvan een gegrond vermoeden, waardoor een ernstig gevaar voor de volksgezondheid kan ontstaan, dan kan de burgemeester maatregelen treffen om dit gevaar af te wenden, na advies van de GGD (Wet op de lijkbezorging art. 22a). Beslisser is de burgemeester. De melding komt van een arts via de GGD (Wet publieke gezondheid art. 21 lid 2, 27 lid 3). De maatregel zelf is een beschikking." />
              <property key="wiki-gemma-model synoniemen" value="Treffen maatregel bij besmet lijk (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/treffen-maatregel-bij-besmet-stoffelijk-overschot.md" />
              <property key="wiki-gemma-model procesniveau" value="deelproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="stoffelijk-overschot" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Verlenen vergunning grafbedekking" id="id-873fa38b3c5e556c9a1f0e7f5b577f7d">
              <documentation>Het beslissen op een aanvraag om een vergunning voor een gedenkteken of andere grafbedekking op een particulier graf.</documentation>
              <property key="wiki-gemma-model id" value="verlenen-vergunning-grafbedekking" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2010-vng-model-beheersverordening-begraafplaatsen; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="De rechthebbende van een particulier graf vraagt de vergunning aan; het college beslist en kan de vergunning weigeren als niet wordt voldaan aan de nadere regels over de aard en de afmetingen van de grafbedekking (Groningen art. 22; VNG-model art. 19). Beslisser is het college." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/verlenen-vergunning-grafbedekking.md" />
              <property key="wiki-gemma-model procesniveau" value="deelproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="grafbedekking" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Schouwen stoffelijk overschot" id="id-8aeb21e52a7a5af99faf3d55995af0bb">
              <documentation>Onderzoek van een stoffelijk overschot door een arts na het overlijden, om vast te stellen of de dood een natuurlijke oorzaak heeft.</documentation>
              <property key="wiki-gemma-model id" value="schouwen-stoffelijk-overschot" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst" />
              <property key="wiki-gemma-model beschrijving" value="Elk stoffelijk overschot wordt zo spoedig mogelijk geschouwd, door de behandelend arts of door een gemeentelijke lijkschouwer (art. 3). Is de dood natuurlijk, dan volgt een verklaring van overlijden (art. 7); anders waarschuwt de lijkschouwer de officier van justitie en de ambtenaar van de burgerlijke stand (art. 10). Bij een minderjarige kan een nader onderzoek naar de doodsoorzaak volgen (art. 10a). De schouwing door de behandelend arts valt buiten het gemeentelijk perspectief." />
              <property key="wiki-gemma-model synoniemen" value="Lijkschouwing (wet); Schouwen lijk (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/schouwen-stoffelijk-overschot.md" />
              <property key="wiki-gemma-model procesniveau" value="deelproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="stoffelijk-overschot" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Afgeven laissez-passer" id="id-8cec781544c351dcafada66fb7c002ce">
              <documentation>Het afgeven van het laissez-passer voor lijken voor vervoer van een stoffelijk overschot naar een verdragsstaat.</documentation>
              <property key="wiki-gemma-model id" value="afgeven-laissez-passer" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-besluit-op-de-lijkbezorging-wettekst; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="De burgemeester van de gemeente waar de akte van overlijden is ingeschreven, geeft het laissez-passer af voor vervoer naar een staat die partij is bij de Overeenkomst van Straatsburg; voor vervoer over land naar België of Luxemburg volstaat het verlof tot begraving of crematie (Besluit op de lijkbezorging art. 11 lid 1, 3). Beslisser is de burgemeester." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/afgeven-laissez-passer.md" />
              <property key="wiki-gemma-model procesniveau" value="deelproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="stoffelijk-overschot" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Opgraven stoffelijk overschot" id="id-abcb82c5d790520f856afdda24be34b1">
              <documentation>Het opgraven van een stoffelijk overschot uit een graf, met vergunning van de burgemeester.</documentation>
              <property key="wiki-gemma-model id" value="opgraven-stoffelijk-overschot" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="Een stoffelijk overschot wordt slechts opgegraven met vergunning van de burgemeester en, bij een particulier graf, met toestemming van de rechthebbende; de burgemeester verbindt voorschriften aan de vergunning over geneeskundig toezicht, vervoer en bestemming (art. 29). Beslisser is de burgemeester. De rechthebbende dient de aanvraag in en schakelt een erkend bedrijf in; opgraven gebeurt in de regel pas na tien jaar grafrust (Groningen art. 28)." />
              <property key="wiki-gemma-model synoniemen" value="Opgraving (wet); Opgraven lijk (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/opgraven-stoffelijk-overschot.md" />
              <property key="wiki-gemma-model procesniveau" value="deelproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="stoffelijk-overschot" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Verlenen vergunning bijzonder crematorium" id="id-c1affa7acf5353f9bc6f7eab26090146">
              <documentation>Het verlenen van de vergunning voor het vestigen, uitbreiden of wijzigen van een crematorium van een particuliere houder.</documentation>
              <property key="wiki-gemma-model id" value="verlenen-vergunning-bijzonder-crematorium" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst" />
              <property key="wiki-gemma-model beschrijving" value="Het vestigen, uitbreiden of wijzigen van een bijzonder crematorium behoeft een vergunning van het college (Wet op de lijkbezorging art. 53). Een vergunning voor vestiging wordt pas verleend nadat het college het voornemen ten minste dertig dagen tevoren openbaar heeft gemaakt (art. 54). Belanghebbenden kunnen in beroep bij gedeputeerde staten (art. 55)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/verlenen-vergunning-bijzonder-crematorium.md" />
              <property key="wiki-gemma-model procesniveau" value="deelproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="crematorium" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Behandelen vergunningaanvragen lijkbezorging" id="id-c3bb9f903a155d4f8925239f9ee53754">
              <documentation>Het behandelen van aanvragen om een vergunning, verlof of toestemming voor de lijkbezorging en voor begraafplaatsen en crematoria.</documentation>
              <property key="wiki-gemma-model id" value="behandelen-vergunningaanvragen-lijkbezorging" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-vng-gemma-2026-10-02; 2026-rijk-besluit-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2025-groningen-algemene-plaatselijke-verordening" />
              <property key="wiki-gemma-model beschrijving" value="Binnen de lijkbezorging verleent de gemeente op aanvraag verloven, vergunningen en toestemmingen: het verlof tot begraving of crematie (Wet op de lijkbezorging art. 11), een andere termijn (art. 17), de vergunning tot opgraving (art. 29), de toestemming voor een bijzondere begraafplaats (art. 40, 41), de vergunning voor een bijzonder crematorium (art. 53), het verlof tot ontleding (art. 68), het laissez-passer voor lijken (Besluit op de lijkbezorging art. 11), de vergunning grafbedekking (Groningen art. 22) en de toestemming voor asverstrooiing (APV Groningen art. 5:27 lid 3; Groningen art. 21). Het cluster groepeert deze deelprocessen als specialisatie van het GEMMA-proces Behandelen aanvraag vergunning of ontheffing." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/behandelen-vergunningaanvragen-lijkbezorging.md" />
              <property key="wiki-gemma-model procesniveau" value="cluster naar soort werk" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Sluiten begraafplaats" id="id-d0fd7ec403a853aa853532a68ae58530">
              <documentation>Het besluit dat op een begraafplaats niet meer wordt begraven, of de geslotenverklaring na tien jaar zonder begraving.</documentation>
              <property key="wiki-gemma-model id" value="sluiten-begraafplaats" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst" />
              <property key="wiki-gemma-model beschrijving" value="Een begraafplaats kan worden gesloten; voor een gemeentelijke begraafplaats neemt het college het besluit, en van de sluiting van een andere begraafplaats wordt het college direct op de hoogte gesteld (Wet op de lijkbezorging art. 43). Is er tien jaar niet begraven, dan kan het college de begraafplaats gesloten verklaren (art. 44). Belanghebbenden kunnen in beroep bij gedeputeerde staten, die de rechthebbende op een particulier graf een schadeloosstelling ten laste van de gemeente kunnen toekennen (art. 45)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/sluiten-begraafplaats.md" />
              <property key="wiki-gemma-model procesniveau" value="deelproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="begraafplaats" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Verzorgen gemeentebegrafenis" id="id-d254a261cbf8513f9768449e654e0032">
              <documentation>Het regelen en betalen van de lijkbezorging door de gemeente als niemand anders daarin voorziet.</documentation>
              <property key="wiki-gemma-model id" value="verzorgen-gemeentebegrafenis" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-vng-ggm-2-5-1" />
              <property key="wiki-gemma-model beschrijving" value="Als niemand voorziet in de lijkschouwing en lijkbezorging, waarschuwt degene die het stoffelijk overschot onder zich heeft de burgemeester, die daarvoor zorg draagt (art. 20, 21 lid 1). Beslisser is de burgemeester. De kosten komen ten laste van de gemeente, die ze kan verhalen op de nalatenschap, onderhoudsplichtige verwanten of de werkgever (art. 22); dat kostenverhaal is een stap in dit proces. Een stoffelijk overschot waarvan de identiteit niet kan worden vastgesteld, wordt begraven (art. 21 lid 6). Het resultaat is een gemeentebegrafenis." />
              <property key="wiki-gemma-model synoniemen" value="Lijkbezorging door de burgemeester (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/verzorgen-gemeentebegrafenis.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="gemeentebegrafenis" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Verlenen toestemming bijzondere begraafplaats" id="id-d8af547308345aad80d4bb0e78696466">
              <documentation>Het aanwijzen van grond voor een bijzondere begraafplaats en het toestaan van de ingebruikneming ervan.</documentation>
              <property key="wiki-gemma-model id" value="verlenen-toestemming-bijzondere-begraafplaats" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="Een bijzondere begraafplaats wordt aangelegd en in stand gehouden door een kerkgenootschap, een privaatrechtelijke rechtspersoon of een natuurlijk persoon (Wet op de lijkbezorging art. 37). Voor aanleg of uitbreiding wordt alleen grond gebruikt die de gemeenteraad heeft aangewezen; het college kan maatregelen voorschrijven om de grond geschikt te maken (art. 40). Voor de ingebruikneming is toestemming van het college nodig, die alleen wordt geweigerd als niet aan de wettelijke voorschriften is voldaan (art. 41). Tegen deze besluiten staat beroep open bij gedeputeerde staten (art. 42)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/verlenen-toestemming-bijzondere-begraafplaats.md" />
              <property key="wiki-gemma-model procesniveau" value="deelproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="begraafplaats" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Beheren crematoria" id="id-df39047cb6b35de2925edbb67e10e4a0">
              <documentation>Het beheer van een crematorium over de hele levensloop: vestigen, uitbreiden of wijzigen, en opheffen.</documentation>
              <property key="wiki-gemma-model id" value="beheren-crematoria" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst" />
              <property key="wiki-gemma-model beschrijving" value="Crematoria zijn gemeentelijk of bijzonder; een bijzonder crematorium wordt gevestigd en in werking gehouden door een kerkgenootschap, een privaatrechtelijke rechtspersoon of een natuurlijk persoon (Wet op de lijkbezorging art. 51, 52). Het college besluit tot vestiging van een gemeentelijk crematorium of verleent een vergunning voor een bijzonder crematorium, in beide gevallen na een openbare kennisgeving van ten minste dertig dagen (art. 53, 54). Bij opheffing van een bijzonder crematorium gaat het register naar het archief van de gemeente (art. 50 lid 3)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/beheren-crematoria.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="crematorium" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Verzorgen lijkbezorging" id="id-efc98c226b0c523bab7ef44f9cdd0fc0">
              <documentation>Gemeentelijke taak rond de lijkbezorging: het bezorgen van stoffelijke overschotten en het beheer van graven en grafrechten.</documentation>
              <property key="wiki-gemma-model id" value="verzorgen-lijkbezorging" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-vng-wet-op-de-lijkbezorging" />
              <property key="wiki-gemma-model beschrijving" value="Lijkbezorging geschiedt door begraving, crematie of een andere wettelijke wijze (Wet op de lijkbezorging art. 1). De gemeente schouwt stoffelijke overschotten via de gemeentelijke lijkschouwer, geeft het verlof tot begraving of crematie af, heeft ten minste één gemeentelijke begraafplaats, geeft graven uit, staat opgraving en ruiming toe en draagt zorg voor de lijkbezorging als niemand daarin voorziet (art. 4, 11, 21, 28, 29, 31, 33). De taak groepeert de processen daarvoor, één per kernobject: het stoffelijk overschot, de gemeentebegrafenis, het grafrecht, het graf, de begraafplaats en het crematorium." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/verzorgen-lijkbezorging.md" />
              <property key="wiki-gemma-model procesniveau" value="taak" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Uitvoeren lijkbezorging" id="id-f3fef18c03185926a98c84015a0dae05">
              <documentation>Het begraven, cremeren of op een andere wettelijke wijze bezorgen van een stoffelijk overschot.</documentation>
              <property key="wiki-gemma-model id" value="uitvoeren-lijkbezorging" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen" />
              <property key="wiki-gemma-model beschrijving" value="De lijkbezorging geschiedt door begraving, crematie of op een andere wettelijk voorziene wijze, en omvat ook het geven van een bestemming aan de as (art. 1, 18 lid 2). Ze vereist een verlof tot begraving of crematie (art. 11) en volgt, waar mogelijk, de wens van de overledene (art. 19). Op de gemeentelijke begraafplaats bepaalt de beheerder tijd en plaats in overleg met de uitvaartondernemer, na kennisgeving door wie de uitvaart regelt (Groningen art. 7). Begraving, crematie en ontleding zijn varianten zonder eigen pagina; het bijzetten of verstrooien van de as is een eigen deelproces." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/uitvoeren-lijkbezorging.md" />
              <property key="wiki-gemma-model procesniveau" value="deelproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="stoffelijk-overschot" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Bijzetten of verstrooien van de as" id="id-f72e2ea91a40554590885208703a5f48">
              <documentation>Het geven van een bestemming aan de as na een crematie: bijzetten van de urn, verstrooien van de as of meegeven aan de nabestaande.</documentation>
              <property key="wiki-gemma-model id" value="bijzetten-of-verstrooien-van-de-as" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen" />
              <property key="wiki-gemma-model beschrijving" value="Na de crematie bewaart de houder van het crematorium de asbus minimaal een maand en zorgt hij daarna dat de asbus wordt bijgezet, de as wordt verstrooid, de asbus aan de nabestaande wordt meegegeven of naar het buitenland gaat (Wet op de lijkbezorging art. 59). Een asbus wordt bijgezet in een crematorium, in of op een graf of op een afzonderlijke plaats op een begraafplaats, of in een bewaarplaats; in een particulier graf alleen met toestemming van de rechthebbende (art. 62). De houder van de plaats van bijzetting houdt een register bij en kan de asbus op verzoek aan de nabestaande meegeven (art. 63, 65). Verstrooien door een houder mag alleen op een daartoe bestemd terrein of in open zee (art. 66a); op de gemeentelijke begraafplaats kan het college incidentele asverstrooiing op een aangewezen plek toestaan (Groningen art. 21)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/bijzetten-of-verstrooien-van-de-as.md" />
              <property key="wiki-gemma-model procesniveau" value="deelproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="urn" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Verlenen verlof tot begraving of crematie" id="id-f99078369b645c1f80d4b1767a539fcc">
              <documentation>Het afgeven van het schriftelijk verlof waarmee een stoffelijk overschot mag worden begraven of gecremeerd.</documentation>
              <property key="wiki-gemma-model id" value="verlenen-verlof-tot-begraving-of-crematie" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-rvo-aangifte-en-akte-van-overlijden; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="Geen begraving of crematie geschiedt zonder schriftelijk verlof van de ambtenaar van de burgerlijke stand, dat kosteloos wordt afgegeven (art. 11). Hij verleent het alleen als hij beschikt over een verklaring van overlijden van de behandelend arts of de gemeentelijke lijkschouwer, of over een verklaring van geen bezwaar van de officier van justitie (art. 12). De stukken worden bij de akte van overlijden gevoegd (art. 13). In de praktijk krijgt de uitvaartondernemer het verlof na de aangifte van overlijden (Ondernemersplein)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/verlenen-verlof-tot-begraving-of-crematie.md" />
              <property key="wiki-gemma-model procesniveau" value="deelproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="stoffelijk-overschot" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
          </folder>
        </folder>
      </folder>
      <folder name="Producten" id="id-2036e647274c5af5818a37739cf9a460">
        <folder name="7 Volksgezondheid en Milieu" id="id-9b2c096aa97c5ffea6adba7e89883833">
          <folder name="Begraafplaatsen en crematoria" id="id-72675453814a56dca88224af923978c7">
            <element xsi:type="archimate:Product" name="Grafuitgifte" id="id-8d4fd52a89f35252a2ad5988de55110d">
              <documentation>Een particulier graf, urnengraf of urnennis op een gemeentelijke begraafplaats, met het uitsluitend recht daarop voor een vaste termijn.</documentation>
              <property key="wiki-gemma-model id" value="grafuitgifte" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2010-vng-model-beheersverordening-begraafplaatsen; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2026-vng-retributies" />
              <property key="wiki-gemma-model beschrijving" value="De gemeente geeft op haar begraafplaatsen particuliere graven, urnengraven en urnennissen uit (VNG-model art. 11, 13–15; Groningen art. 14, 16). Het product bundelt de dienst Graf aanvragen en de afspraak Grafrecht. De gemeente heft er lijkbezorgingsrechten voor; die staan in de UPL als het product grafrechten (Gemeentewet art. 229; VNG retributies).&#10;&#10;De UPL geeft als grondslag art. 11 van de model-beheersverordening (indeling graven en asbezorging); de uitgifte zelf staat in art. 13 tot 15 van dat model (UPL)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/producten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/grafuitgifte.md" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model domein" value="Fysieke leefomgeving" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
          </folder>
        </folder>
      </folder>
      <folder name="Rollen" id="id-8952e40c37b1557a9e0fe6b1dbcd6ebb">
        <element xsi:type="archimate:BusinessRole" name="Beheerder van de begraafplaats" id="id-0b6bb452a0fc5152a59a86b77fe09422">
          <documentation>Ambtenaar die belast is met de dagelijkse leiding van de gemeentelijke begraafplaatsen.</documentation>
          <property key="wiki-gemma-model id" value="beheerder-van-de-begraafplaats" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2010-vng-model-beheersverordening-begraafplaatsen" />
          <property key="wiki-gemma-model beschrijving" value="De beheerder bepaalt tijd en plaats van begravingen in overleg met de uitvaartondernemer, ontvangt en toetst de stukken (verlof, machtiging) en aanvragen, houdt het register van begraven lijken bij, handhaaft de orde en ziet toe op ruiming (Groningen art. 1 e, 4–9, 27, 30). Het VNG-model beveelt aan de beheerder aan te wijzen als aanspreekpunt voor burgers en aanvragen, met mandaat om te beslissen (toelichting 2)." />
          <property key="wiki-gemma-model synoniemen" value="Beheerder (beleid)" />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/beheerder-van-de-begraafplaats.md" />
          <property key="wiki-gemma-model doelgroep" value="gemeente" />
        </element>
        <element xsi:type="archimate:BusinessRole" name="Ambtenaar van de burgerlijke stand" id="id-3b44289d234957ecad7e1c725acf246a">
          <documentation>Ambtenaar die bevoegd is akten van de burgerlijke stand op te maken.</documentation>
          <property key="wiki-gemma-model id" value="ambtenaar-van-de-burgerlijke-stand" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-rvo-aangifte-en-akte-van-overlijden" />
          <property key="wiki-gemma-model beschrijving" value="De ambtenaar van de burgerlijke stand maakt de akten van de burgerlijke stand op, waaronder de akte van overlijden na aangifte bij de gemeente waar iemand is overleden (Wet op de lijkbezorging art. 13, 14; Ondernemersplein)." />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/ambtenaar-van-de-burgerlijke-stand.md" />
          <property key="wiki-gemma-model doelgroep" value="gemeente" />
        </element>
        <element xsi:type="archimate:BusinessRole" name="Houder van de begraafplaats" id="id-77e415928f565e74b91359fde6ad9da7">
          <documentation>Verantwoordelijkheid voor het in stand houden en beheren van een begraafplaats.</documentation>
          <property key="wiki-gemma-model id" value="houder-van-de-begraafplaats" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2010-vng-model-beheersverordening-begraafplaatsen; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen" />
          <property key="wiki-gemma-model beschrijving" value="De houder van de begraafplaats stelt voor een begraving de identiteit van het stoffelijk overschot vast (art. 8), bepaalt wie in een algemeen graf wordt begraven (art. 23), houdt het register van begraven lijken (art. 27), doet mededeling van het verstrijken van termijnen (art. 27a, 28 lid 2), kan een verklaring van verwaarlozing opstellen (art. 28 lid 4) en geeft last tot het ruimen van graven (art. 31). Bij een gemeentelijke begraafplaats is de gemeente houder; bij een bijzondere begraafplaats een kerkgenootschap, rechtspersoon of natuurlijk persoon (art. 37)." />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/houder-van-de-begraafplaats.md" />
          <property key="wiki-gemma-model doelgroep" value="gemeente" />
        </element>
        <element xsi:type="archimate:BusinessRole" name="Gemeentelijke lijkschouwer" id="id-7a33463e2bb35989ab38d88aa0e2a173">
          <documentation>Arts die door het college is benoemd om stoffelijke overschotten te schouwen.</documentation>
          <property key="wiki-gemma-model id" value="gemeentelijke-lijkschouwer" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst" />
          <property key="wiki-gemma-model beschrijving" value="Burgemeester en wethouders benoemen een of meer gemeentelijke lijkschouwers, uitsluitend forensisch artsen (art. 4, 5). Normaal schouwt de behandelend arts het stoffelijk overschot; de gemeentelijke lijkschouwer is de uitzondering en schouwt alleen als de behandelend arts dat niet doet, geeft een verklaring van overlijden af of waarschuwt bij een niet-natuurlijke dood de officier van justitie en de ambtenaar van de burgerlijke stand, en leidt het nader onderzoek bij een minderjarige (art. 3, 7, 10, 10a). Hij kan de elektronische weg openstellen voor mededelingen van de behandelend arts (art. 7 lid 3)." />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/gemeentelijke-lijkschouwer.md" />
          <property key="wiki-gemma-model doelgroep" value="gemeente" />
        </element>
        <element xsi:type="archimate:BusinessRole" name="Kostendrager" id="id-7ef9e7cf4e2158848fdf94c3f5304bce">
          <documentation>Verantwoordelijkheid voor het dragen van de kosten van een voorziening of handeling.</documentation>
          <property key="wiki-gemma-model id" value="kostendrager" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst" />
          <property key="wiki-gemma-model beschrijving" value="Een kostendrager betaalt voor een voorziening of handeling die een ander uitvoert of die hij zelf laat uitvoeren, en kan de kosten soms verhalen." />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/kostendrager.md" />
          <property key="wiki-gemma-model doelgroep" value="gemeente" />
        </element>
        <element xsi:type="archimate:BusinessRole" name="Rechthebbende op het graf" id="id-cb6de84aee08550d85ac3727aad8bec2">
          <documentation>Wie het grafrecht op een particulier graf heeft en bepaalt wie daarin wordt begraven of bijgezet.</documentation>
          <property key="wiki-gemma-model id" value="rechthebbende-op-het-graf" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2010-vng-model-beheersverordening-begraafplaatsen" />
          <property key="wiki-gemma-model beschrijving" value="De rechthebbende bepaalt wie in het particulier graf wordt begraven (art. 23 lid 2), geeft toestemming voor opgraving en ruiming (art. 29, 31), vraagt verlenging, overschrijving en een vergunning voor de grafbedekking aan, onderhoudt de grafbedekking en kan afstand doen van het recht (Groningen art. 16, 18, 19, 22, 24). Dat kan een natuurlijk persoon of een rechtspersoon zijn (Groningen art. 1 w)." />
          <property key="wiki-gemma-model synoniemen" value="Rechthebbende (beleid)" />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/rechthebbende-op-het-graf.md" />
          <property key="wiki-gemma-model doelgroep" value="inwoners en ondernemers" />
        </element>
        <element xsi:type="archimate:BusinessRole" name="Degene die in de lijkbezorging voorziet" id="id-e816170ab8e354c192c34c534cfa3355">
          <documentation>Wie de lijkbezorging van een overledene regelt en daarvoor het verlof aanvraagt.</documentation>
          <property key="wiki-gemma-model id" value="degene-die-in-de-lijkbezorging-voorziet" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2010-vng-model-beheersverordening-begraafplaatsen" />
          <property key="wiki-gemma-model beschrijving" value="Degene die in de lijkbezorging voorziet vraagt het verlof tot begraving of crematie aan, of is redelijkerwijs in diens plaats getreden; de lijkbezorging volgt zoveel mogelijk de wens van de overledene (art. 18, 19). Op de gemeentelijke begraafplaats doet hij de kennisgeving van begraven of bijzetten en ondertekent hij zo nodig de machtiging (Groningen art. 7 lid 2, 9). In de praktijk vervult vaak de uitvaartondernemer deze rol namens de nabestaanden." />
          <property key="wiki-gemma-model synoniemen" value="Degene die in de uitvaart voorziet (beleid)" />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/degene-die-in-de-lijkbezorging-voorziet.md" />
          <property key="wiki-gemma-model doelgroep" value="inwoners en ondernemers" />
        </element>
        <element xsi:type="archimate:BusinessRole" name="Houder van een plaats van bijzetting" id="id-f97e7a1412ff52749ee3016217299bdb">
          <documentation>Verantwoordelijkheid voor een plaats waar urnen worden bijgezet.</documentation>
          <property key="wiki-gemma-model id" value="houder-van-een-plaats-van-bijzetting" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen" />
          <property key="wiki-gemma-model beschrijving" value="De houder van een plaats van bijzetting houdt een openbaar register van de bijgezette asbussen, stelt ze op verzoek ter beschikking en ruimt ze door verstrooiing van de as (art. 63, 65, 66). Het register gaat bij opheffing naar het archief van de gemeente (art. 65 lid 3)." />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/houder-van-een-plaats-van-bijzetting.md" />
          <property key="wiki-gemma-model doelgroep" value="gemeente" />
        </element>
        <element xsi:type="archimate:BusinessRole" name="Houder van het crematorium" id="id-fafdec9a745a5861ae1b04f2947fa87b">
          <documentation>Verantwoordelijkheid voor een crematorium, het bergen van de as en de bestemming daarvan.</documentation>
          <property key="wiki-gemma-model id" value="houder-van-het-crematorium" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst" />
          <property key="wiki-gemma-model beschrijving" value="De houder van het crematorium bergt de as in asbussen, bewaart ze en zorgt voor de bestemming van de as, en houdt een openbaar register van gecremeerde stoffelijke overschotten (art. 50, 58, 59). Bij een gemeentelijk crematorium is de gemeente houder, bij een bijzonder crematorium een kerkgenootschap, rechtspersoon of natuurlijk persoon (art. 51, 52)." />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/houder-van-het-crematorium.md" />
          <property key="wiki-gemma-model doelgroep" value="gemeente" />
        </element>
        <element xsi:type="archimate:BusinessRole" name="Nabestaande" id="id-fef4ddc0626658c98d617a3cf964afab">
          <documentation>Naaste van een overledene die zorg draagt voor de uitvaart of de urn.</documentation>
          <property key="wiki-gemma-model id" value="nabestaande" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2010-vng-model-beheersverordening-begraafplaatsen; 2025-groningen-algemene-plaatselijke-verordening" />
          <property key="wiki-gemma-model beschrijving" value="De nabestaande draagt zorg voor de asbus, geeft opdracht tot bijzetting of verstrooiing en kan de as laten meegeven (art. 58–60, 62). Op de gemeentelijke begraafplaats kan hij werkzaamheden bij de begraving zelf verrichten en bij ruiming de resten laten herbegraven of cremeren (Groningen art. 7 lid 4, 27 lid 4; VNG-model art. 24 lid 4)." />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/nabestaande.md" />
          <property key="wiki-gemma-model doelgroep" value="inwoners en ondernemers" />
        </element>
      </folder>
    </folder>
  </folder>
  <folder name="Application" id="8aa1ca69-de12-497b-a538-48f327cb37b2" type="application" />
  <folder name="Technology &amp; Physical" id="d5745061-4cb2-49f5-8598-10ff5fbf5e02" type="technology" />
  <folder name="Motivation" id="301f18c5-e0d4-4813-af2a-f936b7ffe42b" type="motivation">
    <folder name="wiki-gemma-model" id="id-06cf3b673119556db59ccce705f6df1e">
      <folder name="Beleidskaders" id="id-b6f3bffb69ca575287dff372c8952482">
        <folder name="7 Volksgezondheid en Milieu" id="id-cb186694bf085428aab64bec48d69e46">
          <folder name="Begraafplaatsen en crematoria" id="id-c16abd88342c50689fcdc5cd49c8469e">
            <element xsi:type="archimate:Driver" name="Wet op de lijkbezorging" id="id-58cba76204ce551b9650abf0d9fbf686">
              <documentation>Wet die regelt hoe een stoffelijk overschot wordt geschouwd, begraven, gecremeerd of anders bezorgd, en welke taken de gemeente daarbij heeft.</documentation>
              <property key="wiki-gemma-model id" value="wet-op-de-lijkbezorging" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-vng-wet-op-de-lijkbezorging" />
              <property key="wiki-gemma-model beschrijving" value="De Wet op de lijkbezorging (BWBR0005009) bepaalt wat een lijk is, hoe lijkschouwing, begraving, crematie en ontleding verlopen, en welke besluiten burgemeester, college en raad daarbij nemen (art. 1–4, 11, 21, 29, 68). Ze verplicht elke gemeente tot ten minste één gemeentelijke begraafplaats (art. 33) en regelt het uitsluitend recht op een graf, de ruiming en de sluiting van begraafplaatsen (art. 28, 31, 43)." />
              <property key="wiki-gemma-model pagina" value="motivatie/beleidskaders/wet-op-de-lijkbezorging.md" />
              <property key="wiki-gemma-model regelgever" value="rijk" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:Driver" name="Model-beheersverordening begraafplaatsen" id="id-698780f0d7a7536b9a3bd66c7edae03d">
              <documentation>Model van de VNG voor de verordening waarin een gemeente het beheer en het gebruik van haar begraafplaatsen regelt.</documentation>
              <property key="wiki-gemma-model id" value="model-beheersverordening-begraafplaatsen" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2010-vng-model-beheersverordening-begraafplaatsen; 2026-vng-wet-op-de-lijkbezorging; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="De raad stelt de beheersverordening vast op grond van art. 35 Wet op de lijkbezorging en art. 149 Gemeentewet; het model geeft de begripsbepalingen (particulier en algemeen graf, urnengraf, urnennis, gedenkplaats, rechthebbende, gebruiker, beheerder) en de regels voor uitgifte, termijnen, overschrijving, afstand, grafbedekking, onderhoud en ruiming (aanhef, art. 1–24).&#10;&#10;De openbare versie is die van 2010, met toelichting; nieuwere versies staan in de Kennisbank decentrale regelgeving van SDU. De toelichting citeert art. 28 lid 7 Wet op de lijkbezorging nog met een termijn van twintig jaar; de huidige wet zegt tien jaar (tegenspraak)." />
              <property key="wiki-gemma-model synoniemen" value="VNG Model beheersverordening begraafplaatsen (beleid)" />
              <property key="wiki-gemma-model pagina" value="motivatie/beleidskaders/model-beheersverordening-begraafplaatsen.md" />
              <property key="wiki-gemma-model regelgever" value="VNG-model" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:Driver" name="Besluit op de lijkbezorging" id="id-c263c16949c15730b9ef86d9ddb548db">
              <documentation>Algemene maatregel van bestuur die de Wet op de lijkbezorging uitwerkt, onder meer voor het vervoer van een stoffelijk overschot naar en uit het buitenland.</documentation>
              <property key="wiki-gemma-model id" value="besluit-op-de-lijkbezorging" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-05T10:05:11" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-besluit-op-de-lijkbezorging-wettekst; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="Het Besluit op de lijkbezorging (BWBR0009080) regelt de modellen van de verklaring van overlijden, de eisen aan kist, graf en grafkelder, de inhoud van de registers van crematorium en plaats van bijzetting en het vervoer naar en uit het buitenland (art. 2–11). Voor de gemeente gaat het vooral om het laissez-passer voor lijken (art. 11) en de beslistermijn voor het verlof tot ontleding (art. 17)." />
              <property key="wiki-gemma-model pagina" value="motivatie/beleidskaders/besluit-op-de-lijkbezorging.md" />
              <property key="wiki-gemma-model regelgever" value="rijk" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
          </folder>
        </folder>
      </folder>
    </folder>
  </folder>
