              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessService" name="Briefadres aanvragen" id="id-cce2db3ca08e50aabfba66bfab95d134">
              <documentation>Het aanvragen van een inschrijving op een briefadres door iemand die geen woonadres heeft.</documentation>
              <property key="wiki-gemma-model id" value="briefadres-aanvragen" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2026-nvvb-beleidsregel-briefadres; 2026-rvig-hup-verblijfplaats" />
              <property key="wiki-gemma-model beschrijving" value="Wie geen woonadres heeft, vraagt een briefadres aan; daarvoor is een briefadresgever nodig die schriftelijk instemt (HUP Verblijfplaats). De NVVB-modelregeling kent een vragenformulier voor de aanvraag en een verklaring van toestemming (NVVB Beleidsregel briefadres). Grondslag is art. 2.23 Wet BRP; de aanvraag kan digitaal (UPL nr. 85)." />
              <property key="wiki-gemma-model synoniemen" value="Briefadres (UPL); Aanvraag briefadres (beleid)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/0-bestuur-en-ondersteuning/burgerzaken/briefadres-aanvragen.md" />
              <property key="wiki-gemma-model afnemer" value="extern" />
