            <element xsi:type="archimate:BusinessService" name="Paspoort tweede" id="id-72a676a811b25f72a8da16e8d6df6268">
              <documentation>Het aanvragen van een tweede paspoort naast het eerste, voor wie moet reizen terwijl het eerste voor een visum bij een buitenlandse vertegenwoordiging ligt.</documentation>
              <property key="wiki-gemma-model id" value="paspoort-tweede" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2026-rijk-paspoortwet-bwbr0005212; 2026-rijk-paspoortbesluit-bwbr0044308; 2026-utrecht-burgerzaken-paspoort-of-identiteitskaart-aanvragen" />
              <property key="wiki-gemma-model beschrijving" value="Op verzoek van een houder van een nationaal paspoort die aantoont dat hij achtereenvolgens verschillende landen moet bezoeken of regelmatig dringend moet reizen terwijl zijn paspoort voor visering bij een buitenlandse vertegenwoordiging ligt; de burgemeester beslist op het verzoek (Paspoortwet art. 30; Paspoortbesluit art. 2.14, 2.15, 3.1, 4.1). Strengere voorwaarden dan een gewoon paspoort (Utrecht). Grondslag art. 30 Paspoortwet (UPL nr. 330)." />
              <property key="wiki-gemma-model synoniemen" value="Tweede paspoort (beleid)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/0-bestuur-en-ondersteuning/burgerzaken/paspoort-tweede.md" />
