              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessService" name="Huwelijk" id="id-b25c4119727655aaa461f148c0c892a8">
              <documentation>Het laten voltrekken van een huwelijk door de ambtenaar van de burgerlijke stand, op een gekozen datum en locatie.</documentation>
              <property key="wiki-gemma-model id" value="huwelijk" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2026-utrecht-burgerzaken-trouwen-in-utrecht; 2026-rijk-burgerlijk-wetboek-boek-1" />
              <property key="wiki-gemma-model beschrijving" value="Na de melding van het voorgenomen huwelijk legt het paar locatie en datum vast, liefst drie maanden vooraf, met twee tot vier getuigen. Gemeenten bieden varianten met eigen tarieven, zoals gratis trouwen, eenvoudig trouwen, een flitshuwelijk of trouwen op een locatie naar keuze (Utrecht). Een geregistreerd partnerschap gaat op dezelfde manier. Grondslag art. 30 BW 1 (UPL nr. 184)." />
              <property key="wiki-gemma-model synoniemen" value="Trouwen (beleid)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/0-bestuur-en-ondersteuning/burgerzaken/huwelijk.md" />
