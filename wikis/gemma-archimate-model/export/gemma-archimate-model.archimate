              <property key="wiki-gemma-model domein" value="Publieksdiensten" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessService" name="Overlijdensakte" id="id-b39fc8b93c7254b6a62b756acb21f354">
              <documentation>Het verkrijgen van een uittreksel of afschrift van de akte van overlijden.</documentation>
              <property key="wiki-gemma-model id" value="overlijdensakte" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2026-utrecht-burgerzaken-overlijden-aangifte-doen; 2026-rijk-burgerlijk-wetboek-boek-1; 2026-utrecht-burgerzaken-uittreksel-of-akte-aanvragen; 2026-rijk-besluit-burgerlijke-stand-1994-bwbr0006493" />
              <property key="wiki-gemma-model beschrijving" value="De UPL noemt als grondslag art. 19f BW 1, het opmaken van de akte van overlijden; de afnemer krijgt een uittreksel, een internationaal uittreksel of een afschrift (Utrecht: € 17,80 in 2026). De akte zelf is een specialisatie van Akte van de burgerlijke stand. Een afschrift bevat ook de latere vermeldingen, een uittreksel de toestand op het moment van afgifte (Besluit burgerlijke stand art. 26)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/0-bestuur-en-ondersteuning/burgerzaken/overlijdensakte.md" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model domein" value="Publieksdiensten" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessService" name="Rijbewijs verlengen" id="id-b997cf79b5b251abb905ef12a184dd0f">
              <documentation>Het vernieuwen van een Nederlands rijbewijs bij de gemeente, aan de balie of online via de RDW, en het afhalen ervan.</documentation>
              <property key="wiki-gemma-model id" value="rijbewijs-verlengen" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2026-utrecht-burgerzaken-rijbewijs-aanvragen-of-verlengen; 2026-rijk-reglement-rijbewijzen-bwbr0008074" />
              <property key="wiki-gemma-model beschrijving" value="Wie in de gemeente staat ingeschreven en een Nederlands rijbewijs heeft, kan de verlenging of een categorie-uitbreiding onder bepaalde voorwaarden online aanvragen via de RDW, met een digitale pasfoto van een erkende fotograaf of fotocabine en de DigiD-app; hij haalt het rijbewijs twee werkdagen later op afspraak op (Utrecht). Bij vernieuwing wordt het eerdere rijbewijs overgelegd en, bij een groot rijbewijs, vanaf 75 jaar of na een aantekening van het CBR, moet een verklaring van geschiktheid zijn geregistreerd (Reglement rijbewijzen art. 35)." />
              <property key="wiki-gemma-model synoniemen" value="Rijbewijs vernieuwen (wet); Rijbewijs online verlengen (beleid)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/0-bestuur-en-ondersteuning/burgerzaken/rijbewijs-verlengen.md" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model domein" value="Publieksdiensten" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
