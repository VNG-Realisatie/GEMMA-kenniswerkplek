              <property key="wiki-gemma-model beschrijving" value="Zonder melding vooraf en zonder getuigen; wie in het buitenland woont laat het bij Den Haag doen (Utrecht). Grondslag art. 80g BW 1 (UPL nr. 156)." />
              <property key="wiki-gemma-model synoniemen" value="Omzetting (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/0-bestuur-en-ondersteuning/burgerzaken/geregistreerd-partnerschap-omzetting-in-huwelijk.md" />
