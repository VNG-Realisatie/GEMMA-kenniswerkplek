              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessService" name="BRP-inschrijving" id="id-ca0fde07cdc35c27b83d02c2a4598b86">
              <documentation>Inschrijving in de basisregistratie personen van wie zich vanuit het buitenland in de gemeente vestigt.</documentation>
              <property key="wiki-gemma-model id" value="brp-inschrijving" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2026-utrecht-burgerzaken-inschrijven-vanuit-het-buitenland; 2026-rvig-hup-immigratie; 2026-rvig-hup-verblijfplaats" />
              <property key="wiki-gemma-model beschrijving" value="Wie vanuit het buitenland in de gemeente komt wonen, maakt binnen vijf dagen een afspraak om zich in te schrijven, met identiteitsbewijs, bewijs van verblijfsrecht en eventueel buitenlandse akten; de inschrijving kan vier weken duren en levert ook een burgerservicenummer op (Utrecht Inschrijven vanuit het buitenland). Grondslag is art. 2.38 Wet BRP (UPL nr. 88)." />
              <property key="wiki-gemma-model synoniemen" value="Inschrijven vanuit het buitenland (beleid); Aangifte van verblijf en adres (wet)" />
