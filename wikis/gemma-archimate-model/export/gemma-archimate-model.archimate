        <element xsi:type="archimate:BusinessFunction" name="Exploiteren van begraafplaatsen" id="id-30deba14-c60a-49b2-b6d2-740a6d2539f5">
          <documentation>Het exploiteren van begraafplaatsen, inclusief ondersteunende diensten die bij het uitvoeren van een begrafenis verzorgd worden.</documentation>
          <property key="Object ID" value="30deba14-c60a-49b2-b6d2-740a6d2539f5" />
          <property key="Toelichting" value="Bijv. het uitgeven van grafrechten en verlenen van vergunningen voor plaatsen van grafstenen. BIj het verzorgen van diensten bij begrafenissen valt te denken aan: het graven van een graf, voorlopen, diverse diensten in de Aula e.d." />
          <property key="wiki-gemma-model id" value="exploiteren-van-begraafplaatsen" />
          <property key="wiki-gemma-model herkomst" value="gekoppeld" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model GEMMA-match" value="exact" />
          <property key="wiki-gemma-model bronnen" value="2026-vng-gemma-2026-10-02; 2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2010-vng-model-beheersverordening-begraafplaatsen; 2025-vng-upl-producten-en-diensten-extern" />
          <property key="wiki-gemma-model beschrijving" value="De gemeente heeft ten minste één gemeentelijke begraafplaats en is belast met het beheer, het onderhoud en de administratie ervan (Wet op de lijkbezorging art. 33, 39 lid 2). De functie bedient het beheer van graven en grafrechten en het begraven en bijzetten op de begraafplaats." />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsfuncties/fysieke-leefomgeving/exploiteren-van-begraafplaatsen.md" />
          <property key="wiki-gemma-model domein" value="Fysieke leefomgeving" />
        </element>
