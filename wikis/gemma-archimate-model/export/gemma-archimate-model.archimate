        <element xsi:type="archimate:BusinessFunction" name="Exploitatie fysieke leefomgeving" id="id-a4504f6c-e588-45d3-bf6e-8d86515d7696">
          <documentation>Het conform privaatrechtelijke grondslag exploiteren van de gemeentelijke voorzieningen zoals een zwembad, museum, parkeergarage of sportaccommodatie.</documentation>
          <property key="GEMMA type" value="Bedrijfsfunctie" />
          <property key="Object ID" value="a4504f6c-e588-45d3-bf6e-8d86515d7696" />
          <property key="wiki-gemma-model id" value="exploitatie-fysieke-leefomgeving" />
