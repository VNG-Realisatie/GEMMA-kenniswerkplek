              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessService" name="BRP-adoptie-uitschrijving" id="id-86b641d4ae0e5c8b8e5d64a6ccb0459b">
              <documentation>Het verzoek om gegevens van vóór een adoptie of geslachtswijziging van de persoonslijst te laten verwijderen.</documentation>
