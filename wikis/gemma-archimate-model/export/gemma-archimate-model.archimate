              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessService" name="Vermissing of diefstal reisdocument doorgeven" id="id-55478cb19a675ad781eb5aea41ee6c19">
              <documentation>Het melden bij de gemeente dat een paspoort of identiteitskaart kwijt of gestolen is, zodat het document ongeldig wordt en misbruik wordt voorkomen.</documentation>
              <property key="wiki-gemma-model id" value="vermissing-of-diefstal-reisdocument-doorgeven" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-utrecht-burgerzaken-paspoort-of-identiteitskaart-vermissing-of-diefstal-doorgeven; 2026-rvig-hup-inhouding-inlevering-vermissing" />
              <property key="wiki-gemma-model beschrijving" value="Gratis, online en per document; vanaf achttien jaar meldt de houder zelf, voor een kind tot en met elf jaar een ouder, van twaalf tot en met zeventien jaar het kind of een ouder. Een als vermist opgegeven document is niet meer geldig, ook niet als het terugkomt, en moet dan worden ingeleverd (Utrecht). De Paspoortwet laat de houder de vermissing melden op een bij ministeriële regeling bepaalde wijze (art. 5a). De UPL kent geen product voor deze melding; zie de terugmelding." />
              <property key="wiki-gemma-model synoniemen" value="Paspoort of identiteitskaart, vermissing of diefstal doorgeven (beleid); Verklaring van vermissing (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/0-bestuur-en-ondersteuning/burgerzaken/vermissing-of-diefstal-reisdocument-doorgeven.md" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model domein" value="Publieksdiensten" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessService" name="Vreemdelingenpaspoort" id="id-56a050284f4151babe67c728cdf42128">
              <documentation>Het aanvragen en ophalen van een reisdocument voor vreemdelingen, voor wie in Nederland verblijft en geen eigen nationaal paspoort kan krijgen.</documentation>
              <property key="wiki-gemma-model id" value="vreemdelingenpaspoort" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2026-rijk-paspoortwet-bwbr0005212; 2026-utrecht-burgerzaken-paspoort-of-identiteitskaart-aanvragen" />
              <property key="wiki-gemma-model beschrijving" value="Voor wie een geldig verblijfsdocument regulier heeft, geen eigen nationaal paspoort heeft en het niet bij de eigen autoriteiten kan aanvragen; de aanvraag wordt voorgelegd aan de IND en het ministerie van Buitenlandse Zaken (Utrecht). De verstrekking volgt pas als de minister van Justitie en Veiligheid heeft vastgesteld dat aan de voorwaarden is voldaan (Paspoortwet art. 12 tot en met 15, 40 lid 4). De UPL noemt als grondslag art. 11 Paspoortwet (UPL nr. 462)." />
              <property key="wiki-gemma-model synoniemen" value="Reisdocument voor vreemdelingen aanvragen (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/0-bestuur-en-ondersteuning/burgerzaken/vreemdelingenpaspoort.md" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model domein" value="Publieksdiensten" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessService" name="Bewijs van nederlanderschap" id="id-57b557212ec35d25ae7c486128d97cc5">
              <documentation>Het verkrijgen van een bewijs dat iemand de Nederlandse nationaliteit bezit, als uittreksel uit de basisregistratie personen.</documentation>
