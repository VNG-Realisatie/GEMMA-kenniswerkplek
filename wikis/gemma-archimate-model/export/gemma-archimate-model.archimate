              <property key="wiki-gemma-model beschrijving" value="De inschrijving is gratis en op afspraak; de persoon krijgt aan de balie een BSN en een afschrift van de opgenomen gegevens (Utrecht RNI). Grondslag is art. 2.66 Wet BRP (UPL nr. 369)." />
              <property key="wiki-gemma-model synoniemen" value="Inschrijven RNI (beleid)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/0-bestuur-en-ondersteuning/burgerzaken/rni-inschrijving.md" />
