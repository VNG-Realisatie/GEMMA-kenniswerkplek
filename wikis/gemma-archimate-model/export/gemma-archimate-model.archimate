              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessService" name="BRP-wijzigingsverzoek" id="id-140bcdf33b1b50489151ad8a57766322">
              <documentation>Het verzoek om onjuiste eigen gegevens in de basisregistratie personen te laten corrigeren.</documentation>
