            <element xsi:type="archimate:BusinessService" name="Uittreksel burgerlijke stand" id="id-e2c3bf05e85f585e8f73560cb158dbc1">
              <documentation>Het verkrijgen van een afschrift of uittreksel van een akte van de burgerlijke stand.</documentation>
              <property key="wiki-gemma-model id" value="uittreksel-burgerlijke-stand" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2026-utrecht-burgerzaken-uittreksel-of-akte-aanvragen; 2026-rijk-burgerlijk-wetboek-boek-1; 2026-rijk-besluit-burgerlijke-stand-1994-bwbr0006493" />
              <property key="wiki-gemma-model beschrijving" value="Alleen bij de gemeente waar de gebeurtenis plaatsvond; online met vooraf betalen en verzending per post, of aan de balie op afspraak; meertalig in tien talen; Utrecht € 17,80 in 2026 (Utrecht). Een uittreksel uit de BRP, over de huidige situatie, is een andere dienst (BRP-uittreksel). Grondslag art. 23b BW 1 (UPL nr. 23)." />
              <property key="wiki-gemma-model synoniemen" value="Akte van de burgerlijke stand (UPL); Afschrift of uittreksel van een akte (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/diensten/0-bestuur-en-ondersteuning/burgerzaken/uittreksel-burgerlijke-stand.md" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model domein" value="Publieksdiensten" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessService" name="Naamgebruik verzoek aanduiding" id="id-e7a99ad3ce985e3d95f9ac033bf496a8">
              <documentation>Het kiezen welke achternaam de overheid gebruikt na een huwelijk of geregistreerd partnerschap: de eigen, die van de partner of een combinatie.</documentation>
              <property key="wiki-gemma-model id" value="naamgebruik-verzoek-aanduiding" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-08T08:42:26" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
