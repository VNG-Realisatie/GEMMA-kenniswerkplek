              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessService" name="Legalisatie handtekening" id="id-48e1b543cdd55f42884fc388ef30176d">
              <documentation>Het bewijzen dat een handtekening echt is, doordat de gemeente haar vergelijkt met de handtekening op het identiteitsbewijs.</documentation>
              <property key="wiki-gemma-model id" value="legalisatie-handtekening" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
