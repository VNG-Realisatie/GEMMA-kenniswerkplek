      </folder>
      <folder name="Procesindeling naar taak" id="id-5a2ea782586655bcb03c08a86e6935c9">
        <folder name="0 Bestuur en Ondersteuning" id="id-6a8e87305e04547192d63e46f7824210">
          <folder name="Burgerzaken" id="id-c8ce59de3ce455719db3d8caee036f9d">
            <element xsi:type="archimate:BusinessProcess" name="Behandelen verzoek om verwijdering van gegevens" id="id-066b19a1277659a7bad68fb6357d7736">
              <documentation>Het beslissen op een verzoek om gegevens van vóór een adoptie of geslachtswijziging van de persoonslijst te verwijderen.</documentation>
              <property key="wiki-gemma-model id" value="behandelen-verzoek-om-verwijdering-van-gegevens" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-utrecht-burgerzaken-persoonsgegevens-opvragen-of-aanpassen-brp; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="Na een adoptie of een wijziging van de vermelding van het geslacht kunnen de betrokkenen schriftelijk vragen de oude gegevens van de persoonslijst te verwijderen: voor een adoptiekind jonger dan 16 jaar de adoptieouders, daarna het kind zelf, en de biologische ouders voor de gegevens over het kind; bij een geslachtswijziging de ingeschrevene, of voor hem de ouder, voogd of curator (Utrecht Gegevens verwijderen). De gemeente neemt binnen vier weken een besluit waartegen bezwaar mogelijk is (Utrecht). Het afvoeren van een ten onrechte opgenomen persoonslijst is een registratiestap zonder eigen besluit (HUP Afvoeren persoonslijst)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/behandelen-verzoek-om-verwijdering-van-gegevens.md" />
              <property key="wiki-gemma-model procesniveau" value="deelproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="ingeschreven-persoon" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Behandelen verzoek om correctie" id="id-0c641a76f6495bb2ac35bcadfac15e94">
              <documentation>Het beslissen op een verzoek van een ingeschrevene om onjuiste gegevens in de basisregistratie personen te corrigeren.</documentation>
              <property key="wiki-gemma-model id" value="behandelen-verzoek-om-correctie" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-utrecht-burgerzaken-persoonsgegevens-opvragen-of-aanpassen-brp; 2026-rvig-hup-correcties-en-ten-onrechte-opgenomen-gegevens; 2018-nvvb-stappenplan-identiteitswijziging-brp; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="De burger kan vragen gegevens te laten aanpassen: adresgegevens, zoals een onjuiste inschrijfdatum, of persoonsgegevens zoals naam, geslacht en geboortedatum, met bewijsstukken; de gemeente beoordeelt de bewijsstukken en neemt binnen vier weken een besluit waartegen bezwaar mogelijk is (Utrecht Persoonsgegevens aanpassen). Wijzigt daardoor in feite de identiteit, zoals bij een andere geboortedatum, dan zijn gemeenten bijzonder terughoudend; de NVVB heeft een stappenplan, een model rectificatieverzoek en een model weigeringsbeschikking (NVVB Identiteitswijziging). Correcties na een eigen constatering of een onderzoek zijn registratiestappen zonder eigen besluit (HUP Correcties)." />
              <property key="wiki-gemma-model synoniemen" value="Correctieverzoek (HUP)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/behandelen-verzoek-om-correctie.md" />
              <property key="wiki-gemma-model procesniveau" value="deelproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="ingeschreven-persoon" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Verzorgen burgerzaken" id="id-17cd0277d8255b70b97932d2c5d7fccd">
              <documentation>Gemeentelijke taak rond burgerzaken: het bijhouden van de persoonsgegevens, de burgerlijke stand, reisdocumenten, het Nederlanderschap en het kiesrecht.</documentation>
              <property key="wiki-gemma-model id" value="verzorgen-burgerzaken" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-brp-bwbr0033715; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="Het college houdt de basisregistratie personen bij en verstrekt de gegevens daaruit (Wet BRP art. 1.4). De taak groepeert de processen daarvoor, één per kernobject; nu Bijhouden persoonsgegevens met de ingeschreven persoon als kernobject." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/verzorgen-burgerzaken.md" />
              <property key="wiki-gemma-model procesniveau" value="taak" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Bijhouden persoonsgegevens" id="id-1f731112e5db53e0a1d0cfb864edc17a">
              <documentation>Het bijhouden van de gegevens van een ingeschreven persoon in de basisregistratie personen, van inschrijving tot opschorting.</documentation>
              <property key="wiki-gemma-model id" value="bijhouden-persoonsgegevens" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rvig-hup-algemeen; 2026-rvig-hup-achtergronden-en-begrippen; 2023-rvig-circulaire-adresonderzoek-brp; 2025-rvig-logisch-ontwerp-brp-2025q1; 2026-rvig-hup-intergemeentelijke-adreswijziging; 2026-rijk-besluit-brp-bwbr0034306; 2026-rvig-hup-immigratie; 2026-rvig-hup-hervestiging; 2026-utrecht-burgerzaken-registratie-niet-ingezetenen-rni-inschrijven; 2026-rvig-hup-binnengemeentelijke-adreswijziging; 2026-rvig-hup-emigratie; 2026-rvig-hup-verblijfplaats; 2026-rvig-hup-verstrekkingsbeperking; 2024-nvvb-schema-schriftelijke-gegevensverstrekking-brp; 2026-utrecht-burgerzaken-persoonsgegevens-brp-bekijken-en-overzicht-aanvragen; 2025-vng-upl-producten-en-diensten-extern; 2026-rvig-hup-correcties-en-ten-onrechte-opgenomen-gegevens; 2026-utrecht-burgerzaken-persoonsgegevens-opvragen-of-aanpassen-brp; 2026-rvig-hup-wijzigen-identificatienummers; 2026-rijk-wet-brp-bwbr0033715" />
              <property key="wiki-gemma-model beschrijving" value="Bijhouden omvat het inschrijven van personen en het actualiseren, corrigeren en verwijderen van gegevens (HUP Achtergronden). De bijhouding is per gebeurtenis opgezet: een aangifte van de persoon, een akte uit de registers van de burgerlijke stand of een ander document, zoals een buitenlandse akte of een rechterlijke uitspraak; de gemeente ontleent de gegevens aan zulke brondocumenten (HUP Algemeen; HUP Achtergronden). Het college van de gemeente waar een ingezetene zijn adres heeft is verantwoordelijk; bij een verhuizing naar een andere gemeente gaat de persoonslijst naar de nieuwe bijhoudingsgemeente, bij emigratie naar de RNI (HUP Achtergronden; LO BRP 1.6).&#10;&#10;Registratiestappen zonder eigen besluit of product zijn processtappen zonder pagina: het onderzoeken en in onderzoek stellen van gegevens, het vaststellen van de identiteit, het afvoeren van een persoonslijst na een dubbele inschrijving en het leggen van relaties tussen persoonslijsten (HUP Proceduregegevens; HUP Dubbelinschrijving; HUP Gerelateerden)." />
              <property key="wiki-gemma-model synoniemen" value="Bijhouding (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/bijhouden-persoonsgegevens.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="ingeschreven-persoon" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Behandelen verzoek om geheimhouding" id="id-2fb8a0f54f775b1980b9b7047ba889d1">
              <documentation>Het verwerken van een verzoek om persoonsgegevens niet aan bepaalde derden te verstrekken, of om die geheimhouding te beëindigen.</documentation>
              <property key="wiki-gemma-model id" value="behandelen-verzoek-om-geheimhouding" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-utrecht-burgerzaken-persoonsgegevens-geheimhouden; 2026-rvig-hup-verstrekkingsbeperking; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="De burger kan verstrekking aan overheidsorganen op grond van een autorisatiebesluit niet tegenhouden, maar wel schriftelijk verzoeken geen gegevens te verstrekken aan bepaalde derden (HUP Verstrekkingsbeperking). Het verzoek is vormvrij en hoeft niet te worden gemotiveerd; de gemeente stelt de identiteit vast, verwerkt het binnen vier weken, bevestigt het schriftelijk en weigert het niet als de juiste persoon het doet (HUP Verstrekkingsbeperking). Online kan het met DigiD binnen vijf werkdagen; de geheimhouding verhuist mee naar een nieuwe gemeente (Utrecht Persoonsgegevens geheimhouden)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/behandelen-verzoek-om-geheimhouding.md" />
              <property key="wiki-gemma-model procesniveau" value="deelproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="ingeschreven-persoon" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Inschrijven ingezetene" id="id-3044d66d8ce65ffa81be0f88936c11e0">
              <documentation>Het inschrijven van een persoon die zich vanuit het buitenland in de gemeente vestigt als ingezetene in de basisregistratie personen.</documentation>
              <property key="wiki-gemma-model id" value="inschrijven-ingezetene" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-utrecht-burgerzaken-inschrijven-vanuit-het-buitenland; 2026-rvig-hup-immigratie; 2026-rvig-hup-hervestiging; 2026-rijk-besluit-brp-bwbr0034306; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="Wie zich vanuit het buitenland in de gemeente vestigt, doet uiterlijk de vijfde dag na aanvang van het verblijf in persoon aangifte van verblijf en adres (HUP Immigratie). De gemeente stelt de identiteit vast, toetst de criteria (waaronder rechtmatig verblijf), gaat na of de persoon al in de BRP of RNI voorkomt, verifieert het adres en schrijft de persoon in met een A-nummer en een BSN; binnen vier weken stuurt zij een volledig overzicht van de persoonslijst (HUP Immigratie; Utrecht Inschrijven vanuit het buitenland). Kan de geboortedatum of de vreemde nationaliteit niet uit de gewone bronnen worden ontleend, dan vraagt de gemeente een mededeling ex artikel 2.17 Wet BRP op bij de IND (NVVB mededeling art. 2.17). Ontbreekt een brondocument, dan neemt de gemeente een verklaring onder eed of belofte af (HUP Immigratie; UPL nr. 335).&#10;&#10;Bij een hervestiging staat de persoon al in de RNI: de gemeente wordt bijhoudingsgemeente en stelt alle gegevens vast aan de hand van brondocumenten (HUP Hervestiging). Het college beslist over de inschrijving (Besluit BRP art. 24)." />
              <property key="wiki-gemma-model synoniemen" value="Eerste inschrijving (LO BRP)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/inschrijven-ingezetene.md" />
              <property key="wiki-gemma-model procesniveau" value="deelproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="ingeschreven-persoon" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Uitvoeren adresonderzoek" id="id-51cd6df863dd53da8fe6bbce08d29ad6">
              <documentation>Het onderzoeken of een persoon woont op het adres waarop hij is ingeschreven, en het besluiten over een juiste inschrijving.</documentation>
              <property key="wiki-gemma-model id" value="uitvoeren-adresonderzoek" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2023-rvig-circulaire-adresonderzoek-brp; 2026-utrecht-burgerzaken-onjuiste-inschrijving-op-uw-adres-melding-doen-adresonderzoek; 2026-nvvb-handreiking-adresonderzoek; 2026-rijk-besluit-brp-bwbr0034306" />
              <property key="wiki-gemma-model beschrijving" value="Het adresonderzoek is het instrument waarmee de gemeente een verkeerde adresinschrijving verbetert; zij start het bij twijfel over de juistheid van adresgegevens (Circulaire adresonderzoek par. 2). Aanleidingen zijn een melding van een bewoner of organisatie, een terugmelding van een bestuursorgaan, een signaal uit de Landelijke Aanpak Adreskwaliteit (LAA), een eigen constatering of een aangifte van verhuizing (Circulaire adresonderzoek; NVVB Handreiking adresonderzoek). De gemeente legt een onderzoeksdossier aan, plaatst een aantekening in onderzoek, schrijft de persoon aan, kan een huisbezoek laten afleggen door een toezichthouder BRP en neemt na een voornemen een besluit; de melder wordt over het resultaat geïnformeerd (Circulaire adresonderzoek 3.2–4.7). Een richtlijn voor de doorlooptijd is tien weken.&#10;&#10;De uitkomst is: woont nog op het adres, inschrijving op een briefadres, vestiging vanuit het buitenland, ambtshalve verhuizing binnen of naar een andere gemeente, of ambtshalve vertrek naar het buitenland of naar een onbekend land (Circulaire adresonderzoek 4.8)." />
              <property key="wiki-gemma-model synoniemen" value="Adresonderzoek (beleid)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/uitvoeren-adresonderzoek.md" />
              <property key="wiki-gemma-model procesniveau" value="deelproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="verblijfplaats" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Verwerken emigratie" id="id-6c6d0392474d50fdada6188db6b42a75">
              <documentation>Het verwerken van het vertrek van een ingezetene naar het buitenland, waarna hij als niet-ingezetene in de RNI staat.</documentation>
              <property key="wiki-gemma-model id" value="verwerken-emigratie" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-utrecht-burgerzaken-emigratie-doorgeven; 2026-rvig-hup-emigratie; 2026-rijk-besluit-brp-bwbr0034306; 2025-rvig-logisch-ontwerp-brp-2025q1; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="Wie ten minste twee derde van een jaar in het buitenland gaat wonen, doet aangifte van vertrek, vanaf vijf dagen voor het vertrek; ook een verhuizing naar het Caribisch deel van het Koninkrijk is een emigratie, waarbij de persoon kosteloos een verhuisbericht krijgt (HUP Emigratie; Regeling BRP bijlage 9). Na verwerking verhuist de persoonslijst naar de RNI en blijft de laatste bijhoudingsgemeente verantwoordelijk voor rechtsfeiten van voor de emigratie (HUP Emigratie). Is de persoon niet te bereiken, dan neemt de gemeente het vertrek ambtshalve op na een adresonderzoek (HUP Emigratie; Circulaire adresonderzoek 4.8)." />
              <property key="wiki-gemma-model synoniemen" value="Uitschrijving (dagelijks gebruik)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/verwerken-emigratie.md" />
              <property key="wiki-gemma-model procesniveau" value="deelproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="ingeschreven-persoon" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Inschrijven niet-ingezetene" id="id-8335638935c759c0bfc047c9869aefac">
              <documentation>Het inschrijven van een persoon die niet in Nederland woont in de registratie niet-ingezetenen, door een gemeente die RNI-loket is.</documentation>
              <property key="wiki-gemma-model id" value="inschrijven-niet-ingezetene" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-utrecht-burgerzaken-registratie-niet-ingezetenen-rni-inschrijven; 2025-vng-upl-producten-en-diensten-extern; 2026-rvig-hup-achtergronden-en-begrippen" />
              <property key="wiki-gemma-model beschrijving" value="Wie niet in Nederland woont maar een relatie heeft met de Nederlandse overheid, of hooguit vier maanden in Nederland blijft, laat zich inschrijven in de RNI en krijgt een BSN (Utrecht RNI). De inschrijving gebeurt op verzoek bij een RNI-loket of op voordracht van een aangewezen bestuursorgaan; de minister van BZK is verantwoordelijk voor de RNI (HUP Achtergronden; LO BRP 1.5.2). Utrecht schrijft sinds 2026 alleen personen met een Europees paspoort in; anderen gaan naar andere RNI-loketten (Utrecht RNI)." />
              <property key="wiki-gemma-model synoniemen" value="Inschrijving in de RNI (beleid)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/inschrijven-niet-ingezetene.md" />
              <property key="wiki-gemma-model procesniveau" value="deelproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="ingeschreven-persoon" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Verwerken adreswijziging" id="id-8e8bd36b60d658e39e878025d8f3b7af">
              <documentation>Het verwerken van een verhuizing binnen of naar de gemeente in de verblijfplaats van de ingeschreven persoon.</documentation>
              <property key="wiki-gemma-model id" value="verwerken-adreswijziging" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-utrecht-burgerzaken-verhuizing-doorgeven; 2026-rvig-hup-binnengemeentelijke-adreswijziging; 2026-rvig-hup-intergemeentelijke-adreswijziging; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="Wie binnen of naar de gemeente verhuist, doet aangifte van adreswijziging, vanaf vier weken voor tot de vijfde dag na de verhuizing; alle verhuizende personen ondertekenen, de aangifte kan schriftelijk of digitaal met DigiD en de gemeente kan de betrouwbaarheid controleren (HUP Binnengemeentelijke adreswijziging; Utrecht Verhuizing doorgeven). Bij een verhuizing vanuit een andere gemeente wordt de nieuwe gemeente bijhoudingsgemeente en neemt zij de persoonslijst over, met openstaande onderzoeken (HUP Intergemeentelijke adreswijziging). Wie bij iemand anders gaat wonen, levert een verklaring van inwoning van de hoofdbewoner (Utrecht).&#10;&#10;Een infrastructurele wijziging zonder verhuizing (straatnaamwijziging, vernummering, gemeentelijke herindeling) wordt als adreswijziging verwerkt, zonder aangifte (HUP Binnengemeentelijke en Intergemeentelijke adreswijziging)." />
              <property key="wiki-gemma-model synoniemen" value="Binnengemeentelijke adreswijziging (HUP); Intergemeentelijke adreswijziging (HUP)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/verwerken-adreswijziging.md" />
              <property key="wiki-gemma-model procesniveau" value="deelproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="verblijfplaats" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Verstrekken overzicht gegevensverstrekkingen" id="id-b0865bca9d145725bba952ae7ff4f096">
              <documentation>Het op verzoek leveren van een overzicht aan een ingeschrevene van welke gegevens over hem aan wie zijn verstrekt.</documentation>
              <property key="wiki-gemma-model id" value="verstrekken-overzicht-gegevensverstrekkingen" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-utrecht-burgerzaken-persoonsgegevens-brp-bekijken-en-overzicht-aanvragen; 2025-vng-upl-producten-en-diensten-extern; 2025-rvig-logisch-ontwerp-brp-2025q1; 2026-rijk-besluit-brp-bwbr0034306" />
              <property key="wiki-gemma-model beschrijving" value="Wie in de gemeente staat ingeschreven, kan een overzicht vragen van de persoonsgegevens die uit de BRP zijn verstrekt en wanneer; het Ministerie van BZK levert de gegevens (vanaf 6 januari 2013), de gemeente stuurt het overzicht met een begeleidende brief per beveiligde e-mail of aangetekende post (Utrecht Persoonsgegevens bekijken). Het overzicht wordt gemaakt met de ProtocolleringsOverzichtModule (LO BRP 1.5.2)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/verstrekken-overzicht-gegevensverstrekkingen.md" />
              <property key="wiki-gemma-model procesniveau" value="deelproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="ingeschreven-persoon" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Inschrijven op briefadres" id="id-c13031998c565bd9882281bc2ab4996c">
              <documentation>Het beoordelen van een aangifte van een briefadres en het inschrijven van een persoon zonder woonadres op een briefadres.</documentation>
              <property key="wiki-gemma-model id" value="inschrijven-op-briefadres" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-nvvb-beleidsregel-briefadres; 2025-vng-upl-producten-en-diensten-extern; 2026-rvig-hup-verblijfplaats" />
              <property key="wiki-gemma-model beschrijving" value="Een briefadres wordt geregistreerd als iemand geen woonadres heeft, in een aangewezen instelling verblijft of als de burgemeester opneming van het woonadres om veiligheidsredenen niet wenselijk vindt; de briefadresgever stemt schriftelijk in (HUP Verblijfplaats). Het college beoordeelt of de aangifte kan worden ingewilligd en wijst zo nodig een rechtspersoon als briefadresgever aan (HUP Verblijfplaats). Sinds 1 januari 2022 registreert de gemeente iemand zonder woonadres die geen aangifte doet ambtshalve op een briefadres; de NVVB heeft daarvoor een modelregeling met een aanvraagformulier, een toestemmingsverklaring en een beheerregeling (NVVB Beleidsregel briefadres)." />
              <property key="wiki-gemma-model synoniemen" value="Aangifte van een briefadres (HUP)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/inschrijven-op-briefadres.md" />
              <property key="wiki-gemma-model procesniveau" value="deelproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="briefadres" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Wijzigen identificatienummers" id="id-eab1b4319876559cae8350d8b12596c1">
              <documentation>Het wijzigen van het burgerservicenummer of het administratienummer van een ingeschreven persoon.</documentation>
              <property key="wiki-gemma-model id" value="wijzigen-identificatienummers" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rvig-hup-wijzigen-identificatienummers; 2026-rvig-hup-wijzigen-bsn; 2026-rvig-hup-wijzigen-administratienummer" />
              <property key="wiki-gemma-model beschrijving" value="Het BSN wordt gewijzigd bij een dubbele inschrijving, zodat één juiste persoonslijst overblijft; het college van de bijhoudingsgemeente besluit, weegt de belangen van de persoon af (toeslagen, pensioen) en informeert hem; een geldig reisdocument vervalt dan van rechtswege (HUP Wijzigen BSN). Het A-nummer wordt gewijzigd als meer personen hetzelfde nummer hebben gekregen; de gemeente kent dan nieuwe nummers toe en meldt dat aan de andere gemeenten, de RNI en de BRP-verstrekkingsvoorziening (HUP Wijzigen administratienummer)." />
              <property key="wiki-gemma-model synoniemen" value="Wijzigen BSN (HUP); Wijzigen A-nummer (HUP)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/wijzigen-identificatienummers.md" />
              <property key="wiki-gemma-model procesniveau" value="deelproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="ingeschreven-persoon" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Verstrekken persoonsgegevens" id="id-f797baac19cd5ed9abdd82a96c2ba2ce">
              <documentation>Het beslissen op een verzoek om gegevens uit de basisregistratie personen en het verstrekken ervan aan de ingeschrevene of aan anderen.</documentation>
              <property key="wiki-gemma-model id" value="verstrekken-persoonsgegevens" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2024-nvvb-schema-schriftelijke-gegevensverstrekking-brp; 2026-utrecht-burgerzaken-persoonsgegevens-brp-bekijken-en-overzicht-aanvragen; 2025-vng-upl-producten-en-diensten-extern; 2026-rijk-besluit-brp-bwbr0034306" />
              <property key="wiki-gemma-model beschrijving" value="Het college ontvangt verzoeken om gegevens uit de BRP: van de ingeschrevene zelf (inzage, kopie, uittreksel; art. 2.55 Wet BRP) en van overheidsorganen, bij besluit aangewezen derden, bij gemeentelijke verordening aangewezen derden en overige verzoekers (NVVB Schema; UPL). De medewerker stelt vast wie verzoekt en waarvoor, deelt het verzoek in, verstrekt de gegevens die daarbij horen en protocolleert de verstrekking; bij een geregistreerde verstrekkingsbeperking volgt een belangenafweging (NVVB Schema). Gegevens in onderzoek worden met vermelding daarvan verstrekt; verzoeken over niet-ingezetenen gaan naar een RNI-loket (NVVB Schema).&#10;&#10;De systematische verstrekking aan afnemers loopt via de BRP-verstrekkingsvoorziening van de minister, niet via dit proces (LO BRP 1.5.2; Besluit BRP art. 37)." />
              <property key="wiki-gemma-model synoniemen" value="Schriftelijke gegevensverstrekking (beleid)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/0-bestuur-en-ondersteuning/burgerzaken/verstrekken-persoonsgegevens.md" />
              <property key="wiki-gemma-model procesniveau" value="deelproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="ingeschreven-persoon" />
              <property key="wiki-gemma-model taakveld" value="0 Bestuur en Ondersteuning" />
              <property key="wiki-gemma-model beleidsdomein" value="Burgerzaken" />
            </element>
          </folder>
        </folder>
        <folder name="7 Volksgezondheid en Milieu" id="id-b6d15ba2baa35732a8115e44ce770f1a">
          <folder name="Begraafplaatsen en crematoria" id="id-89b6653d88455d32b8d84704fe50f5fe">
            <element xsi:type="archimate:BusinessProcess" name="Verlenen toestemming asverstrooiing" id="id-230de6a7ba9e53e0a76ee579c8196885">
              <documentation>Het beslissen op een verzoek om as te verstrooien op een plek waar dat zonder toestemming verboden is.</documentation>
              <property key="wiki-gemma-model id" value="verlenen-toestemming-asverstrooiing" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-groningen-algemene-plaatselijke-verordening; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2026-rijk-wet-op-de-lijkbezorging-wettekst; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="Buiten de begraafplaats verleent het college op verzoek van de nabestaande die zorgdraagt voor de asbus bij bijzondere omstandigheden ontheffing van het verbod op de plaatsen uit de APV (APV Groningen art. 5:27 lid 3). Op de gemeentelijke begraafplaats geeft het college toestemming voor verstrooiing op een aangewezen plek (Groningen art. 21 lid 1–2). Beslisser is het college.&#10;&#10;Het verstrooien zelf hoort bij Bijzetten of verstrooien van de as." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/verlenen-toestemming-asverstrooiing.md" />
              <property key="wiki-gemma-model procesniveau" value="deelproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="urn" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Beheren grafrechten" id="id-2644dde5bf4c5a80b29f7c7663de02c7">
              <documentation>Het beheer van een grafrecht over de hele looptijd: verlenen, verlengen, overschrijven en vervallen.</documentation>
              <property key="wiki-gemma-model id" value="beheren-grafrechten" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2010-vng-model-beheersverordening-begraafplaatsen; 2026-rijk-wet-op-de-lijkbezorging-wettekst" />
              <property key="wiki-gemma-model beschrijving" value="Het grafrecht wordt schriftelijk gevestigd voor onbepaalde tijd of voor ten minste tien jaar, en op verzoek verlengd (Wet op de lijkbezorging art. 28 lid 1–3). Het college verleent het recht op aanvraag, schrijft het over en kan het vervallen verklaren; het recht vervalt ook als na een verklaring van verwaarlozing niet alsnog in het onderhoud is voorzien (Groningen art. 16–20; art. 28 lid 4–7)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/beheren-grafrechten.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="grafrecht" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Ruimen graf" id="id-2de444e3552c5f908f12c6a6868cadfa">
              <documentation>Het leegmaken van een graf, waarbij de resten worden herbegraven en de as wordt verstrooid.</documentation>
              <property key="wiki-gemma-model id" value="ruimen-graf" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2010-vng-model-beheersverordening-begraafplaatsen; 2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen" />
              <property key="wiki-gemma-model beschrijving" value="Een graf wordt geruimd op last van de houder van de begraafplaats, na ten minste tien jaar na de laatste begraving en bij een particulier graf met toestemming van de rechthebbende (art. 31). Het college kondigt een ruiming ten minste een jaar vooraf aan, per brief of met een bordje bij het graf en op het mededelingenbord; de beheerder ziet toe op een respectvolle omgang met de resten, die worden herbegraven, terwijl de as wordt verstrooid (Groningen art. 27; VNG-model art. 24). Asbussen worden geruimd door verstrooiing van de as (art. 66)." />
              <property key="wiki-gemma-model synoniemen" value="Ruiming (beleid); Ruimen van graven (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/ruimen-graf.md" />
              <property key="wiki-gemma-model procesniveau" value="deelproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="graf" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Beheren graven" id="id-33d71105e2d25cd892c59c94ec68d297">
              <documentation>Het beheer van een graf over de hele levensloop: uitgeven, begraven en bijzetten, onderhouden en ruimen.</documentation>
              <property key="wiki-gemma-model id" value="beheren-graven" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen" />
              <property key="wiki-gemma-model beschrijving" value="De houder van de begraafplaats bepaalt bij een algemeen graf wie erin wordt begraven, houdt het register van begraven lijken bij en ruimt graven na ten minste tien jaar grafrust (Wet op de lijkbezorging art. 23, 27, 31). Op de gemeentelijke begraafplaats regelt de beheersverordening de soorten graven, de uitgifte, het onderhoud en de ruiming (Groningen art. 11–16, 23, 27)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/beheren-graven.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="graf" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Beheren begraafplaatsen" id="id-35cade79cce6571e814c3084684d0397">
              <documentation>Het beheer van een begraafplaats over de hele levensloop: aanleggen, in gebruik nemen, sluiten en opheffen.</documentation>
              <property key="wiki-gemma-model id" value="beheren-begraafplaatsen" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst" />
              <property key="wiki-gemma-model beschrijving" value="Elke gemeente heeft ten minste één gemeentelijke begraafplaats, alleen of samen met andere gemeenten; voor aanleg op het grondgebied van een andere gemeente is toestemming van de raad van die gemeente nodig (Wet op de lijkbezorging art. 33, 36). Voor een bijzondere begraafplaats wijst de raad de grond aan en geeft het college toestemming voor de ingebruikneming (art. 40, 41). Het college kan een gemeentelijke begraafplaats sluiten, of gesloten verklaren als er tien jaar niet is begraven (art. 43, 44). Een begraafplaats houdt op te bestaan als de grond die bestemming verloor en er geen graf meer is (art. 47)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/beheren-begraafplaatsen.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="begraafplaats" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Verlenen verlof tot ontleding" id="id-3d946a179e735290aeea986a5aae209a">
              <documentation>Het afgeven van het schriftelijk verlof waarmee een stoffelijk overschot mag worden ontleed.</documentation>
              <property key="wiki-gemma-model id" value="verlenen-verlof-tot-ontleding" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-rijk-besluit-op-de-lijkbezorging-wettekst; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="Ontleding gebeurt alleen met schriftelijk verlof van de burgemeester, dat binnen drie dagen kosteloos wordt afgegeven en de plaats van ontleding vermeldt; tegen het besluit staat binnen 24 uur beroep open bij de commissaris van de Koning (Wet op de lijkbezorging art. 68). Beslisser is de burgemeester. De ontleding zelf hoort bij Uitvoeren lijkbezorging." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/verlenen-verlof-tot-ontleding.md" />
              <property key="wiki-gemma-model procesniveau" value="deelproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="stoffelijk-overschot" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Stellen andere termijn" id="id-5a96b5b99c4355e799bb7898f48f7066">
              <documentation>Het toestaan dat een overledene eerder dan 36 uur of later dan de zesde werkdag na het overlijden wordt begraven of gecremeerd.</documentation>
              <property key="wiki-gemma-model id" value="stellen-andere-termijn" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-rvo-aangifte-en-akte-van-overlijden" />
              <property key="wiki-gemma-model beschrijving" value="Begraving of crematie geschiedt niet eerder dan 36 uur en uiterlijk op de zesde werkdag na het overlijden (Wet op de lijkbezorging art. 16). Na een arts te hebben gehoord kan de burgemeester van de gemeente waar het stoffelijk overschot zich bevindt een andere termijn stellen; binnen 36 uur alleen in overeenstemming met de officier van justitie (art. 17 lid 1). Tegen het besluit staat binnen 24 uur beroep open bij de commissaris van de Koning (art. 17 lid 2). De nabestaanden vragen de vergunning aan bij de gemeente waar de persoon is overleden, meestal via de uitvaartondernemer (RVO)." />
              <property key="wiki-gemma-model synoniemen" value="Andere termijn stellen (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/stellen-andere-termijn.md" />
              <property key="wiki-gemma-model procesniveau" value="deelproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="stoffelijk-overschot" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Uitbaten begraafplaatsen en crematoria" id="id-5af8af7852ed53e997cd7d3cc9e4405f">
              <documentation>Het openhouden van gemeentelijke begraafplaatsen en crematoria en het ter beschikking stellen van graven en ruimte voor bijzetting en verstrooiing.</documentation>
              <property key="wiki-gemma-model id" value="uitbaten-begraafplaatsen-en-crematoria" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2026-vng-gemma-2026-10-02" />
              <property key="wiki-gemma-model beschrijving" value="Op de gemeentelijke begraafplaats en in een gemeentelijk crematorium begraaft, cremeert en zet de gemeente bij, binnen de tijden die de verordening bepaalt (Wet op de lijkbezorging art. 23, 49, 56, 62; Groningen art. 7, 21), en ruimt zij graven om ruimte vrij te maken (art. 31; Groningen art. 27). Het cluster groepeert deze deelprocessen als specialisatie van het GEMMA-proces Uitbaten gemeentelijke voorzieningen." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/uitbaten-begraafplaatsen-en-crematoria.md" />
              <property key="wiki-gemma-model procesniveau" value="cluster naar soort werk" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Bezorgen stoffelijk overschot" id="id-5be7592f534f5579bbc0e06512b526f1">
              <documentation>Het proces van overlijden tot de bezorging van het stoffelijk overschot: schouwen, verlof verlenen, begraven of cremeren, en zo nodig zorg door de gemeente.</documentation>
              <property key="wiki-gemma-model id" value="bezorgen-stoffelijk-overschot" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2025-groningen-algemene-plaatselijke-verordening; 2026-rijk-besluit-op-de-lijkbezorging-wettekst" />
              <property key="wiki-gemma-model beschrijving" value="Na het overlijden wordt het stoffelijk overschot geschouwd, verleent de ambtenaar van de burgerlijke stand verlof tot begraving of crematie, en wordt het binnen de wettelijke termijn begraven, gecremeerd of ontleed (Wet op de lijkbezorging art. 3, 11, 16, 67). Zorgt niemand anders voor de bezorging, dan draagt de burgemeester er zorg voor (art. 21); bij een besmet stoffelijk overschot kan hij maatregelen treffen (art. 22a). Ook een latere opgraving hoort bij de levensloop van het stoffelijk overschot (art. 29).&#10;&#10;Het is een ketenproces: bij een niet-natuurlijke dood brengt de gemeentelijke lijkschouwer verslag uit aan de officier van justitie, die een verklaring van geen bezwaar afgeeft voordat verlof kan worden verleend (art. 10, 12); een vervroegde uitvaart vraagt ook zijn instemming (art. 17). De uitvaartondernemer regelt de uitvaart namens de nabestaanden (RVO)." />
              <property key="wiki-gemma-model synoniemen" value="Bezorgen lijken (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/bezorgen-stoffelijk-overschot.md" />
              <property key="wiki-gemma-model procesniveau" value="ketenproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="stoffelijk-overschot" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Onderhouden graf" id="id-6344b6861697540e8216a9c9707038a8">
              <documentation>Het onderhouden van grafbedekking en beplanting op een graf door de gemeente.</documentation>
              <property key="wiki-gemma-model id" value="onderhouden-graf" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2010-vng-model-beheersverordening-begraafplaatsen; 2026-vng-retributies" />
              <property key="wiki-gemma-model beschrijving" value="De gemeente maakt gedenktekens schoon en onderhoudt de beplanting op graven, op sommige begraafplaatsen altijd en elders op schriftelijk verzoek van de rechthebbende voor ten minste vijf jaar, tegen betaling van een recht uit de heffingsverordening (Groningen art. 23, 24 lid 3). Bij niet-betalen wordt de grafbedekking na waarschuwing verwijderd (art. 23 lid 4). Het VNG-model regelt een minimaal onderhoud door de gemeente (art. 20)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/onderhouden-graf.md" />
              <property key="wiki-gemma-model procesniveau" value="deelproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="grafbedekking" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Verlenen grafrecht" id="id-72c234ccca9b5464811e0474bcd782ce">
              <documentation>Het verlenen van een grafrecht op een particulier graf aan een rechthebbende.</documentation>
              <property key="wiki-gemma-model id" value="verlenen-grafrecht" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2010-vng-model-beheersverordening-begraafplaatsen; 2026-vng-retributies" />
              <property key="wiki-gemma-model beschrijving" value="Het college verleent op schriftelijke aanvraag een recht op een particulier graf, voor 30 jaar of bij een urnengraf voor 5 tot 30 jaar (Groningen art. 16; VNG-model art. 15); de wet spreekt van het vestigen van het uitsluitend recht, voor onbepaalde tijd of ten minste tien jaar (art. 28). Beslisser is het college; het VNG-model beveelt mandaat aan de beheerder aan. Graven worden in volgorde van ligging uitgegeven (Groningen art. 14). Verlenging volgt op verzoek van de rechthebbende (art. 28 lid 1). De gemeente heft voor de uitgifte lijkbezorgingsrechten (VNG retributies)." />
              <property key="wiki-gemma-model synoniemen" value="Uitgifte van een graf (beleid); Vestigen van het uitsluitend recht op een graf (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/verlenen-grafrecht.md" />
              <property key="wiki-gemma-model procesniveau" value="deelproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="grafrecht" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Vervallen verklaren grafrecht" id="id-75a1ffb3a38f5ed482179917b41d5c97">
              <documentation>Het beëindigen van een grafrecht door de gemeente, bijvoorbeeld bij verwaarlozing van het graf of het uitblijven van betaling.</documentation>
              <property key="wiki-gemma-model id" value="vervallen-verklaren-grafrecht" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2010-vng-model-beheersverordening-begraafplaatsen" />
              <property key="wiki-gemma-model beschrijving" value="Bij kennelijke verwaarlozing van het onderhoud van een particulier graf legt de houder dat vast in een verklaring van verwaarlozing; voorziet de rechthebbende niet binnen één jaar (of vijf jaar na bekendmaking bij het graf) in het onderhoud, dan vervalt het recht (art. 28 lid 4–7). Het college kan het grafrecht ook vervallen verklaren bij wanbetaling, verzuim of als het na het overlijden van de rechthebbende niet tijdig wordt overgeschreven (Groningen art. 18 lid 4, 20 lid 2; VNG-model art. 17 lid 3). Beslisser is het college." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/vervallen-verklaren-grafrecht.md" />
              <property key="wiki-gemma-model procesniveau" value="deelproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="grafrecht" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Treffen maatregel bij besmet stoffelijk overschot" id="id-80882f2992c259ec970fe9e268f3f946">
              <documentation>Het nemen van maatregelen om gevaar voor de volksgezondheid door een besmet stoffelijk overschot af te wenden.</documentation>
              <property key="wiki-gemma-model id" value="treffen-maatregel-bij-besmet-stoffelijk-overschot" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-rijk-wet-publieke-gezondheid-wettekst" />
              <property key="wiki-gemma-model beschrijving" value="Is een stoffelijk overschot besmet met een infectieus of giftig agens of stof, of bestaat daarvan een gegrond vermoeden, waardoor een ernstig gevaar voor de volksgezondheid kan ontstaan, dan kan de burgemeester maatregelen treffen om dit gevaar af te wenden, na advies van de GGD (Wet op de lijkbezorging art. 22a). Beslisser is de burgemeester. De melding komt van een arts via de GGD (Wet publieke gezondheid art. 21 lid 2, 27 lid 3). De maatregel zelf is een beschikking." />
              <property key="wiki-gemma-model synoniemen" value="Treffen maatregel bij besmet lijk (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/treffen-maatregel-bij-besmet-stoffelijk-overschot.md" />
              <property key="wiki-gemma-model procesniveau" value="deelproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="stoffelijk-overschot" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Verlenen vergunning grafbedekking" id="id-873fa38b3c5e556c9a1f0e7f5b577f7d">
              <documentation>Het beslissen op een aanvraag om een vergunning voor een gedenkteken of andere grafbedekking op een particulier graf.</documentation>
              <property key="wiki-gemma-model id" value="verlenen-vergunning-grafbedekking" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2010-vng-model-beheersverordening-begraafplaatsen; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="De rechthebbende van een particulier graf vraagt de vergunning aan; het college beslist en kan de vergunning weigeren als niet wordt voldaan aan de nadere regels over de aard en de afmetingen van de grafbedekking (Groningen art. 22; VNG-model art. 19). Beslisser is het college." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/verlenen-vergunning-grafbedekking.md" />
              <property key="wiki-gemma-model procesniveau" value="deelproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="grafbedekking" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Schouwen stoffelijk overschot" id="id-8aeb21e52a7a5af99faf3d55995af0bb">
              <documentation>Onderzoek van een stoffelijk overschot door een arts na het overlijden, om vast te stellen of de dood een natuurlijke oorzaak heeft.</documentation>
              <property key="wiki-gemma-model id" value="schouwen-stoffelijk-overschot" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst" />
              <property key="wiki-gemma-model beschrijving" value="Elk stoffelijk overschot wordt zo spoedig mogelijk geschouwd, door de behandelend arts of door een gemeentelijke lijkschouwer (art. 3). Is de dood natuurlijk, dan volgt een verklaring van overlijden (art. 7); anders waarschuwt de lijkschouwer de officier van justitie en de ambtenaar van de burgerlijke stand (art. 10). Bij een minderjarige kan een nader onderzoek naar de doodsoorzaak volgen (art. 10a). De schouwing door de behandelend arts valt buiten het gemeentelijk perspectief." />
              <property key="wiki-gemma-model synoniemen" value="Lijkschouwing (wet); Schouwen lijk (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/schouwen-stoffelijk-overschot.md" />
              <property key="wiki-gemma-model procesniveau" value="deelproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="stoffelijk-overschot" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Afgeven laissez-passer" id="id-8cec781544c351dcafada66fb7c002ce">
              <documentation>Het afgeven van het laissez-passer voor lijken voor vervoer van een stoffelijk overschot naar een verdragsstaat.</documentation>
              <property key="wiki-gemma-model id" value="afgeven-laissez-passer" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-besluit-op-de-lijkbezorging-wettekst; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="De burgemeester van de gemeente waar de akte van overlijden is ingeschreven, geeft het laissez-passer af voor vervoer naar een staat die partij is bij de Overeenkomst van Straatsburg; voor vervoer over land naar België of Luxemburg volstaat het verlof tot begraving of crematie (Besluit op de lijkbezorging art. 11 lid 1, 3). Beslisser is de burgemeester." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/afgeven-laissez-passer.md" />
              <property key="wiki-gemma-model procesniveau" value="deelproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="stoffelijk-overschot" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Opgraven stoffelijk overschot" id="id-abcb82c5d790520f856afdda24be34b1">
              <documentation>Het opgraven van een stoffelijk overschot uit een graf, met vergunning van de burgemeester.</documentation>
              <property key="wiki-gemma-model id" value="opgraven-stoffelijk-overschot" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="Een stoffelijk overschot wordt slechts opgegraven met vergunning van de burgemeester en, bij een particulier graf, met toestemming van de rechthebbende; de burgemeester verbindt voorschriften aan de vergunning over geneeskundig toezicht, vervoer en bestemming (art. 29). Beslisser is de burgemeester. De rechthebbende dient de aanvraag in en schakelt een erkend bedrijf in; opgraven gebeurt in de regel pas na tien jaar grafrust (Groningen art. 28)." />
              <property key="wiki-gemma-model synoniemen" value="Opgraving (wet); Opgraven lijk (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/opgraven-stoffelijk-overschot.md" />
              <property key="wiki-gemma-model procesniveau" value="deelproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="stoffelijk-overschot" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Verlenen vergunning bijzonder crematorium" id="id-c1affa7acf5353f9bc6f7eab26090146">
              <documentation>Het verlenen van de vergunning voor het vestigen, uitbreiden of wijzigen van een crematorium van een particuliere houder.</documentation>
              <property key="wiki-gemma-model id" value="verlenen-vergunning-bijzonder-crematorium" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst" />
              <property key="wiki-gemma-model beschrijving" value="Het vestigen, uitbreiden of wijzigen van een bijzonder crematorium behoeft een vergunning van het college (Wet op de lijkbezorging art. 53). Een vergunning voor vestiging wordt pas verleend nadat het college het voornemen ten minste dertig dagen tevoren openbaar heeft gemaakt (art. 54). Belanghebbenden kunnen in beroep bij gedeputeerde staten (art. 55)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/verlenen-vergunning-bijzonder-crematorium.md" />
              <property key="wiki-gemma-model procesniveau" value="deelproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="crematorium" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Behandelen vergunningaanvragen lijkbezorging" id="id-c3bb9f903a155d4f8925239f9ee53754">
              <documentation>Het behandelen van aanvragen om een vergunning, verlof of toestemming voor de lijkbezorging en voor begraafplaatsen en crematoria.</documentation>
              <property key="wiki-gemma-model id" value="behandelen-vergunningaanvragen-lijkbezorging" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-vng-gemma-2026-10-02; 2026-rijk-besluit-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2025-groningen-algemene-plaatselijke-verordening" />
              <property key="wiki-gemma-model beschrijving" value="Binnen de lijkbezorging verleent de gemeente op aanvraag verloven, vergunningen en toestemmingen: het verlof tot begraving of crematie (Wet op de lijkbezorging art. 11), een andere termijn (art. 17), de vergunning tot opgraving (art. 29), de toestemming voor een bijzondere begraafplaats (art. 40, 41), de vergunning voor een bijzonder crematorium (art. 53), het verlof tot ontleding (art. 68), het laissez-passer voor lijken (Besluit op de lijkbezorging art. 11), de vergunning grafbedekking (Groningen art. 22) en de toestemming voor asverstrooiing (APV Groningen art. 5:27 lid 3; Groningen art. 21). Het cluster groepeert deze deelprocessen als specialisatie van het GEMMA-proces Behandelen aanvraag vergunning of ontheffing." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/behandelen-vergunningaanvragen-lijkbezorging.md" />
              <property key="wiki-gemma-model procesniveau" value="cluster naar soort werk" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Sluiten begraafplaats" id="id-d0fd7ec403a853aa853532a68ae58530">
              <documentation>Het besluit dat op een begraafplaats niet meer wordt begraven, of de geslotenverklaring na tien jaar zonder begraving.</documentation>
              <property key="wiki-gemma-model id" value="sluiten-begraafplaats" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst" />
              <property key="wiki-gemma-model beschrijving" value="Een begraafplaats kan worden gesloten; voor een gemeentelijke begraafplaats neemt het college het besluit, en van de sluiting van een andere begraafplaats wordt het college direct op de hoogte gesteld (Wet op de lijkbezorging art. 43). Is er tien jaar niet begraven, dan kan het college de begraafplaats gesloten verklaren (art. 44). Belanghebbenden kunnen in beroep bij gedeputeerde staten, die de rechthebbende op een particulier graf een schadeloosstelling ten laste van de gemeente kunnen toekennen (art. 45)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/sluiten-begraafplaats.md" />
              <property key="wiki-gemma-model procesniveau" value="deelproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="begraafplaats" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Verzorgen gemeentebegrafenis" id="id-d254a261cbf8513f9768449e654e0032">
              <documentation>Het regelen en betalen van de lijkbezorging door de gemeente als niemand anders daarin voorziet.</documentation>
              <property key="wiki-gemma-model id" value="verzorgen-gemeentebegrafenis" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-vng-ggm-2-5-1" />
              <property key="wiki-gemma-model beschrijving" value="Als niemand voorziet in de lijkschouwing en lijkbezorging, waarschuwt degene die het stoffelijk overschot onder zich heeft de burgemeester, die daarvoor zorg draagt (art. 20, 21 lid 1). Beslisser is de burgemeester. De kosten komen ten laste van de gemeente, die ze kan verhalen op de nalatenschap, onderhoudsplichtige verwanten of de werkgever (art. 22); dat kostenverhaal is een stap in dit proces. Een stoffelijk overschot waarvan de identiteit niet kan worden vastgesteld, wordt begraven (art. 21 lid 6). Het resultaat is een gemeentebegrafenis." />
              <property key="wiki-gemma-model synoniemen" value="Lijkbezorging door de burgemeester (wet)" />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/verzorgen-gemeentebegrafenis.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="gemeentebegrafenis" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Verlenen toestemming bijzondere begraafplaats" id="id-d8af547308345aad80d4bb0e78696466">
              <documentation>Het aanwijzen van grond voor een bijzondere begraafplaats en het toestaan van de ingebruikneming ervan.</documentation>
              <property key="wiki-gemma-model id" value="verlenen-toestemming-bijzondere-begraafplaats" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="Een bijzondere begraafplaats wordt aangelegd en in stand gehouden door een kerkgenootschap, een privaatrechtelijke rechtspersoon of een natuurlijk persoon (Wet op de lijkbezorging art. 37). Voor aanleg of uitbreiding wordt alleen grond gebruikt die de gemeenteraad heeft aangewezen; het college kan maatregelen voorschrijven om de grond geschikt te maken (art. 40). Voor de ingebruikneming is toestemming van het college nodig, die alleen wordt geweigerd als niet aan de wettelijke voorschriften is voldaan (art. 41). Tegen deze besluiten staat beroep open bij gedeputeerde staten (art. 42)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/verlenen-toestemming-bijzondere-begraafplaats.md" />
              <property key="wiki-gemma-model procesniveau" value="deelproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="begraafplaats" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Beheren crematoria" id="id-df39047cb6b35de2925edbb67e10e4a0">
              <documentation>Het beheer van een crematorium over de hele levensloop: vestigen, uitbreiden of wijzigen, en opheffen.</documentation>
              <property key="wiki-gemma-model id" value="beheren-crematoria" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst" />
              <property key="wiki-gemma-model beschrijving" value="Crematoria zijn gemeentelijk of bijzonder; een bijzonder crematorium wordt gevestigd en in werking gehouden door een kerkgenootschap, een privaatrechtelijke rechtspersoon of een natuurlijk persoon (Wet op de lijkbezorging art. 51, 52). Het college besluit tot vestiging van een gemeentelijk crematorium of verleent een vergunning voor een bijzonder crematorium, in beide gevallen na een openbare kennisgeving van ten minste dertig dagen (art. 53, 54). Bij opheffing van een bijzonder crematorium gaat het register naar het archief van de gemeente (art. 50 lid 3)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/beheren-crematoria.md" />
              <property key="wiki-gemma-model procesniveau" value="bedrijfsproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="crematorium" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Verzorgen lijkbezorging" id="id-efc98c226b0c523bab7ef44f9cdd0fc0">
              <documentation>Gemeentelijke taak rond de lijkbezorging: het bezorgen van stoffelijke overschotten en het beheer van graven en grafrechten.</documentation>
              <property key="wiki-gemma-model id" value="verzorgen-lijkbezorging" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-vng-wet-op-de-lijkbezorging" />
              <property key="wiki-gemma-model beschrijving" value="Lijkbezorging geschiedt door begraving, crematie of een andere wettelijke wijze (Wet op de lijkbezorging art. 1). De gemeente schouwt stoffelijke overschotten via de gemeentelijke lijkschouwer, geeft het verlof tot begraving of crematie af, heeft ten minste één gemeentelijke begraafplaats, geeft graven uit, staat opgraving en ruiming toe en draagt zorg voor de lijkbezorging als niemand daarin voorziet (art. 4, 11, 21, 28, 29, 31, 33). De taak groepeert de processen daarvoor, één per kernobject: het stoffelijk overschot, de gemeentebegrafenis, het grafrecht, het graf, de begraafplaats en het crematorium." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/verzorgen-lijkbezorging.md" />
              <property key="wiki-gemma-model procesniveau" value="taak" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Uitvoeren lijkbezorging" id="id-f3fef18c03185926a98c84015a0dae05">
              <documentation>Het begraven, cremeren of op een andere wettelijke wijze bezorgen van een stoffelijk overschot.</documentation>
              <property key="wiki-gemma-model id" value="uitvoeren-lijkbezorging" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen" />
              <property key="wiki-gemma-model beschrijving" value="De lijkbezorging geschiedt door begraving, crematie of op een andere wettelijk voorziene wijze, en omvat ook het geven van een bestemming aan de as (art. 1, 18 lid 2). Ze vereist een verlof tot begraving of crematie (art. 11) en volgt, waar mogelijk, de wens van de overledene (art. 19). Op de gemeentelijke begraafplaats bepaalt de beheerder tijd en plaats in overleg met de uitvaartondernemer, na kennisgeving door wie de uitvaart regelt (Groningen art. 7). Begraving, crematie en ontleding zijn varianten zonder eigen pagina; het bijzetten of verstrooien van de as is een eigen deelproces." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/uitvoeren-lijkbezorging.md" />
              <property key="wiki-gemma-model procesniveau" value="deelproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="stoffelijk-overschot" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Bijzetten of verstrooien van de as" id="id-f72e2ea91a40554590885208703a5f48">
              <documentation>Het geven van een bestemming aan de as na een crematie: bijzetten van de urn, verstrooien van de as of meegeven aan de nabestaande.</documentation>
              <property key="wiki-gemma-model id" value="bijzetten-of-verstrooien-van-de-as" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen" />
              <property key="wiki-gemma-model beschrijving" value="Na de crematie bewaart de houder van het crematorium de asbus minimaal een maand en zorgt hij daarna dat de asbus wordt bijgezet, de as wordt verstrooid, de asbus aan de nabestaande wordt meegegeven of naar het buitenland gaat (Wet op de lijkbezorging art. 59). Een asbus wordt bijgezet in een crematorium, in of op een graf of op een afzonderlijke plaats op een begraafplaats, of in een bewaarplaats; in een particulier graf alleen met toestemming van de rechthebbende (art. 62). De houder van de plaats van bijzetting houdt een register bij en kan de asbus op verzoek aan de nabestaande meegeven (art. 63, 65). Verstrooien door een houder mag alleen op een daartoe bestemd terrein of in open zee (art. 66a); op de gemeentelijke begraafplaats kan het college incidentele asverstrooiing op een aangewezen plek toestaan (Groningen art. 21)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/bijzetten-of-verstrooien-van-de-as.md" />
              <property key="wiki-gemma-model procesniveau" value="deelproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="urn" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Verlenen verlof tot begraving of crematie" id="id-f99078369b645c1f80d4b1767a539fcc">
              <documentation>Het afgeven van het schriftelijk verlof waarmee een stoffelijk overschot mag worden begraven of gecremeerd.</documentation>
              <property key="wiki-gemma-model id" value="verlenen-verlof-tot-begraving-of-crematie" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-rvo-aangifte-en-akte-van-overlijden; 2025-vng-upl-producten-en-diensten-extern" />
              <property key="wiki-gemma-model beschrijving" value="Geen begraving of crematie geschiedt zonder schriftelijk verlof van de ambtenaar van de burgerlijke stand, dat kosteloos wordt afgegeven (art. 11). Hij verleent het alleen als hij beschikt over een verklaring van overlijden van de behandelend arts of de gemeentelijke lijkschouwer, of over een verklaring van geen bezwaar van de officier van justitie (art. 12). De stukken worden bij de akte van overlijden gevoegd (art. 13). In de praktijk krijgt de uitvaartondernemer het verlof na de aangifte van overlijden (Ondernemersplein)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsprocessen/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/verlenen-verlof-tot-begraving-of-crematie.md" />
              <property key="wiki-gemma-model procesniveau" value="deelproces" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model kernobject" value="stoffelijk-overschot" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
          </folder>
        </folder>
      </folder>
      <folder name="Producten" id="id-2036e647274c5af5818a37739cf9a460">
        <folder name="7 Volksgezondheid en Milieu" id="id-9b2c096aa97c5ffea6adba7e89883833">
          <folder name="Begraafplaatsen en crematoria" id="id-72675453814a56dca88224af923978c7">
            <element xsi:type="archimate:Product" name="Grafuitgifte" id="id-8d4fd52a89f35252a2ad5988de55110d">
              <documentation>Een particulier graf, urnengraf of urnennis op een gemeentelijke begraafplaats, met het uitsluitend recht daarop voor een vaste termijn.</documentation>
              <property key="wiki-gemma-model id" value="grafuitgifte" />
              <property key="wiki-gemma-model herkomst" value="nieuw" />
              <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
              <property key="wiki-gemma-model soort export" value="definitief" />
              <property key="wiki-gemma-model status" value="goedgekeurd" />
              <property key="wiki-gemma-model bronnen" value="2025-vng-upl-producten-en-diensten-extern; 2010-vng-model-beheersverordening-begraafplaatsen; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2026-vng-retributies" />
              <property key="wiki-gemma-model beschrijving" value="De gemeente geeft op haar begraafplaatsen particuliere graven, urnengraven en urnennissen uit (VNG-model art. 11, 13–15; Groningen art. 14, 16). Het product bundelt de dienst Graf aanvragen en de afspraak Grafrecht. De gemeente heft er lijkbezorgingsrechten voor; die staan in de UPL als het product grafrechten (Gemeentewet art. 229; VNG retributies).&#10;&#10;De UPL geeft als grondslag art. 11 van de model-beheersverordening (indeling graven en asbezorging); de uitgifte zelf staat in art. 13 tot 15 van dat model (UPL)." />
              <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/producten/7-volksgezondheid-en-milieu/begraafplaatsen-en-crematoria/grafuitgifte.md" />
              <property key="wiki-gemma-model afnemer" value="extern" />
              <property key="wiki-gemma-model domein" value="Fysieke leefomgeving" />
              <property key="wiki-gemma-model taakveld" value="7 Volksgezondheid en Milieu" />
              <property key="wiki-gemma-model beleidsdomein" value="Begraafplaatsen en crematoria" />
            </element>
          </folder>
        </folder>
      </folder>
      <folder name="Rollen" id="id-8952e40c37b1557a9e0fe6b1dbcd6ebb">
        <element xsi:type="archimate:BusinessRole" name="Beheerder van de begraafplaats" id="id-0b6bb452a0fc5152a59a86b77fe09422">
          <documentation>Ambtenaar die belast is met de dagelijkse leiding van de gemeentelijke begraafplaatsen.</documentation>
          <property key="wiki-gemma-model id" value="beheerder-van-de-begraafplaats" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2010-vng-model-beheersverordening-begraafplaatsen" />
          <property key="wiki-gemma-model beschrijving" value="De beheerder bepaalt tijd en plaats van begravingen in overleg met de uitvaartondernemer, ontvangt en toetst de stukken (verlof, machtiging) en aanvragen, houdt het register van begraven lijken bij, handhaaft de orde en ziet toe op ruiming (Groningen art. 1 e, 4–9, 27, 30). Het VNG-model beveelt aan de beheerder aan te wijzen als aanspreekpunt voor burgers en aanvragen, met mandaat om te beslissen (toelichting 2)." />
          <property key="wiki-gemma-model synoniemen" value="Beheerder (beleid)" />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/beheerder-van-de-begraafplaats.md" />
          <property key="wiki-gemma-model doelgroep" value="gemeente" />
        </element>
        <element xsi:type="archimate:BusinessRole" name="Bijhoudingsgemeente" id="id-21ee5aa7e6ad5b49802973485b3e3974">
          <documentation>Verantwoordelijkheid van een gemeente voor de bijhouding van de gegevens van de ingezetenen die er hun adres hebben.</documentation>
          <property key="wiki-gemma-model id" value="bijhoudingsgemeente" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2026-rvig-hup-intergemeentelijke-adreswijziging; 2026-rvig-hup-emigratie; 2026-rvig-hup-wijzigen-bsn; 2026-rvig-hup-achtergronden-en-begrippen" />
          <property key="wiki-gemma-model beschrijving" value="Het college van de gemeente waar een ingezetene zijn adres heeft, is verantwoordelijk voor de bijhouding van zijn gegevens (HUP Achtergronden). Bij een verhuizing naar een andere gemeente wordt die de nieuwe bijhoudingsgemeente; na emigratie blijft de laatste bijhoudingsgemeente verantwoordelijk voor rechtsfeiten van voor de emigratie (HUP Intergemeentelijke adreswijziging; HUP Emigratie)." />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/bijhoudingsgemeente.md" />
          <property key="wiki-gemma-model doelgroep" value="gemeente" />
        </element>
        <element xsi:type="archimate:BusinessRole" name="Briefadresgever" id="id-339066946d2c5fd59ac2ad56f0263ba2">
          <documentation>Verantwoordelijkheid van een persoon of aangewezen rechtspersoon om post voor de houder van een briefadres in ontvangst te nemen en door te geven.</documentation>
          <property key="wiki-gemma-model id" value="briefadresgever" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2026-rvig-hup-verblijfplaats" />
          <property key="wiki-gemma-model beschrijving" value="De briefadresgever is een natuurlijk persoon of een door het college aangewezen rechtspersoon; hij stemt schriftelijk in, zorgt dat geschriften voor de houder worden doorgegeven en verstrekt het college inlichtingen (HUP Verblijfplaats). Zonder briefadresgever registreert de gemeente een adres van de gemeente zelf (HUP Verblijfplaats)." />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/briefadresgever.md" />
          <property key="wiki-gemma-model doelgroep" value="inwoners en ondernemers" />
        </element>
        <element xsi:type="archimate:BusinessRole" name="Ambtenaar van de burgerlijke stand" id="id-3b44289d234957ecad7e1c725acf246a">
          <documentation>Ambtenaar die bevoegd is akten van de burgerlijke stand op te maken.</documentation>
          <property key="wiki-gemma-model id" value="ambtenaar-van-de-burgerlijke-stand" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2026-rvo-aangifte-en-akte-van-overlijden" />
          <property key="wiki-gemma-model beschrijving" value="De ambtenaar van de burgerlijke stand maakt de akten van de burgerlijke stand op, waaronder de akte van overlijden na aangifte bij de gemeente waar iemand is overleden (Wet op de lijkbezorging art. 13, 14; Ondernemersplein)." />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/ambtenaar-van-de-burgerlijke-stand.md" />
          <property key="wiki-gemma-model doelgroep" value="gemeente" />
        </element>
        <element xsi:type="archimate:BusinessRole" name="Aangever" id="id-4f74cda77d82593ba83734350ebc1468">
          <documentation>Hoedanigheid van wie bij de gemeente aangifte doet van een feit dat in de basisregistratie personen moet worden verwerkt, voor zichzelf of een ander.</documentation>
          <property key="wiki-gemma-model id" value="aangever" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2026-rvig-hup-verblijfplaats; 2026-rvig-hup-emigratie" />
          <property key="wiki-gemma-model beschrijving" value="Een meerderjarige doet zelf aangifte van verblijf en adres, adreswijziging en vertrek; ouders, voogden en verzorgers zijn verplicht aangifte te doen voor minderjarigen; echtgenoten, partners en ouders met een meerderjarig kind zijn bevoegd voor elkaar; het hoofd van een instelling kan aangifte doen voor wie er verblijft (HUP Verblijfplaats). Het college kan verplichten in persoon te verschijnen (HUP Verblijfplaats; Besluit BRP art. 30)." />
          <property key="wiki-gemma-model synoniemen" value="Doorgever (beleid)" />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/aangever.md" />
          <property key="wiki-gemma-model doelgroep" value="inwoners en ondernemers" />
        </element>
        <element xsi:type="archimate:BusinessRole" name="Houder van de begraafplaats" id="id-77e415928f565e74b91359fde6ad9da7">
          <documentation>Verantwoordelijkheid voor het in stand houden en beheren van een begraafplaats.</documentation>
          <property key="wiki-gemma-model id" value="houder-van-de-begraafplaats" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2010-vng-model-beheersverordening-begraafplaatsen; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen" />
          <property key="wiki-gemma-model beschrijving" value="De houder van de begraafplaats stelt voor een begraving de identiteit van het stoffelijk overschot vast (art. 8), bepaalt wie in een algemeen graf wordt begraven (art. 23), houdt het register van begraven lijken (art. 27), doet mededeling van het verstrijken van termijnen (art. 27a, 28 lid 2), kan een verklaring van verwaarlozing opstellen (art. 28 lid 4) en geeft last tot het ruimen van graven (art. 31). Bij een gemeentelijke begraafplaats is de gemeente houder; bij een bijzondere begraafplaats een kerkgenootschap, rechtspersoon of natuurlijk persoon (art. 37)." />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/houder-van-de-begraafplaats.md" />
          <property key="wiki-gemma-model doelgroep" value="gemeente" />
        </element>
        <element xsi:type="archimate:BusinessRole" name="Gemeentelijke lijkschouwer" id="id-7a33463e2bb35989ab38d88aa0e2a173">
          <documentation>Arts die door het college is benoemd om stoffelijke overschotten te schouwen.</documentation>
          <property key="wiki-gemma-model id" value="gemeentelijke-lijkschouwer" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst" />
          <property key="wiki-gemma-model beschrijving" value="Burgemeester en wethouders benoemen een of meer gemeentelijke lijkschouwers, uitsluitend forensisch artsen (art. 4, 5). Normaal schouwt de behandelend arts het stoffelijk overschot; de gemeentelijke lijkschouwer is de uitzondering en schouwt alleen als de behandelend arts dat niet doet, geeft een verklaring van overlijden af of waarschuwt bij een niet-natuurlijke dood de officier van justitie en de ambtenaar van de burgerlijke stand, en leidt het nader onderzoek bij een minderjarige (art. 3, 7, 10, 10a). Hij kan de elektronische weg openstellen voor mededelingen van de behandelend arts (art. 7 lid 3)." />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/gemeentelijke-lijkschouwer.md" />
          <property key="wiki-gemma-model doelgroep" value="gemeente" />
        </element>
        <element xsi:type="archimate:BusinessRole" name="Kostendrager" id="id-7ef9e7cf4e2158848fdf94c3f5304bce">
          <documentation>Verantwoordelijkheid voor het dragen van de kosten van een voorziening of handeling.</documentation>
          <property key="wiki-gemma-model id" value="kostendrager" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst" />
          <property key="wiki-gemma-model beschrijving" value="Een kostendrager betaalt voor een voorziening of handeling die een ander uitvoert of die hij zelf laat uitvoeren, en kan de kosten soms verhalen." />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/kostendrager.md" />
          <property key="wiki-gemma-model doelgroep" value="gemeente" />
        </element>
        <element xsi:type="archimate:BusinessRole" name="Toezichthouder BRP" id="id-c5359c92fe845af58a4d30b4dbd85edc">
          <documentation>Verantwoordelijkheid voor het toezicht op de juistheid van de inschrijving in de basisregistratie personen, onder meer met een huisbezoek.</documentation>
          <property key="wiki-gemma-model id" value="toezichthouder-brp" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2023-rvig-circulaire-adresonderzoek-brp" />
          <property key="wiki-gemma-model beschrijving" value="De toezichthouder BRP heeft de bevoegdheid inlichtingen op te vragen en legt bij een adresonderzoek huisbezoeken af; het college kan ook externen tot onbezoldigd ambtenaar en toezichthouder benoemen (Circulaire adresonderzoek 4.4, 4.5)." />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/toezichthouder-brp.md" />
          <property key="wiki-gemma-model doelgroep" value="gemeente" />
        </element>
        <element xsi:type="archimate:BusinessRole" name="Rechthebbende op het graf" id="id-cb6de84aee08550d85ac3727aad8bec2">
          <documentation>Wie het grafrecht op een particulier graf heeft en bepaalt wie daarin wordt begraven of bijgezet.</documentation>
          <property key="wiki-gemma-model id" value="rechthebbende-op-het-graf" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2010-vng-model-beheersverordening-begraafplaatsen" />
          <property key="wiki-gemma-model beschrijving" value="De rechthebbende bepaalt wie in het particulier graf wordt begraven (art. 23 lid 2), geeft toestemming voor opgraving en ruiming (art. 29, 31), vraagt verlenging, overschrijving en een vergunning voor de grafbedekking aan, onderhoudt de grafbedekking en kan afstand doen van het recht (Groningen art. 16, 18, 19, 22, 24). Dat kan een natuurlijk persoon of een rechtspersoon zijn (Groningen art. 1 w)." />
          <property key="wiki-gemma-model synoniemen" value="Rechthebbende (beleid)" />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/rechthebbende-op-het-graf.md" />
          <property key="wiki-gemma-model doelgroep" value="inwoners en ondernemers" />
        </element>
        <element xsi:type="archimate:BusinessRole" name="RNI-loket" id="id-ccc943c53eb35f5591901dce3e5ffbbf">
          <documentation>Verantwoordelijkheid van een daartoe aangewezen gemeente om personen in de registratie niet-ingezetenen in te schrijven en hun gegevens te verstrekken.</documentation>
          <property key="wiki-gemma-model id" value="rni-loket" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2026-rvig-hup-achtergronden-en-begrippen; 2026-utrecht-burgerzaken-registratie-niet-ingezetenen-rni-inschrijven; 2024-nvvb-schema-schriftelijke-gegevensverstrekking-brp" />
          <property key="wiki-gemma-model beschrijving" value="Niet elke gemeente is RNI-loket; wie niet bij een loket terecht kan, gaat naar een ander loket (Utrecht RNI). Het college van het RNI-loket is bevoegd schriftelijk gegevens over niet-ingezetenen te verstrekken; andere gemeenten sturen zulke verzoeken door (NVVB Schema). De minister van BZK is verantwoordelijk voor de RNI (HUP Achtergronden). Het RNI-loket is een verantwoordelijkheid, geen kanaal." />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/rni-loket.md" />
          <property key="wiki-gemma-model doelgroep" value="gemeente" />
        </element>
        <element xsi:type="archimate:BusinessRole" name="Degene die in de lijkbezorging voorziet" id="id-e816170ab8e354c192c34c534cfa3355">
          <documentation>Wie de lijkbezorging van een overledene regelt en daarvoor het verlof aanvraagt.</documentation>
          <property key="wiki-gemma-model id" value="degene-die-in-de-lijkbezorging-voorziet" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2010-vng-model-beheersverordening-begraafplaatsen" />
          <property key="wiki-gemma-model beschrijving" value="Degene die in de lijkbezorging voorziet vraagt het verlof tot begraving of crematie aan, of is redelijkerwijs in diens plaats getreden; de lijkbezorging volgt zoveel mogelijk de wens van de overledene (art. 18, 19). Op de gemeentelijke begraafplaats doet hij de kennisgeving van begraven of bijzetten en ondertekent hij zo nodig de machtiging (Groningen art. 7 lid 2, 9). In de praktijk vervult vaak de uitvaartondernemer deze rol namens de nabestaanden." />
          <property key="wiki-gemma-model synoniemen" value="Degene die in de uitvaart voorziet (beleid)" />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/degene-die-in-de-lijkbezorging-voorziet.md" />
          <property key="wiki-gemma-model doelgroep" value="inwoners en ondernemers" />
        </element>
        <element xsi:type="archimate:BusinessRole" name="Houder van een plaats van bijzetting" id="id-f97e7a1412ff52749ee3016217299bdb">
          <documentation>Verantwoordelijkheid voor een plaats waar urnen worden bijgezet.</documentation>
          <property key="wiki-gemma-model id" value="houder-van-een-plaats-van-bijzetting" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen" />
          <property key="wiki-gemma-model beschrijving" value="De houder van een plaats van bijzetting houdt een openbaar register van de bijgezette asbussen, stelt ze op verzoek ter beschikking en ruimt ze door verstrooiing van de as (art. 63, 65, 66). Het register gaat bij opheffing naar het archief van de gemeente (art. 65 lid 3)." />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/houder-van-een-plaats-van-bijzetting.md" />
          <property key="wiki-gemma-model doelgroep" value="gemeente" />
        </element>
        <element xsi:type="archimate:BusinessRole" name="Houder van het crematorium" id="id-fafdec9a745a5861ae1b04f2947fa87b">
          <documentation>Verantwoordelijkheid voor een crematorium, het bergen van de as en de bestemming daarvan.</documentation>
          <property key="wiki-gemma-model id" value="houder-van-het-crematorium" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst" />
          <property key="wiki-gemma-model beschrijving" value="De houder van het crematorium bergt de as in asbussen, bewaart ze en zorgt voor de bestemming van de as, en houdt een openbaar register van gecremeerde stoffelijke overschotten (art. 50, 58, 59). Bij een gemeentelijk crematorium is de gemeente houder, bij een bijzonder crematorium een kerkgenootschap, rechtspersoon of natuurlijk persoon (art. 51, 52)." />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/houder-van-het-crematorium.md" />
          <property key="wiki-gemma-model doelgroep" value="gemeente" />
        </element>
        <element xsi:type="archimate:BusinessRole" name="Nabestaande" id="id-fef4ddc0626658c98d617a3cf964afab">
          <documentation>Naaste van een overledene die zorg draagt voor de uitvaart of de urn.</documentation>
          <property key="wiki-gemma-model id" value="nabestaande" />
          <property key="wiki-gemma-model herkomst" value="nieuw" />
          <property key="wiki-gemma-model exportdatum" value="2026-10-07T01:04:31" />
          <property key="wiki-gemma-model soort export" value="definitief" />
          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model bronnen" value="2026-rijk-wet-op-de-lijkbezorging-wettekst; 2023-groningen-beheersverordening-gemeentelijke-begraafplaatsen; 2010-vng-model-beheersverordening-begraafplaatsen; 2025-groningen-algemene-plaatselijke-verordening" />
          <property key="wiki-gemma-model beschrijving" value="De nabestaande draagt zorg voor de asbus, geeft opdracht tot bijzetting of verstrooiing en kan de as laten meegeven (art. 58–60, 62). Op de gemeentelijke begraafplaats kan hij werkzaamheden bij de begraving zelf verrichten en bij ruiming de resten laten herbegraven of cremeren (Groningen art. 7 lid 4, 27 lid 4; VNG-model art. 24 lid 4)." />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/rollen/nabestaande.md" />
          <property key="wiki-gemma-model doelgroep" value="inwoners en ondernemers" />
        </element>
      </folder>
    </folder>
  </folder>
