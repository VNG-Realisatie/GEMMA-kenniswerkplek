          <property key="wiki-gemma-model status" value="goedgekeurd" />
          <property key="wiki-gemma-model GEMMA-match" value="exact" />
          <property key="wiki-gemma-model bronnen" value="2026-vng-gemma-2026-10-02; 2026-rvo-aangifte-en-akte-van-overlijden; 2026-rijk-wet-op-de-lijkbezorging-wettekst; 2025-vng-upl-producten-en-diensten-extern" />
          <property key="wiki-gemma-model beschrijving" value="De gemeente beheert en verleent vergunningen voor lokale activiteiten die inwoners en ondernemers aanvragen, zoals vergunningen op grond van het Burgerlijk Wetboek en de APV." />
          <property key="wiki-gemma-model pagina" value="bedrijfsarchitectuur/bedrijfsfuncties/publieksdiensten/vergunningenbeheer-publieksdiensten.md" />
