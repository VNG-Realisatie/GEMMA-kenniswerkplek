        <element xsi:type="archimate:BusinessFunction" name="Burgerlijke stand diensten" id="id-c689b2cc-4672-4474-a82f-44273c60d384">
          <documentation>Het bijhouden van de burgerlijke staat van personen naar aanleiding van geboorte, overlijden, huwelijk en verhuizing.</documentation>
          <property key="Object ID" value="c689b2cc-4672-4474-a82f-44273c60d384" />
          <property key="Toelichting" value="Bijv. het opmaken van akten bij geboorte, huwelijk, echtscheiding en overlijden." />
          <property key="wiki-gemma-model id" value="burgerlijke-stand-diensten" />
          <property key="wiki-gemma-model herkomst" value="gekoppeld" />
