{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lijst",
  "description": "Gegenereerde lijst (bijv. terugmeldingen/ggm-terugmeldingen.md, docs/beslistabel.md, ter-beoordeling.md); nooit met de hand bewerken.",
  "type": "object",
  "required": [
    "id",
    "type",
    "titel"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "const": "lijst"
    },
    "titel": {
      "type": "string",
      "minLength": 1
    },
    "bijgewerkt": {
      "type": "string"
    },
    "bronnen": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
