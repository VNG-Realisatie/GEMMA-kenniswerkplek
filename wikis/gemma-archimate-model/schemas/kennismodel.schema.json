{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "kennismodel",
  "description": "Het kennismodel (kennismodel/): wat het model is. Gegenereerd door tools/kennismodel.py, behalve modelleerregels.md (met de hand).",
  "type": "object",
  "required": [
    "id",
    "type",
    "titel"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "const": "kennismodel"
    },
    "titel": {
      "type": "string",
      "minLength": 1
    },
    "bijgewerkt": {
      "type": "string"
    },
    "bronnen": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
