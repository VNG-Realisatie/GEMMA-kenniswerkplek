{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "beoordeling",
  "description": "Beoordeling van één begrip (beoordelingen/begrippen/<id>.yaml): het oordeel van de AI. `status` en `afgeleid` vullen de scripts (tools/afleiden.py, llmwiki promote); nooit zelf invullen. Gegenereerd door tools/bepaal_type.py schema.",
  "type": "object",
  "required": [
    "begrip",
    "onderwerpen",
    "kenmerken"
  ],
  "properties": {
    "begrip": {
      "type": "string",
      "minLength": 1,
      "description": "De naam: de gangbare term uit beleid en praktijk"
    },
    "onderwerpen": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "kenmerken": {
      "type": "object",
      "required": [
        "herkenbaar",
        "gemeentelijk",
        "buiten_dit_model",
        "slechts_eigenschap",
        "eigen_identiteit",
        "betekenis_in_onderwerp",
        "gedrag",
        "handelende_partij",
        "hoedanigheid",
        "samenwerkingsverband",
        "toegangspunt",
        "plaats",
        "aanbod_als_geheel",
        "regeling_als_geheel",
        "los_van_verantwoordelijkheid",
        "eigen_rechtspersoon",
        "vervult_een_rol",
        "voert_gedrag_uit",
        "soort_partij",
        "ontsluit_een_dienst",
        "per_keer_doorlopen",
        "groepeert_processen",
        "gegroepeerd_gedrag",
        "toestandsverandering",
        "aangeboden_gedrag",
        "gezamenlijk_gedrag",
        "toegewezen_partij",
        "gebruikt_objecten",
        "aanleiding",
        "benoembaar_resultaat",
        "komt_herhaald_voor",
        "eigen_normering",
        "stabiel_over_tijd",
        "afnemer",
        "gerealiseerd_door",
        "leidt_tot_gedrag",
        "bijdrage_aan_groter_proces",
        "omvat_processen",
        "omvat_levensloop",
        "meer_organisaties",
        "eigen_besluit",
        "levert_aanbod",
        "bedient_gedrag",
        "in_functie_indeling",
        "leidt_tot_gebeurtenis",
        "onderscheidbare_exemplaren",
        "levenscyclus",
        "wordt_bewerkt",
        "afspraak",
        "waarneembare_vorm",
        "deel_van_object",
        "invoer_van_een_ander",
        "zelfstandig_aanbod",
        "omvat_diensten_en_afspraken",
        "geautomatiseerd_verwerkt",
        "landelijk",
        "in_werking",
        "is_grondslag_voor",
        "zelfstandige_specialisatie",
        "generiek"
      ],
      "properties": {
        "herkenbaar": {
          "$ref": "#/$defs/antwoord"
        },
        "gemeentelijk": {
          "$ref": "#/$defs/antwoord"
        },
        "buiten_dit_model": {
          "$ref": "#/$defs/antwoord"
        },
        "slechts_eigenschap": {
          "$ref": "#/$defs/antwoord"
        },
        "eigen_identiteit": {
          "$ref": "#/$defs/antwoord"
        },
        "betekenis_in_onderwerp": {
          "$ref": "#/$defs/antwoord"
        },
        "gedrag": {
          "$ref": "#/$defs/antwoord"
        },
        "handelende_partij": {
          "$ref": "#/$defs/antwoord"
        },
        "hoedanigheid": {
          "$ref": "#/$defs/antwoord"
        },
        "samenwerkingsverband": {
          "$ref": "#/$defs/antwoord"
        },
        "toegangspunt": {
          "$ref": "#/$defs/antwoord"
        },
        "plaats": {
          "$ref": "#/$defs/antwoord"
        },
        "aanbod_als_geheel": {
          "$ref": "#/$defs/antwoord"
        },
        "regeling_als_geheel": {
          "$ref": "#/$defs/antwoord"
        },
        "los_van_verantwoordelijkheid": {
          "$ref": "#/$defs/antwoord"
        },
        "eigen_rechtspersoon": {
          "$ref": "#/$defs/antwoord"
        },
        "vervult_een_rol": {
          "$ref": "#/$defs/antwoord"
        },
        "voert_gedrag_uit": {
          "$ref": "#/$defs/antwoord"
        },
        "soort_partij": {
          "$ref": "#/$defs/antwoord"
        },
        "ontsluit_een_dienst": {
          "$ref": "#/$defs/antwoord"
        },
        "per_keer_doorlopen": {
          "$ref": "#/$defs/antwoord"
        },
        "groepeert_processen": {
          "$ref": "#/$defs/antwoord"
        },
        "gegroepeerd_gedrag": {
          "$ref": "#/$defs/antwoord"
        },
        "toestandsverandering": {
          "$ref": "#/$defs/antwoord"
        },
        "aangeboden_gedrag": {
          "$ref": "#/$defs/antwoord"
        },
        "gezamenlijk_gedrag": {
          "$ref": "#/$defs/antwoord"
        },
        "toegewezen_partij": {
          "$ref": "#/$defs/antwoord"
        },
        "gebruikt_objecten": {
          "$ref": "#/$defs/antwoord"
        },
        "aanleiding": {
          "$ref": "#/$defs/antwoord"
        },
        "benoembaar_resultaat": {
          "$ref": "#/$defs/antwoord"
        },
        "komt_herhaald_voor": {
          "$ref": "#/$defs/antwoord"
        },
        "eigen_normering": {
          "$ref": "#/$defs/antwoord"
        },
        "stabiel_over_tijd": {
          "$ref": "#/$defs/antwoord"
        },
        "afnemer": {
          "$ref": "#/$defs/antwoord"
        },
        "gerealiseerd_door": {
          "$ref": "#/$defs/antwoord"
        },
        "leidt_tot_gedrag": {
          "$ref": "#/$defs/antwoord"
        },
        "bijdrage_aan_groter_proces": {
          "$ref": "#/$defs/antwoord"
        },
        "omvat_processen": {
          "$ref": "#/$defs/antwoord"
        },
        "omvat_levensloop": {
          "$ref": "#/$defs/antwoord"
        },
        "meer_organisaties": {
          "$ref": "#/$defs/antwoord"
        },
        "eigen_besluit": {
          "$ref": "#/$defs/antwoord"
        },
        "levert_aanbod": {
          "$ref": "#/$defs/antwoord"
        },
        "bedient_gedrag": {
          "$ref": "#/$defs/antwoord"
        },
        "in_functie_indeling": {
          "$ref": "#/$defs/antwoord"
        },
        "leidt_tot_gebeurtenis": {
          "$ref": "#/$defs/antwoord"
        },
        "onderscheidbare_exemplaren": {
          "$ref": "#/$defs/antwoord"
        },
        "levenscyclus": {
          "$ref": "#/$defs/antwoord"
        },
        "wordt_bewerkt": {
          "$ref": "#/$defs/antwoord"
        },
        "afspraak": {
          "$ref": "#/$defs/antwoord"
        },
        "waarneembare_vorm": {
          "$ref": "#/$defs/antwoord"
        },
        "deel_van_object": {
          "$ref": "#/$defs/antwoord"
        },
        "invoer_van_een_ander": {
          "$ref": "#/$defs/antwoord"
        },
        "zelfstandig_aanbod": {
          "$ref": "#/$defs/antwoord"
        },
        "omvat_diensten_en_afspraken": {
          "$ref": "#/$defs/antwoord"
        },
        "geautomatiseerd_verwerkt": {
          "$ref": "#/$defs/antwoord"
        },
        "landelijk": {
          "$ref": "#/$defs/antwoord"
        },
        "in_werking": {
          "$ref": "#/$defs/antwoord"
        },
        "is_grondslag_voor": {
          "$ref": "#/$defs/antwoord"
        },
        "zelfstandige_specialisatie": {
          "$ref": "#/$defs/antwoord"
        },
        "generiek": {
          "$ref": "#/$defs/antwoord"
        }
      },
      "additionalProperties": false
    },
    "synoniem_van": {
      "type": "string",
      "description": "Stap 0: het element (of het begrip in deze run) waarvan dit woord een synoniem is"
    },
    "homoniem_van": {
      "type": "string",
      "description": "Stap 0: het andere begrip met dezelfde naam, en waar het voorkomt (wiki, GGM, GEMMA-model, bron)"
    },
    "genoemd_begrip": {
      "type": "string",
      "description": "Het begrip waarvan dit een eigenschap, onderdeel, bredere specialisatie of waarneembare vorm is"
    },
    "archimate_buiten_model": {
      "type": "string",
      "description": "Het ArchiMate-type buiten dit model (Goal, Outcome, Principle, Requirement, Constraint, Value, Capability, Grouping …)"
    },
    "kernobject": {
      "type": "string",
      "description": "Stap 7: het bedrijfsobject waarvan dit proces de levensloop omvat (bedrijfs- en ketenproces) of waarin het een mutatie doet (deelproces)"
    },
    "afnemer": {
      "enum": [
        "extern",
        "intern"
      ],
      "description": "Indelingsveld: de plaats in de indelingen (stap 7)"
    },
    "domein": {
      "enum": [
        "Bestuur",
        "Fysieke leefomgeving",
        "Niet domeingebonden",
        "Openbare orde en veiligheid",
        "Ondersteuning",
        "Publieksdiensten",
        "Sociaal domein"
      ],
      "description": "Indelingsveld: de plaats in de indelingen (stap 7)"
    },
    "doelgroep": {
      "enum": [
        "gemeente",
        "inwoners en ondernemers",
        "ketenpartners"
      ],
      "description": "Indelingsveld: de plaats in de indelingen (stap 7)"
    },
    "regelgever": {
      "enum": [
        "EU",
        "rijk",
        "VNG-model"
      ],
      "description": "Indelingsveld: de plaats in de indelingen (stap 7)"
    },
    "toelichting": {
      "type": "string",
      "minLength": 1,
      "description": "Waarom deze uitkomst, voor de begrippenlijst (vooral bij een begrip zonder pagina)"
    },
    "definitie": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "not": {
        "pattern": "(?i)gelijk aan (het |de )?(ggm|gemma)"
      },
      "description": "Herkenbare definitie: één zin, hoogstens 160 tekens; gaat naar GEMMA"
    },
    "definitie_formeel": {
      "type": "string",
      "minLength": 1,
      "description": "Letterlijk uit de hoogst gerangschikte bron, alleen bij een wezenlijk verschil"
    },
    "definitie_formeel_bron": {
      "type": "object",
      "required": [
        "bron",
        "plaats"
      ],
      "properties": {
        "bron": {
          "type": "string",
          "minLength": 1
        },
        "plaats": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "beschrijving": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Alinea's; elke alinea op één regel"
    },
    "per_onderwerp": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "description": "Alinea's; elke alinea op één regel"
      }
    },
    "synoniemen": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "naam",
          "context"
        ],
        "properties": {
          "naam": {
            "type": "string",
            "minLength": 1
          },
          "context": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "taakveld": {
      "type": "string",
      "minLength": 1
    },
    "beleidsdomein": {
      "type": "string",
      "minLength": 1
    },
    "grondslag": {
      "enum": [
        "ggm-entiteit",
        "ggm-afgeleid",
        "procesobject",
        "regelgeving",
        "bron"
      ]
    },
    "grondslag_toelichting": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Bij regelgeving de juridische bron, bij procesobject het proces, bij ggm-afgeleid de afleiding"
    },
    "ggm": {
      "type": "object",
      "required": [
        "sterkte",
        "onderbouwing"
      ],
      "properties": {
        "guid": {
          "type": "string",
          "pattern": "^EAID_"
        },
        "sterkte": {
          "enum": [
            "exact",
            "sterk",
            "partieel",
            "zwak",
            "geen"
          ]
        },
        "onderbouwing": {
          "type": "string",
          "minLength": 1
        },
        "duplicaten": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "guid",
              "toelichting"
            ],
            "properties": {
              "guid": {
                "type": "string",
                "pattern": "^EAID_"
              },
              "toelichting": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "gemma": {
      "type": "object",
      "required": [
        "sterkte",
        "onderbouwing"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sterkte": {
          "enum": [
            "exact",
            "sterk",
            "partieel",
            "zwak",
            "geen"
          ]
        },
        "onderbouwing": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "gemma_generiek": {
      "type": "object",
      "required": [
        "id",
        "onderbouwing"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "onderbouwing": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "description": "Specialisatie van een generiek GEMMA-element (bedrijfsproces, gebeurtenis, dienst of rol), met het id van dat element; bij een cluster naar soort werk bepaalt dit het procesniveau"
    },
    "naamkeuze": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Alinea's; elke alinea op één regel"
    },
    "homoniemen": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "begrip",
          "betekenis",
          "waar",
          "naamkeuze"
        ],
        "properties": {
          "begrip": {
            "type": "string",
            "minLength": 1
          },
          "betekenis": {
            "type": "string",
            "minLength": 1
          },
          "waar": {
            "type": "string",
            "minLength": 1
          },
          "naamkeuze": {
            "type": "string",
            "minLength": 1
          },
          "element": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        },
        "additionalProperties": false
      }
    },
    "generalisatie": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Alinea's; elke alinea op één regel"
    },
    "specialisaties": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "naam",
          "omschrijving"
        ],
        "properties": {
          "naam": {
            "type": "string",
            "minLength": 1
          },
          "omschrijving": {
            "type": "string",
            "minLength": 1
          },
          "element": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "ggm_guid": {
            "type": "string",
            "minLength": 1
          },
          "ggm_attribuut": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "ggm_componenten": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "naam",
          "guid",
          "toelichting"
        ],
        "properties": {
          "naam": {
            "type": "string",
            "minLength": 1
          },
          "guid": {
            "type": "string",
            "pattern": "^EAID_"
          },
          "toelichting": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "tegenhanger": {
      "type": "object",
      "required": [
        "element",
        "toelichting"
      ],
      "properties": {
        "element": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "toelichting": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "relaties": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "soort",
          "naar",
          "grondslag"
        ],
        "properties": {
          "soort": {
            "type": "string",
            "pattern": "^(associatie|associatie \\(gericht\\)|aggregatie|compositie|specialisatie|toewijzing|toegang \\([a-zë-]+\\)|triggering|stroom|realisatie|bediening)$"
          },
          "naar": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "naam": {
            "type": "string",
            "minLength": 1
          },
          "kardinaliteit": {
            "type": "string",
            "minLength": 1
          },
          "grondslag": {
            "enum": [
              "ggm-exact",
              "ggm-afgeleid",
              "bron"
            ]
          },
          "via": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "Een begrip met uitkomst specialisatie van het doel (een specialisatie zonder pagina)"
          },
          "ggm_relatie": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^EAID_"
            }
          },
          "bronnen": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9]{4}-[a-z0-9]+(-[a-z0-9]+)*$"
            }
          },
          "vindplaats": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "bronnen": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]{4}-[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "description": "Bronnen naast die in kenmerken en relaties, bijv. de algemene bron van de beschrijving"
    },
    "vragen": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Open vragen aan de redacteur"
    },
    "besluiten": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "datum",
          "besluit",
          "gevolg"
        ],
        "properties": {
          "datum": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "besluit": {
            "type": "string",
            "minLength": 1
          },
          "gevolg": {
            "enum": [
              "opnemen",
              "afwijzen",
              "verwerkt"
            ]
          },
          "redenen": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "De voorgelegde redenen (uit afgeleid.voor_te_leggen) die dit besluit dekt"
          }
        },
        "additionalProperties": false
      }
    },
    "status": {
      "enum": [
        "kandidaat",
        "review",
        "goedgekeurd",
        "afgewezen"
      ],
      "description": "Door tools/afleiden.py en llmwiki promote; niet zelf invullen"
    },
    "afgeleid": {
      "type": "object",
      "description": "Door tools/afleiden.py; niet zelf invullen"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "antwoord": {
      "type": "object",
      "required": [
        "waarde",
        "onderbouwing"
      ],
      "properties": {
        "waarde": {
          "enum": [
            "ja",
            "nee"
          ]
        },
        "onderbouwing": {
          "type": "string",
          "minLength": 1
        },
        "bronnen": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
