{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "beoordeling",
  "description": "Beoordeling van één begrip (onderwerpen/<onderwerp>/beoordelingen/<id>.yaml): het oordeel van de AI. `status` en `beslist` vullen de scripts (tools/beslissen.py, llmwiki promote); nooit zelf invullen. Gegenereerd door tools/bepaal_type.py schema.",
  "type": "object",
  "required": [
    "begrip",
    "onderwerpen",
    "kenmerken"
  ],
  "properties": {
    "begrip": {
      "type": "string",
      "minLength": 1,
      "description": "De naam: de gangbare term uit beleid en praktijk"
    },
    "onderwerpen": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "description": "Het eerste is het thuisonderwerp (regel Thuishoren); de andere gebruiken het element met relaties en per_onderwerp"
    },
    "kenmerken": {
      "type": "object",
      "properties": {
        "herkenbaar": {
          "$ref": "#/$defs/kenmerk"
        },
        "gemeentelijk": {
          "$ref": "#/$defs/kenmerk"
        },
        "buiten_dit_model": {
          "$ref": "#/$defs/kenmerk"
        },
        "slechts_eigenschap": {
          "$ref": "#/$defs/kenmerk"
        },
        "eigen_identiteit": {
          "$ref": "#/$defs/kenmerk"
        },
        "betekenis_in_onderwerp": {
          "$ref": "#/$defs/kenmerk"
        },
        "gedrag": {
          "$ref": "#/$defs/kenmerk"
        },
        "handelende_partij": {
          "$ref": "#/$defs/kenmerk"
        },
        "hoedanigheid": {
          "$ref": "#/$defs/kenmerk"
        },
        "samenwerkingsverband": {
          "$ref": "#/$defs/kenmerk"
        },
        "toegangspunt": {
          "$ref": "#/$defs/kenmerk"
        },
        "plaats": {
          "$ref": "#/$defs/kenmerk"
        },
        "aanbod_als_geheel": {
          "$ref": "#/$defs/kenmerk"
        },
        "regeling_als_geheel": {
          "$ref": "#/$defs/kenmerk"
        },
        "los_van_verantwoordelijkheid": {
          "$ref": "#/$defs/kenmerk"
        },
        "eigen_rechtspersoon": {
          "$ref": "#/$defs/kenmerk"
        },
        "vervult_een_rol": {
          "$ref": "#/$defs/kenmerk"
        },
        "voert_gedrag_uit": {
          "$ref": "#/$defs/kenmerk"
        },
        "soort_partij": {
          "$ref": "#/$defs/kenmerk"
        },
        "ontsluit_een_dienst": {
          "$ref": "#/$defs/kenmerk"
        },
        "per_keer_doorlopen": {
          "$ref": "#/$defs/kenmerk"
        },
        "groepeert_processen": {
          "$ref": "#/$defs/kenmerk"
        },
        "gegroepeerd_gedrag": {
          "$ref": "#/$defs/kenmerk"
        },
        "toestandsverandering": {
          "$ref": "#/$defs/kenmerk"
        },
        "aangeboden_gedrag": {
          "$ref": "#/$defs/kenmerk"
        },
        "gezamenlijk_gedrag": {
          "$ref": "#/$defs/kenmerk"
        },
        "toegewezen_partij": {
          "$ref": "#/$defs/kenmerk"
        },
        "gebruikt_objecten": {
          "$ref": "#/$defs/kenmerk"
        },
        "aanleiding": {
          "$ref": "#/$defs/kenmerk"
        },
        "benoembaar_resultaat": {
          "$ref": "#/$defs/kenmerk"
        },
        "komt_herhaald_voor": {
          "$ref": "#/$defs/kenmerk"
        },
        "eigen_normering": {
          "$ref": "#/$defs/kenmerk"
        },
        "stabiel_over_tijd": {
          "$ref": "#/$defs/kenmerk"
        },
        "afnemer": {
          "$ref": "#/$defs/kenmerk"
        },
        "gerealiseerd_door": {
          "$ref": "#/$defs/kenmerk"
        },
        "leidt_tot_gedrag": {
          "$ref": "#/$defs/kenmerk"
        },
        "bijdrage_aan_groter_proces": {
          "$ref": "#/$defs/kenmerk"
        },
        "klant_tot_klant": {
          "$ref": "#/$defs/kenmerk"
        },
        "omvat_processen": {
          "$ref": "#/$defs/kenmerk"
        },
        "omvat_levensloop": {
          "$ref": "#/$defs/kenmerk"
        },
        "eigen_besluit": {
          "$ref": "#/$defs/kenmerk"
        },
        "levert_aanbod": {
          "$ref": "#/$defs/kenmerk"
        },
        "bedient_gedrag": {
          "$ref": "#/$defs/kenmerk"
        },
        "in_functie_indeling": {
          "$ref": "#/$defs/kenmerk"
        },
        "leidt_tot_gebeurtenis": {
          "$ref": "#/$defs/kenmerk"
        },
        "onderscheidbare_exemplaren": {
          "$ref": "#/$defs/kenmerk"
        },
        "levenscyclus": {
          "$ref": "#/$defs/kenmerk"
        },
        "wordt_bewerkt": {
          "$ref": "#/$defs/kenmerk"
        },
        "afspraak": {
          "$ref": "#/$defs/kenmerk"
        },
        "waarneembare_vorm": {
          "$ref": "#/$defs/kenmerk"
        },
        "deel_van_object": {
          "$ref": "#/$defs/kenmerk"
        },
        "invoer_van_een_ander": {
          "$ref": "#/$defs/kenmerk"
        },
        "zelfstandig_aanbod": {
          "$ref": "#/$defs/kenmerk"
        },
        "omvat_diensten_en_afspraken": {
          "$ref": "#/$defs/kenmerk"
        },
        "geautomatiseerd_verwerkt": {
          "$ref": "#/$defs/kenmerk"
        },
        "landelijk": {
          "$ref": "#/$defs/kenmerk"
        },
        "in_werking": {
          "$ref": "#/$defs/kenmerk"
        },
        "is_grondslag_voor": {
          "$ref": "#/$defs/kenmerk"
        },
        "zelfstandige_specialisatie": {
          "$ref": "#/$defs/kenmerk"
        },
        "generiek": {
          "$ref": "#/$defs/kenmerk"
        }
      },
      "additionalProperties": false,
      "description": "De kenmerken op het pad (tools/bepaal_type.py vragen); buiten het pad leidt het script nee af. Een kale nee alleen in Aard en Soort gedrag (script)"
    },
    "synoniem_van": {
      "type": "string",
      "description": "Stap 0: het element (of het begrip in deze run) waarvan dit woord een synoniem is"
    },
    "homoniem_van": {
      "type": "string",
      "description": "Stap 0: het andere begrip met dezelfde naam, en waar het voorkomt (wiki, GGM, GEMMA-model, bron)"
    },
    "genoemd_begrip": {
      "type": "string",
      "description": "Het begrip waarvan dit een eigenschap, onderdeel, bredere specialisatie of waarneembare vorm is"
    },
    "archimate_buiten_model": {
      "type": "string",
      "description": "Het ArchiMate-type buiten dit model (Goal, Outcome, Principle, Requirement, Constraint, Value, Capability, Grouping …)"
    },
    "kernobject": {
      "type": "string",
      "description": "Stap 7: het bedrijfsobject waarvan dit proces de levensloop omvat (levensloopproces), waarin het een mutatie doet (bedrijfsproces), of dat door de keten gaat (bedrijfsinteractie)"
    },
    "afnemer": {
      "enum": [
        "extern",
        "intern"
      ],
      "description": "Indelingsveld: de plaats in de indelingen (stap 7)"
    },
    "domein": {
      "enum": [
        "Bestuur",
        "Fysieke leefomgeving",
        "Niet domeingebonden",
        "Openbare orde en veiligheid",
        "Ondersteuning",
        "Publieksdiensten",
        "Sociaal domein"
      ],
      "description": "Indelingsveld: de plaats in de indelingen (stap 7)"
    },
    "doelgroep": {
      "enum": [
        "gemeente",
        "inwoners en ondernemers",
        "ketenpartners"
      ],
      "description": "Indelingsveld: de plaats in de indelingen (stap 7)"
    },
    "regelgever": {
      "enum": [
        "EU",
        "rijk",
        "VNG-modelverordening"
      ],
      "description": "Indelingsveld: de plaats in de indelingen (stap 7)"
    },
    "toelichting": {
      "type": "string",
      "minLength": 1,
      "description": "Waarom deze uitkomst, voor de begrippenlijst (vooral bij een begrip zonder pagina)"
    },
    "definitie": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "not": {
        "pattern": "(?i)gelijk aan (het |de )?(ggm|gemma)"
      },
      "description": "Herkenbare definitie: één zin, hoogstens 160 tekens; gaat naar GEMMA"
    },
    "definitie_formeel": {
      "type": "string",
      "minLength": 1,
      "description": "Letterlijk uit de hoogst gerangschikte bron, alleen bij een wezenlijk verschil"
    },
    "definitie_formeel_bron": {
      "type": "object",
      "required": [
        "bron",
        "plaats"
      ],
      "properties": {
        "bron": {
          "type": "string",
          "minLength": 1
        },
        "plaats": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "beschrijving": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Alinea's; elke alinea op één regel"
    },
    "per_onderwerp": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "description": "Alinea's; elke alinea op één regel"
      }
    },
    "synoniemen": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "naam",
          "context"
        ],
        "properties": {
          "naam": {
            "type": "string",
            "minLength": 1
          },
          "context": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "object_van": {
      "type": "object",
      "required": [
        "id",
        "wijziging",
        "datum"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "wijziging": {
          "enum": [
            "hernoemd",
            "samengevoegd",
            "gesplitst"
          ]
        },
        "datum": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      },
      "additionalProperties": false,
      "description": "Het Archi-object dat dit element voortzet na hernoemen, samenvoegen of splitsen (regel Objectbehoud): het begrip-id van het oude begrip. Hernoemd: altijd; samengevoegd of gesplitst: de redacteur kiest of en welk object blijft"
    },
    "taakveld": {
      "type": "string",
      "minLength": 1
    },
    "beleidsdomein": {
      "type": "string",
      "minLength": 1
    },
    "ggm": {
      "type": "object",
      "required": [
        "sterkte",
        "onderbouwing"
      ],
      "properties": {
        "guid": {
          "type": "string",
          "pattern": "^EAID_"
        },
        "sterkte": {
          "enum": [
            "exact",
            "sterk",
            "partieel",
            "zwak",
            "geen"
          ]
        },
        "onderbouwing": {
          "type": "string",
          "minLength": 1
        },
        "duplicaten": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "guid",
              "toelichting"
            ],
            "properties": {
              "guid": {
                "type": "string",
                "pattern": "^EAID_"
              },
              "toelichting": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "gemma": {
      "type": "object",
      "required": [
        "sterkte",
        "onderbouwing"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sterkte": {
          "enum": [
            "exact",
            "sterk",
            "partieel",
            "zwak",
            "geen"
          ]
        },
        "onderbouwing": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "gemma_generiek": {
      "type": "object",
      "required": [
        "id",
        "onderbouwing"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "onderbouwing": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "description": "Specialisatie van een generiek GEMMA-element (bedrijfsproces, gebeurtenis, dienst of rol), met het id van dat element; bij een cluster naar soort werk bepaalt dit het procesniveau"
    },
    "gemma_functie": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "gemma_relatie": {
          "type": "string",
          "pattern": "^id-"
        },
        "bronnen": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]{4}-[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "minItems": 1
        },
        "vindplaats": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "description": "Bij een bedrijfsfunctie of dienst: de plek in de GEMMA-functiehiërarchie (Functie-indeling naar domein), als het id van de bovenliggende GEMMA-functie, die zelf geen element is. De plek steunt op de GEMMA-relatie van die functie naar de GEMMA-match van dit element (`gemma_relatie`), of anders op `bronnen` met `vindplaats` (regel Elke claim een bron); het script toetst ze aan het model"
    },
    "kwaliteitsdoelen": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "sterkte",
          "onderbouwing",
          "bronnen"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sterkte": {
            "enum": [
              "++",
              "+",
              "-",
              "--"
            ]
          },
          "onderbouwing": {
            "type": "string",
            "minLength": 1
          },
          "bronnen": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9]{4}-[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "minItems": 1
          },
          "vindplaats": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "description": "Bij een beleidskader: de GEMMA-kwaliteitsdoelen waaraan het grondslag geeft (relatie invloed, 'geeft grondslag aan'), met het GEMMA-id, de sterkte (++ bindend: de regeling stelt eisen of normen voor het doel, + draagt bij: de regeling bevordert het doel, - beperkt: de regeling staat het doel deels in de weg, -- staat haaks: de regeling gaat tegen het doel in), een onderbouwing en de bronnen"
    },
    "naamkeuze": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Alinea's; elke alinea op één regel"
    },
    "homoniemen": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "begrip",
          "betekenis",
          "waar",
          "naamkeuze"
        ],
        "properties": {
          "begrip": {
            "type": "string",
            "minLength": 1
          },
          "betekenis": {
            "type": "string",
            "minLength": 1
          },
          "waar": {
            "type": "string",
            "minLength": 1
          },
          "naamkeuze": {
            "type": "string",
            "minLength": 1
          },
          "element": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        },
        "additionalProperties": false
      }
    },
    "generalisatie": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Alinea's; elke alinea op één regel"
    },
    "specialisaties": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "naam",
          "omschrijving"
        ],
        "properties": {
          "naam": {
            "type": "string",
            "minLength": 1
          },
          "omschrijving": {
            "type": "string",
            "minLength": 1
          },
          "element": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "ggm_guid": {
            "type": "string",
            "minLength": 1
          },
          "ggm_attribuut": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "deelprocessen": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "naam",
          "omschrijving",
          "bronnen"
        ],
        "properties": {
          "naam": {
            "type": "string",
            "minLength": 1
          },
          "omschrijving": {
            "type": "string",
            "minLength": 1
          },
          "bronnen": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9]{4}-[a-z0-9]+(-[a-z0-9]+)*$"
            }
          },
          "vindplaats": {
            "type": "string",
            "minLength": 1
          },
          "begrip": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        },
        "additionalProperties": false
      },
      "description": "Bij een bedrijfsproces: de deelprocessen in volgorde, elk met één of twee zinnen voor procesontwerpers (wat er gebeurt, wie, welke termijn); `begrip` is de beoordeling van een deelproces zonder pagina"
    },
    "ggm_componenten": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "naam",
          "guid",
          "toelichting"
        ],
        "properties": {
          "naam": {
            "type": "string",
            "minLength": 1
          },
          "guid": {
            "type": "string",
            "pattern": "^EAID_"
          },
          "toelichting": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "tegenhanger": {
      "type": "object",
      "required": [
        "element",
        "toelichting"
      ],
      "properties": {
        "element": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "toelichting": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "relaties": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "soort",
          "naar",
          "ggm_match"
        ],
        "properties": {
          "soort": {
            "type": "string",
            "pattern": "^(associatie|associatie \\(gericht\\)|aggregatie|compositie|specialisatie|toewijzing|toegang \\([a-zë-]+\\)|triggering|stroom|realisatie|bediening)$"
          },
          "naar": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "naam": {
            "type": "string",
            "minLength": 1
          },
          "kardinaliteit": {
            "type": "string",
            "minLength": 1
          },
          "ggm_match": {
            "enum": [
              "exact",
              "geen"
            ],
            "description": "exact: de relatie is een GGM-relatie tussen de gematchte entiteiten (`ggm_relatie`); geen: geen GGM-relatie, ook niet bij een afgeleide keten"
          },
          "via": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "Een begrip met uitkomst specialisatie van het doel (een specialisatie zonder pagina)"
          },
          "ggm_relatie": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^EAID_"
            }
          },
          "gemma_relatie": {
            "type": "string",
            "pattern": "^id-",
            "description": "Een relatie binnen een GEMMA-indeling tussen twee gematchte elementen: het id van de GEMMA-relatie, in plaats van bronnen (regel Elke claim een bron); het script toetst haar aan het model"
          },
          "bronnen": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9]{4}-[a-z0-9]+(-[a-z0-9]+)*$"
            }
          },
          "vindplaats": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "bronnen": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]{4}-[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "description": "Bronnen naast die in kenmerken en relaties, bijv. de algemene bron van de beschrijving"
    },
    "vragen": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Open vragen aan de redacteur"
    },
    "besluiten": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "datum",
          "besluit",
          "gevolg"
        ],
        "properties": {
          "datum": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "besluit": {
            "type": "string",
            "minLength": 1
          },
          "gevolg": {
            "enum": [
              "afwijzen",
              "verwerkt"
            ]
          },
          "zekerheid": {
            "enum": [
              "kennis",
              "logica",
              "indruk"
            ],
            "description": "kennis: domeinkennis van de redacteur of een bron, geldt als regel; logica: afgeleid, opnieuw voorleggen als nieuwe informatie de redenering raakt; indruk: voorlopig, in fase 3 opnieuw voorleggen. Zonder veld: logica"
          },
          "stand": {
            "type": "string",
            "minLength": 1,
            "description": "Bij een besluit dat nog open staat: hoe het nu staat"
          }
        },
        "additionalProperties": false
      }
    },
    "status": {
      "enum": [
        "review",
        "goedgekeurd",
        "afgewezen"
      ],
      "description": "Door tools/beslissen.py en llmwiki promote; niet zelf invullen"
    },
    "beslist": {
      "type": "object",
      "description": "Door tools/beslissen.py; niet zelf invullen"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "kenmerk": {
      "oneOf": [
        {
          "$ref": "#/$defs/antwoord"
        },
        {
          "const": "nee",
          "description": "Een nee zonder onderbouwing"
        }
      ]
    },
    "antwoord": {
      "type": "object",
      "required": [
        "waarde",
        "onderbouwing"
      ],
      "properties": {
        "waarde": {
          "enum": [
            "ja",
            "nee"
          ]
        },
        "onderbouwing": {
          "type": "string",
          "minLength": 1
        },
        "bronnen": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gemma_relatie": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^id-"
          },
          "description": "Alleen bij in_functie_indeling, zelfstandige_specialisatie: de GEMMA-relaties waarop de plek in een GEMMA-indeling steunt, in plaats van een bron (regel Elke claim een bron); het script toetst ze aan het model"
        }
      },
      "additionalProperties": false
    }
  }
}
