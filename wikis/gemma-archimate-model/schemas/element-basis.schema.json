{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "element-basis",
  "description": "Gedeelde velden van een elementpagina. Zonder prefix = eigen veld van de wiki; ggm_ = letterlijk uit het GGM (alleen tools/ggm.py); gemma_ = letterlijk uit het GEMMA-model (alleen tools/gemma.py). Lege velden weglaten. Geen verwijzingen naar andere elementen in de frontmatter: die staan als relatieve links in de body.",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "ja_nee": {
      "enum": [
        "ja",
        "nee"
      ]
    },
    "matchsterkte": {
      "enum": [
        "exact",
        "sterk",
        "partieel",
        "zwak",
        "geen"
      ]
    },
    "element": {
      "type": "object",
      "required": [
        "id",
        "type",
        "status",
        "naam",
        "archimate_type",
        "onderwerp",
        "bronnen",
        "definitie",
        "grondslag",
        "kenmerken"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string"
        },
        "status": {
          "enum": [
            "kandidaat",
            "review",
            "goedgekeurd",
            "afgewezen"
          ]
        },
        "naam": {
          "type": "string",
          "minLength": 1
        },
        "archimate_type": {
          "type": "string"
        },
        "onderwerp": {
          "$ref": "#/$defs/id"
        },
        "bronnen": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "bijgewerkt": {
          "type": "string"
        },
        "taakveld": {
          "type": "string",
          "minLength": 1
        },
        "beleidsdomein": {
          "type": "string",
          "minLength": 1
        },
        "definitie": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "not": {
            "pattern": "(?i)gelijk aan (het |de )?(ggm|gemma)"
          },
          "description": "Herkenbare definitie: 1 zin, ≤160 tekens, gangbare taal; gaat naar GEMMA"
        },
        "definitie_formeel": {
          "type": "string",
          "minLength": 1,
          "description": "Letterlijk uit de hoogst gerangschikte bron (wet/informatiemodel), alleen bij een wezenlijk verschil met de herkenbare definitie; niet als die bron het GGM is (dan ggm_definitie)"
        },
        "definitie_formeel_bron": {
          "type": "object",
          "required": [
            "bron",
            "plaats"
          ],
          "properties": {
            "bron": {
              "type": "string",
              "minLength": 1
            },
            "plaats": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "toelichting": {
          "type": "string"
        },
        "synoniemen": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "naam",
              "context"
            ],
            "properties": {
              "naam": {
                "type": "string",
                "minLength": 1
              },
              "context": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "grondslag": {
          "enum": [
            "ggm-entiteit",
            "ggm-afgeleid",
            "procesobject",
            "governance-object",
            "bron"
          ]
        },
        "match": {
          "type": "object",
          "properties": {
            "ggm": {
              "$ref": "#/$defs/matchsterkte"
            },
            "gemma": {
              "$ref": "#/$defs/matchsterkte"
            }
          },
          "additionalProperties": false
        },
        "data_object": {
          "$ref": "#/$defs/ja_nee"
        },
        "kenmerken": {
          "$ref": "beoordeling.schema.json#/$defs/kenmerkwaarden"
        },
        "ggm_entiteit": {
          "type": "string",
          "minLength": 1
        },
        "ggm_guid": {
          "type": "string",
          "pattern": "^EAID_"
        },
        "ggm_uml_type": {
          "enum": [
            "Class",
            "Enumeration"
          ]
        },
        "ggm_beleidsdomein": {
          "type": "string",
          "minLength": 1
        },
        "ggm_taakveld": {
          "type": "string",
          "minLength": 1
        },
        "ggm_diagram": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ggm_diagram_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ggm_definitie": {
          "type": "string"
        },
        "ggm_toelichting": {
          "type": "string"
        },
        "ggm_synoniemen": {
          "type": "string"
        },
        "ggm_herkomst": {
          "type": "string"
        },
        "ggm_duplicaat_entiteiten": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "entiteit",
              "guid",
              "beleidsdomein"
            ],
            "properties": {
              "entiteit": {
                "type": "string",
                "minLength": 1
              },
              "guid": {
                "type": "string",
                "minLength": 1
              },
              "beleidsdomein": {
                "type": "string",
                "minLength": 1
              },
              "taakveld": {
                "type": "string"
              },
              "afwijkende_attributen": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "gemma_id": {
          "type": "string",
          "minLength": 1
        },
        "gemma_naam": {
          "type": "string",
          "minLength": 1
        },
        "gemma_type": {
          "type": "string",
          "minLength": 1
        },
        "gemma_definitie": {
          "type": "string"
        },
        "gemma_map": {
          "type": "string"
        },
        "gemma_eigenschappen": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "dependentRequired": {
        "definitie_formeel": [
          "definitie_formeel_bron"
        ],
        "definitie_formeel_bron": [
          "definitie_formeel"
        ],
        "ggm_guid": [
          "ggm_entiteit"
        ],
        "gemma_id": [
          "gemma_naam"
        ]
      }
    }
  }
}
